import kernel.*
import kernel.config.*
import kernel.log.*
import kernel.security.*
import identity.*
import age.*
import onboarding.*
import profile.*
import communities.*
import communityprojects.*
import groups.*
import studypairs.*

// Composition root: config -> datasource -> migrations -> app -> kernel routes -> domain routes -> listen.
// Domain wiring (stores, services, routes, jobs) is added between Platform.create and start.
main() {
    var log = Log("main")
    try {
        var cfg = Config.env()
        var port = cfg.getInt("PORT", cfg.getInt("SERVER_PORT", 8081))
        var platform = Platform.create(cfg)
        // Shared services (idempotency, outbox worker, audit, cipher, caches, sanction gate, risk engine, ...).
        var shared = SharedServices.create(platform)
        // Request pipeline (filters, limiters, guards). Each domain port replaces its own seam in `hooks`
        // (moderators, monitoring, reports, origins) before this line.
        var hooks = SecurityHooks.defaults(platform.db)
        var parts = Security.install(platform, hooks)
        // identity (auth, 2FA, social login, identity verification), age (parental supervision, age gate) and
        // onboarding. Seams: IdentitySeams (users, mailer, Turnstile, IP blocks, signup guard, notifier, OAuth links,
        // identity providers) and OnboardingActions (communities, groups, network); defaults documented in
        // docs/PORTING_STATUS.md.
        var identity = IdentityModule.install(platform, shared, hooks, parts)
        var age = AgeModule.install(platform, identity.mailer)
        OnboardingModule.install(platform, age.policy)
        // profile, network, preferences, presence (seams: ProfileModule.installWith).
        ProfileModule.install(platform, shared, hooks)
        // Domains (one line each, after Security.install).
        GroupsModule.install(platform, shared, hooks)
        CommunitiesModule.install(platform, shared, hooks)
        CommunityProjectsModule.install(platform, shared, hooks)
        StudyPairsModule.install(platform, shared, hooks)
        log.info("listening on port " + port)
        platform.start(port)
    } catch (String e) {
        log.error("boot_failed " + e)
        process.exit(1)
    }
}
