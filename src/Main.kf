import app.*
import kernel.*
import kernel.config.*
import kernel.log.*

// Composition root: config -> datasource -> migrations -> app wiring (app.AppWiring) -> listen.
main() {
    var log = Log("main")
    try {
        var cfg = Config.env()
        var port = cfg.getInt("PORT", cfg.getInt("SERVER_PORT", 8081))
        var platform = Platform.create(cfg)
        AppWiring.install(platform)
        log.info("listening on port " + port)
        platform.start(port)
    } catch (String e) {
        log.error("boot_failed " + e)
        process.exit(1)
    }
}
