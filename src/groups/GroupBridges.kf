package groups

import calls.*
import kernel.db.*

// calls: the role of a person in a group and the members a "Tamo junto" call announces to, asked to GroupService
// (roleOf / memberIds) instead of reading `group_members`.
class GroupsCallGroups extends CallGroups {
    GroupService service
    public constructor(database: Db, service: GroupService) {
        super(database)
        this.service = service
    }
    String? roleOf(groupId: String, userId: String) = service.roleOf(groupId, userId)
    List<String> memberIds(groupId: String) = service.memberIds(groupId)
}
