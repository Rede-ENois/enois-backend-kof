package groups

// JSON shapes of the Groups endpoints (the Java records of GroupController / GroupContentController,
// component by component, in declaration order). Names are prefixed: type names are global.
record GroupView(String id, String slug, String name, String? description, String? topic, String? avatar, String? banner, String? bannerHtml, String joinMode, String status, Long members, String? viewerRole, Bool joined, Bool requestPending, String createdAt)

record GroupMemberView(String userId, String? username, String? name, String? avatar, String role, String joinedAt, GroupNameStyle? nameStyle)

record GroupRequestView(String id, String userId, String? username, String? name, String? avatar, String? message, String createdAt, GroupNameStyle? nameStyle)

record GroupTopicView(String id, String groupId, String name, String? description, Int position, String status, String createdAt)

record GroupPostView(String id, String groupId, String topicId, String authorId, String? authorName, String? authorUsername, String? authorAvatar, List<String> authorBadges, String content, List<String> mediaIds, Bool pinned, Int reactions, Int comments, String? myReaction, String createdAt, String? authorAvatarFrame, GroupNameStyle? authorStyle, List<GroupMediaSummary> media)

record GroupCommentView(String id, String postId, String authorId, String? authorName, String? authorUsername, String? authorAvatar, List<String> authorBadges, String? parentCommentId, String content, String createdAt, String? authorAvatarFrame, GroupNameStyle? authorStyle)

// PageResponse<T>(items, nextCursor), one record per item type.
record GroupViewPage(List<GroupView> items, String? nextCursor)

record GroupMemberPage(List<GroupMemberView> items, String? nextCursor)

record GroupRequestPage(List<GroupRequestView> items, String? nextCursor)

record GroupTopicPage(List<GroupTopicView> items, String? nextCursor)

record GroupPostPage(List<GroupPostView> items, String? nextCursor)

record GroupCommentPage(List<GroupCommentView> items, String? nextCursor)

// StatusResponse(id, status) and the JoinResponse(status) of the join/decision endpoints.
record GroupStatusView(String id, String status)

record GroupOutcomeView(String status)

// Request bodies (unknown properties are ignored, absent ones are null).
record GroupBody(String? name, String? description, String? topic, String? avatar, String? banner, String? bannerHtml, String? joinMode)

record GroupTransferBody(String? userId)

record GroupStatusBody(String? status, String? reason)

record GroupTopicBody(String? name, String? description)

record GroupReorderBody(List<String>? topicIds)

record GroupPostBody(String? topicId, String? content, List<String>? mediaIds)

record GroupCommentBody(String? content, String? parentCommentId)

record GroupCommentEditBody(String? content)

record GroupReactionBody(String? type)
