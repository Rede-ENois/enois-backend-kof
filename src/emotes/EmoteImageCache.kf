package emotes

import kernel.http.*
import kernel.concurrent.*
import kernel.time.*

// Fetches the bytes of one image from the provider CDN, behind a seam so tests answer from memory.
// Short timeouts on purpose: cdn.frankerfacez.com has spikes where it does not answer in 12 s, and without
// a limit each empty square of the picker held a thread until the CDN gave up.
class EmoteImageFetcher {
    public constructor() {}
    static String notFoundTag() = "IMAGE_NOT_FOUND"
    // The image, or throws: `IMAGE_NOT_FOUND: ...` for a definitive 404/410, anything else is transient.
    EmoteStoredImage fetch(url: String) {
        var res = HttpFetch.getBytes(url, listOf("User-Agent: enois/1.0 (+https://enois.ia.br)", "Accept: image/*"), 4000, 6000, 1048576)
        if (res.status == 404 || res.status == 410) {
            throw EmoteImageFetcher.notFoundTag() + ": CDN de figurinha respondeu " + res.status
        }
        if (res.status != 200) {
            throw "CDN de figurinha respondeu " + res.status
        }
        if (!res.contentType.startsWith("image/")) {
            throw "CDN de figurinha respondeu " + res.contentType
        }
        if (res.size() > 1048576) {
            throw "Imagem de figurinha maior que o limite"
        }
        return EmoteStoredImage(res.body, res.contentType)
    }
}

// Cache of the sticker images served by the backend (the CDN fails ~30% of direct attempts: the first reader
// pays with a second try, the others get memory, and the browser keeps it for days).
//
// The animation arrives from the catalog; the cache key carries that bit, so when a refresh discovers an
// animation the old static entry is not reused by mistake. Guards: the upstream address is always a constant
// plus the validated id (EmoteImages.upstream); only a known provider enters; only an `image/*` answer of at
// most 1 MB is kept. Nothing the caller sends becomes the destination host.
class EmoteImageCache {
    EmoteImageFetcher fetcher
    Gate gate = Gate()
    Map<String,EmoteStoredImage> items = mapOf<String, EmoteStoredImage>()
    Map<String,Long> storedAt = mapOf<String, Long>()
    List<String> order = listOf<String>()
    Long weight = 0L
    public constructor(fetcher: EmoteImageFetcher) {
        this.fetcher = fetcher
    }
    static Long maxWeight() = 50331648L
    static Long ttlMillis() = 604800000L
    // The image from the cache or the CDN; null when provider/id do not exist or the CDN did not answer.
    EmoteStoredImage? find(providerParam: String?, id: String?, variantParam: String?, animated: Bool) {
        var provider = EmoteRules.parseProvider(providerParam)
        if (provider == null) {
            return null
        }
        if (id == null) {
            return null
        }
        if (!EmoteRules.validId(id)) {
            return null
        }
        var variant = EmoteImages.variant(variantParam)
        var suffix = "/s"
        if (animated) {
            suffix = "/a"
        }
        var key = provider + "/" + id + "/" + variant + suffix
        var cached = this.lookup(key)
        if (cached != null) {
            return cached
        }
        var fetched = this.download(provider, id, variant, animated)
        if (fetched != null) {
            this.store(key, fetched)
        }
        return fetched
    }
    EmoteStoredImage? lookup(key: String) {
        gate.enter()
        var hit = items.get(key)
        var at = storedAt.get(key)
        if (hit != null && at != null && Time.nowMillis() - at > EmoteImageCache.ttlMillis()) {
            this.dropLocked(key)
            gate.leave()
            return null
        }
        gate.leave()
        return hit
    }
    store(key: String, image: EmoteStoredImage) {
        gate.enter()
        this.dropLocked(key)
        items.put(key, image)
        storedAt.put(key, Time.nowMillis())
        order.add(key)
        weight = weight + image.bytes().length
        // Over budget: the oldest entries go first.
        while (weight > EmoteImageCache.maxWeight() && order.size() > 1) {
            this.dropLocked(order.get(0))
        }
        gate.leave()
    }
    dropLocked(key: String) {
        var old = items.get(key)
        if (old != null) {
            weight = weight - old.bytes().length
            items.remove(key)
            storedAt.remove(key)
            var kept = listOf<String>()
            for (var k in order) {
                if (k != key) {
                    kept.add(k)
                }
            }
            order = kept
        }
    }
    // The right address first; the static one only when the CDN refuses a file the catalog says exists.
    EmoteStoredImage? download(provider: String, id: String, variant: String, animated: Bool) {
        var preferred = this.attempt(EmoteImages.upstream(provider, id, variant, animated))
        if (preferred != null) {
            return preferred
        }
        var staticUrl = EmoteImages.fallback(provider, id, variant, animated)
        if (staticUrl == null) {
            return null
        }
        return this.attempt(staticUrl)
    }
    // Two tries per address: the FFZ CDN fails in bursts and usually answers the second time.
    EmoteStoredImage? attempt(url: String) {
        var tries = 1
        while (tries <= 2) {
            try {
                return fetcher.fetch(url)
            } catch (String e) {
                // A definitive answer ("does not exist") is not retried: the next step is the static file.
                if (e.startsWith(EmoteImageFetcher.notFoundTag())) {
                    return null
                }
                if (tries == 2) {
                    return null
                }
            }
            tries = tries + 1
        }
        return null
    }
    Int cachedEntries() = items.size()
}
