package ops

import kernel.monitoring.*

// One line of the admin events panel (and of the JSONL file). Field names are the Java EventView.
record MonitoringEvent(String id, String createdAt, String level, String type, String message, String? requestId, String? method, String? path, String? route, Int? status, Long? durationMs, String? userId, String? clientIp, String? deviceId, String? metadata)

record MonitoringJvm(Long heapUsedBytes, Long heapMaxBytes, Int threads, Int processors)

record MonitoringOverview(String generatedAt, Long uptimeSeconds, Long requestsLastMinute, Long errors4xxLastMinute, Long errors5xxLastMinute, Double errorRate, Long p95Ms, Long droppedEvents, List<MonitoringMinutePoint> series, List<MonitoringCount> levels24h, List<MonitoringCount> types24h, List<MonitoringCount> topRoutes, List<MonitoringEvent> recent, MonitoringJvm jvm, Double requestsPerSecond, Int inFlight, Int peakInFlight, Long requestsTotal, Long p50Ms, Long p99Ms, Long maxMs, Long slowLastMinute, Long rateLimitedLastMinute, List<MonitoringCount> statusCounts, List<MonitoringCount> methodCounts, HostResourcesView resources)

// A day of the sign-up series: how many joined, the running total at the end of the day and the variation.
record UserDailyPoint(String date, Long newUsers, Long total, Double growthPercent)

// Projection of the account total N days ahead, at the pace of the last week.
record UserProjection(Int days, Long total, Double growthPercent)

record UsersView(String generatedAt, Long total, Long newToday, Long newLast7Days, Long newLast30Days, Double growthTodayPercent, Double growth7DaysPercent, Double growth30DaysPercent, Double averageDailyNew7Days, Double averageDailyNew30Days, List<UserDailyPoint> series, List<UserProjection> projections)

// What /admin/emails shows: metadata only, recipient masked, subject and error scrubbed of addresses.
record EmailLogView(String id, String toEmail, String subject, String kind, String status, String? error, String createdAt)
