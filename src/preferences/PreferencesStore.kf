package preferences

import kernel.db.*

// user_preferences (UserPreferencePersistenceAdapter): one row per account.
class PreferencesStore {
    Db store
    public constructor(store: Db) {
        this.store = store
    }
    PreferencesRow? find(userId: String) {
        var r = store.queryOptional("select user_id, theme_id, liked_topics, blocked_topics, disabled_modules, night_rest_reminder, night_rest_dismissed_on, lite_mode, batata_mode, updated_at from user_preferences where user_id = ?", DbParams().bindStr(userId))
        if (r == null) {
            return null
        }
        return PreferencesRow(r.getStr("user_id"), r.getStrOrNull("theme_id"), r.getStrOrNull("liked_topics"), r.getStrOrNull("blocked_topics"), r.getStrOrNull("disabled_modules"), r.getBool("night_rest_reminder"), r.getDateOrNull("night_rest_dismissed_on"), r.getBool("lite_mode"), r.getBool("batata_mode"), r.getInstant("updated_at"))
    }
    // Insert or update the whole row (JPA merge).
    save(p: PreferencesRow) {
        var changed = store.execute("update user_preferences set theme_id = ?, liked_topics = ?, blocked_topics = ?, disabled_modules = ?, night_rest_reminder = ?, night_rest_dismissed_on = ?, lite_mode = ?, batata_mode = ?, updated_at = ? where user_id = ?", DbParams().bindStrOrNull(p.themeId).bindStrOrNull(p.likedTopics).bindStrOrNull(p.blockedTopics).bindStrOrNull(p.disabledModules).bindBool(p.nightRestReminder).bindDateOrNull(p.nightRestDismissedOn).bindBool(p.liteMode).bindBool(p.batataMode).bindInstant(p.updatedAt).bindStr(p.userId))
        if (changed == 0) {
            store.execute("insert into user_preferences (user_id, theme_id, liked_topics, blocked_topics, disabled_modules, night_rest_reminder, night_rest_dismissed_on, lite_mode, batata_mode, updated_at) values (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)", DbParams().bindStr(p.userId).bindStrOrNull(p.themeId).bindStrOrNull(p.likedTopics).bindStrOrNull(p.blockedTopics).bindStrOrNull(p.disabledModules).bindBool(p.nightRestReminder).bindDateOrNull(p.nightRestDismissedOn).bindBool(p.liteMode).bindBool(p.batataMode).bindInstant(p.updatedAt))
        }
    }
    delete(userId: String) {
        store.execute("delete from user_preferences where user_id = ?", DbParams().bindStr(userId))
    }
}
