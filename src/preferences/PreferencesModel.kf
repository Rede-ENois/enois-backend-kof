package preferences

// A row of user_preferences (UserPreference). List fields are validated CSV text; null means "never set".
record PreferencesRow(String userId, String? themeId, String? likedTopics, String? blockedTopics, String? disabledModules, Bool nightRestReminder, String? nightRestDismissedOn, Bool liteMode, Bool batataMode, String updatedAt)

// GET/PUT /me/preferences and POST /me/preferences/night-rest/dismissed answer (PersonalizationResponse).
record PreferencesView(List<String> likedTopics, List<String> blockedTopics, List<String> disabledModules, Bool nightRestReminder, String? nightRestDismissedOn, Bool liteMode, Bool batataMode)

// GET /me/theme (ThemeResponse): the choice and when this account saved it.
record PreferencesThemeView(String? theme, String? updatedAt)

record PreferencesUpdateBody(List<String>? likedTopics, List<String>? blockedTopics, List<String>? disabledModules, Troolean nightRestReminder, Troolean liteMode, Troolean batataMode)

record PreferencesNightBody(String? night)

record PreferencesThemeBody(String? theme)
