package preferences

import kernel.error.*
import kernel.http.*
import kernel.security.*
import kernel.url.*

// HTTP adapter of preferences (PersonalizationController, ThemeController).
class PreferencesRoutes {
    static PreferencesUpdateBody updateBody() {
        SafeLinks.checkRequest()
        try {
            return json.decode<PreferencesUpdateBody>(Req.bodyText())
        } catch (String e) {
            throw Errors.badRequest()
        }
    }
    static PreferencesNightBody nightBody() {
        SafeLinks.checkRequest()
        try {
            return json.decode<PreferencesNightBody>(Req.bodyText())
        } catch (String e) {
            throw Errors.badRequest()
        }
    }
    static PreferencesThemeBody themeBody() {
        SafeLinks.checkRequest()
        try {
            return json.decode<PreferencesThemeBody>(Req.bodyText())
        } catch (String e) {
            throw Errors.badRequest()
        }
    }
    static register(server: HttpServer, service: PreferencesService) {
        server.get("/me/preferences", () -> json.encode(service.of(Auth.requireUser())))
        server.put("/me/preferences", () -> {
    var userId = Auth.requireUser()
    return json.encode(service.update(userId, PreferencesRoutes.updateBody()))
})
        server.post("/me/preferences/night-rest/dismissed", () -> {
    var userId = Auth.requireUser()
    return json.encode(service.dismissNightRest(userId, PreferencesRoutes.nightBody().night()))
})
        server.get("/me/theme", () -> json.encode(service.theme(Auth.requireUser())))
        server.put("/me/theme", () -> {
    var userId = Auth.requireUser()
    service.setTheme(userId, PreferencesRoutes.themeBody().theme())
    return status(204, "")
})
    }
}
