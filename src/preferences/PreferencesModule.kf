package preferences

import kernel.*

// Preferences module. `service` is the read API for the feed (`likedTopics`, `blockedTopics`) and
// for anything that needs the account preferences.
class PreferencesModule {
    PreferencesService service
    public constructor(service: PreferencesService) {
        this.service = service
    }
    static PreferencesModule install(platform: Platform, gallery: PreferencesThemeGallery) {
        var service = PreferencesService(PreferencesStore(platform.db), gallery)
        PreferencesRoutes.register(platform.server, service)
        return PreferencesModule(service)
    }
}
