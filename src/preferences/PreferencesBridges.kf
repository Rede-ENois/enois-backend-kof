package preferences

import feed.*
import kernel.db.*
import studypairs.*

// The personalisation reads other domains held while this one did not exist, now backed by PreferencesService.

// feed: liked and blocked topics of the reader.
class PreferencesFeedReader extends FeedReaderPrefs {
    PreferencesService service
    public constructor(database: Db, service: PreferencesService) {
        super(database)
        this.service = service
    }
    List<String> blockedTopics(userId: String) = service.blockedTopics(userId)
    List<String> likedTopics(userId: String) = service.likedTopics(userId)
}

// study pairs: has the person switched the module off.
class PreferencesStudyPairs extends StudyPairPreferences {
    PreferencesService service
    public constructor(database: Db, service: PreferencesService) {
        super(database)
        this.service = service
    }
    Bool moduleDisabled(userId: String) = service.of(userId).disabledModules.contains(StudyPairRules.module())
}
