package preferences

import kernel.db.*

// Does a published community theme with this id exist (ThemeGalleryUseCase.isPublished)? Used by
// preferences. pending-port: themes.
class PreferencesThemeGallery {
    Db store
    public constructor(store: Db) {
        this.store = store
    }
    Bool isPublished(themeId: String) = store.queryLong("select count(*) from theme_gallery where id = ? and status = \'PUBLISHED\'", DbParams().bindStr(themeId)) > 0L
}
