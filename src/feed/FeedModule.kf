package feed

import kernel.*
import kernel.security.*

// Composition of the feed domain: stores, services, routes. Seams default to read-only readers over the
// owners' tables (see docs/PORTING_STATUS.md, "feed"); the owner subclasses and passes its own in.
class FeedModule {
    FeedService service
    FeedStore store
    public constructor(service: FeedService, store: FeedStore) {
        this.service = service
        this.store = store
    }
    static FeedModule install(platform: Platform, shared: SharedServices, hooks: SecurityHooks) {
        var database = platform.db
        var store = FeedStore(database)
        var service = FeedService(database, store, FeedAuthors(database), FeedMedia(database), FeedCommunities(database), FeedNotifier(database), FeedAgeGate(), FeedCoins(), FeedCorporate(database), shared.blockedUsers, shared.sanctionGate, shared.risk, shared.duplication, shared.outbox, shared.audit, Security.parts())
        // MomentExpiryScheduler: every 5 minutes, first run after 2 (REDE_FEED_WORKERS_ENABLED=false in tests).
        if (platform.cfg.getBool("REDE_FEED_WORKERS_ENABLED", true)) {
            shared.jobs.fixedDelay("feed-moment-expiry", 120000L, 300000L, () -> service.expireDueMoments(200))
        }
        FeedRoutes.register(platform.server, service, shared.idempotency, FeedHoneypot())
        return FeedModule(service, store)
    }
}
