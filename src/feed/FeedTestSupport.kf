package feed

import kernel.*
import kernel.audit.*
import kernel.blocks.*
import kernel.cache.*
import kernel.idempotency.*
import kernel.jobs.*
import kernel.outbox.*
import kernel.risk.*
import kernel.sanctions.*
import kernel.security.*
import kernel.testkit.*

// Test support: one booted app per test file (a file is a process) with the feed wired on the full
// security pipeline, limits relaxed so a suite can write freely.
class FeedTestSupport {
    static TestApp? cachedApp = null
    static TestApp app() {
        var cur = FeedTestSupport.cachedApp
        if (cur != null) {
            return cur
        }
        var created = TestApp.bootWith("feed", mapOf("REDE_ORIGINS_ENFORCE", "false", "REDE_SECURITY_NEW_ACCOUNT_COOLDOWN_SECONDS", "0", "REDE_RATE_POST_LIMIT", "1000", "REDE_RATE_COMMENT_LIMIT", "1000", "POST_USER_RATE_LIMIT", "100000", "GLOBAL_RATE_LIMIT_PER_MINUTE", "0"), (p: Platform) -> FeedTestSupport.wire(p))
        FeedTestSupport.cachedApp = created
        return created
    }
    static wire(p: Platform) {
        var shared = FeedTestSupport.sharedWithoutWorker(p)
        var hooks = SecurityHooks.defaults(p.db)
        Security.install(p, hooks)
        FeedModule.install(p, shared, hooks)
    }
    // SharedServices.create minus the outbox worker thread (it keeps the test process alive); tests call
    // shared.outbox.processPending() themselves.
    static SharedServices sharedWithoutWorker(p: Platform) {
        var cfg = p.cfg
        var database = p.db
        var sanctionReader = SanctionGateReader(database)
        var duplication = ContentDuplicationGuard.fromConfig(cfg)
        var risk = RiskEngine.fromConfig(cfg, RiskSubjectReader(database, sanctionReader), RiskAssessmentWriter(database), RiskTimingSignals(), duplication, RiskEscalation())
        return SharedServices(p, Scheduler(), Idempotency(database), Outbox(database), Audit(database), SecretCipher.fromConfig(cfg), Caches.create(cfg), BlockedUsers(database), sanctionReader, SanctionGate(sanctionReader), SuspiciousText.fromConfig(cfg), duplication, risk)
    }
    // A verified user with a live session; returns the token.
    static String user(id: String) {
        SecurityFixtures.login(FeedTestSupport.app().db(), id, "tok-" + id + "-1234567890")
        return "tok-" + id + "-1234567890"
    }
    // A string field of a response (the test fails when it is missing).
    static String field(res: TestResponse, path: String) {
        var v = res.jsonStr(path)
        if (v == null) {
            throw "missing field " + path + " in " + res.body
        }
        return v
    }
    static List<String> write(token: String, key: String) = listOf("X-Session-Token: " + token, "Idempotency-Key: " + key, "Content-Type: application/json")
    static List<String> read(token: String) = listOf("X-Session-Token: " + token)
    static TestResponse post(token: String, key: String, body: String) = FeedTestSupport.app().client.send("POST", "/feed/posts", FeedTestSupport.write(token, key), "", body)
    static TestResponse send(method: String, path: String, token: String, key: String, body: String) = FeedTestSupport.app().client.send(method, path, FeedTestSupport.write(token, key), "", body)
}
