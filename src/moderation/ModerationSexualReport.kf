package moderation

import feed.*
import kernel.log.*
import kernel.time.*
import notifications.*

record ModerationSexualOutcome(String status, Bool quarantined, Bool removed, Bool released)

// SexualContentReportService: a report for SEXUAL content on a post takes the post off the air at once and the bot decides first.
// Why this path exists: sexual content is the case where waiting for a person IS the damage. The common report still goes to the
// human queue; this one, as soon as it is created, hides the post (quarantine, not deletion) and starts the automatic evaluation
// with the text and the images of the post itself.
// The three exits, and only them: confirmed NSFW (a PENALIZAR verdict that passes the auto-penalty gate) deletes the post for good;
// SAFE (verdict NENHUMA) puts it back on the feed; anything else (doubt, model down, invalid JSON) leaves the case in the human
// quarantine queue. No exit punishes the account: deleting content and punishing the account are separate decisions, and the
// second stays with a person.
class ModerationSexualReport {
    Log log = Log("moderation.sexual")
    ModerationSafetyStore ledger
    ModerationPosts posts
    FeedModeration feed
    ModerationImages images
    ModerationAi ai
    Notifications notifications
    Bool enabled
    public constructor(ledger: ModerationSafetyStore, posts: ModerationPosts, feed: FeedModeration, images: ModerationImages, ai: ModerationAi, notifications: Notifications, enabled: Bool) {
        this.ledger = ledger
        this.posts = posts
        this.feed = feed
        this.images = images
        this.ai = ai
        this.notifications = notifications
        this.enabled = enabled
    }
    // The actor of the trail: the automation, not a person.
    static String actor() = "automod:sexual"
    static Int maxImages() = 3
    // Handles a just-created sexual report. Idempotent: a post already evaluated by this path answers the previous state. The
    // quarantine is the FIRST thing (immediate precaution); the bot's evaluation comes after and cannot knock anything down: a
    // failure becomes "doubt" and the case stays with a person.
    ModerationSexualOutcome handle(postId: String, reportDescription: String?) {
        if (!enabled) {
            return ModerationSexualOutcome("DISABLED", false, false, false)
        }
        var previous = ledger.findContent(postId)
        if (previous != null) {
            return ModerationSexualOutcome("ALREADY_CHECKED", previous.status == "PENDING", previous.status == "REMOVED", previous.status == "RELEASED")
        }
        var post = posts.byId(postId)
        if (post == null) {
            return ModerationSexualOutcome("SKIP", false, false, false)
        }
        if (post.status() != "ACTIVE") {
            return ModerationSexualOutcome("SKIP", false, false, false)
        }
        // 1. Immediate precaution: the post leaves the air and the case enters the human queue BEFORE the bot.
        this.remember(post, "UNSURE", 0.0, "denúncia sexual: em avaliação automática", "PENDING")
        var hidden = false
        try {
            hidden = feed.quarantine(ModerationSexualReport.actor(), postId, "Denúncia sexual em avaliação (precaução)")
        } catch (String e) {
            log.warn("sexual_report_quarantine_failed post=" + postId)
        }
        this.notice(post, "Post em análise", "Um post seu foi denunciado por conteúdo sexual e está temporariamente fora do ar enquanto passa pela avaliação automática e pela revisão do time. Se estiver tudo certo, ele volta ao ar e você é avisado.", "/api/diretrizes", "Ver diretrizes")
        // 2. The bot decides: confirmed NSFW deletes, safe gives back, the rest stays with a person.
        if (!ai.available()) {
            log.info("sexual_report_bot_unavailable post=" + postId)
            return ModerationSexualOutcome("HUMAN_REVIEW", hidden, false, false)
        }
        var verdict = this.guess(post, reportDescription)
        if (verdict == null) {
            return ModerationSexualOutcome("HUMAN_REVIEW", hidden, false, false)
        }
        var action = ModerationVerdicts.text(verdict.acao)
        if (action == "PENALIZAR" && ModerationVerdicts.canAutoPenalize(verdict)) {
            return this.remove(post, verdict)
        }
        if (action == "NENHUMA") {
            return this.release(post, verdict)
        }
        return ModerationSexualOutcome("HUMAN_REVIEW", hidden, false, false)
    }
    // The validated verdict of the model for the post (text and images); null on any failure.
    ModerationVerdict? guess(post: FeedPostRow, reportDescription: String?) {
        try {
            var pictures = images.imagesOf("POST", post.id(), ModerationSexualReport.maxImages())
            var raw = ai.triage(ModerationPrompts.user(post.content(), "SEXUAL_CONTENT", ModerationVerdicts.text(reportDescription)), pictures)
            return ai.parseVerdict(raw)
        } catch (String e) {
            log.warn("sexual_report_bot_failed post=" + post.id())
            return null
        }
    }
    // Confirmed NSFW: the post leaves for good. The account is NOT punished on this path.
    ModerationSexualOutcome remove(post: FeedPostRow, verdict: ModerationVerdict) {
        var why = ModerationVerdicts.text(verdict.justificativa)
        var motive = "Automod de conteúdo sexual: confirmado pela avaliação automática"
        if (why.trim().length() > 0) {
            motive = "Automod de conteúdo sexual: " + why
        }
        try {
            feed.removeAsModerator(ModerationSexualReport.actor(), post.id(), motive)
        } catch (String e) {
            // The removal failed: the post stays hidden and the case does NOT leave the human queue.
            log.error("sexual_report_remove_failed post=" + post.id())
            return ModerationSexualOutcome("REMOVE_FAILED", true, false, false)
        }
        ledger.updateContentStatus(post.id(), "REMOVED")
        this.notice(post, "Post removido", "Seu post foi removido por conteúdo sexual, depois da avaliação automática e da revisão do time. Se discordar, use o canal de recurso.", "/api/diretrizes", "Ver diretrizes")
        log.warn("sexual_report_removed post=" + post.id())
        return ModerationSexualOutcome("REMOVED", true, true, false)
    }
    // Safe: the post goes back to the feed exactly as it was.
    ModerationSexualOutcome release(post: FeedPostRow, verdict: ModerationVerdict) {
        var back = false
        try {
            back = feed.release(ModerationSexualReport.actor(), post.id())
        } catch (String e) {
            log.warn("sexual_report_release_failed post=" + post.id())
        }
        ledger.updateContentStatus(post.id(), "RELEASED")
        this.notice(post, "Post liberado", "Seu post passou pela avaliação automática e voltou ao ar.", "/api/feed", "Ver feed")
        log.info("sexual_report_released post=" + post.id())
        return ModerationSexualOutcome("RELEASED", false, false, back)
    }
    remember(post: FeedPostRow, verdict: String, confidence: Double, reason: String, status: String) {
        try {
            ledger.saveContent(ModerationSafetyRules.content(post.id(), post.authorId(), verdict, confidence, reason, ai.model, Time.nowIso(), status))
        } catch (String e) {
            // An unavailable ledger cannot stop the precaution: the quarantine goes on.
            log.warn("sexual_report_ledger_failed post=" + post.id())
        }
    }
    notice(post: FeedPostRow, title: String, message: String, href: String, cta: String) {
        try {
            notifications.create(post.authorId(), "MODERACAO", ModerationSexualReport.actor(), title, message, href, cta)
        } catch (String e) {
            log.warn("sexual_report_notice_failed post=" + post.id())
        }
    }
}
