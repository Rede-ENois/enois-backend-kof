package moderation

import kernel.id.*

// A moderator application (ModeratorApplication): PENDING, then APPROVED or REJECTED; an approved one is the role itself and
// REVOKED when an admin takes it back.
record ModerationApplication(String id, String userId, String motivation, String? experience, String? availability, String status, String createdAt, String? reviewedBy, String? reviewedAt, String? reviewNote)

// The application with who the candidate is: the admin needs to know whom they approve (ApplicationView).
record ModerationApplicationView(String id, String userId, String? username, String? name, String motivation, String? experience, String? availability, String status, String createdAt, String? reviewedBy, String? reviewedAt, String? reviewNote)

// GET /moderation/me (MeResponse).
record ModerationMeView(Int reputation, Int minReputation, Bool eligible, Bool moderator, Bool admin, Long moderatorCount, Int minModeratorsForSanction, ModerationApplicationView? application)

// A moderator's vote on a report (ModerationVote): PUNISH or DISMISS, changeable while the report is pending.
record ModerationVote(String id, String reportId, String moderatorId, String vote, String? note, String createdAt, String updatedAt)

// The report queue of the panel: content, author and the vote counts (PanelReportView).
record ModerationPanelReport(String reportId, String targetType, String targetId, String reason, String description, String createdAt, String reporter, String? authorId, String? author, String? content, Int punishVotes, Int dismissVotes, String? myVote, Int quorum)

record ModerationVoteResult(Int punishVotes, Int dismissVotes, String myVote, String reportStatus, String decision, String message, Int quorum)

record ModerationDirectSanction(String userId, String username, String type, String status)

record ModerationSanitizeResult(String userId, String username, Int posts, Int comments, Int otherRows)

record ModerationApplicationBody(String? motivation, String? experience, String? availability)

record ModerationVoteBody(String? vote, String? note)

record ModerationDecisionBody(String? note)

record ModerationAppointBody(String? username, String? note)

record ModerationSanctionBody(String? type, String? reason)

class ModerationModeratorRules {
    static Int minModeratorsForSanction() = 10
    static List<String> applicationStatuses() = listOf("PENDING", "APPROVED", "REJECTED", "REVOKED")
    static List<String> voteTypes() = listOf("PUNISH", "DISMISS")
    static String? noString() = null
    static ModerationApplicationView? noView() = null
    static String newId(prefix: String) = Ids.prefixed(prefix)
    static ModerationApplication decided(a: ModerationApplication, status: String, reviewerId: String, note: String?, at: String) = ModerationApplication(a.id, a.userId, a.motivation, a.experience, a.availability, status, a.createdAt, reviewerId, at, note)
    static String? trimOrNull(v: String?) {
        if (v == null) {
            return null
        }
        var t = v.trim()
        if (t.length() == 0) {
            return null
        }
        return t
    }
    static String trim(v: String?) {
        if (v == null) {
            return ""
        }
        return v.trim()
    }
}
