package moderation

import feed.*

// ReportedContentRemover: the content of an approved report leaves the air (post or comment; other targets have none).
// The reason recorded on the audit trail is "<PREFIX>:<REASON>".
class ModerationContentRemover {
    FeedModeration feed
    public constructor(feed: FeedModeration) {
        this.feed = feed
    }
    remove(report: ModerationReport, actorId: String, reasonPrefix: String) {
        var reason = reasonPrefix + ":" + report.reason
        if (report.targetType == "POST") {
            feed.removeAsModerator(actorId, report.targetId, reason)
        }
        if (report.targetType == "COMMENT") {
            feed.removeCommentAsModerator(actorId, report.targetId, reason)
        }
    }
}
