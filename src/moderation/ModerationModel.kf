package moderation

// A report as the `reports` table keeps it (Report in the Java domain). Status moves PENDING -> APPROVED,
// DISMISSED or AUTO_PENALIZED; the AI triage and the pre-triage fields are filled by the triage jobs.
record ModerationReport(String id, String reporterId, String targetType, String targetId, String reason, String description, String status, String createdAt, String? reviewedBy, String? reviewedAt, String? resolutionNote, String? aiTriage, String? aiTriagedAt, String? preTriage, Int? preTriageScore, String? preTriagedAt)

// POST /reports body (CreateReportRequest). The enums arrive as text and are checked by ModerationRules.
record ModerationReportBody(String? targetType, String? targetId, String? reason, String? description, String? e2eConversationKey)

// The full report as the admin panel sees it (ReportView).
record ModerationReportView(String id, String reporterId, String targetType, String targetId, String reason, String description, String status, String createdAt, String? aiTriage, String? aiTriagedAt)

// The reporter's own view: no reporter id (it is them) and no internal triage (ReporterReportView).
record ModerationMyReportView(String id, String targetType, String targetId, String reason, String description, String status, String createdAt)

// GET /admin/reports/{id}: who reported, who wrote it, what it says (ReportReview as a map in Java).
record ModerationReviewView(ModerationReportView report, String reporter, String authorId, String author, String content)

// Body of approve and dismiss (ReviewRequest) and the fixed shapes hashed for their idempotency keys.
record ModerationReviewBody(String? note)

record ModerationIdempotencyNote(String reportId, String note)

record ModerationIdempotencyKey(String reportId, String op)

record ModerationConversationKey(String conversationKey)

class ModerationRules {
    static List<String> targetTypes() = listOf("POST", "COMMENT", "USER", "JOB", "GAME", "GROUP_POST", "GROUP_COMMENT", "MESSAGE", "COMPANY")
    static List<String> reasons() = listOf("AI_GENERATED", "FAKE_CONTENT", "SCAM", "DISCRIMINATION", "PREJUDICE", "HARASSMENT", "SPAM", "VIOLENCE", "SEXUAL_CONTENT", "COPYRIGHT", "OTHER")
    // The sender of the reports the automations open (ModerationService.SYSTEM_REPORTER).
    static String systemReporter() = "system"
    static ModerationReportView view(r: ModerationReport) = ModerationReportView(r.id, r.reporterId, r.targetType, r.targetId, r.reason, r.description, r.status, r.createdAt, r.aiTriage, r.aiTriagedAt)
    static ModerationMyReportView mine(r: ModerationReport) = ModerationMyReportView(r.id, r.targetType, r.targetId, r.reason, r.description, r.status, r.createdAt)
    // The report after a decision (Report.approve / dismiss / autoPenalize): same fields, new status and review trail.
    static ModerationReport decided(r: ModerationReport, status: String, reviewerId: String?, at: String?, note: String?) = ModerationReport(r.id, r.reporterId, r.targetType, r.targetId, r.reason, r.description, status, r.createdAt, reviewerId, at, note, r.aiTriage, r.aiTriagedAt, r.preTriage, r.preTriageScore, r.preTriagedAt)
}
