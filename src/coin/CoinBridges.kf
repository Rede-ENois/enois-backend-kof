package coin

import blog.*
import communities.*
import groups.*
import messaging.*
import notifications.*

// The coin seams of the domains that were ported before this one. Each of them kept a no-op `*Coins` class waiting for
// the coin service; these subclasses call it, and Main.kf passes them in (see docs/PORTING_STATUS.md, "economy").
//
// Presence (CoinService.recordPresence): the Java services call it AFTER the action; here it runs after the commit of
// the caller's transaction, in its own, and never throws.
class CoinCommunityCoins extends CommunityCoins {
    CoinService coins
    public constructor(coins: CoinService) {
        super()
        this.coins = coins
    }
    recordPresence(userId: String) {
        coins.recordPresence(userId)
    }
}

class CoinGroupCoins extends GroupCoins {
    CoinService coins
    public constructor(coins: CoinService) {
        super()
        this.coins = coins
    }
    recordPresence(userId: String) {
        coins.recordPresence(userId)
    }
}

class CoinBlogCoins extends BlogCoins {
    CoinService coins
    public constructor(coins: CoinService) {
        super()
        this.coins = coins
    }
    recordPresence(userId: String) {
        coins.recordPresence(userId)
    }
}

class CoinMessagingCoins extends MessagingCoins {
    CoinService coins
    public constructor(coins: CoinService) {
        super()
        this.coins = coins
    }
    recordPresence(userId: String) {
        coins.recordPresence(userId)
    }
}

// The community apology (notifications): the ledger answers whether the reward was paid and pays it.
class CoinNotificationCoins extends NotificationCoins {
    CoinService coins
    public constructor(coins: CoinService) {
        super()
        this.coins = coins
    }
    Bool hasReward(ref: String) = coins.hasReward(ref)
    reward(userId: String, amount: Long, ref: String, message: String) {
        coins.reward(userId, amount, ref, message)
    }
}
