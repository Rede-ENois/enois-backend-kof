package coin

import blog.*
import communities.*
import feed.*
import games.*
import groups.*
import kernel.db.*
import kernel.log.*
import kernel.security.*
import messaging.*
import notifications.*

// The coin seams of the domains that were ported before this one. Each of them kept a no-op `*Coins` class waiting for
// the coin service; these subclasses call it, and Main.kf passes them in (see docs/PORTING_STATUS.md, "economy").
//
// Presence (CoinService.recordPresence): the Java services call it AFTER the action; here it runs after the commit of
// the caller's transaction, in its own, and never throws.
class CoinCommunityCoins extends CommunityCoins {
    CoinService coins
    public constructor(coins: CoinService) {
        super()
        this.coins = coins
    }
    recordPresence(userId: String) {
        coins.recordPresence(userId)
    }
}

class CoinGroupCoins extends GroupCoins {
    CoinService coins
    public constructor(coins: CoinService) {
        super()
        this.coins = coins
    }
    recordPresence(userId: String) {
        coins.recordPresence(userId)
    }
}

class CoinBlogCoins extends BlogCoins {
    CoinService coins
    public constructor(coins: CoinService) {
        super()
        this.coins = coins
    }
    recordPresence(userId: String) {
        coins.recordPresence(userId)
    }
}

class CoinMessagingCoins extends MessagingCoins {
    CoinService coins
    public constructor(coins: CoinService) {
        super()
        this.coins = coins
    }
    recordPresence(userId: String) {
        coins.recordPresence(userId)
    }
}

// The community apology (notifications): the ledger answers whether the reward was paid and pays it.
class CoinNotificationCoins extends NotificationCoins {
    CoinService coins
    public constructor(coins: CoinService) {
        super()
        this.coins = coins
    }
    Bool hasReward(ref: String) = coins.hasReward(ref)
    reward(userId: String, amount: Long, ref: String, message: String) {
        coins.reward(userId, amount, ref, message)
    }
}

// feed: the presence streak of an author and the reward of an accepted answer (QuestionAnswerService:
// HELP_REWARD = 20 faiscas at the current rate, ref `resposta:{postId}` so the payment is unique for good).
class CoinFeedCoins extends FeedCoins {
    CoinService coins
    Log log = Log("coin.feed")
    public constructor(coins: CoinService) {
        super()
        this.coins = coins
    }
    recordPresence(userId: String) {
        coins.recordPresence(userId)
    }
    rewardAnswer(answererId: String, askerId: String, postId: String) {
        try {
            coins.reward(answererId, coins.scaledReward(CoinService.fais(20L)), "resposta:" + postId, "Sua resposta resolveu uma dúvida")
        } catch (String e) {
            log.warn("answer_reward_failed")
        }
    }
}

// games: rewards, store purchases, the rate and the daily presence streak, all through the coin service.
class CoinGamesCoins extends GamesCoins {
    CoinService coins
    CoinRateService rates
    public constructor(store: Db, cipher: SecretCipher, coins: CoinService, rates: CoinRateService) {
        super(store, cipher)
        this.coins = coins
        this.rates = rates
    }
    recordPresence(userId: String) {
        coins.recordPresence(userId)
    }
    Long scaledReward(baseMf: Long) = coins.scaledReward(baseMf)
    Long currentMicros() = rates.currentBrlMicros()
    Bool hasReward(ref: String) = coins.hasReward(ref)
    Bool hasPurchase(ref: String) = coins.hasPurchase(ref)
    reward(accountId: String, amount: Long, ref: String, message: String) {
        coins.reward(accountId, amount, ref, message)
    }
    purchase(accountId: String, amount: Long, ref: String, message: String) {
        coins.purchase(accountId, amount, ref, message)
    }
}
