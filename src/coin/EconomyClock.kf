package coin

import kernel.security.*
import kernel.time.*

// The wall clock of the economy domains (the Java services took a java.time.Clock). It reads the system clock;
// tests move it two ways: `EconomyClock.fix(iso)` pins an absolute instant (seasonal shop, event windows) and
// `SecurityClock.advanceSeconds` shifts it, the way the other domains' tests do.
class EconomyClock {
    // -1 = not pinned. Named after its owner: static fields share one namespace across the module (KOF_GAPS G35).
    static Long economyClockPinnedMs = -1L
    static String nowIso() {
        if (EconomyClock.economyClockPinnedMs >= 0L) {
            return Time.fromMillis(EconomyClock.economyClockPinnedMs)
        }
        if (SecurityClock.skewMs == 0L) {
            return Time.nowIso()
        }
        return Time.fromMillis(SecurityClock.nowMillis())
    }
    static Long nowMillis() = Time.toMillis(EconomyClock.nowIso())
    // The calendar day in Sao Paulo (the zone of the streak, the seasons and the events).
    static String brazilDay() = ZoneDates.dayOf(EconomyClock.nowIso(), "America/Sao_Paulo")
    // The UTC calendar day (the java.time.Clock of the Java service is UTC).
    static String utcDay() = EconomyClock.nowIso().substring(0, 10)
    static fix(iso: String) {
        EconomyClock.economyClockPinnedMs = Time.toMillis(iso)
    }
    static unfix() {
        EconomyClock.economyClockPinnedMs = -1L
    }
}
