package coin

// JSON the wallet endpoints answer (the Java controller built Maps and records; the field names are the contract).
record CoinQuotePoint(Long brlCents, Long brlMicros, String em)

record CoinQuoteView(Long brlCents, Long brlMicros, Long escala, String atualizadaEm, List<CoinQuotePoint> historico)

record CoinQuotePublished(Long brlCents, Long brlMicros, String em)

record CoinEntryView(Long amount, String kind, String? message, String refId, String createdAt)

record CoinWalletView(Long balance, Long escala, Long cotacaoBrlCents, Long cotacaoBrlMicros, String chave, List<CoinEntryView> entries, CoinStreakView streak)

record CoinAdminWalletView(String username, Long balance, Long escala, List<CoinEntryView> entries)

record CoinExtractView(List<CoinEntryView> entries, Int page, Int size, Bool hasNext)

record CoinTransferSent(String status, Long amount, String toUsername, String refId)

record CoinTransferHash(String to, Long amount, String message)

record CoinGrantedView(String status, String ref)

record CoinDisputeStateView(String id, String state)

record CoinEconomyReading(Int janelaDias, Long usoEscrow, Long usoP2p, Long retornoCofre, Long emissao, Long circulacao, Long cofre, Double escassez, Double indice, Long cotacaoAtualMicros, Long cotacaoSugeridaMicros, Bool publicavelAgora, Double periodoDecorrido, String proximaAvaliacaoEm)

record CoinEconomyRecalc(Bool publicada, Long cotacaoAnteriorMicros, Long cotacaoAtualMicros, Double escassez, Double indice, Long usoEscrow, Long usoP2p, Long retornoCofre, Long emissao, Long circulacao, Long cofre, Bool publicavelAgora, Double periodoDecorrido, String proximaAvaliacaoEm)

class CoinViews {
    static List<CoinEntryView> entries(rows: List<CoinEntry>) {
        var out = listOf<CoinEntryView>()
        for (var e in rows) {
            out.add(CoinEntryView(e.amount(), e.kind(), e.message(), e.refId(), e.createdAt()))
        }
        return out
    }
    // The next call would publish a new value? Outside the period, never.
    static Bool publishable(s: CoinEconomySummary) = s.due() && s.result().suggestedMicros() != s.previousMicros()
    static CoinEconomyReading reading(s: CoinEconomySummary) = CoinEconomyReading(s.windowDays(), s.metrics().escrowUsage(), s.metrics().p2pUsage(), s.metrics().treasuryInflow(), s.metrics().issuance(), s.metrics().circulation(), s.metrics().treasuryBalance(), s.result().scarcity(), s.result().index(), s.previousMicros(), s.result().suggestedMicros(), CoinViews.publishable(s), s.elapsedFraction(), s.nextEvaluationAt())
    static CoinEconomyRecalc recalc(s: CoinEconomySummary) = CoinEconomyRecalc(s.published(), s.previousMicros(), s.currentMicros(), s.result().scarcity(), s.result().index(), s.metrics().escrowUsage(), s.metrics().p2pUsage(), s.metrics().treasuryInflow(), s.metrics().issuance(), s.metrics().circulation(), s.metrics().treasuryBalance(), CoinViews.publishable(s), s.elapsedFraction(), s.nextEvaluationAt())
}
