package importresume

// A field of the job form in the shape the prefill needs (label + type + required); type is TEXT, TEXTAREA, NUMBER
// or LINK.
record ResumeJobField(String id, String label, String type, Bool required)

// One suggested answer, or the reason a field was left without suggestion (NO_LINK_FOUND, NO_CONTACT_FOUND,
// NO_YEARS_FOUND, MANUAL_FIELD).
record ResumeFieldSuggestion(String fieldId, String label, String? suggestedValue, String? reason)

record ResumeApplyPrefill(String jobId, String jobTitle, String? suggestedMessage, List<ResumeFieldSuggestion> fields, Int filled, Int total)
