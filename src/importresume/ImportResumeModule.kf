package importresume

import importlinkedin.*
import jobs.*
import kernel.*

// Composition of the importresume domain. Main.kf calls install once, after jobs and importlinkedin:
//
//   ImportResumeModule.install(platform, jobs, linkedinImport)
//
// Both of its endpoints are multipart uploads (POST /me/import/resume and POST /me/import/resume/prefill/{jobId}),
// claimed in the binary lane by method and path (ImportResumeRoutes). REDE_IMPORT_UPLOAD_MAX_BYTES (16777216) caps
// the request and its file part, like the LinkedIn upload endpoints.
class ImportResumeModule {
    ResumeImportService service
    ResumePrefillService prefill
    public constructor(service: ResumeImportService, prefill: ResumePrefillService) {
        this.service = service
        this.prefill = prefill
    }
    static ImportResumeModule install(platform: Platform, jobs: JobsModule, linkedinImport: LinkedinImportModule) {
        var service = ResumeImportService(linkedinImport.service)
        var prefill = ResumePrefillService(jobs.store, service)
        ImportResumeRoutes(service, prefill, platform.cfg.getLong("REDE_IMPORT_UPLOAD_MAX_BYTES", LinkedinImportModule.defaultMaxUploadBytes())).register(platform.server)
        return ImportResumeModule(service, prefill)
    }
}
