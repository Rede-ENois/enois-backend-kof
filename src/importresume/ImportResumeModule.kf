package importresume

import importlinkedin.*
import jobs.*

// Composition of the importresume domain. Main.kf calls install once, after jobs and importlinkedin:
//
//   ImportResumeModule.install(jobs, linkedinImport)
//
// Both of its endpoints are uploads (POST /me/import/resume and POST /me/import/resume/prefill/{jobId}, multipart),
// so they wait for the binary lane: nothing is registered here yet. When the lane lands the two routes call
// ResumeImportService.parse and ResumePrefillService.prefill(userId, jobId, extractText(...)) with the upload's temp
// file path.
class ImportResumeModule {
    ResumeImportService service
    ResumePrefillService prefill
    public constructor(service: ResumeImportService, prefill: ResumePrefillService) {
        this.service = service
        this.prefill = prefill
    }
    static ImportResumeModule install(jobs: JobsModule, linkedinImport: LinkedinImportModule) {
        var service = ResumeImportService(linkedinImport.service)
        return ImportResumeModule(service, ResumePrefillService(jobs.store, service))
    }
}
