package leaves

import apiv1.*
import blog.*
import java.util.HashMap
import ops.*
import kernel.*
import kernel.security.*
import kernel.testkit.*
import notices.*
import projects.*
import releasenotes.*
import search.*
import stats.*
import suggestions.*
import themes.*

// Test boot of the leaf domains (ops, apiv1, stats, search, themes, projects, notices, releasenotes,
// suggestions, blog): the platform, the shared services, the request pipeline and every module wired in the
// order of Main.kf. One app per test file (a test file is one process).
class LeavesApp {
    static SharedServices? sharedSlot = null
    static SecurityHooks? hooksSlot = null
    static OpsModule? opsSlot = null
    // A test that wants a fake GitHub gateway sets it before booting.
    static SuggestionIssueGateway? suggestionGatewaySlot = null
    // A blog test sets these before booting to stand in for the feed and notifications domains.
    static BlogFeedPointers? blogFeedSlot = null
    static BlogNotifier? blogNotifierSlot = null
    // `jobs` false stops the shared scheduler right after wiring (the outbox worker and every module job
    // would otherwise keep the test process alive); tests then call the job bodies directly.
    static TestApp boot(name: String, overrides: Map<String,String>) = LeavesApp.bootJobs(name, overrides, false)
    static TestApp bootJobs(name: String, overrides: Map<String,String>, jobs: Bool) {
        var merged = new HashMap<String, String>()
        merged.put("REDE_ORIGINS_ENFORCE", "false")
        merged.put("REDE_MONITORING_FILE_DIR", "/tmp/kof-monitoring-" + name + "-" + uuid.v4())
        for (var k in overrides.keys()) {
            merged.put(k, overrides.getOrDefault(k, ""))
        }
        SecurityClock.reset()
        return TestApp.bootWith(name, merged, (p: Platform) -> LeavesApp.wire(p, jobs))
    }
    static wire(p: Platform, jobs: Bool) {
        var shared = SharedServices.create(p)
        var hooks = SecurityHooks.defaults(p.db)
        LeavesApp.sharedSlot = shared
        LeavesApp.hooksSlot = hooks
        LeavesApp.opsSlot = OpsModule.install(p, shared, hooks)
        ApiV1Module.install(p, shared, hooks)
        Security.install(p, hooks)
        StatsModule.install(p, shared, hooks)
        NoticeModule.install(p, shared, hooks)
        ReleaseNoteModule.install(p, shared, hooks)
        SearchModule.install(p, shared, hooks)
        ThemeModule.install(p, shared, hooks)
        ProjectsModule.install(p, shared, hooks)
        var gateway = LeavesApp.suggestionGatewaySlot
        if (gateway == null) {
            SuggestionsModule.install(p, shared, hooks)
        }
        else {
            SuggestionsModule.withGateway(p, gateway)
        }
        var feed = BlogFeedPointers()
        var feedFake = LeavesApp.blogFeedSlot
        if (feedFake != null) {
            feed = feedFake
        }
        var notifier = BlogNotifier()
        var notifierFake = LeavesApp.blogNotifierSlot
        if (notifierFake != null) {
            notifier = notifierFake
        }
        BlogModule.withSeams(p, shared, BlogProfiles(p.db), feed, notifier, BlogCoins(), BlogEmailSender(MailTestKit.capturing(p)))
        if (!jobs) {
            shared.stop()
        }
    }
    static OpsModule ops() {
        var o = LeavesApp.opsSlot
        if (o == null) {
            throw "LeavesApp not booted"
        }
        return o
    }
    static SharedServices shared() {
        var s = LeavesApp.sharedSlot
        if (s == null) {
            throw "LeavesApp not booted"
        }
        return s
    }
}
