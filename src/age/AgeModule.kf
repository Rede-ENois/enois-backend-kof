package age

import identity.*
import kernel.*
import kernel.http.*

// The age domain: parental supervision routes, plus the policy reader and the write gate other domains use.
class AgeModule {
    AgeService service
    AgePolicyReader policy
    AgeGate gate
    public constructor(service: AgeService, policy: AgePolicyReader, gate: AgeGate) {
        this.service = service
        this.policy = policy
        this.gate = gate
    }
    static AgeModule install(platform: Platform, mailer: IdentityMailer) {
        var store = AgeStore(platform.db)
        var policy = AgePolicyReader(store)
        var service = AgeService(platform.db, store, policy, mailer)
        AgeRoutes(service).register(platform.server)
        return AgeModule(service, policy, AgeGate(policy))
    }
}
