package age

import kernel.error.*

// Entry point of the age policy enforcement: write use cases call it before the action, the message and the
// code are unique so the front end opens the regularisation screen anywhere in the app.
class AgeGate {
    AgePolicyReader reader
    public constructor(reader: AgePolicyReader) {
        this.reader = reader
    }
    static String code() = "BIRTH_DATE_REQUIRED"
    // The action needs a declared birth date (regularisation of the old base).
    requireDeclared(userId: String) {
        if (!reader.birthDateDeclared(userId)) {
            throw Errors.api(403, AgeGate.code(), "Confirme sua data de nascimento para continuar. É um requisito da plataforma.")
        }
    }
    // Write gate: declared date AND, for a minor, an active guardian authorization. The declaration alone does
    // not free a minor: the link must have been accepted by an adult (see /age/parental).
    requireCanWrite(userId: String) {
        requireDeclared(userId)
        if (reader.isMinor(userId) && !reader.parentalConsentActive(userId)) {
            throw Errors.api(403, "PARENTAL_CONSENT_REQUIRED", "Sua conta e de menor de 18 anos e precisa da autorizacao de um responsavel para publicar, comentar e enviar mensagens.")
        }
    }
}
