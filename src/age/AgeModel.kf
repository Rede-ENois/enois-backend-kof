package age

// A parental link row (ParentalLink): minor <-> guardian, with the one-use invite token stored as a hash.
record AgeLink(String id, String minorUserId, String? guardianUserId, String guardianEmail, String status, String? tokenHash, String termsVersion, String createdAt, String expiresAt, String? decidedAt, String? revokedAt)

// POST /age/parental/invite answers this (status is the enum name).
record AgeInviteBody(String status, String expiresAt, Bool emailSent)
record AgeSupervisedBody(String minorUserId, String username, String name, String since)
record AgeStatusBody(String id, String status)

record AgeInviteRequest(String? email)
record AgeTokenRequest(String? token)
record AgeRevokeRequest(String? minorUserId)
