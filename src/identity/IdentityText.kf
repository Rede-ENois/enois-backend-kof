package identity

// Null handling the compiler cannot do for us: narrowing does not survive `||` / `&&` (KOF_GAPS G31) and a
// local cannot be initialised with a null literal. Request fields are all `String?`, so the use cases
// normalise them here once and work with plain Strings.
class IdentityText {
    static String? none() {
        return null
    }
    static Bool blank(value: String?) {
        if (value == null) {
            return true
        }
        return value.trim().length() == 0
    }
    static IdentityIssued? noSession() {
        return null
    }
    static String orEmpty(value: String?) {
        if (value == null) {
            return ""
        }
        return value
    }
    // trim + lower-case, "" for null.
    static String lower(value: String?) {
        if (value == null) {
            return ""
        }
        return value.trim().toLowerCase()
    }
}
