package identity

// The authenticated user as the front end sees it (AuthUserView).
record IdentityUserView(String id, String username, String name, String? headline, String email, Bool emailVerified, Bool twoFactorEnabled, Bool identityVerified, Bool hasPassword, Bool onboardingCompleted)

// AuthResponse as Jackson writes it: the tokens are @JsonIgnore and travel only in HttpOnly cookies.
record IdentitySessionBody(String expiresAt, String refreshExpiresAt, IdentityUserView user)

// An issued session. The tokens never reach the JSON body (see IdentitySessionBody).
record IdentityIssued(String token, String refreshToken, String expiresAt, String refreshExpiresAt, IdentityUserView user)

record IdentityConfigBody(String captchaMode, String? turnstileSiteKey, Bool googleLoginEnabled)
record IdentityChallengeBody(String challengeId, String question, String expiresAt)
record IdentitySignupBody(String email, Bool verificationRequired, Bool emailSent)
record IdentityStatusBody(String? id, String status)
record IdentityStatusOnly(String status)
record IdentityOk(Bool ok)

// users row, the columns identity reads (the profile domain owns the table).
record IdentityUserRow(String id, String username, String name, String? headline, String email, Bool emailVerified, Bool totpEnabled, Bool emailOtpEnabled, Bool federatedSecondFactor, Bool onboardingCompleted, String? birthDate)

record IdentityCredential(String userId, String email, String passwordHash, Bool passwordUsable, Bool resetNeeded)

record IdentityPending(String id, String email, String name, String birthDate, String passwordHash, String tokenHash, String expiresAt, String createdAt, Int resendCount, String? lastSentAt)

// A single-use token row (email verification, password reset): only the hash is stored.
record IdentityToken(String tokenHash, String userId, String expiresAt, String? usedAt)

// What the mailer got: tests read the captured messages instead of an SMTP server.
record IdentityMail(String kind, String to, String subject, String body)

// The decoded request bodies. Every field is nullable: json.decode rejects a missing non-null field
// and Jackson answered with nulls, which the service then validates (a boolean rides as String?).
record IdentitySignupRequest(String? name, String? role, String? email, String? password, String? acceptedTerms, String? turnstileToken, String? website, String? birthDate, String? challengeId, Int? challengeAnswer)
record IdentityLoginRequest(String? email, String? password, String? turnstileToken)
record IdentityTokenRequest(String? token)
record IdentityEmailRequest(String? email)
record IdentityEmailPasswordRequest(String? email, String? password)
record IdentityRefreshRequest(String? refreshToken)
record IdentityResetRequest(String? token, String? password)
record IdentityPasswordChangeRequest(String? currentPassword, String? newPassword)
record IdentityPasswordRequest(String? password)

record IdentityChallenge(String id, String userId, String? method, String? codeHash, Int attempts, String expiresAt, String? consumedAt, String createdAt)
record IdentityTotpSetupBody(String secret, String otpauthUri)
record IdentityTwoFactorStatusBody(Bool emailVerified, Bool totpEnabled, Bool emailOtpEnabled, Bool providerSecondFactor, Bool twoFactorEnabled, Bool identityVerified, Int backupCodesLeft, Bool totpAvailable)
record IdentityBackupCodesBody(String status, List<String> backupCodes)
record IdentityTwoFactorVerifyRequest(String? challengeId, String? code)
record IdentityChallengeRequest(String? challengeId)
record IdentityTotpEnableRequest(String? code, String? password)
record IdentityCodeRequest(String? code)
record IdentityLoginTwoFactorBody(Bool twoFactorRequired, String challengeId, String method, String expiresAt)
record IdentityPasswordExpiredBody(Bool passwordExpired, String resetToken)
