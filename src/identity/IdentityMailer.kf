package identity

import kernel.config.*
import kernel.id.*
import kernel.log.*
import kernel.time.*
import kernel.text.*
import kernel.url.*
import ops.*

// Outgoing identity e-mails (EmailService): the subjects, the bodies and the links of the Java service.
// Every message goes through `dispatch` into the shared MailService (SMTP in production, a recording
// transport in tests), which records the email_log row. With `capture` on, the messages are also kept in
// memory for tests (sent()).
class IdentityMailer {
    Log log = Log("identity.mail")
    String frontendUrl
    String backendUrl
    String templatesDir
    Bool capture
    MailService mail
    List<IdentityMail> captured = listOf<IdentityMail>()
    public constructor(cfg: Config, mail: MailService, capture: Bool) {
        this.frontendUrl = IdentityMailer.trimSlash(cfg.getStr("FRONTEND_URL", "http://localhost:5173"))
        this.backendUrl = IdentityMailer.trimSlash(cfg.getStr("REDE_BACKEND_URL", "https://api.enois.ia.br"))
        this.templatesDir = cfg.getStr("TEMPLATES_DIR", "resources/templates")
        this.capture = capture
        this.mail = mail
    }
    static String trimSlash(url: String) {
        if (url.endsWith("/")) {
            return url.substring(0, url.length() - 1)
        }
        return url
    }
    List<IdentityMail> sent() = captured
    clearSent() {
        captured.clear()
    }
    // Sends through the mail service (which logs it); false when the message did not leave.
    Bool dispatch(kind: String, to: String, subject: String, html: String) {
        var ok = mail.sendHtml(to, subject, html, kind)
        if (capture) {
            captured.add(IdentityMail(kind, to, subject, html))
        }
        return ok
    }
    Bool sendVerificationEmail(to: String, userName: String, token: String) {
        var html = render("email-verification", mapOf("userName", userName, "verificationLink", frontendUrl + "/auth/verify?token=" + token, "currentYear", year()))
        return dispatch("EMAIL_VERIFICATION", to, "Confirme seu e-mail no Énóis", html)
    }
    Bool sendPasswordResetEmail(to: String, userName: String, token: String) {
        var html = render("password-reset", mapOf("userName", userName, "resetLink", frontendUrl + "/auth/reset?token=" + token))
        return dispatch("PASSWORD_RESET", to, "Redefinição de senha", html)
    }
    Bool sendTwoFactorCode(to: String, userName: String, code: String) {
        var html = render("two-factor-code", mapOf("userName", userName, "code", code, "currentYear", year()))
        return dispatch("TWO_FACTOR", to, "Seu código de acesso ao Énóis", html)
    }
    Bool sendParentalConsentEmail(guardianEmail: String, minorName: String, token: String) {
        var html = render("parental-consent", mapOf("minorName", minorName, "consentLink", frontendUrl + "/responsavel?token=" + token, "currentYear", year()))
        return dispatch("PARENTAL_CONSENT", guardianEmail, "Autorizacao de responsavel no Enois", html)
    }
    Bool sendEmailChangeConfirmation(to: String, userName: String, token: String) {
        var link = backendUrl + "/api/auth/email/change/confirm?token=" + UrlCodec.encode(token)
        var body = "<p>Olá, " + IdentityMailer.escapeHtml(userName) + ".</p>" + "<p>Recebemos um pedido para trocar o e-mail da sua conta no Énóis para este endereço.</p>" + "<p><a href=\"" + IdentityMailer.escapeHtml(link) + "\" style=\"display:inline-block;padding:12px 24px;" + "background:#6366f1;color:#fff;text-decoration:none;border-radius:999px;font-weight:600\">" + "Confirmar novo e-mail</a></p>" + "<p>Se não foi você, ignore esta mensagem: nada muda até o clique.</p>" + "<p>— Equipe Énóis</p>"
        return dispatch("HTML", to, "Confirme seu novo e-mail — Énóis", body)
    }
    Bool sendSignupAttemptNotice(to: String, userName: String) {
        var body = "<p>Olá, " + IdentityMailer.escapeHtml(userName) + ".</p>" + "<p>Alguém tentou criar uma conta no Énóis com este e-mail, mas ele já tem uma conta.</p>" + "<p>Se foi você, <a href=\"" + IdentityMailer.escapeHtml(frontendUrl + "/entrar") + "\">entre</a> normalmente " + "ou use \"Esqueci minha senha\". Se não foi, pode ignorar esta mensagem: nada mudou na sua conta.</p>" + "<p>— Equipe Énóis</p>"
        return dispatch("HTML", to, "Tentativa de cadastro com seu e-mail — Énóis", body)
    }
    Bool sendHtml(to: String, subject: String, html: String) = dispatch("HTML", to, subject, html)
    String year() = Time.todayIso().substring(0, 4)
    // The Thymeleaf subset the identity templates use (kernel HtmlTemplate): th:text, th:href, the footer year.
    String render(template: String, vars: Map<String,String>) {
        var html = File(templatesDir + "/" + template + ".html").readText()
        if (html == null) {
            throw "TEMPLATE_MISSING: " + template
        }
        return HtmlTemplate.render(html, vars)
    }
    // HtmlUtils.htmlEscape(value, "UTF-8"): & < > " ' only.
    static String escapeHtml(value: String?) {
        if (value == null) {
            return ""
        }
        return value.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;").replace("\'", "&#39;")
    }
}
