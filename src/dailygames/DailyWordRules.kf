package dailygames

import kernel.text.*

// Pure rules for five-letter guesses (WordRules). The answer never leaves the service.
class WordRules {
    // Trimmed, accents stripped (NFD without marks), upper case. Null is "".
    static String normalize(input: String?) {
        if (input == null) {
            return ""
        }
        return Texts.stripAccents(input.trim()).toUpperCase()
    }
    // CORRECT / PRESENT / ABSENT per letter; repeated letters only consume the occurrences that are left.
    static List<String> evaluate(answer: String, guess: String) {
        if (!Regexes.matches("[A-Z]{5}", answer) || !Regexes.matches("[A-Z]{5}", guess)) {
            throw "ILLEGAL_ARGUMENT: Palavra deve ter cinco letras."
        }
        var result = listOf<String>()
        var remaining = listOf<Int>()
        var letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        var i = 0
        while (i < 26) {
            remaining.add(0)
            i = i + 1
        }
        i = 0
        while (i < 5) {
            if (answer.substring(i, i + 1) == guess.substring(i, i + 1)) {
                result.add("CORRECT")
            }
            else {
                result.add("")
                var slot = letters.indexOf(answer.substring(i, i + 1))
                remaining.set(slot, remaining.get(slot) + 1)
            }
            i = i + 1
        }
        i = 0
        while (i < 5) {
            if (result.get(i) == "") {
                var letter = letters.indexOf(guess.substring(i, i + 1))
                if (remaining.get(letter) > 0) {
                    result.set(i, "PRESENT")
                    remaining.set(letter, remaining.get(letter) - 1)
                }
                else {
                    result.set(i, "ABSENT")
                }
            }
            i = i + 1
        }
        return result
    }
    static String joinMarks(marks: List<String>) {
        var out = ""
        var i = 0
        while (i < marks.size()) {
            if (i > 0) {
                out = out + ","
            }
            out = out + marks.get(i)
            i = i + 1
        }
        return out
    }
}
