package dailygames

import kernel.text.*

// Deterministic perfect maze (MazeRules). Bit flags N=1, E=2, S=4, W=8 denote open passages. Same
// java.util.Random sequence as the Java service, so the stored seed draws the same maze on both sides.
class MazeRules {
    static Int size() = 9
    static Int dx(d: Int) {
        if (d == 1) {
            return 1
        }
        if (d == 3) {
            return -1
        }
        return 0
    }
    static Int dy(d: Int) {
        if (d == 0) {
            return -1
        }
        if (d == 2) {
            return 1
        }
        return 0
    }
    static Int bit(d: Int) {
        if (d == 0) {
            return 1
        }
        if (d == 1) {
            return 2
        }
        if (d == 2) {
            return 4
        }
        return 8
    }
    static Bool open(passages: Int, d: Int) = passages / MazeRules.bit(d) % 2 == 1
    static List<Int> generate(seed: Long) {
        var cells = MazeRules.size() * MazeRules.size()
        var maze = listOf<Int>()
        var visited = listOf<Int>()
        var i = 0
        while (i < cells) {
            maze.add(0)
            visited.add(0)
            i = i + 1
        }
        var stack = listOf<Int>()
        var top = 0
        var rng = JavaRandom(seed)
        visited.set(0, 1)
        stack.add(0)
        top = 1
        while (top > 0) {
            var cell = stack.get(top - 1)
            var x = cell % MazeRules.size()
            var y = cell / MazeRules.size()
            var choices = listOf<Int>()
            var d = 0
            while (d < 4) {
                var nx = x + MazeRules.dx(d)
                var ny = y + MazeRules.dy(d)
                if (nx >= 0 && nx < MazeRules.size() && ny >= 0 && ny < MazeRules.size()) {
                    if (visited.get(ny * MazeRules.size() + nx) == 0) {
                        choices.add(d)
                    }
                }
                d = d + 1
            }
            if (choices.size() == 0) {
                top = top - 1
            }
            else {
                var chosen = choices.get(rng.nextInt(choices.size()))
                var next = (y + MazeRules.dy(chosen)) * MazeRules.size() + x + MazeRules.dx(chosen)
                maze.set(cell, maze.get(cell) + MazeRules.bit(chosen))
                maze.set(next, maze.get(next) + MazeRules.bit((chosen + 2) % 4))
                visited.set(next, 1)
                if (top < stack.size()) {
                    stack.set(top, next)
                }
                else {
                    stack.add(next)
                }
                top = top + 1
            }
        }
        return maze
    }
    // The cell after moving; throws ILLEGAL_ARGUMENT for an unknown direction or a wall.
    static Int move(maze: List<Int>, position: Int, direction: String?) {
        var d = -1
        if (direction == "UP") {
            d = 0
        }
        if (direction == "RIGHT") {
            d = 1
        }
        if (direction == "DOWN") {
            d = 2
        }
        if (direction == "LEFT") {
            d = 3
        }
        if (d < 0 || position < 0 || position >= maze.size()) {
            throw "ILLEGAL_ARGUMENT: Movimento invalido"
        }
        if (!MazeRules.open(maze.get(position), d)) {
            throw "ILLEGAL_ARGUMENT: Movimento invalido"
        }
        return position + MazeRules.dy(d) * MazeRules.size() + MazeRules.dx(d)
    }
}
