package dailygames

import kernel.error.*
import kernel.text.*
import kernel.time.*

// The clock of the daily games. Production reads the system clock; a test subclasses it to fix the instant
// (the Java services took a `Clock`). A "day" is the calendar day in America/Sao_Paulo (UTC-3 all year).
class DailyGamesClock {
    String nowIso() = Time.nowIso()
    String today() = Time.plusSeconds(this.nowIso(), -10800L).substring(0, 10)
}

// Rules shared by the three daily games.
class DailyRules {
    // The challenge a request may touch: today, or yesterday (the resume window). Anything else is 400.
    static String requestedDay(clock: DailyGamesClock, requested: String?) {
        var today = clock.today()
        var day = today
        if (requested != null) {
            day = requested
        }
        if (day.compareTo(today) > 0 || day.compareTo(ZoneDates.plusDays(today, -1)) < 0) {
            throw Errors.api(400, "INVALID_CHALLENGE_DATE", "Desafio fora do prazo de retomada.")
        }
        return day
    }
    static Bool validRequestId(requestId: String?) {
        if (requestId == null) {
            return false
        }
        return Regexes.matches("[A-Za-z0-9_-]{8,80}", requestId)
    }
    // Milliseconds between two ISO instants, never negative.
    static Long elapsedMillis(from: String, to: String) {
        var diff = Time.toMillis(to) - Time.toMillis(from)
        if (diff < 0L) {
            return 0L
        }
        return diff
    }
    // Zero-padded decimal, for sort keys that must compare like numbers.
    static String pad(value: Long, width: Int) {
        var text = "" + value
        while (text.length() < width) {
            text = "0" + text
        }
        return text
    }
}
