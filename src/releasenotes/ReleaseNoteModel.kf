package releasenotes

// One entry of the release notes: plain text, already trimmed and defused.
record ReleaseNoteItem(String title, String description)

// The same entry as it arrives in the PUT body: any member may be missing.
record ReleaseNoteItemInput(String? title, String? description)

// PUT /admin/novidades body.
record ReleaseNotePublishRequest(List<ReleaseNoteItemInput>? items)

// The current "what's new": `publishedAt` is the first publication and survives edits, `updatedAt`
// changes on every publish and is the version identity (the front shows the popup once per id + updatedAt).
record ReleaseNoteView(String id, List<ReleaseNoteItem> items, String publishedAt, String updatedAt)
