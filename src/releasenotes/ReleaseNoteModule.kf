package releasenotes

import kernel.*
import kernel.security.*

class ReleaseNoteModule {
    ReleaseNoteService service
    public constructor(service: ReleaseNoteService) {
        this.service = service
    }
    static ReleaseNoteModule install(platform: Platform, shared: SharedServices, hooks: SecurityHooks) {
        var service = ReleaseNoteService(ReleaseNoteStore(platform.db))
        ReleaseNoteRoutes.register(platform.server, service)
        return ReleaseNoteModule(service)
    }
}
