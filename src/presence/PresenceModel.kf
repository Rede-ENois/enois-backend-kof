package presence

// GET/PUT /me/presence and GET /users/{username}/presence answer {"status": "..."}.
record PresenceView(String status)

record PresenceStatusBody(String? status)

class PresenceStatuses {
    // AVAILABLE, AWAY, DO_NOT_DISTURB, INVISIBLE (PresenceStatus enum names, as stored).
    static Set<String> all = setOf("AVAILABLE", "AWAY", "DO_NOT_DISTURB", "INVISIBLE")
}
