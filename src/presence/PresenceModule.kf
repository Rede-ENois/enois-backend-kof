package presence

import kernel.*
import kernel.sanctions.*
import profile.*

// Presence module: builds the store, the service and the routes. `service` is the read API for push
// delivery (`allowPush`) and for anyone that needs a public status.
class PresenceModule {
    PresenceService service
    public constructor(service: PresenceService) {
        this.service = service
    }
    static PresenceModule install(platform: Platform, directory: ProfileDirectory, sanctions: SanctionGateReader) {
        var service = PresenceService(PresenceStore(platform.db))
        PresenceRoutes.register(platform.server, service, directory, sanctions)
        return PresenceModule(service)
    }
}
