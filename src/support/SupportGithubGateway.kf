package support

// The GitHub mirror of the tickets (private repository). A base class with safe no-op defaults (a Kof
// interface cannot be implemented across packages, G30): tests and the real client extend it. Failures never
// propagate: the ticket is the local source of truth and the mirror is best effort.
class SupportGithubGateway {
    Bool enabled() = false
    // null when GitHub did not answer.
    SupportIssueRef? createIssue(title: String, body: String) = null
    Bool closeIssue(number: Int) = false
    Bool reopenIssue(number: Int) = false
    // The id of the comment, 0 when it was not published. `tokenOverride` publishes as a person (null = service token).
    Long comment(number: Int, body: String, tokenOverride: String?) = 0L
}
