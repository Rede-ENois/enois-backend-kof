package support

import contributions.*
import profile.*

// The GitHub identity of the person who answers a ticket, from the contributions domain: their login and, when they
// linked GitHub with write permission, their own token (the comment then shows under their profile).
class SupportLinkedPeople extends SupportGithubPeople {
    GithubIdentities identities
    GithubUserTokens tokens
    public constructor(directory: ProfileDirectory, identities: GithubIdentities, tokens: GithubUserTokens) {
        super(directory)
        this.identities = identities
        this.tokens = tokens
    }
    String? login(userId: String) {
        var login = identities.login(userId)
        if (login.length() == 0) {
            return null
        }
        return login
    }
    String? userToken(userId: String) {
        var token = tokens.accessToken(userId)
        if (token.length() == 0) {
            return null
        }
        return token
    }
}
