package support

import kernel.log.*

// Support tickets of the app. Enum values travel as Strings (G43): the lists below are the Java enums.
record SupportRequestRecord(String id, String userId, String subject, String message, String contactEmail, String? imageUrl, String category, String status, String? adminReply, String? repliedBy, String? repliedAt, String createdAt, Int? githubIssueNumber, String? githubIssueUrl)

// One message of the ticket thread (githubCommentId 0 = none: a boxed Long? cannot be built from a Long): a panel reply (direction ENOIS) or a GitHub comment (direction GITHUB).
record SupportMessageRecord(String id, String requestId, String direction, String? authorName, String? authorGithubLogin, String body, Long githubCommentId, String createdAt)

record SupportIssueRef(Int number, String? url)

// Bodies. Optional booleans do not exist here, so every member is a String.
record SupportCreateBody(String? subject, String? message, String? contactEmail, String? imageUrl, String? category)

record SupportUpdateBody(String? status, String? category)

record SupportReplyBody(String? message)

record SupportGithubSettingsBody(String? token, String? repo, String? webhookSecret)

// Responses.
record SupportConfigView(String? email)

record SupportGithubSettingsView(Bool enabled, String? repo, Bool tokenConfigured, Bool webhookSecretConfigured)

record SupportRequestView(String id, String userId, String subject, String message, String? contactEmail, String? imageUrl, String category, String status, String? adminReply, String? repliedBy, String? repliedAt, String createdAt)

record SupportAdminView(String id, String userId, String subject, String message, String? contactEmail, String? imageUrl, String category, String status, String? adminReply, String? repliedBy, String? repliedAt, String createdAt, Int? githubIssueNumber, String? githubIssueUrl)

record SupportMessageView(String id, String direction, String? authorName, String? authorGithubLogin, String body, String createdAt)

class SupportText {
    static String? none() = null
}

class SupportViews {
    static List<String> categories() = listOf("BUG", "ACCOUNT", "CONTENT", "IDEA", "API_ACCESS", "OTHER")
    static List<String> statuses() = listOf("OPEN", "IN_PROGRESS", "CLOSED")
    static SupportRequestView request(r: SupportRequestRecord) = SupportRequestView(r.id(), r.userId(), r.subject(), r.message(), PiiMask.email(r.contactEmail()), r.imageUrl(), r.category(), r.status(), r.adminReply(), r.repliedBy(), r.repliedAt(), r.createdAt())
    static SupportAdminView admin(r: SupportRequestRecord) = SupportAdminView(r.id(), r.userId(), r.subject(), r.message(), PiiMask.email(r.contactEmail()), r.imageUrl(), r.category(), r.status(), r.adminReply(), r.repliedBy(), r.repliedAt(), r.createdAt(), r.githubIssueNumber(), r.githubIssueUrl())
    static SupportMessageView message(m: SupportMessageRecord) = SupportMessageView(m.id(), m.direction(), m.authorName(), m.authorGithubLogin(), m.body(), m.createdAt())
    static List<SupportRequestView> requests(rows: List<SupportRequestRecord>) {
        var out = listOf<SupportRequestView>()
        for (var r in rows) {
            out.add(SupportViews.request(r))
        }
        return out
    }
    static List<SupportAdminView> admins(rows: List<SupportRequestRecord>) {
        var out = listOf<SupportAdminView>()
        for (var r in rows) {
            out.add(SupportViews.admin(r))
        }
        return out
    }
    static List<SupportMessageView> messages(rows: List<SupportMessageRecord>) {
        var out = listOf<SupportMessageView>()
        for (var m in rows) {
            out.add(SupportViews.message(m))
        }
        return out
    }
}
