package support

import kernel.http.*
import kernel.log.*

record SupportGhIssueReply(Int? number, String? html_url)

record SupportGhCommentReply(Long? id)

// The real GitHub client: issues of the private support repository, closed/reopened with PATCH, comments
// with the service token or the token of the person who answered. The body of an answer never goes to the log.
class SupportGithubClient extends SupportGithubGateway {
    SupportGithubConfig settings
    String apiBase
    Log log = Log("support.github")
    public constructor(settings: SupportGithubConfig, apiBase: String) {
        super()
        this.settings = settings
        this.apiBase = apiBase.trim()
    }
    Bool enabled() = settings.enabled()
    SupportIssueRef? createIssue(title: String, body: String) {
        var answer = this.call("POST", "/repos/" + settings.repository() + "/issues", SupportGithubClient.issuePayload(title, body), SupportText.none())
        return this.parseIssue(answer)
    }
    static String issuePayload(title: String, body: String) = "{\"title\":" + json.encode(title) + ",\"body\":" + json.encode(body) + "}"
    SupportIssueRef? parseIssue(text: String) {
        if (text.length() == 0) {
            return null
        }
        try {
            var reply = json.decode<SupportGhIssueReply>(text)
            var number = reply.number()
            if (number == null) {
                return null
            }
            if (number <= 0) {
                return null
            }
            var url = reply.html_url()
            if (url == null) {
                return SupportIssueRef(number, null)
            }
            if (url.trim().length() == 0) {
                return SupportIssueRef(number, null)
            }
            return SupportIssueRef(number, url)
        } catch (String e) {
            return null
        }
    }
    Bool closeIssue(number: Int) = this.call("PATCH", "/repos/" + settings.repository() + "/issues/" + number, "{\"state\":\"closed\",\"state_reason\":\"completed\"}", null).length() > 0
    Bool reopenIssue(number: Int) = this.call("PATCH", "/repos/" + settings.repository() + "/issues/" + number, "{\"state\":\"open\"}", null).length() > 0
    Long comment(number: Int, body: String, tokenOverride: String?) {
        var text = this.call("POST", "/repos/" + settings.repository() + "/issues/" + number + "/comments", "{\"body\":" + json.encode(body) + "}", tokenOverride)
        if (text.length() == 0) {
            return 0L
        }
        try {
            var reply = json.decode<SupportGhCommentReply>(text)
            var id = reply.id()
            if (id == null) {
                return 0L
            }
            if (id > 0L) {
                return id
            }
        } catch (String e) {
            return 0L
        }
        return 0L
    }
    // The answer body of a 2xx, empty on any failure (G204: no nullable result next to a try/catch). The ticket carries personal data and the token is in the
    // header: neither the body nor the headers are ever logged.
    String call(method: String, path: String, payload: String, tokenOverride: String?) {
        var status = 0
        if (!this.enabled()) {
            return ""
        }
        var token = settings.token()
        if (tokenOverride != null) {
            if (tokenOverride.trim().length() > 0) {
                token = tokenOverride
            }
        }
        var headers = listOf("Accept: application/vnd.github+json", "Authorization: Bearer " + token, "X-GitHub-Api-Version: 2022-11-28", "User-Agent: enois-suporte/1.0", "Content-Type: application/json")
        var text = ""
        var failed = false
        try {
            var reply = this.send(method, apiBase + path, headers, payload)
            status = reply.status()
            text = reply.body()
        } catch (String e) {
            failed = true
        }
        if (failed) {
            log.warn("Falha ao falar com o GitHub (" + method + " " + path + ")")
            return ""
        }
        if (status / 100 != 2) {
            log.warn("GitHub respondeu " + status + " em " + method + " " + path)
            return ""
        }
        return text
    }
    OutboundReply send(method: String, url: String, headers: List<String>, payload: String) {
        if (method == "PATCH") {
            return Outbound.patch(url, headers, payload, 6000)
        }
        return Outbound.request(method, url, headers, payload, 6000)
    }
}
