package notices

import kernel.error.*

// The platform notice an administrator publishes from the panel. `bodyHtml` already went through the
// page sanitiser. `publishedAt` marks the first publication and survives edits; `updatedAt` changes on
// every publish and is the version identity (the front remembers a dismissal by id + updatedAt).
record NoticeView(String id, String title, String bodyHtml, String surface, String publishedAt, String updatedAt)

// PUT /admin/avisos body. Every member is optional on the wire; the service rejects what is missing.
record NoticePublishRequest(String? title, String? bodyHtml, String? surface)

// Where the notice shows: a top strip, a popup that opens once per edit, or both.
class NoticeSurfaces {
    static List<String> all() = listOf("BANNER", "MODAL", "BOTH")
    // null for a blank value; the spelling is case-insensitive and trimmed. 400 for an unknown one.
    static String? parse(raw: String?) {
        if (raw == null) {
            return null
        }
        var clean = raw.trim()
        if (clean.length() == 0) {
            return null
        }
        var upper = clean.toUpperCase()
        if (!NoticeSurfaces.all().contains(upper)) {
            throw Errors.api(400, "INVALID_NOTICE_SURFACE", "Superfície do aviso desconhecida: use banner, modal ou both.")
        }
        return upper
    }
}
