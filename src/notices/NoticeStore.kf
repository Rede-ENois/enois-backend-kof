package notices

import kernel.db.*

// The single row of the current notice (fixed id `ativo`, V197).
class NoticeStore {
    Db store
    public constructor(store: Db) {
        this.store = store
    }
    static String rowId() = "ativo"
    NoticeView? findCurrent() {
        var row = store.queryOptional("select id, title, body_html, surface, published_at, updated_at from admin_notice where id = ?", DbParams().bindStr(NoticeStore.rowId()))
        if (row == null) {
            return null
        }
        return NoticeView(row.getStr("id"), row.getStr("title"), row.getStr("body_html"), row.getStr("surface"), row.getInstant("published_at"), row.getInstant("updated_at"))
    }
    // Insert or rewrite the single row.
    save(notice: NoticeView) {
        var updated = store.execute("update admin_notice set title = ?, body_html = ?, surface = ?, published_at = ?, updated_at = ? where id = ?", DbParams().bindStr(notice.title()).bindStr(notice.bodyHtml()).bindStr(notice.surface()).bindInstant(notice.publishedAt()).bindInstant(notice.updatedAt()).bindStr(notice.id()))
        if (updated == 0) {
            store.execute("insert into admin_notice (id, title, body_html, surface, published_at, updated_at) values (?, ?, ?, ?, ?, ?)", DbParams().bindStr(notice.id()).bindStr(notice.title()).bindStr(notice.bodyHtml()).bindStr(notice.surface()).bindInstant(notice.publishedAt()).bindInstant(notice.updatedAt()))
        }
    }
    // No row, nothing to take down: "no notice" and "notice retired" are the same state for the screen.
    clear() {
        store.execute("delete from admin_notice where id = ?", DbParams().bindStr(NoticeStore.rowId()))
    }
}
