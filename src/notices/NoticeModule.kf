package notices

import kernel.*
import kernel.security.*

class NoticeModule {
    NoticeService service
    public constructor(service: NoticeService) {
        this.service = service
    }
    static NoticeModule install(platform: Platform, shared: SharedServices, hooks: SecurityHooks) {
        var service = NoticeService(NoticeStore(platform.db))
        NoticeRoutes.register(platform.server, service)
        return NoticeModule(service)
    }
}
