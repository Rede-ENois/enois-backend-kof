package importlinkedin

// The portrait the import hands back to the front for review (LinkedinImportService.LinkedinImportPreview): the
// same shape for the ZIP, the pasted text and the resume file. Field names are the JSON contract.
record LinkedinExperiencePreview(String? title, String? company, String? location, String? description, String? startDate, String? endDate, Bool currentlyHere)

record LinkedinEducationPreview(String school, String? degree, String? field, String? description, String? startDate, String? endDate, Bool currentlyHere)

record LinkedinCertificationPreview(String name, String? issuer, String? description, String? issueDate, String? expirationDate, String? credentialUrl)

record LinkedinProjectPreview(String title, String? description, String? url, String? startDate, String? endDate)

// The fields of Profile.csv the Enois profile has somewhere to keep.
record LinkedinProfilePreview(String? name, String? headline, String? summary, String? location, String? industry)

record LinkedinImportPreview(List<LinkedinExperiencePreview> experiences, List<LinkedinEducationPreview> education, List<LinkedinCertificationPreview> certifications, List<LinkedinProjectPreview> projects, LinkedinProfilePreview? profile, List<String> skills, Map<String,Int> semEstrutura, Int found)

// One contact of Connections.csv.
record LinkedinParsedContact(String name, String? email)

// The contact invites (importlinkedin.LinkedinInviteStatus: QUEUED, INVITED, PENDING, ALREADY_CONNECTED, NO_MATCH,
// AMBIGUOUS, SKIPPED).
record LinkedinInvite(String id, String userId, String contactName, String nameKey, String? matchedUserId, String status, String createdAt, String updatedAt)

record LinkedinImportResult(Int contacts, Int invited, Int pending, Int alreadyConnected, Int noMatch, Int ambiguous, Int skipped, Int queued, Bool autoInvite)

record LinkedinSummary(Bool autoInvite, Int contacts, Int invited, Int pending, Int alreadyConnected, Int noMatch, Int ambiguous, Int skipped, Int queued)

record LinkedinInviteView(String name, String status, String? matchedUsername)

record LinkedinTextBody(String? texto)

record LinkedinAutoInviteBody(Bool enabled)
