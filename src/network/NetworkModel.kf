package network

import profile.*

// A row of user_connections (UserConnection). status: PENDING, ACCEPTED, BLOCKED, REMOVED.
record NetworkConnection(Long id, String requesterUserId, String receiverUserId, String status, String createdAt, String? acceptedAt, String? removedAt)

record NetworkSuggestion(String userId, Int mutualConnections)

// A row of user_blocks / user_mutes.
record NetworkBlock(Long id, String blockerId, String blockedId, String createdAt)

record NetworkMute(Long id, String muterId, String mutedId, String createdAt, String? expiresAt)

// NetworkUserView: `mutualConnections` is filled only for suggestions, null elsewhere.
record NetworkUserView(String id, String? username, String? name, String? headline, String? avatar, Int connections, Int followers, Bool connected, String? avatarFrame, ProfileNameStyle? nameStyle, Int? mutualConnections)

record NetworkPage(List<NetworkUserView> items, String? nextCursor)

record NetworkSummaryView(String userId, Int connections, Int followers, Int pendingRequests)

// direction is INCOMING (someone asked me) or OUTGOING (I asked); peer is the other side.
record NetworkRequestView(String id, String fromUserId, String toUserId, String status, String createdAt, String direction, NetworkUserView peer)

record NetworkRequestPage(List<NetworkRequestView> items, String? nextCursor)

// muteExpiresAt is null when there is no mute or when it lasts until the person turns it off.
record NetworkStatusView(String targetUserId, String status, Bool requestedByMe, Bool blocked, Bool muted, String? muteExpiresAt)

record NetworkBlockedUserView(String userId, String? username, String? name, String? avatar, String? blockedAt)

record NetworkMutedUserView(String userId, String? username, String? name, String? avatar, String? mutedAt, String? expiresAt)

record NetworkConnectionState(String status, Bool requestedByMe)

// POST /network/mutes body: {"duration":"24h"}; absent means until the person turns it off.
record NetworkMuteBody(String? duration)

// StatusResponse of the command endpoints.
record NetworkStatusAnswer(String id, String status)
