package network

import feed.*
import kernel.db.*
import messaging.*

// The connection graph other domains held while this one did not exist, now backed by NetworkService.

// messaging: accepted connections between people (who may message whom).
class NetworkMessagingConnections extends MessagingConnections {
    NetworkService service
    public constructor(database: Db, service: NetworkService) {
        super(database)
        this.service = service
    }
    Bool existsAccepted(userA: String, userB: String) = service.state(userA, userB).status == "ACCEPTED"
    List<String> acceptedAmong(userId: String, others: List<String>) {
        var friends = service.friendIds(userId)
        var out = listOf<String>()
        for (var other in others) {
            if (friends.contains(other)) {
                out.add(other)
            }
        }
        return out
    }
}

// feed: the friends of the reader (NetworkService.findFriends).
class NetworkFeedGraph extends FeedGraph {
    NetworkService service
    public constructor(database: Db, service: NetworkService) {
        super(database)
        this.service = service
    }
    List<String> friendIds(userId: String) = service.friendIds(userId)
}
