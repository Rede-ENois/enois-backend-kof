package communityprojects

import kernel.*
import kernel.security.*

// Composition of the community projects domain. Main.kf calls install once, after Security.install.
class CommunityProjectsModule {
    CommunityProjectService service
    CommunityProjectProfiles profiles
    CommunityProjectModerators moderators
    public constructor(service: CommunityProjectService, profiles: CommunityProjectProfiles, moderators: CommunityProjectModerators) {
        this.service = service
        this.profiles = profiles
        this.moderators = moderators
    }
    // Defaults read the profile and moderation tables; the owners call installWith with their subclasses.
    static CommunityProjectsModule install(platform: Platform, shared: SharedServices, hooks: SecurityHooks) = CommunityProjectsModule.installWith(platform, CommunityProjectProfiles(platform.db), CommunityProjectModerators(platform.db))
    static CommunityProjectsModule installWith(platform: Platform, profiles: CommunityProjectProfiles, moderators: CommunityProjectModerators) {
        var service = CommunityProjectService(platform.db, CommunityProjectStore(platform.db), profiles)
        CommunityProjectRoutes.register(platform.server, service, moderators)
        return CommunityProjectsModule(service, profiles, moderators)
    }
}
