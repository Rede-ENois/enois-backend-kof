package communityprojects

// Lifecycle states of a community project (CommunityProjectStatus). Stored as the enum name.
class CommunityProjectStatus {
    static String submitted() = "SUBMITTED"
    static String published() = "PUBLISHED"
    static String rejected() = "REJECTED"
    static String suspended() = "SUSPENDED"
}

// One row of `community_projects` (the Java CommunityProject domain object). Instants are ISO strings.
record CommunityProject(String id, String userId, String slug, String title, String? description, String? shortDescription, String? cover, String? url, String? repoUrl, String? tags, String? category, String status, String? reviewedBy, String? reviewNote, String submittedAt, String? reviewedAt, String? publishedAt, String? suspendedAt, String createdAt, String updatedAt)

// Project as the front consumes it (CommunityProjectView): lifecycle plus the showcase fields.
record CommunityProjectView(String id, String userId, String? username, String slug, String title, String? description, String? shortDescription, String? cover, String? url, String? repoUrl, String? tags, String? category, String status, String? reviewNote, String submittedAt, String? publishedAt, Bool owned)

// Catalogue page; the cursor is the offset of the next page (CommunityProjectPageView).
record CommunityProjectPageView(List<CommunityProjectView> items, String? nextCursor)

// `{"id","status"}` answers of resubmit/approve/reject/suspend/unsuspend/delete.
record CommunityProjectStatusView(String id, String status)

// One page of the catalogue search: `hasMore` answers "is there a next page" without a count.
record CommunityProjectSearchPage(List<CommunityProject> items, Bool hasMore)

// POST/PATCH body (SubmitProjectRequest). Every field optional; unknown properties are ignored.
record CommunityProjectSubmitBody(String? slug, String? title, String? description, String? shortDescription, String? cover, String? url, String? repoUrl, String? tags, String? category)

record CommunityProjectReviewBody(String? note)

// Pure rules shared by service and routes.
class CommunityProjectRules {
    static CommunityProjectView view(p: CommunityProject, username: String?, viewerId: String?) {
        var owned = false
        if (viewerId != null) {
            owned = p.userId() == viewerId
        }
        return CommunityProjectView(p.id(), p.userId(), username, p.slug(), p.title(), p.description(), p.shortDescription(), p.cover(), p.url(), p.repoUrl(), p.tags(), p.category(), p.status(), p.reviewNote(), p.submittedAt(), p.publishedAt(), owned)
    }
    // Math.min/max on Int arguments compile to the float overload (VerifyError), so clamp by hand.
    static Int clamp(v: Int, lo: Int, hi: Int) {
        if (v < lo) {
            return lo
        }
        if (v > hi) {
            return hi
        }
        return v
    }
    // StringUtils.hasText ? value.trim() : null
    static String? trimOrNull(value: String?) {
        if (value == null) {
            return null
        }
        if (value.trim().length() == 0) {
            return null
        }
        return value.trim()
    }
}
