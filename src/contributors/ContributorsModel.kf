package contributors

// Enum values travel as Strings (G43).
class ContributorEnums {
    static List<String> statuses() = listOf("NEW", "REVIEWING", "APPROVED", "REJECTED")
    static List<String> experiences() = listOf("INICIANTE", "INTERMEDIARIO", "AVANCADO", "MANTENEDOR")
    static List<String> areas() = listOf("ENGENHARIA", "DESIGN", "PRODUTO", "DADOS", "INFRA", "DOCUMENTACAO", "COMUNIDADE", "OUTRO")
    static String? none() = null
}

record ContributorApplicationRecord(String id, String? userId, String name, String github, String email, String? area, String? experience, String? message, String acceptedTermsAt, String status, String source, String createdAt)

// What the landing form and the confirmation send. acceptedTerms is a Troolean (an optional boolean, G140).
record ContributorApplyBody(String? name, String? github, String? email, String? area, String? experience, String? message, Troolean acceptedTerms)
record ContributorStatusBody(String? status)

record ContributorApplicationView(String id, String status, String createdAt)
record ContributorApplicationSummary(String id, String status, String source, String createdAt)
record ContributorUserStatusView(Bool verified, String? github, Bool applicationPending, String? name, String? email, ContributorApplicationSummary? application)
record ContributorAdminView(String? id, String? userId, String name, String github, String? email, String? area, String? experience, String? message, String status, String source, Bool formPending, String? sealName, Int? evidenceCount, String? acceptedTermsAt, String createdAt)
