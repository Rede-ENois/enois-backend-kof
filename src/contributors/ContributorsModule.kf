package contributors

import contributions.*
import kernel.*
import kernel.security.*
import profile.*

// Composition of the contributors domain. It reads the verified contributors of the contributions domain.
class ContributorsModule {
    ContributorApplicationService service
    public constructor(service: ContributorApplicationService) {
        this.service = service
    }
    static ContributorsModule install(platform: Platform, parts: SecurityParts, contributions: ContributionsModule, profiles: ProfileModule) {
        var verified = VerifiedContributors(contributions.store, profiles.directory)
        var service = ContributorApplicationService(ContributorsStore(platform.db), verified, profiles.directory)
        ContributorsRoutes.register(platform.server, service, parts.ipLimiter)
        return ContributorsModule(service)
    }
}
