package communities

import feed.*
import kernel.db.*

// feed: the community of a post and the private channel of a post, read through the directories of this domain
// (PostCommunityReaderAdapter / CommunityChannelReader) instead of the `communities` tables.
class CommunityFeedCommunities extends FeedCommunities {
    CommunityDirectory directory
    CommunityChannelDirectory channels
    public constructor(store: Db, directory: CommunityDirectory, channels: CommunityChannelDirectory) {
        super(store)
        this.directory = directory
        this.channels = channels
    }
    FeedCommunityRef? byId(communityId: String, viewerId: String?) {
        var found = directory.byIds(listOf(communityId), viewerId).get(communityId)
        if (found == null) {
            return null
        }
        return FeedCommunityRef(found.id, found.name, found.topic, found.joined)
    }
    FeedChannelRef? channel(channelId: String) {
        var c = channels.byId(channelId)
        if (c == null) {
            return null
        }
        return FeedChannelRef(c.id, c.communityId, c.topic)
    }
}
