package onboarding

record OnboardingCommunityCard(String id, String name, String? description, String? topic, String? avatar, Int memberCount)

record OnboardingGroupCard(String id, String slug, String name, String? description, String? topic, String? avatar, Int memberCount)

record OnboardingPersonCard(String id, String username, String name, String? headline, String? avatar)

record OnboardingStarterPack(List<OnboardingCommunityCard> communities, List<OnboardingGroupCard> groups, List<OnboardingPersonCard> people)

// What is in place after the call (already there or done now); skipped ids are left out.
record OnboardingResult(Bool onboardingCompleted, List<String> joinedCommunityIds, List<String> joinedGroupIds, List<String> requestedUserIds)

// POST /me/onboarding/complete: every field is optional (a missing body is the empty command).
record OnboardingCompleteRequest(List<String>? topics, List<String>? skills, List<String>? communityIds, List<String>? groupIds, List<String>? connectUserIds)
