package onboarding

import age.*
import kernel.*

// The onboarding domain. `actions` is the seam to communities, groups, network and preferences: Main.kf replaces
// it (a subclass of OnboardingActions) once those domains are ported.
class OnboardingModule {
    OnboardingService service
    public constructor(service: OnboardingService) {
        this.service = service
    }
    static OnboardingModule install(platform: Platform, policy: AgePolicyReader) = OnboardingModule.installWith(platform, policy, OnboardingActions(platform.db))
    static OnboardingModule installWith(platform: Platform, policy: AgePolicyReader, actions: OnboardingActions) {
        var service = OnboardingService(platform.db, OnboardingStore(platform.db), actions, policy)
        OnboardingRoutes(service).register(platform.server)
        return OnboardingModule(service)
    }
}
