package freelances

import age.*
import corporate.*
import kernel.*
import kernel.security.*
import messaging.*
import profile.*

// Composition of the freelances domain. AppWiring calls install once, after the modules it calls: profile (usernames),
// age (write gate), corporate (professional identity of a proposal) and messaging (the FREELANCE conversation).
class FreelancesModule {
    FreelanceService service
    public constructor(service: FreelanceService) {
        this.service = service
    }
    static FreelancesModule install(platform: Platform, shared: SharedServices, profiles: ProfileModule, gate: AgeGate, corporate: CorporateModule, messaging: MessagingModule) {
        var service = FreelanceService(platform.db, FreelanceStore(platform.db), profiles.directory, ActionThrottle(), gate, corporate.service, messaging.service, shared.blockedUsers)
        FreelanceRoutes.register(platform.server, service)
        return FreelancesModule(service)
    }
}
