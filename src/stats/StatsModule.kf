package stats

import kernel.*
import kernel.security.*

class StatsModule {
    StatsService service
    public constructor(service: StatsService) {
        this.service = service
    }
    static StatsModule install(platform: Platform, shared: SharedServices, hooks: SecurityHooks) {
        var service = StatsService(StatsStore(platform.db), shared.caches.get("communityStats"))
        StatsRoutes.register(platform.server, service)
        return StatsModule(service)
    }
}
