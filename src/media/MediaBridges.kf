package media

import feed.*
import groups.*
import java.util.HashMap
import kernel.db.*

// The media reads other domains held while this one did not exist, now backed by MediaService (ownership checks,
// visible attachments, deletion requests that feed the deletion jobs).
// feed: ownership of the attachments of a post or comment, the cards, and the release of the media with the post.
class MediaFeedBridge extends FeedMedia {
    MediaService service
    // How many times the feed asked for the cards of a page (one per page is the contract: no N+1).
    Int cardLookups = 0
    public constructor(store: Db, service: MediaService) {
        super(store)
        this.service = service
    }
    requireOwned(ownerId: String, mediaIds: List<String>) {
        service.validateOwnedBy(ownerId, mediaIds)
    }
    Map<String,FeedMediaSummary> visibleByIds(mediaIds: List<String>) {
        var out = new HashMap<String, FeedMediaSummary>()
        this.cardLookups = this.cardLookups + 1
        var visible = service.visibleByIds(mediaIds)
        for (var id in visible.keys()) {
            var m = visible.get(id)
            if (m != null) {
                out.put(id, FeedMediaSummary(m.id, m.cdnUrl, m.mimeType, m.width, m.height))
            }
        }
        return out
    }
    requestPostMediaDeletion(ownerId: String, postId: String, mediaIds: List<String>) {
        service.requestPostMediaDeletion(ownerId, postId, mediaIds)
    }
}

// groups: the attachments a topic or comment card draws.
class MediaGroupLookup extends GroupMediaLookup {
    MediaService service
    public constructor(store: Db, service: MediaService) {
        super(store)
        this.service = service
    }
    Map<String,GroupMediaSummary> visibleByIds(ids: List<String>) {
        var out = mapOf<String, GroupMediaSummary>()
        var visible = service.visibleByIds(ids)
        for (var id in visible.keys()) {
            var m = visible.get(id)
            if (m != null) {
                out.put(id, GroupMediaSummary(m.id, m.cdnUrl, m.mimeType, m.width, m.height))
            }
        }
        return out
    }
}
