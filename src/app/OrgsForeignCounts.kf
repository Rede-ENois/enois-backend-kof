package app

import events.*
import kernel.db.*
import mentoring.*
import profile.*

// The profile seam ProfileForeignCounts has two owners in the orgs wave: events (attendance total) and mentoring
// (sessions as mentee). One subclass answers both; every other count keeps reading as the base class does.
class OrgsForeignCounts extends EventsForeignCounts {
    MentoringProfileCounts mentoringCounts
    public constructor(database: Db, eventsStore: EventsStore) {
        super(database, eventsStore)
        this.mentoringCounts = MentoringProfileCounts(database)
    }
    Int mentoringAsMentee(userId: String) = mentoringCounts.mentoringAsMentee(userId)
}
