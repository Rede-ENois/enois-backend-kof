package app

import gifs.*
import emotes.*
import calls.*
import kernel.*
import kernel.config.*
import kernel.log.*
import kernel.security.*
import identity.*
import age.*
import onboarding.*
import apiv1.*
import blog.*
import notices.*
import ops.*
import projects.*
import releasenotes.*
import search.*
import stats.*
import suggestions.*
import themes.*
import messaging.*
import notifications.*
import feed.*
import profile.*
import push.*
import communities.*
import communityprojects.*
import groups.*
import studypairs.*
import linkedin.*
import media.*
import jobs.*
import importlinkedin.*
import importresume.*
import games.*
import dailygames.*
import coin.*
import cosmetics.*
import contributions.*
import contributors.*
import githubprofile.*
import support.*
import marketplace.*
import services.*
import corporate.*
import companies.*
import freelances.*
import events.*
import mentoring.*
import moderation.*
import network.*
import preferences.*

// The production composition: every domain module installed on a created platform, in dependency order.
// Main.kf and tests/integration/BootRoutesTest.kf both call it, so a test boots the exact production wiring.
// Returns the shared services so the caller can stop the background jobs (outbox worker, schedulers).
// What the composition built and tests need to reach into: the shared services (to stop the jobs) and the modules
// whose seams the wiring switched (tests listen to notifications, read the feed store...).
class AppWired {
    SharedServices shared
    NotificationsModule notifications
    FeedModule feed
    ModerationModule moderation
    MediaFeedBridge mediaFeed
    public constructor(shared: SharedServices, notifications: NotificationsModule, feed: FeedModule, moderation: ModerationModule, mediaFeed: MediaFeedBridge) {
        this.mediaFeed = mediaFeed
        this.shared = shared
        this.notifications = notifications
        this.feed = feed
        this.moderation = moderation
    }
}

class AppWiring {
    static SharedServices install(platform: Platform) = AppWiring.installAll(platform).shared
    static AppWired installAll(platform: Platform) {
        // Shared services (idempotency, outbox worker, audit, cipher, caches, sanction gate, risk engine, ...).
        // The moderation pieces the pipeline and the shared services need before the module exists (automatic reports, risk
        // escalation, moderator check); bound to the report service when moderation is installed at the end.
        var early = ModerationEarly()
        var shared = SharedServices.createWith(platform, early.escalation)
        // The one mail service every sender shares (identity, age, jobs, notifications digest, blog newsletter):
        // SMTP from MAIL_HOST / MAIL_PORT / MAIL_USERNAME / MAIL_PASSWORD, one email_log row per send.
        var mail = MailService.fromConfig(platform.cfg, EmailLogStore(platform.db))
        // Request pipeline (filters, limiters, guards). Each domain port replaces its own seam in `hooks`
        // (moderators, monitoring, reports, origins) before this line.
        var hooks = SecurityHooks.defaults(platform.db)
        early.wire(hooks, platform.db)
        // ops replaces hooks.monitoring and apiv1 uses hooks.origins: both before Security.install captures them.
        OpsModule.install(platform, shared, hooks)
        ApiV1Module.install(platform, shared, hooks)
        var parts = Security.install(platform, hooks)
        // identity (auth, 2FA, social login, identity verification), age (parental supervision, age gate) and
        // onboarding. Seams: IdentitySeams (users, mailer, Turnstile, IP blocks, signup guard, notifier, OAuth links,
        // identity providers) and OnboardingActions (communities, groups, network); defaults documented in
        // docs/PORTING_STATUS.md.
        // profile, network, preferences, presence (seams: ProfileModule.installWith). Before identity: the job
        // eligibility rule of identity reads the live reputation of the profile domain.
        // The cosmetics core (catalog + badge ownership) comes first: profile asks it who owns an emblem.
        var cosmeticsCore = CosmeticsCore.create(platform)
        // The events store comes first: profile (attendance total of the reputation) and notifications (the event a notice
        // points at) read it through EventsForeignCounts and EventsNotificationPlaces; EventsModule installs later.
        var eventsStore = EventsStore(platform.db)
        // Profile is installed before notifications (the actors read profiles): its notifier is bound right after.
        var profileNotifier = ProfileNotificationsBridge(platform.db)
        // The themes service comes first: preferences asks it whether a gallery theme is published.
        var themeService = ThemeService(ThemeStore(platform.db))
        var profiles = ProfileModule.installWith(platform, shared, profileNotifier, cosmeticsCore.badges, AgeProfileParentalLinks(platform.db, AgePolicyReader(AgeStore(platform.db))), ModerationForeignCounts(platform.db, eventsStore), ThemesPreferencesGallery(platform.db, themeService))
        // corporate (professional identity): after profile, before the domains that read it (feed, messaging, jobs).
        var corporate = CorporateModule.install(platform, profiles)
        // contributions: evidence, seals and the GitHub link. It comes before identity: the OAuth link of GitHub is
        // remembered by it (ContributionsOAuthLinks) and a verified contributor owns the cosmetic tag.
        var contributions = ContributionsModule.install(platform, shared, parts, profiles)
        // Domains (one block each, ordered by dependency): notifications is the sink the others write to.
        // economy (coin): the ledger service is built first because the domains below call it (presence, rewards);
        // the routes, the disputes and the jobs come after notifications (CoinModule.install).
        var coinCore = CoinCore.create(platform, shared, parts)
        var notificationSeams = NotificationsSeams(platform, mail)
        notificationSeams.coins = CoinNotificationCoins(coinCore.service)
        notificationSeams.actors = ProfileNotificationActors(platform.db, profiles.directory, corporate.service)
        notificationSeams.sources = FeedNotificationSources(platform.db, FeedStore(platform.db))
        notificationSeams.accounts = ProfileNotificationAccounts(platform.db, profiles.directory)
        notificationSeams.digestAccounts = ProfileDigestAccounts(platform.db, profiles.directory)
        notificationSeams.digestPersonalization = PreferencesDigestPersonalization(platform.db, profiles.preferences)
        notificationSeams.placeReader = EventsNotificationPlaces(platform.db, eventsStore)
        var notificationsModule = NotificationsModule.installWith(platform, shared, notificationSeams)
        profileNotifier.api = notificationsModule.notifications
        var jobSeams = JobSeamSet(platform, profiles)
        jobSeams.corporate = CorporateJobsBridge(platform.db, corporate.service)
        var identitySeams = IdentitySeams.defaults(platform, mail)
        identitySeams.notifier = IdentityNotificationsBridge(notificationsModule.notifications)
        identitySeams.oauthLinks = ContributionsOAuthLinks(platform.db, contributions.identities, contributions.tokens, contributions.linkSync)
        identitySeams.reputations = JobsIdentityReputation(jobSeams.reputation)
        var identity = IdentityModule.installWith(platform, shared, hooks, parts, identitySeams)
        var age = AgeModule.install(platform, identity.mailer)
        // media comes before the feed (post attachments) and the groups (topic attachments).
        var media = MediaModule.install(platform, shared, hooks)
        // The feed asks communities and blog through their stores (stateless readers over the same database): the
        // communities module itself is installed after the feed because it serves the community feed.
        var communityDirectory = CommunityDirectory(CommunityStore(platform.db))
        var channelDirectory = CommunityChannelDirectory(CommunityChannelStore(platform.db))
        var feedSeams = FeedSeams(platform.db)
        feedSeams.authors = ProfileFeedAuthors(platform.db, profiles.directory, corporate.service, contributions.store)
        var mediaFeed = MediaFeedBridge(platform.db, media.service)
        feedSeams.media = mediaFeed
        feedSeams.communities = CommunityFeedCommunities(platform.db, communityDirectory, channelDirectory)
        feedSeams.notifier = FeedNotificationsBridge(platform.db, notificationsModule.notifications)
        feedSeams.ageGate = AgeFeedGate(age.gate)
        feedSeams.coins = CoinFeedCoins(coinCore.service)
        feedSeams.corporate = CorporateFeedBridge(platform.db, corporate.service)
        feedSeams.graph = NetworkFeedGraph(platform.db, profiles.network)
        feedSeams.blogs = BlogFeedBlogs(platform.db, BlogStore(platform.db))
        feedSeams.prefs = PreferencesFeedReader(platform.db, profiles.preferences)
        // The hidden-field guard bans through the moderation sanction service, bound at the end of the composition.
        var honeypot = ModerationModule.honeypotFor(platform, parts)
        feedSeams.honeypot = honeypot
        var feedModule = FeedModule.installSeams(platform, shared, hooks, feedSeams)
        // Coin disputes report and penalise through the moderation services (bound when moderation is installed).
        var coinDispute = ModerationCoinDispute(platform.db, parts.actionThrottle, notificationsModule.notifications, platform.cfg.getInt("REDE_MODERATION_REPORTS_PER_HOUR", 10))
        var coinModule = CoinModule.installWith(platform, shared, coinCore, profiles, notificationsModule, coinDispute)
        CosmeticsModule.installWith(platform, cosmeticsCore, coinModule, profiles, ContributionsCosmeticsContributors(platform.db, VerifiedContributors(contributions.store, profiles.directory)))
        // events: attendance, rituals (recurrence job) and the sanitisation job; writes notifications, reads identity.
        EventsModule.install(platform, shared, parts, identity, notificationsModule, eventsStore)
        PushModule.withPresence(platform, notificationsModule, PresencePushBridge(platform.db, profiles.presence))
        var messagingSeams = MessagingSeamSet(platform)
        messagingSeams.agePolicy = AgeMessagingPolicy(platform.db, age.policy, age.gate)
        messagingSeams.connections = NetworkMessagingConnections(platform.db, profiles.network)
        messagingSeams.corporate = CorporateMessagingBridge(platform.db, corporate.service)
        messagingSeams.coins = CoinMessagingCoins(coinCore.service)
        var messagingModule = MessagingModule.installWith(platform, shared, parts, notificationsModule, messagingSeams)
        // Groups notices go through the Notifications API (push + preferences): see GroupNotificationsBridge.
        var groupsModule = GroupsModule.installWith(platform, shared, ProfileGroupLookup(platform.db, profiles.directory), AgeGroupGate(platform.db, age.gate), MediaGroupLookup(platform.db, media.service), GroupNotificationsBridge(platform.db, notificationsModule.notifications), CoinGroupCoins(coinCore.service))
        // calls: who may enter a group call comes from the groups service, the name from the profile directory.
        var callSeams = CallsSeamSet(platform)
        callSeams.groups = GroupsCallGroups(platform.db, groupsModule.groups)
        callSeams.profiles = ProfileCallLookup(platform.db, profiles.directory)
        CallsModule.installWith(platform, shared, parts, notificationsModule, messagingModule, callSeams)
        // Jobs: postings, applications (delivery by message and email), company directory, external listings and
        // their refresh job. Seams: JobSeamSet (reputation, companies, corporate, source transport).
        // companies: the page service comes first because the jobs seam JobCompanies is backed by it; the routes,
        // the directory and the microprojects come after the jobs.
        var companyService = CompaniesModule.core(platform, notificationsModule)
        jobSeams.companies = CompanyJobsBridge(platform.db, companyService)
        var jobs = JobsModule.installWith(platform, shared, parts, profiles, notificationsModule, messagingModule, identity.mailer, jobSeams)
        CompaniesModule.install(platform, shared, companyService, profiles, corporate, notificationsModule, messagingModule, coinModule, jobs)
        // LinkedIn import (profile text, contacts and their automatic invites) and resume import (prefill of an
        // application). The four file uploads are multipart POSTs claimed in the binary lane.
        var linkedinImport = LinkedinImportModule.install(platform, shared, profiles)
        ImportResumeModule.install(platform, jobs, linkedinImport)
        // Games: the aggregator (profile, notifications and age gate through their APIs; coin and feed through
        // the seams GamesCoins and GamesFeed) and the daily games with their 00:20 prize job.
        var gamesModule = GamesModule.installFull(platform, profiles, notificationsModule, CoinGamesCoins(platform.db, shared.cipher, coinCore.service, coinCore.rates), FeedGamesFeed(platform.db, age.gate, shared.sanctionGate, feedModule.service), GamesHosts())
        DailyGamesModule.install(platform, shared, notificationsModule, gamesModule.coins)
        var communitiesModule = CommunitiesModule.installWith(platform, shared, hooks, ProfileCommunityLookup(platform.db, profiles.directory), FeedCommunityLookup(platform.db, feedModule.reader, feedModule.service, feedModule.store), CoinCommunityCoins(coinCore.service))
        // onboarding joins communities and groups and asks for connections through their services: after them.
        OnboardingModule.installWith(platform, age.policy, AppOnboardingActions(platform.db, profiles.preferences, profiles.service, profiles.directory, communitiesModule.service, groupsModule.groups, profiles.network))
        CommunityProjectsModule.installWith(platform, ProfileCommunityProjectLookup(platform.db, profiles.directory), ModerationProjectModerators(platform.db))
        StudyPairsModule.installWith(platform, shared, ProfileStudyPairLookup(platform.db, profiles.directory), AgeStudyPairPolicy(platform.db, age.policy), PreferencesStudyPairs(platform.db, profiles.preferences), StudyPairNotificationsBridge(platform.db, notificationsModule.notifications))
        GifsModule.install(platform, shared, hooks)
        LinkedInModule.installWith(platform, shared, FeedLinkedInPosts(platform.db, feedModule.store), LinkedInHttpShareClient(LinkedInHttpShareClient.defaultEndpoint()), LinkedInClock())
        EmotesModule.install(platform, shared, hooks)
        // Leaf domains: stats, search, themes, projects, notices, releasenotes, suggestions, blog.
        StatsModule.install(platform, shared, hooks)
        NoticeModule.install(platform, shared, hooks)
        ReleaseNoteModule.install(platform, shared, hooks)
        SearchModule.install(platform, shared, hooks)
        var themeModule = ThemeModule.withService(platform, themeService)
        var projectsModule = ProjectsModule.withProfiles(platform, ProfileProjectsLookup(platform.db, profiles.directory))
        // support (tickets, the GitHub mirror, the webhook): the person who answers comments with their own GitHub
        // identity (contributions). The suggestions reuse its GitHub token, so they come after it.
        var supportModule = SupportModule.install(platform, shared, profiles, notificationsModule, mail, SupportLinkedPeople(profiles.directory, contributions.identities, contributions.tokens))
        SuggestionsModule.withGateway(platform, SuggestionIssueClient.fromConfig(platform.cfg, SuggestionsSupportToken(platform.db, shared.cipher, supportModule.settings)))
        ContributorsModule.install(platform, parts, contributions, profiles)
        GithubProfileModule.install(platform, shared, contributions, profiles, projectsModule)
        BlogModule.withSeams(platform, shared, ProfileBlogLookup(platform.db, profiles.directory), FeedBlogPointers(feedModule.service), BlogNotificationsBridge(notificationsModule.notifications), CoinBlogCoins(coinCore.service), BlogEmailSender(mail))
        // economy: the marketplace (escrow, workers) and the services directory/contracts sit on the coin service.
        MarketplaceModule.install(platform, shared, coinModule, profiles, themeModule)
        var servicesModule = ServicesModule.install(platform, shared, coinModule, profiles, messagingModule)
        // freelances: closed-scope jobs. Reads profile (usernames), age (write gate), corporate (the professional
        // identity a proposal needs) and messaging (the FREELANCE conversation); no seam of its own.
        FreelancesModule.install(platform, shared, profiles, age.gate, corporate, messagingModule)
        // mentoring: agenda, bookings paid through the coin escrow, rooms. After coin and profile.
        MentoringModule.install(platform, shared, coinModule, profiles)
        // moderation (reports, sanctions, moderators, IP blocks, automations): last, it acts on the content of every domain above.
        // Seams it owns: hooks.moderators / hooks.reports and the risk escalation (set before the pipeline), the feed honeypot,
        // the coin dispute, the community project moderators, the profile report facts and caches, the company page closing.
        var moderationModule = ModerationModule.installWith(platform, shared, parts, feedModule, groupsModule, profiles, mail, notificationsModule.notifications, ModerationReportEvents(), ModerationCompaniesBridge(platform.db, companyService), ModerationProfileCaches(platform.db, shared.caches), ModerationLlmTransport(), ModerationImages(), honeypot, early)
        coinDispute.bind(moderationModule.service, moderationModule.sanctions)
        ModerationReviewRoutes.register(platform.server, gamesModule.games, servicesModule.offers, profiles.directory)
        return AppWired(shared, notificationsModule, feedModule, moderationModule, mediaFeed)
    }
}
