package app

import gifs.*
import emotes.*
import calls.*
import kernel.*
import kernel.config.*
import kernel.log.*
import kernel.security.*
import identity.*
import age.*
import onboarding.*
import apiv1.*
import blog.*
import notices.*
import ops.*
import projects.*
import releasenotes.*
import search.*
import stats.*
import suggestions.*
import themes.*
import messaging.*
import notifications.*
import feed.*
import profile.*
import push.*
import communities.*
import communityprojects.*
import groups.*
import studypairs.*
import linkedin.*
import media.*
import jobs.*
import importlinkedin.*
import importresume.*
import games.*
import dailygames.*
import coin.*
import cosmetics.*
import marketplace.*
import services.*
import corporate.*
import companies.*

// The production composition: every domain module installed on a created platform, in dependency order.
// Main.kf and tests/integration/BootRoutesTest.kf both call it, so a test boots the exact production wiring.
// Returns the shared services so the caller can stop the background jobs (outbox worker, schedulers).
class AppWiring {
    static SharedServices install(platform: Platform) {
        // Shared services (idempotency, outbox worker, audit, cipher, caches, sanction gate, risk engine, ...).
        var shared = SharedServices.create(platform)
        // Request pipeline (filters, limiters, guards). Each domain port replaces its own seam in `hooks`
        // (moderators, monitoring, reports, origins) before this line.
        var hooks = SecurityHooks.defaults(platform.db)
        // ops replaces hooks.monitoring and apiv1 uses hooks.origins: both before Security.install captures them.
        OpsModule.install(platform, shared, hooks)
        ApiV1Module.install(platform, shared, hooks)
        var parts = Security.install(platform, hooks)
        // identity (auth, 2FA, social login, identity verification), age (parental supervision, age gate) and
        // onboarding. Seams: IdentitySeams (users, mailer, Turnstile, IP blocks, signup guard, notifier, OAuth links,
        // identity providers) and OnboardingActions (communities, groups, network); defaults documented in
        // docs/PORTING_STATUS.md.
        // profile, network, preferences, presence (seams: ProfileModule.installWith). Before identity: the job
        // eligibility rule of identity reads the live reputation of the profile domain.
        // The cosmetics core (catalog + badge ownership) comes first: profile asks it who owns an emblem.
        var cosmeticsCore = CosmeticsCore.create(platform)
        var profiles = ProfileModule.installWith(platform, shared, ProfileNotifier(platform.db), cosmeticsCore.badges, ProfileParentalLinks(platform.db), ProfileForeignCounts(platform.db), PreferencesThemeGallery(platform.db))
        // corporate (professional identity): after profile, before the domains that read it (feed, messaging, jobs).
        var corporate = CorporateModule.install(platform, profiles)
        var jobSeams = JobSeamSet(platform, profiles)
        jobSeams.corporate = CorporateJobsBridge(platform.db, corporate.service)
        var identitySeams = IdentitySeams.defaults(platform, IdentityStore(platform.db))
        identitySeams.reputations = JobsIdentityReputation(jobSeams.reputation)
        var identity = IdentityModule.installWith(platform, shared, hooks, parts, identitySeams)
        var age = AgeModule.install(platform, identity.mailer)
        OnboardingModule.install(platform, age.policy)
        FeedModule.installWithCorporate(platform, shared, hooks, FeedCoins(), CorporateFeedBridge(platform.db, corporate.service))
        // Domains (one block each, ordered by dependency): notifications is the sink the others write to.
        // economy (coin): the ledger service is built first because the domains below call it (presence, rewards);
        // the routes, the disputes and the jobs come after notifications (CoinModule.install).
        var coinCore = CoinCore.create(platform, shared, parts)
        var notificationSeams = NotificationsSeams(platform)
        notificationSeams.coins = CoinNotificationCoins(coinCore.service)
        var notificationsModule = NotificationsModule.installWith(platform, shared, notificationSeams)
        var coinModule = CoinModule.install(platform, shared, parts, coinCore, profiles, notificationsModule)
        CosmeticsModule.install(platform, cosmeticsCore, coinModule, profiles)
        PushModule.install(platform, shared, hooks, parts, notificationsModule)
        var messagingSeams = MessagingSeamSet(platform)
        messagingSeams.corporate = CorporateMessagingBridge(platform.db, corporate.service)
        messagingSeams.coins = CoinMessagingCoins(coinCore.service)
        var messagingModule = MessagingModule.installWith(platform, shared, parts, notificationsModule, messagingSeams)
        CallsModule.install(platform, shared, hooks, parts, notificationsModule, messagingModule)
        // Groups notices go through the Notifications API (push + preferences): see GroupNotificationsBridge.
        GroupsModule.installWith(platform, shared, GroupProfileLookup(platform.db), GroupAgeGate(platform.db), GroupMediaLookup(platform.db), GroupNotificationsBridge(platform.db, notificationsModule.notifications), CoinGroupCoins(coinCore.service))
        // Jobs: postings, applications (delivery by message and email), company directory, external listings and
        // their refresh job. Seams: JobSeamSet (reputation, companies, corporate, source transport).
        // companies: the page service comes first because the jobs seam JobCompanies is backed by it; the routes,
        // the directory and the microprojects come after the jobs.
        var companyService = CompaniesModule.core(platform, notificationsModule)
        jobSeams.companies = CompanyJobsBridge(platform.db, companyService)
        var jobs = JobsModule.installWith(platform, shared, parts, profiles, notificationsModule, messagingModule, identity.mailer, jobSeams)
        CompaniesModule.install(platform, shared, companyService, profiles, corporate, notificationsModule, messagingModule, coinModule, jobs)
        // LinkedIn import (profile text, contacts and their automatic invites) and resume import (prefill of an
        // application). The four file uploads are multipart POSTs claimed in the binary lane.
        var linkedinImport = LinkedinImportModule.install(platform, shared, profiles)
        ImportResumeModule.install(platform, jobs, linkedinImport)
        // Games: the aggregator (profile, notifications and age gate through their APIs; coin and feed through
        // the seams GamesCoins and GamesFeed) and the daily games with their 00:20 prize job.
        var gamesModule = GamesModule.install(platform, shared, hooks, profiles, notificationsModule, age.gate)
        DailyGamesModule.install(platform, shared, notificationsModule, gamesModule.coins)
        CommunitiesModule.installWith(platform, shared, hooks, CommunityProfileLookup(platform.db), CommunityFeedLookup(platform.db), CoinCommunityCoins(coinCore.service))
        CommunityProjectsModule.install(platform, shared, hooks)
        StudyPairsModule.install(platform, shared, hooks)
        GifsModule.install(platform, shared, hooks)
        LinkedInModule.install(platform, shared, hooks)
        EmotesModule.install(platform, shared, hooks)
        MediaModule.install(platform, shared, hooks)
        // Leaf domains: stats, search, themes, projects, notices, releasenotes, suggestions, blog.
        StatsModule.install(platform, shared, hooks)
        NoticeModule.install(platform, shared, hooks)
        ReleaseNoteModule.install(platform, shared, hooks)
        SearchModule.install(platform, shared, hooks)
        var themeModule = ThemeModule.install(platform, shared, hooks)
        ProjectsModule.install(platform, shared, hooks)
        SuggestionsModule.install(platform, shared, hooks)
        BlogModule.withSeams(platform, shared, BlogProfiles(platform.db), BlogFeedPointers(), BlogNotifier(), CoinBlogCoins(coinCore.service), BlogEmailSender(EmailLogStore(platform.db)))
        // economy: the marketplace (escrow, workers) and the services directory/contracts sit on the coin service.
        MarketplaceModule.install(platform, shared, coinModule, profiles, themeModule)
        ServicesModule.install(platform, shared, coinModule, profiles, messagingModule)
        return shared
    }
}
