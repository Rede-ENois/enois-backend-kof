package messaging

// Tables `conversations`, `conversation_participants`, `messages`, `message_hidden`, `message_reactions`.
record ConversationRecord(String id, String kind, String? title, String createdBy, String createdAt, String updatedAt)

record ParticipantRecord(String userId, String? lastReadAt, String joinedAt)

// `mediaIds` is the comma separated column as a list; `iv` is only set for E2E messages.
record MessageRecord(String id, String conversationId, String senderId, String text, List<String> mediaIds, Bool mediaSpoiler, Bool e2e, String? iv, String? replyToId, String createdAt)

// One reaction of one person to one message.
record MessageReactionRow(String messageId, String userId, String type)

// GET /conversations/{id}/messages/{messageId}/reactions item (ReactionSummary).
record MessageReactionView(String userId, String type, String createdAt)

record MessageReactionList(String messageId, Map<String,Int> summary, List<MessageReactionView> reactions)

// The last message of a conversation as the list previews it (LastMessagePreview).
record LastMessagePreview(String? text, Bool e2e, String? iv, String? time, String? from)

// The identity a participant shows in a professional conversation (IdentityView).
record MessagingIdentity(String identity, String username, String name, String avatar)

record ConversationView(String id, String userId, String kind, String context, String? title, List<String> participantIds, Map<String,MessagingIdentity> identities, String? lastMessage, String? time, Int unread, String? otherLastReadAt, Bool lastMessageE2e, String? lastMessageIv, String? lastMessageFrom)

record ConversationDetailView(String id, String kind, String context, String? title, List<String> participantIds, Map<String,MessagingIdentity> identities, String? lastMessage, Int unread, String? otherLastReadAt, Bool lastMessageE2e, String? lastMessageIv, String? lastMessageFrom)

record MessageReplyView(String id, String from, String text, Bool e2e)

record MessageView(String id, String conversationId, String from, String text, List<String> mediaIds, String? time, Map<String,Int> reactions, String? myReaction, Bool mediaSpoiler, Bool e2e, String? iv, String? replyToId, MessageReplyView? replyTo)

record ConversationPage(List<ConversationView> items, String? nextCursor)

record MessagePage(List<MessageView> items, String? nextCursor)

record MessagingStatusBody(String id, String status)

record MessagingCountBody(Int count)

// The conversation context (ConversationContext): the work kinds belong to the professional interface.
class ConversationContexts {
    static String professionalList() = "(\'JOB\', \'FREELANCE\', \'SERVICE\', \'BUSINESS_DIRECT\')"
    static String of(kind: String?) {
        if (kind != null && "|JOB|FREELANCE|SERVICE|BUSINESS_DIRECT|".contains("|" + kind.toUpperCase() + "|")) {
            return "PROFESSIONAL"
        }
        return "SOCIAL"
    }
    // The notification kind of a new message in a conversation.
    static String messageNotificationKind(kind: String) {
        if (ConversationContexts.of(kind) == "PROFESSIONAL") {
            return "NEW_WORK_MESSAGE"
        }
        return "NEW_MESSAGE"
    }
    static List<String> reactionTypes() = listOf<String>("LIKE", "LOVE", "LAUGH", "WOW", "SAD", "CELEBRATE", "SUPPORT", "INSIGHTFUL", "ROFL", "ANGRY", "DISGUST", "SKEPTICAL", "EYES", "NOTE", "FIRE", "CLAP", "CLOWN", "NAILS")
}
