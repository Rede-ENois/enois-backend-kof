package projects

// One entry of the evolution diary of a project.
record ProjectDiaryEntry(String date, String text)

// The same entry as stored or sent: any member may be missing.
record ProjectDiaryInput(String? date, String? text)

// A project card of the profile: stack, repository link, status and the evolution diary. When `html`
// exists the WHOLE card becomes the author's HTML (sanitised on write) and the structured part is kept as
// a fallback.
record ProjectRecord(String id, String userId, Int position, String title, String? description, String? banner, String? icon, List<String> stack, String? repoUrl, String? status, List<ProjectDiaryEntry> diary, String? html, String createdAt, String updatedAt)

// What the profile screen gets: the card without owner, position and dates.
record ProjectView(String id, String title, String? description, String? banner, String? icon, List<String> stack, String? repoUrl, String? status, List<ProjectDiaryEntry> diary, String? html)

// POST and PUT body of a card.
record ProjectRequest(String? title, String? description, String? banner, String? icon, List<String>? stack, String? repoUrl, String? status, List<ProjectDiaryInput>? diary, String? html)

class ProjectViews {
    static ProjectView of(p: ProjectRecord) = ProjectView(p.id(), p.title(), p.description(), p.banner(), p.icon(), p.stack(), p.repoUrl(), p.status(), p.diary(), p.html())
    static List<ProjectView> all(projects: List<ProjectRecord>) {
        var out = listOf<ProjectView>()
        for (var p in projects) {
            out.add(ProjectViews.of(p))
        }
        return out
    }
}
