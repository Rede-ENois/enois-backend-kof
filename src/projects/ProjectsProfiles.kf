package projects

import kernel.db.*

// Seam to the profile domain: which account owns a public username.
// pending-port: profile. The default reads `users` read-only with the lookup the profile repository does.
class ProjectsProfiles {
    Db store
    public constructor(store: Db) {
        this.store = store
    }
    // The user id behind a username, or null when nobody has it.
    String? idByUsername(username: String) {
        var row = store.queryOptional("select id from users where username = ?", DbParams().bindStr(username))
        if (row == null) {
            return null
        }
        return row.getStr("id")
    }
}
