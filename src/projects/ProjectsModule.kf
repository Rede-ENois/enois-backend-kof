package projects

import kernel.*
import kernel.security.*

class ProjectsModule {
    ProjectsService service
    public constructor(service: ProjectsService) {
        this.service = service
    }
    static ProjectsModule install(platform: Platform, shared: SharedServices, hooks: SecurityHooks) = ProjectsModule.withProfiles(platform, ProjectsProfiles(platform.db))
    // The profile domain passes its own subclass of the seam.
    static ProjectsModule withProfiles(platform: Platform, profiles: ProjectsProfiles) {
        var service = ProjectsService(ProjectStore(platform.db), profiles)
        ProjectsRoutes.register(platform.server, service)
        return ProjectsModule(service)
    }
}
