package gifs

// Outbound HTTP for the providers, the only place that talks to the network. A seam: tests subclass it
// and answer from memory (nothing here is reached by the suite).
// `kof.http` limits (G15): it returns the body only, never the status or headers, and a non-2xx answer or a
// network failure is thrown as a String. Both mean the same to the picker (502 GIF_PROVIDER_ERROR), so
// the status is not needed.
class GifHttp {
    public constructor() {}
    String get(url: String) {
        // Process-wide in the runtime, 8 s like the Java request timeout.
        http.timeout(8)
        return http.get(url)
    }
}
