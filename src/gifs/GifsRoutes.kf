package gifs

import kernel.http.*
import kernel.security.*

// GET /gifs/search: needs a session on purpose (a proxy to a quota-bound provider, and commenting already
// needs an account). The term is normalised (trim + lower case) because it is the cache key.
class GifsRoutes {
    static register(server: HttpServer, service: GifSearchService) {
        server.get("/gifs/search", () -> GifsRoutes.search(service))
    }
    static String search(service: GifSearchService) {
        Auth.requireUser()
        var term = Req.queryStr("q", "").trim().toLowerCase()
        var limit = Req.queryInt("limit", 24)
        if (limit < 1) {
            limit = 1
        }
        if (limit > 50) {
            limit = 50
        }
        return service.searchJson(term, limit)
    }
}
