package gifs

// One GIF ready for the picker: `url` is the direct media (.gif) a comment accepts and `previewUrl` the
// light version of the grid (GifItem).
record GifItem(String? id, String url, String previewUrl, Int width, Int height, String? description, String provider)

// `available` is false when NO provider has a key: the front explains the outage instead of showing
// "no results" for a search that never happened (GifSearchResult).
record GifSearchResult(Bool available, String? provider, List<GifItem> items)

// An external GIF source (GifProvider). A provider without a key still exists: `available()` answers for
// it, so a missing key is a message in the picker and never a boot failure.
class GifProvider {
    public constructor() {}
    String name() = ""
    Bool available() = false
    // An empty query means trending. An empty list is a legitimate answer, not an error.
    List<GifItem> search(query: String, limit: Int) = listOf<GifItem>()
}

// The GIFs the network itself already shared (comments quoting the term). Java's reader lives in the feed
// adapter (`CommunityGifAdapter`: comments with a `.gif` URL matching the term).
// pending-port: feed owns the comments table; until it subclasses this the reader finds nothing.
class GifCommunityReader {
    public constructor() {}
    List<String> search(term: String, limit: Int) = listOf<String>()
}
