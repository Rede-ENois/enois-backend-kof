package apiv1

import kernel.*
import kernel.security.*

// apiv1: the /v1 index and the developer origins. The /v1 alias itself (every route also under /v1) lives in the
// kernel's HttpServer; this module owns the origins table and tells the origin gate (hooks.origins, a
// JdbcOriginDirectory by default) to drop its cache after each change.
class ApiV1Module {
    DeveloperOriginService service
    public constructor(service: DeveloperOriginService) {
        this.service = service
    }
    static ApiV1Module install(platform: Platform, shared: SharedServices, hooks: SecurityHooks) {
        var service = DeveloperOriginService(DeveloperOriginStore(platform.db), hooks.origins)
        ApiV1Routes.register(platform.server, service)
        return ApiV1Module(service)
    }
}
