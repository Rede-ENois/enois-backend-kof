package apiv1

// One endpoint of the version index: method and path (the form the app already uses on the developers page).
record ApiV1Endpoint(String method, String path)

// The version index served by GET /v1.
record ApiV1Index(String version, String base, String note, List<ApiV1Endpoint> endpoints)

record DeveloperOriginView(String id, String origin, String createdAt, Bool blocked, String? blockedReason, String? blockedUntil)

record DeveloperOriginAdminView(String id, String origin, String userId, String createdAt, Bool blocked, String? blockedReason, String? blockedUntil, Int strikes)

record DeveloperOriginRequest(String? origin)

record DeveloperOriginBlockRequest(String? reason)
