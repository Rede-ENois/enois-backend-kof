package profile

// Column <-> value translation of users.profile_appearance (ProfileAppearanceJson). Only known keys are
// read, a broken document falls back to the platform default, writing "nothing chosen" stores NULL.
class ProfileAppearances {
    static ProfileLook emptyLook() = ProfileLook(null, null, null, null, null, null, null)
    static ProfileAppearance empty() = ProfileAppearance(ProfileAppearances.emptyLook(), ProfileAppearances.emptyLook())
    static Bool lookIsEmpty(l: ProfileLook) = l.theme == null && l.accent == null && l.font == null && l.header == null && l.textures == null && l.borders == null && l.decoration == null
    static Bool isEmpty(a: ProfileAppearance) = ProfileAppearances.lookIsEmpty(a.social) && ProfileAppearances.lookIsEmpty(a.professional)
    // JSON text for the column, null when nothing is chosen.
    static String? encode(a: ProfileAppearance) {
        if (ProfileAppearances.isEmpty(a)) {
            return null
        }
        return json.encode(a)
    }
    static ProfileAppearance decode(raw: String?) {
        if (raw == null) {
            return ProfileAppearances.empty()
        }
        if (raw.trim().length() == 0) {
            return ProfileAppearances.empty()
        }
        try {
            var body = json.decode<ProfileAppearanceBody>(raw)
            return ProfileAppearance(ProfileAppearances.look(body.social()), ProfileAppearances.look(body.professional()))
        } catch (String e) {
            return ProfileAppearances.empty()
        }
    }
    static ProfileLook look(b: ProfileLookBody?) {
        if (b == null) {
            return ProfileAppearances.emptyLook()
        }
        return ProfileLook(b.theme(), b.accent(), b.font(), b.header(), b.textures(), b.borders(), b.decoration())
    }
}
