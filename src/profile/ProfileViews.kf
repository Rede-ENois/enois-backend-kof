package profile

import kernel.text.*

// Projections of a ProfileRecord, field by field like UserProfileView.from / OwnProfileView.from.
// A profile read from the repository carries zero counters (the column reputation is the only number it
// has), no posts count and no garden: the single-profile reads add them with `counts`.
class ProfileViews {
    static ProfileLook socialLook(p: ProfileRecord) = p.appearance.social
    // UserProfileView.from(profile): lists, search, ranking, write responses. `counts`/`postsCount` null = unset.
    static ProfileView publicView(p: ProfileRecord, counts: ProfileCounts?, postsCount: Int?, withHtml: Bool) {
        var connections = 0
        var followers = 0
        var reputation = p.reputation
        var garden = ProfileNulls.garden()
        if (counts != null) {
            connections = counts.connections()
            followers = counts.followers()
            reputation = counts.reputation()
            garden = counts.garden()
        }
        var bio = Nulls.str()
        var banner = Nulls.str()
        if (withHtml) {
            bio = p.bioHtml
            banner = p.bannerHtml
        }
        var city = Nulls.str()
        var state = Nulls.str()
        if (p.placeVisible()) {
            city = p.city
            state = p.state
        }
        return ProfileView(p.id, p.username, p.displayWithNickname(), p.headline, p.company, p.location, p.avatar, p.banner, p.badge, p.bio, bio, banner, p.skills, p.goals, p.availability, p.portfolio, p.externalLinks, p.openToWork, p.mentor, connections, followers, reputation, postsCount, p.pronouns, p.badges, p.aka, p.avatarFrame, p.nameTheme, p.nameFont, p.nameColor, p.contributorTagColor, p.cardTheme, p.nameplate, p.bannerItem, p.profileEffect, p.statusText, p.statusIcon, p.createdAt, city, state, p.gardenStyle, garden, p.appearance.social)
    }
    // OwnProfileView.from(profile) (+ withBioHtml/withBannerHtml on GET /me).
    static ProfileOwnView ownView(p: ProfileRecord, counts: ProfileCounts?, postsCount: Int?, withHtml: Bool) {
        var connections = 0
        var followers = 0
        var reputation = p.reputation
        var garden = ProfileNulls.garden()
        if (counts != null) {
            connections = counts.connections()
            followers = counts.followers()
            reputation = counts.reputation()
            garden = counts.garden()
        }
        var bio = Nulls.str()
        var banner = Nulls.str()
        if (withHtml) {
            bio = p.bioHtml
            banner = p.bannerHtml
        }
        return ProfileOwnView(p.id, p.username, p.name, p.headline, p.email, p.company, p.location, p.avatar, p.banner, p.badge, p.bio, bio, banner, p.skills, p.goals, p.availability, p.portfolio, p.externalLinks, p.openToWork, p.mentor, connections, followers, reputation, postsCount, p.nickname, p.socialName, p.pronouns, p.badges, p.aka, p.resumeUrl, p.resumeName, p.showRanking, p.nameTheme, p.nameFont, p.nameColor, p.contributorTagColor, p.avatarFrame, p.cardTheme, p.nameplate, p.bannerItem, p.profileEffect, p.statusText, p.statusIcon, p.birthDate, p.city, p.state, p.showCity, p.gardenStyle, garden, p.appearance)
    }
}
