package profile

// Records of the profile domain: the stored profile, the JSON views the front end relies on
// (field names and order are the Java records `UserProfileView` / `OwnProfileView`), request bodies.
// Nullable booleans are `Troolean` (Kof has no `Bool?`, SEM095); the JSON reader keeps null for absent.
// One side of the showcase look (ProfileLook): every field null means "not chosen".
record ProfileLook(String? theme, String? accent, String? font, String? header, Troolean textures, String? borders, Int? decoration)

// Both sides of the account look, stored together in users.profile_appearance (JSON).
record ProfileAppearance(ProfileLook social, ProfileLook professional)

// NameStyleView: theme, font, color and nameplate that travel with the name in every projection.
record ProfileNameStyle(String? theme, String? font, String? color, String? nameplate)

// ReputationGarden: stages 0..3 per component and a health level.
record ProfileGarden(Int trajectory, Int relations, Int contribution, Int tenure, Int health)

// A row of `users` plus its three collections (UserProfile in Java). Immutable: writes go through
// ProfileStore / ProfileSlots with targeted UPDATEs.
record ProfileRecord(String id, String username, String email, String name, String? headline, String? avatarFrame, String? nameTheme, String? nameFont, String? nameColor, String? contributorTagColor, String? cardTheme, String? nameplate, String? bannerItem, String? profileEffect, ProfileAppearance appearance, String? gardenStyle, String? statusText, String? statusIcon, String? company, String? location, String? city, String? state, String? cityKey, Bool showCity, String? avatar, String? banner, String? badge, String? bio, String? bioHtml, String? bannerHtml, String? nickname, String? socialName, String? pronouns, String? aka, String? resumeUrl, String? resumeName, List<String> badges, List<String> skills, List<String> goals, String? availability, String? portfolio, List<String> externalLinks, Bool openToWork, Bool mentor, Bool admin, Int reputation, String createdAt, String updatedAt, Bool showRanking, String? birthDate, String? emailVerifiedAt, String? totpEnabledAt, String? emailOtpEnabledAt, String? federatedSecondFactorAt) {
    // The social name replaces the registered one for everybody.
    String displayName() {
        var s = socialName
        if (s == null) {
            return name
        }
        if (s.trim().length() > 0) {
            return s
        }
        return name
    }
    // Display name with the nickname in parentheses.
    String displayWithNickname() {
        var base = this.displayName()
        var n = nickname
        if (n == null) {
            return base
        }
        if (n.trim().length() == 0) {
            return base
        }
        return base + " (" + n + ")"
    }
    // The badge list, falling back to the old single column.
    List<String> allBadges() {
        if (badges.size() > 0) {
            return badges
        }
        var b = badge
        if (b == null) {
            return listOf<String>()
        }
        if (b.trim().length() == 0) {
            return listOf<String>()
        }
        var one = listOf<String>()
        one.add(b)
        return one
    }
    // Verified account: confirmed e-mail or any second factor.
    Bool identityVerified() = emailVerifiedAt != null || totpEnabledAt != null || emailOtpEnabledAt != null || federatedSecondFactorAt != null
    // City and state only when the person chose to show them.
    Bool placeVisible() = showCity && city != null && state != null
}

// Counters computed on read (ReputationService.Counts).
record ProfileCounts(Int connections, Int followers, Int reputation, Bool identityVerified, ProfileGarden garden)

// UserProfileView: public projection, never carries the e-mail.
record ProfileView(String id, String username, String name, String? headline, String? company, String? location, String? avatar, String? banner, String? badge, String? bio, String? bioHtml, String? bannerHtml, List<String> skills, List<String> goals, String? availability, String? portfolio, List<String> externalLinks, Bool openToWork, Bool isMentor, Int connectionsCount, Int followersCount, Int reputation, Int? postsCount, String? pronouns, List<String> badges, String? aka, String? avatarFrame, String? nameTheme, String? nameFont, String? nameColor, String? contributorTagColor, String? cardTheme, String? nameplate, String? bannerItem, String? profileEffect, String? statusText, String? statusIcon, String? joinedAt, String? city, String? state, String? gardenStyle, ProfileGarden? garden, ProfileLook profileLook)

// OwnProfileView: the account's own profile (includes the e-mail), only for /me endpoints.
record ProfileOwnView(String id, String username, String name, String? headline, String email, String? company, String? location, String? avatar, String? banner, String? badge, String? bio, String? bioHtml, String? bannerHtml, List<String> skills, List<String> goals, String? availability, String? portfolio, List<String> externalLinks, Bool openToWork, Bool isMentor, Int connectionsCount, Int followersCount, Int reputation, Int? postsCount, String? nickname, String? socialName, String? pronouns, List<String> badges, String? aka, String? resumeUrl, String? resumeName, Bool showRanking, String? nameTheme, String? nameFont, String? nameColor, String? contributorTagColor, String? avatarFrame, String? cardTheme, String? nameplate, String? bannerItem, String? profileEffect, String? statusText, String? statusIcon, String? birthDate, String? city, String? state, Bool showCity, String? gardenStyle, ProfileGarden? garden, ProfileAppearance profileAppearance)

// PublicNetworkUserView of /users/{username}/connections and /followers.
record ProfilePublicNetworkUser(String id, String username, String name, String? headline, String? avatar, String? avatarFrame, ProfileNameStyle? nameStyle)

record ProfileAgeState(String state, Bool minor, Bool declared, Bool supervised)

record ProfileExperienceView(String id, String title, String company, String? location, String? description, Bool currentlyHere, String startDate, String? endDate)

record ProfileEducationView(String id, String school, String degree, String? field, String? description, Bool currentlyHere, String startDate, String? endDate)

record ProfileCertificationView(String id, String name, String issuer, String? description, String issueDate, String? expirationDate, String? credentialUrl)

record ProfileRecommendationView(String id, String recommenderId, String recommendedId, String? comment, String createdAt)

record ProfileAdminView(String id, String username, String name)

// Request bodies (Java request records, same property names).
record ProfileUpdateBody(String? name, String? headline, String? company, String? location, String? avatar, String? banner, String? badge, String? bio, String? bioHtml, String? bannerHtml, List<String>? skills, List<String>? goals, String? availability, String? portfolio, List<String>? externalLinks, Troolean openToWork, Troolean isMentor, String? username, String? aka, String? resumeUrl, String? resumeName, String? birthDate, String? city, String? state, Troolean showCity)

record ProfileBirthDateBody(String? birthDate)

record ProfileRankingBody(Troolean show)

record ProfileBadgesBody(List<String>? badges)

record ProfileIdentityBody(String? nickname, String? socialName, String? pronouns)

record ProfileExperienceBody(String? title, String? company, String? location, String? description, String? startDate, String? endDate)

record ProfileEducationBody(String? school, String? degree, String? field, String? description, String? startDate, String? endDate)

record ProfileCertificationBody(String? name, String? issuer, String? description, String? issueDate, String? expirationDate, String? credentialUrl)

record ProfileRecommendBody(String? comment)

record ProfilePromoteBody(String? username)

record ProfileLookBody(String? theme, String? accent, String? font, String? header, Troolean textures, String? borders, Int? decoration)

record ProfileAppearanceBody(ProfileLookBody? social, ProfileLookBody? professional)

// POST/PUT answers {"id","status"} (StatusResponse).
record ProfileStatusView(String id, String status)
