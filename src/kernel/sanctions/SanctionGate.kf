package kernel.sanctions

import kernel.error.*

// Entry gate of the moderation sanction enforcement. Feed, groups, messaging and blog need the same
// answer and the same code/message so the front handles the case alike everywhere.
//
// Why it exists: the restriction is a human decision ("does not publish nor comment"). On 2026-10-21 it
// was only checked on feed posts and comments: the same restricted account still posted in groups,
// commented in groups and sent private messages (the channel moderation cannot see).
//
//   gate.requireNotRestricted(userId)      // 403 ACCOUNT_RESTRICTED in every write path
class SanctionGate {
    SanctionGateReader reader
    public constructor(reader: SanctionGateReader) {
        this.reader = reader
    }
    static String code() = "ACCOUNT_RESTRICTED"
    // A write action needs an account without an active restriction: post, comment, group post, group
    // comment and private message. A banned account never gets here (the session is revoked at the ban);
    // the restricted one stays connected, which is why the gate exists.
    requireNotRestricted(userId: String) {
        if (reader.restricted(userId)) {
            throw Errors.api(403, SanctionGate.code(), "Sua conta está restrita por moderação. Você pode recorrer na página Penalidades.")
        }
    }
}
