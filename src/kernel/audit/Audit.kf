package kernel.audit

import kernel.db.*
import kernel.id.*
import kernel.time.*

// Append-only audit trail on `audit_logs` (the Java AuditLogRepository). Joins the caller's
// transaction, so the entry exists only when the audited change commits.
//
//   audit.write(adminId, "USER_BANNED", targetUserId, "{\"reason\":\"spam\"}")
class Audit {
    Db store
    public constructor(store: Db) {
        this.store = store
    }
    // actorId/action/targetId are required columns; metadata (JSON text) may be null.
    write(actorId: String, action: String, targetId: String, metadata: String?) {
        store.execute("insert into audit_logs (id, actor_id, action, target_id, metadata, created_at) values (?, ?, ?, ?, ?, ?)", DbParams().bindStr(Ids.uuid()).bindStr(actorId).bindStr(action).bindStr(targetId).bindStrOrNull(metadata).bindInstant(Time.nowIso()))
    }
}
