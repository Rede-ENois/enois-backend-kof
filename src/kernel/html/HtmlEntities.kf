package kernel.html

// Spring's HtmlUtils.htmlUnescape for the text of outside feeds ("hims &#038; hers"): numeric references
// (decimal and hex) and the named entities feeds actually send. An unknown reference is left as written.
class HtmlEntities {
    static String named(name: String) {
        if (name == "amp") { return "&" }
        if (name == "lt") { return "<" }
        if (name == "gt") { return ">" }
        if (name == "quot") { return "\"" }
        if (name == "apos") { return "'" }
        if (name == "nbsp") { return " " }
        if (name == "ndash") { return "–" }
        if (name == "mdash") { return "—" }
        if (name == "hellip") { return "…" }
        if (name == "eacute") { return "é" }
        if (name == "aacute") { return "á" }
        if (name == "iacute") { return "í" }
        if (name == "oacute") { return "ó" }
        if (name == "uacute") { return "ú" }
        if (name == "ccedil") { return "ç" }
        if (name == "atilde") { return "ã" }
        if (name == "otilde") { return "õ" }
        if (name == "agrave") { return "à" }
        if (name == "ecirc") { return "ê" }
        if (name == "ocirc") { return "ô" }
        if (name == "euro") { return "€" }
        if (name == "copy") { return "©" }
        if (name == "reg") { return "®" }
        if (name == "trade") { return "™" }
        return ""
    }
    static String numeric(body: String) {
        var code = 0
        try {
            if (body.startsWith("x") || body.startsWith("X")) {
                code = Integer.parseInt(body.substring(1), 16)
            }
            else {
                code = Integer.parseInt(body)
            }
        } catch (String e) {
            return ""
        }
        if (code <= 0 || code > 65535) {
            return ""
        }
        return Character.toString(code)
    }
    static String unescape(text: String) {
        if (!text.contains("&")) {
            return text
        }
        var out = ""
        var i = 0
        while (i < text.length()) {
            var c = text.substring(i, i + 1)
            if (c != "&") {
                out = out + c
                i = i + 1
                continue
            }
            var semi = text.indexOf(";", i)
            if (semi < 0 || semi - i > 10) {
                out = out + c
                i = i + 1
                continue
            }
            var body = text.substring(i + 1, semi)
            var replaced = ""
            if (body.startsWith("#")) {
                replaced = HtmlEntities.numeric(body.substring(1))
            }
            else {
                replaced = HtmlEntities.named(body)
            }
            if (replaced.length() == 0) {
                out = out + c
                i = i + 1
                continue
            }
            out = out + replaced
            i = semi + 1
        }
        return out
    }
}
