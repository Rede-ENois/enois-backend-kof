package kernel.db

import kernel.log.*

// Callbacks registered with Db.afterCommit while a transaction is open.
class DbHooks {
    List<DbHook> items = listOf<DbHook>()
    add(callback: () -> void) {
        items.add(DbHook(callback))
    }
    // Runs every callback; a failure is logged, never rethrown (the transaction already committed).
    run(log: Log) {
        for (var hook in items) {
            try {
                var f = hook.body
                f()
            } catch (String e) {
                log.error("after_commit_failed message=" + e)
            }
        }
    }
}
