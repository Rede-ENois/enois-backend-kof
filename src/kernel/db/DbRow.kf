package kernel.db

import java.util.HashMap
import kernel.time.*

// One result row, snapshotted as text per column (labels lower-cased) so it outlives the
// connection. Read it with the typed getters; `...OrNull` variants return null for SQL NULL.
class DbRow {
    Map<String,String> cols = new HashMap<String, String>()
    put(label: String, value: String?) {
        if (value != null) {
            cols.put(label.toLowerCase(), value)
        }
    }
    Bool has(col: String) = cols.containsKey(col.toLowerCase())
    Bool isNull(col: String) = !cols.containsKey(col.toLowerCase())
    String? getStrOrNull(col: String) = cols.get(col.toLowerCase())
    String getStr(col: String) {
        var v = cols.get(col.toLowerCase())
        if (v == null) {
            throw "DB_ROW: column " + col + " is null or missing"
        }
        return v
    }
    Long getLong(col: String) = getStr(col).trim().toLong()
    Long? getLongOrNull(col: String) {
        var v = cols.get(col.toLowerCase())
        if (v == null) {
            return null
        }
        return v.trim().toLong()
    }
    Int getInt(col: String) = getStr(col).trim().toInt()
    Int? getIntOrNull(col: String) {
        var v = cols.get(col.toLowerCase())
        if (v == null) {
            return null
        }
        return v.trim().toInt()
    }
    Double getDouble(col: String) = getStr(col).trim().toDouble()
    Bool getBool(col: String) = DbRow.truthy(getStr(col))
    // TIMESTAMP column as an ISO-8601 UTC instant.
    String getInstant(col: String) = Time.fromDbTimestamp(getStr(col))
    String? getInstantOrNull(col: String) {
        var v = cols.get(col.toLowerCase())
        if (v == null) {
            return null
        }
        return Time.fromDbTimestamp(v)
    }
    // DATE column as `yyyy-MM-dd`.
    String getDate(col: String) = getStr(col).trim().substring(0, 10)
    String? getDateOrNull(col: String) {
        var v = cols.get(col.toLowerCase())
        if (v == null) {
            return null
        }
        return v.trim().substring(0, 10)
    }
    static Bool truthy(raw: String) {
        var t = raw.trim().toLowerCase()
        return t == "true" || t == "1" || t == "t"
    }
}
