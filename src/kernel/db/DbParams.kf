package kernel.db

import java.util.ArrayList
import java.time.Instant
import java.time.LocalDate
import java.time.LocalDateTime
import java.time.ZoneOffset

// Positional bind parameters, unlimited, typed. Fluent: DbParams().bindLong(1L).bindStr("x").
// Instants are ISO-8601 UTC strings and are stored as the UTC wall-clock TIMESTAMP, the way
// the Java app stores java.time.Instant (serverTimezone=UTC). Dates are `yyyy-MM-dd`.
class DbParams {
    List<Object> items = new ArrayList<Object>()
    // Parallel to items: 0 = a real value, otherwise the java.sql.Types code of an SQL NULL.
    List<Int> nullTypes = new ArrayList<Int>()
    addValue(v: Object) {
        items.add(v)
        nullTypes.add(0)
    }
    addNull(sqlType: Int) {
        items.add("" as Object)
        nullTypes.add(sqlType)
    }
    DbParams bindLong(v: Long) {
        addValue(v as Object)
        return this
    }
    DbParams bindInt(v: Int) {
        addValue(v as Object)
        return this
    }
    DbParams bindStr(v: String) {
        addValue(v as Object)
        return this
    }
    DbParams bindBool(v: Bool) {
        addValue(v as Object)
        return this
    }
    DbParams bindDouble(v: Double) {
        addValue(v as Object)
        return this
    }
    // ISO instant (`2026-11-04T16:05:00Z`) bound as a UTC TIMESTAMP.
    DbParams bindInstant(iso: String) {
        addValue(LocalDateTime.ofInstant(Instant.parse(iso), ZoneOffset.UTC) as Object)
        return this
    }
    DbParams bindInstantMillis(millis: Long) {
        addValue(LocalDateTime.ofInstant(Instant.ofEpochMilli(millis), ZoneOffset.UTC) as Object)
        return this
    }
    // `yyyy-MM-dd` bound as a DATE.
    DbParams bindDate(iso: String) {
        addValue(LocalDate.parse(iso) as Object)
        return this
    }
    DbParams bindLongOrNull(v: Long?) {
        if (v == null) {
            addNull(-5)
            return this
        }
        addValue(v as Object)
        return this
    }
    DbParams bindIntOrNull(v: Int?) {
        if (v == null) {
            addNull(4)
            return this
        }
        addValue(v as Object)
        return this
    }
    DbParams bindStrOrNull(v: String?) {
        if (v == null) {
            addNull(12)
            return this
        }
        addValue(v as Object)
        return this
    }
    // Nullable Bool has no Kof type (Bool? is rejected): bind `true`/`false` with bindBool and
    // an SQL NULL with bindNullBool.
    DbParams bindNullBool() {
        addNull(16)
        return this
    }
    DbParams bindInstantOrNull(iso: String?) {
        if (iso == null) {
            addNull(93)
            return this
        }
        addValue(LocalDateTime.ofInstant(Instant.parse(iso), ZoneOffset.UTC) as Object)
        return this
    }
    DbParams bindDateOrNull(iso: String?) {
        if (iso == null) {
            addNull(91)
            return this
        }
        addValue(LocalDate.parse(iso) as Object)
        return this
    }
    Int size() = items.size()
}
