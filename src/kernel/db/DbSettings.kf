package kernel.db

import kernel.config.*

// Connection settings, same env names as the Java app (application-qa.properties).
// DB_URL wins; else DB_HOST (+DB_PORT, DB_NAME) builds the MariaDB URL; else in-memory H2 in
// MySQL mode, exactly the URL of the Java dev profile and test suite.
class DbSettings {
    static String url(cfg: Config) {
        var explicit = cfg.lookup("DB_URL")
        if (explicit != null) {
            return explicit
        }
        var host = cfg.lookup("DB_HOST")
        if (host == null) {
            return "jdbc:h2:mem:rede;MODE=MySQL;DB_CLOSE_DELAY=-1"
        }
        var port = cfg.getInt("DB_PORT", 3306)
        var name = cfg.getStr("DB_NAME", "socialcoiso")
        return "jdbc:mariadb://" + host + ":" + port + "/" + name + "?sslMode=DISABLED&serverTimezone=UTC"
    }
    static Bool isH2(url: String) = url.startsWith("jdbc:h2:")
    static String user(cfg: Config) {
        if (DbSettings.isH2(DbSettings.url(cfg))) {
            return cfg.getStr("DB_USER", "sa")
        }
        return cfg.getStr("DB_USER", "socialcoiso")
    }
    static String password(cfg: Config) {
        if (DbSettings.isH2(DbSettings.url(cfg))) {
            return cfg.getStr("DB_PASSWORD", "")
        }
        return cfg.required("DB_PASSWORD")
    }
    static Int poolMax(cfg: Config) = cfg.getInt("DB_POOL_MAX", 30)
    static Int poolMinIdle(cfg: Config) = cfg.getInt("DB_POOL_MIN_IDLE", 10)
}
