package kernel.bytes

import java.io.ByteArrayOutputStream

// Growable byte buffer for the binary formats (media sanitising): the only way domain code builds a
// `Byte[]`, because Java interop stays in the kernel.
class ByteSink {
    ByteArrayOutputStream out = new ByteArrayOutputStream()
    public constructor() {}
    // Appends data[offset, offset + length).
    add(data: Byte[], offset: Int, length: Int) {
        out.write(data, offset, length)
    }
    addAll(data: Byte[]) {
        out.write(data, 0, data.length)
    }
    // Appends the low 8 bits of `value`.
    addByte(value: Int) {
        out.write(value & 255)
    }
    // Appends the ASCII bytes of `text`.
    addAscii(text: String) {
        var raw = text.getBytes()
        out.write(raw, 0, raw.length)
    }
    // Little-endian 32-bit integer.
    addLittleInt(value: Int) {
        addByte(value)
        addByte(value >> 8)
        addByte(value >> 16)
        addByte(value >> 24)
    }
    Int size() = out.size()
    Byte[] toBytes() = out.toByteArray()
}

// Reads of a `Byte[]` with the unsigned and multi-byte views the formats need.
class Bytes {
    // Unsigned value of data[i].
    static Int at(data: Byte[], i: Int) = (data[i] as Int) & 255
    static Int bigShort(data: Byte[], offset: Int) = (Bytes.at(data, offset) << 8) | Bytes.at(data, offset + 1)
    static Int littleShort(data: Byte[], offset: Int) = Bytes.at(data, offset) | (Bytes.at(data, offset + 1) << 8)
    static Int bigInt(data: Byte[], offset: Int) = (Bytes.at(data, offset) << 24) | (Bytes.at(data, offset + 1) << 16) | (Bytes.at(data, offset + 2) << 8) | Bytes.at(data, offset + 3)
    static Int littleInt(data: Byte[], offset: Int) = Bytes.at(data, offset) | (Bytes.at(data, offset + 1) << 8) | (Bytes.at(data, offset + 2) << 16) | (Bytes.at(data, offset + 3) << 24)
    // ASCII text of data[offset, offset + length), "" when it would run past the end.
    static String ascii(data: Byte[], offset: Int, length: Int) {
        if (offset < 0 || length < 0 || offset + length > data.length) {
            return ""
        }
        var sb = ""
        var i = 0
        while (i < length) {
            sb = sb + (Bytes.at(data, offset + i) as Char)
            i = i + 1
        }
        return sb
    }
    // Hex text <-> bytes (test fixtures and assertions on binary content).
    static String toHex(data: Byte[]) {
        var out = ""
        var i = 0
        while (i < data.length) {
            var h = Integer.toHexString(Bytes.at(data, i))
            if (h.length() < 2) {
                h = "0" + h
            }
            out = out + h
            i = i + 1
        }
        return out
    }
    static Byte[] hex(text: String) {
        var sink = ByteSink()
        var i = 0
        while (i + 1 < text.length()) {
            sink.addByte(Integer.parseInt(text.substring(i, i + 2), 16))
            i = i + 2
        }
        return sink.toBytes()
    }
}
