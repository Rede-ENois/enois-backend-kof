package kernel.url

import java.net.URLDecoder
import java.net.URLEncoder

// application/x-www-form-urlencoded encoding and decoding (UTF-8): query values of links and OAuth redirects.
// The one-argument forms on purpose: the two-argument overloads resolve to (String, Charset) or (String, String)
// depending on the run (KOF_GAPS G127/G183, G106); the default charset is UTF-8 since JDK 18.
class UrlCodec {
    static String encode(value: String) = URLEncoder.encode(value)
    static String decode(value: String) = URLDecoder.decode(value)
}
