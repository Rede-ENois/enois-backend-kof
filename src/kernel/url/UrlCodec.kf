package kernel.url

import java.net.URLDecoder
import java.net.URLEncoder
import java.nio.charset.Charset

// application/x-www-form-urlencoded encoding (java.net.URLEncoder, UTF-8): query values of links and
// OAuth redirects. The one place identity needs Java's encoder.
class UrlCodec {
    static String encode(value: String) = URLEncoder.encode(value, "UTF-8")
    static String decode(value: String) = URLDecoder.decode(value, Charset.forName("UTF-8"))
}
