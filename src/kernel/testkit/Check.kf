package kernel.testkit

// Assertions with a readable message (the language `assert` only takes literal messages).
class Check {
    static eqStr(label: String, expected: String, actual: String) {
        if (expected != actual) {
            throw "FAIL " + label + ": expected [" + expected + "] but got [" + actual + "]"
        }
    }
    static eqInt(label: String, expected: Int, actual: Int) {
        if (expected != actual) {
            throw "FAIL " + label + ": expected " + expected + " but got " + actual
        }
    }
    static isTrue(label: String, value: Bool) {
        if (!value) {
            throw "FAIL " + label
        }
    }
    // Status code of a response, with the body in the failure message.
    static status(res: TestResponse, expected: Int) {
        if (res.status != expected) {
            throw "FAIL status: expected " + expected + " but got " + res.status + " body=" + res.body
        }
    }
    // JSON field equals (unquoted string form).
    static jsonEq(res: TestResponse, path: String, expected: String) {
        var actual = res.jsonStr(path)
        if (actual == null) {
            throw "FAIL json " + path + ": expected [" + expected + "] but it is absent or null; body=" + res.body
        }
        if (actual != expected) {
            throw "FAIL json " + path + ": expected [" + expected + "] but got [" + actual + "]"
        }
    }
    // ApiError contract: status + {"code","message","timestamp"}.
    static apiError(res: TestResponse, status: Int, code: String) {
        Check.status(res, status)
        Check.jsonEq(res, "code", code)
        Check.isTrue("error body has message", res.jsonHas("message"))
        Check.isTrue("error body has timestamp", res.jsonHas("timestamp"))
    }
    // The error body of a FILTER answer (origin gate, CSRF, limiters): status + code + message, and
    // no timestamp (the Java filters wrote the JSON by hand).
    static filterError(res: TestResponse, status: Int, code: String) {
        Check.status(res, status)
        Check.jsonEq(res, "code", code)
        Check.isTrue("filter body has message", res.jsonHas("message"))
        Check.isTrue("filter body has no timestamp", !res.jsonHas("timestamp"))
    }
}
