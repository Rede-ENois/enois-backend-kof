package kernel.testkit

import kernel.files.*
import org.apache.pdfbox.Loader
import org.apache.pdfbox.pdmodel.PDDocument
import org.apache.pdfbox.pdmodel.PDPage

// Small generated PDFs for the suites that clean or read them (the Java tests build theirs with PDFBox too).
class PdfMetadataSamples {
    // A one-page PDF whose document information carries an author and a title.
    static Byte[] withAuthor(author: String, title: String) {
        var document = new PDDocument()
        document.addPage(new PDPage())
        var info = document.getDocumentInformation()
        info.setAuthor(author)
        info.setTitle(title)
        var path = UploadFiles.create("pdf-fixture-", ".pdf")
        document.save(path)
        document.close()
        var bytes = UploadFiles.readBytes(path)
        UploadFiles.discard(path)
        return bytes
    }
    // The author in the document information, "" when there is none.
    static String authorOf(data: Byte[]) {
        var document = Loader.loadPDF(data)
        var author = document.getDocumentInformation().getAuthor()
        document.close()
        if (author == null) {
            return ""
        }
        return "" + author
    }
    static Int pagesOf(data: Byte[]) {
        var document = Loader.loadPDF(data)
        var pages = document.getNumberOfPages()
        document.close()
        return pages
    }
}
