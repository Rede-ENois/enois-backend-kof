package kernel.testkit

// Minimal JSON reader for HTTP assertions. Paths use dots: `data.items.0.id`.
// `raw` returns the JSON text of the value (strings keep their quotes), `str` the unquoted string.
record JsonStrBox(String v)

class JsonPath {
    static Int skipWs(s: String, i: Int) {
        var k = i
        while (k < s.length() && (s.substring(k, k + 1) == " " || s.substring(k, k + 1) == "\n" || s.substring(k, k + 1) == "\t" || s.substring(k, k + 1) == "\r")) {
            k = k + 1
        }
        return k
    }
    // Index just past the value starting at i (i points at its first character).
    static Int valueEnd(s: String, i: Int) {
        var c = s.substring(i, i + 1)
        if (c == "\"") {
            var k = i + 1
            while (k < s.length()) {
                var d = s.substring(k, k + 1)
                if (d == "\\") {
                    k = k + 2
                }
                else 
                    if (d == "\"") {
                        return k + 1
                    }
                    else {
                        k = k + 1
                    }
            }
            return s.length()
        }
        if (c == "{" || c == "[") {
            var depth = 0
            var k = i
            while (k < s.length()) {
                var d = s.substring(k, k + 1)
                if (d == "\"") {
                    k = JsonPath.valueEnd(s, k)
                }
                else {
                    if (d == "{" || d == "[") {
                        depth = depth + 1
                    }
                    else 
                        if (d == "}" || d == "]") {
                            depth = depth - 1
                        }
                    k = k + 1
                    if (depth == 0) {
                        return k
                    }
                }
            }
            return s.length()
        }
        var k = i
        while (k < s.length()) {
            var d = s.substring(k, k + 1)
            if (d == "," || d == "}" || d == "]" || d == " " || d == "\n") {
                return k
            }
            k = k + 1
        }
        return k
    }
    static String unquote(raw: String) = json.decode<JsonStrBox>("{\"v\":" + raw + "}").v()
    // JSON text of the value at `path`, or null when absent. An empty path is the whole document.
    static String? raw(doc: String, path: String) {
        var cur = doc.trim()
        if (path.length() == 0) {
            return cur
        }
        for (var seg in path.split("\\.")) {
            var next = JsonPath.child(cur, seg)
            if (next == null) {
                return null
            }
            cur = next
        }
        return cur
    }
    static String? child(node: String, seg: String) {
        var start = node.substring(0, 1)
        var pos = 1
        var index = 0
        while (true) {
            pos = JsonPath.skipWs(node, pos)
            if (pos >= node.length()) {
                return null
            }
            var c = node.substring(pos, pos + 1)
            if (c == "}" || c == "]") {
                return null
            }
            if (c == ",") {
                pos = pos + 1
                continue
            }
            if (start == "{") {
                var kend = JsonPath.valueEnd(node, pos)
                var key = JsonPath.unquote(node.substring(pos, kend))
                pos = JsonPath.skipWs(node, kend)
                pos = JsonPath.skipWs(node, pos + 1)
                var vend = JsonPath.valueEnd(node, pos)
                if (key == seg) {
                    return node.substring(pos, vend)
                }
                pos = vend
            }
            else {
                var vend = JsonPath.valueEnd(node, pos)
                if ("" + index == seg) {
                    return node.substring(pos, vend)
                }
                index = index + 1
                pos = vend
            }
        }
        return null
    }
    static Bool has(doc: String, path: String) = JsonPath.raw(doc, path) != null
    static Bool isNull(doc: String, path: String) {
        var r = JsonPath.raw(doc, path)
        return r != null && r == "null"
    }
    // Unquoted string value (numbers/booleans come back as their text); null when absent or JSON null.
    static String? str(doc: String, path: String) {
        var r = JsonPath.raw(doc, path)
        if (r == null) {
            return null
        }
        if (r == "null") {
            return null
        }
        if (r.startsWith("\"")) {
            return JsonPath.unquote(r)
        }
        return r
    }
    // Number of elements of the array (or members of the object) at `path`.
    static Int size(doc: String, path: String) {
        var r = JsonPath.raw(doc, path)
        if (r == null) {
            return -1
        }
        var pos = 1
        var n = 0
        while (true) {
            pos = JsonPath.skipWs(r, pos)
            if (pos >= r.length()) {
                return n
            }
            var c = r.substring(pos, pos + 1)
            if (c == "}" || c == "]") {
                return n
            }
            if (c == ",") {
                pos = pos + 1
                continue
            }
            var isObject = r.substring(0, 1) == "{"
            var vend = JsonPath.valueEnd(r, pos)
            if (isObject) {
                pos = JsonPath.skipWs(r, vend)
                pos = JsonPath.skipWs(r, pos + 1)
                vend = JsonPath.valueEnd(r, pos)
            }
            n = n + 1
            pos = vend
        }
        return n
    }
}
