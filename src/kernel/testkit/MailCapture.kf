package kernel.testkit

import kernel.mail.*

// A transport that keeps every message in memory (tests never touch the network). `failWith` makes the next
// sends fail with that cause, like a dead SMTP server; an empty string sends normally.
class MailCapture extends MailTransport {
    List<MailMessage> messages = listOf<MailMessage>()
    String failWith = ""
    public constructor() {}
    send(message: MailMessage) {
        if (failWith.length() > 0) {
            throw failWith
        }
        messages.add(message)
    }
    Int count() = messages.size()
    MailMessage last() = messages.get(messages.size() - 1)
}
