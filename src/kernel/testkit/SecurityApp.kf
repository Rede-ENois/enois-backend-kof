package kernel.testkit

import java.util.HashMap
import kernel.*
import kernel.http.*
import kernel.security.*

// A booted platform with the whole request pipeline (Security.install) and the routes of `probes`.
// Origin enforcement is OFF unless a test turns it on (REDE_ORIGINS_ENFORCE=true): the test client is
// not a browser, exactly like MockMvc in the Java suite.
class SecurityApp {
    static TestApp boot(name: String, overrides: Map<String,String>, probes: (HttpServer) -> void) {
        var merged = new HashMap<String, String>()
        merged.put("REDE_ORIGINS_ENFORCE", "false")
        for (var k in overrides.keys()) {
            merged.put(k, overrides.getOrDefault(k, ""))
        }
        SecurityClock.reset()
        return TestApp.bootWith(name, merged, (p: Platform) -> SecurityApp.wire(p, probes))
    }
    static wire(p: Platform, probes: (HttpServer) -> void) {
        Security.install(p, SecurityHooks.defaults(p.db))
        probes(p.server)
    }
}
