package kernel.testkit

import kernel.files.*

// A minimal one-page PDF written by hand for the import tests (no PDF library on the writing side: the reading side
// is PDFBox, which rebuilds the cross-reference table of a hand-made file). One text line per entry, ASCII only.
class PdfFixtures {
    // Writes the PDF to a temp file; its path. No lines: a valid page with no text (what a scanned PDF looks like).
    static String write(lines: List<String>) {
        var stream = "BT /F1 11 Tf 50 750 Td "
        for (var line in lines) {
            var safe = line.replace("\\", "\\\\").replace("(", "\\(").replace(")", "\\)")
            stream = stream + "(" + safe + ") Tj 0 -15 Td "
        }
        stream = stream + "ET"
        var pdf = "%PDF-1.4\n"
        pdf = pdf + "1 0 obj<</Type/Catalog/Pages 2 0 R>>endobj\n"
        pdf = pdf + "2 0 obj<</Type/Pages/Kids[3 0 R]/Count 1>>endobj\n"
        pdf = pdf + "3 0 obj<</Type/Page/Parent 2 0 R/MediaBox[0 0 612 792]/Contents 4 0 R/Resources<</Font<</F1 5 0 R>>>>>>endobj\n"
        pdf = pdf + "4 0 obj<</Length " + stream.length() + ">>stream\n" + stream + "\nendstream endobj\n"
        pdf = pdf + "5 0 obj<</Type/Font/Subtype/Type1/BaseFont/Helvetica/Encoding/WinAnsiEncoding>>endobj\n"
        pdf = pdf + "trailer<</Root 1 0 R/Size 6>>\n%%EOF\n"
        return UploadFiles.writeText(pdf)
    }
}
