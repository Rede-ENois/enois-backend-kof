package kernel.testkit

import java.io.File
import java.lang.System

// Counts the temp files a component left in java.io.tmpdir (the lane suites assert that every path cleans up).
class TempProbe {
    static Int count(prefix: String) {
        var dirName = "" + System.getProperty("java.io.tmpdir")
        var dir = new File(dirName)
        var names = dir.list()
        if (names == null) {
            return 0
        }
        var total = 0
        for (var name in names) {
            if (name.startsWith(prefix)) {
                total = total + 1
            }
        }
        return total
    }
}
