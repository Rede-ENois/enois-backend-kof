package kernel.outbox

// A domain's reaction to an outbox event of one type: extend it in the owning domain, override
// `handle`, register an instance with Outbox.register(eventType, handler) at boot. It is a base
// class, not an interface, because `implements` of a type from another package does not compile
// (KOF_GAPS G28).
//
//   class NotificationOutboxHandler extends OutboxEventHandler {
//       handle(eventType: String, aggregateId: String, payload: String) { ... }
//   }
class OutboxEventHandler {
    public constructor() {}
    handle(eventType: String, aggregateId: String, payload: String);
}
