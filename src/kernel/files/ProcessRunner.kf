package kernel.files

import java.io.File
import java.io.IOException
import java.lang.Process
import java.lang.ProcessBuilder
import java.util.concurrent.TimeUnit

// Runs an external program (ffmpeg) with a timeout. Output is discarded: nobody reads it, and a verbose
// child would fill the pipe and hang until the timeout.
class ProcessRunner {
    // Exit code, or -1 when the program is missing, cannot start, or does not finish within
    // `timeoutSeconds` (it is then killed).
    static Int run(command: List<String>, timeoutSeconds: Long) {
        // The varargs constructor takes an explicit array (KOF_GAPS G2); the List overload is picked wrongly.
        var args = new String[command.size()]
        var i = 0
        for (var part in command) {
            args[i] = part
            i = i + 1
        }
        try {
            var builder = new ProcessBuilder(args)
            builder.redirectErrorStream(true)
            builder.redirectOutput(new File("/dev/null"))
            var process = builder.start()
            var finished = process.waitFor(timeoutSeconds, TimeUnit.SECONDS)
            if (!finished) {
                process.destroyForcibly()
                return -1
            }
            return process.exitValue()
        } catch (IOException e) {
            return -1
        } catch (String e) {
            return -1
        }
    }
}
