package kernel.files

import java.io.File
import java.io.IOException
import org.apache.pdfbox.Loader
import org.apache.pdfbox.pdmodel.PDDocument
import org.apache.pdfbox.text.PDFTextStripper

// What reading a PDF gave: its text, or why it could not be read.
class PdfRead {
    // "OK", "ENCRYPTED", "TOO_MANY_PAGES" or "INVALID"
    String status = "INVALID"
    String text = ""
    public constructor() {}
}

// The one place that imports PDFBox (the Java ResumeImportService.textOfPdf): the text of a resume PDF, read only,
// sorted by position. A page cap keeps a decompression bomb out: a real resume has 1 to 3 pages.
class PdfText {
    static PdfRead extract(path: String, maxPages: Int) {
        var result = PdfRead()
        try {
            var document = Loader.loadPDF(UploadFiles.readBytes(path))
            PdfText.fill(document, maxPages, result)
            document.close()
        } catch (IOException e) {
            result.status = "INVALID"
        } catch (String e) {
            result.status = "INVALID"
        }
        return result
    }
    static fill(document: PDDocument, maxPages: Int, result: PdfRead) {
        if (document.isEncrypted()) {
            result.status = "ENCRYPTED"
            return
        }
        if (document.getNumberOfPages() > maxPages) {
            result.status = "TOO_MANY_PAGES"
            return
        }
        var stripper = new PDFTextStripper()
        stripper.setSortByPosition(true)
        var text = stripper.getText(document)
        result.text = text
        result.status = "OK"
    }
}
