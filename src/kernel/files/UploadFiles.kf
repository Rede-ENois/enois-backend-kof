package kernel.files

import java.io.ByteArrayOutputStream
import java.io.File
import java.io.FileInputStream
import java.io.FileOutputStream
import java.io.IOException

// The uploaded file as the importers see it: a temp file on disk (the binary lane hands the body over as a path),
// read in bounded pieces. Everything that touches java.io for the import domains lives here.
class UploadFiles {
    // A new empty temp file; its path.
    static String create(prefix: String, suffix: String) {
        var file = File.createTempFile(prefix, suffix)
        return file.getAbsolutePath()
    }
    static Long size(path: String) = new File(path).length()
    static Bool exists(path: String) = new File(path).exists()
    // Deletes the file; a file that is already gone is fine.
    static discard(path: String) {
        var ignored = new File(path).delete()
    }
    // The first `count` bytes as ISO-8859-1 text (the magic number of a format: "PK", "%PDF-").
    static String head(path: String, count: Int) {
        var out = new ByteArrayOutputStream()
        try {
            var input = new FileInputStream(path)
            var buffer = new Byte[count]
            var read = input.read(buffer, 0, count)
            if (read > 0) {
                out.write(buffer, 0, read)
            }
            input.close()
        } catch (IOException e) {
            return ""
        }
        return out.toString("ISO-8859-1")
    }
    // The whole file as UTF-8 text, or "" when it cannot be read. The caller checks `size` first.
    static String readText(path: String) {
        var out = new ByteArrayOutputStream()
        try {
            var input = new FileInputStream(path)
            var buffer = new Byte[8192]
            var read = input.read(buffer, 0, 8192)
            while (read != -1) {
                out.write(buffer, 0, read)
                read = input.read(buffer, 0, 8192)
            }
            input.close()
        } catch (IOException e) {
            return ""
        }
        return out.toString("UTF-8")
    }
    // The whole file as bytes (PDFBox takes a byte array: Loader.loadPDF(File) resolves to the wrong overload).
    static Byte[] readBytes(path: String) {
        var input = new FileInputStream(path)
        var bytes = input.readAllBytes()
        input.close()
        return bytes
    }
    // Writes UTF-8 text to a new temp file (tests and the text importers); its path.
    static String writeText(text: String) {
        var path = UploadFiles.create("upload-", ".tmp")
        var out = new FileOutputStream(path)
        var bytes = text.getBytes()
        out.write(bytes, 0, bytes.length)
        out.close()
        return path
    }
}
