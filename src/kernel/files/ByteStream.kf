package kernel.files

import java.io.File
import java.io.FileInputStream
import java.io.FileOutputStream
import java.io.IOException
import java.io.InputStream
import java.io.OutputStream
import java.nio.file.Files

// A readable stream of bytes (a stored object, a request body kept on disk), so domain code can pass
// and drain binary data without touching Java types. Failures are Strings (`STREAM_*`).
class ByteStream {
    InputStream input
    public constructor(input: InputStream) {
        this.input = input
    }
    static ByteStream ofFile(path: String) {
        try {
            return ByteStream(new FileInputStream(path))
        } catch (IOException e) {
            throw "STREAM_OPEN_FAILED"
        }
    }
    static ByteStream ofBytes(data: Byte[]) = ByteStream(new java.io.ByteArrayInputStream(data))
    // Copies the rest of the stream into the file at `path` (created or replaced) and returns the
    // byte count. More than `maxBytes` throws STREAM_TOO_LARGE (the partial file is left to the caller).
    Long copyToFile(path: String, maxBytes: Long) {
        var buffer = new Byte[65536]
        var total = 0L
        var failure = ""
        try {
            var out = new FileOutputStream(path)
            var reading = true
            while (reading) {
                var n = input.read(buffer)
                if (n < 0) {
                    reading = false
                } else {
                    total = total + n
                    if (total > maxBytes) {
                        failure = "STREAM_TOO_LARGE"
                        reading = false
                    } else {
                        out.write(buffer, 0, n)
                    }
                }
            }
            out.close()
        } catch (IOException e) {
            failure = "STREAM_IO_FAILED"
        }
        if (failure.length() > 0) {
            throw failure
        }
        return total
    }
    // Copies exactly `length` bytes (a request body with a Content-Length) into the file at `path`.
    // A short stream throws STREAM_TRUNCATED.
    Long copyExactToFile(path: String, length: Long) {
        var buffer = new Byte[65536]
        var total = 0L
        var failure = ""
        try {
            var out = new FileOutputStream(path)
            while (total < length && failure.length() == 0) {
                var want = 65536
                if (length - total < 65536L) {
                    want = (length - total) as Int
                }
                var n = input.read(buffer, 0, want)
                if (n < 0) {
                    failure = "STREAM_TRUNCATED"
                } else {
                    out.write(buffer, 0, n)
                    total = total + n
                }
            }
            out.close()
        } catch (IOException e) {
            failure = "STREAM_IO_FAILED"
        }
        if (failure.length() > 0) {
            throw failure
        }
        return total
    }
    // Writes the rest of the stream to `out` (a socket) and returns the byte count.
    Long transferTo(out: OutputStream) {
        try {
            return input.transferTo(out)
        } catch (IOException e) {
            throw "STREAM_IO_FAILED"
        }
    }
    // At most `max` bytes from the start (fewer at the end of the stream).
    Byte[] readUpTo(max: Int) {
        try {
            return input.readNBytes(max)
        } catch (IOException e) {
            throw "STREAM_IO_FAILED"
        }
    }
    close() {
        try {
            input.close()
        } catch (IOException e) {
        }
    }
}

// Temp files and file facts, as paths (Strings).
class TempFiles {
    static String create(prefix: String, suffix: String) {
        try {
            return Files.createTempFile(prefix, suffix).toString()
        } catch (IOException e) {
            throw "TEMP_FILE_FAILED"
        }
    }
    static Bool delete(path: String) = new File(path).delete()
    static Bool exists(path: String) = new File(path).exists()
    static Long size(path: String) = new File(path).length()
    static Byte[] readAll(path: String) {
        try {
            return Files.readAllBytes(new File(path).toPath())
        } catch (IOException e) {
            throw "TEMP_FILE_FAILED"
        }
    }
    static write(path: String, data: Byte[]) {
        try {
            var out = new FileOutputStream(path)
            out.write(data, 0, data.length)
            out.close()
        } catch (IOException e) {
            throw "TEMP_FILE_FAILED"
        }
    }
}
