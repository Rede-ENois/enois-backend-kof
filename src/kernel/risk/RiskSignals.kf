package kernel.risk

// The signals the risk engine combines, the levels and the decisions (the Java enums as constants:
// Kof enums cannot be used across packages safely, G28).
class RiskSignals {
    // Intervals between actions almost identical: automation cadence.
    static String roboticCadence() = "ROBOTIC_CADENCE"
    // The same text published by the same account inside the window.
    static String duplicateContent() = "DUPLICATE_CONTENT"
    // Freshly created account (short window, no history).
    static String newAccount() = "NEW_ACCOUNT"
    // Account with an active sanction (restriction or ban).
    static String activeSanction() = "ACTIVE_SANCTION"
    static String low() = "LOW"
    static String medium() = "MEDIUM"
    static String high() = "HIGH"
    static String critical() = "CRITICAL"
    // ALLOW passes silently; MONITOR passes and records; ESCALATE also opens a case for moderation;
    // RESTRICT also blocks the operation (containment mode, only with enforcement on).
    static String allow() = "ALLOW"
    static String monitor() = "MONITOR"
    static String escalate() = "ESCALATE"
    static String restrict() = "RESTRICT"
}
