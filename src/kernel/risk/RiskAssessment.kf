package kernel.risk

// The risk assessment of an account at a point in time: who was assessed, what they tried, with which
// signals, at which level, which answer came out and which rule version decided (so the decision can be
// reconstructed in an investigation). `level` is LOW|MEDIUM|HIGH|CRITICAL, `decision` is
// ALLOW|MONITOR|ESCALATE|RESTRICT, signals are codes (never free text): ROBOTIC_CADENCE,
// DUPLICATE_CONTENT, NEW_ACCOUNT, ACTIVE_SANCTION. `createdAt` is an ISO instant.
class RiskAssessment {
    String id
    String userId
    String action
    String level
    Int score
    List<String> signals
    String ruleVersion
    String decision
    String createdAt
    public constructor(id: String, userId: String, action: String, level: String, score: Int, signals: List<String>, ruleVersion: String, decision: String, createdAt: String) {
        this.id = id
        this.userId = userId
        this.action = action
        this.level = level
        this.score = score
        this.signals = signals
        this.ruleVersion = ruleVersion
        this.decision = decision
        this.createdAt = createdAt
    }
    // `[A, B]` like the Java List.toString, used in the escalation text.
    String signalsText() {
        var out = ""
        for (var s in signals) {
            if (out != "") {
                out = out + ", "
            }
            out = out + s
        }
        return "[" + out + "]"
    }
}
