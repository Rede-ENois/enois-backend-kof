package kernel.mail

import kernel.html.*

// The plain-text alternative of an HTML e-mail: block ends become line breaks, tags and style blocks go away,
// entities are decoded and blank runs collapse. Good enough for a client that does not render HTML.
class MailText {
    static String fromHtml(html: String) {
        var out = html.replaceAll("(?is)<(style|script|head)[^>]*>.*?</\\1>", "")
        out = out.replaceAll("(?i)<br\\s*/?>", "\n")
        out = out.replaceAll("(?i)</(p|div|h[1-6]|li|tr|table|blockquote|pre)>", "\n")
        out = out.replaceAll("(?s)<[^>]*>", "")
        out = HtmlEntities.unescape(out)
        out = out.replaceAll("[ \\t]+", " ").replaceAll(" *\\n *", "\n").replaceAll("\\n{3,}", "\n\n")
        return out.trim()
    }
}
