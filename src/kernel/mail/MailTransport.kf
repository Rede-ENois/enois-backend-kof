package kernel.mail

// One outgoing message, as the services describe it. `from` is the sender address; `fromName`, `replyTo` and
// `listUnsubscribe` are optional (an empty string means absent). `text` is the plain-text alternative.
record MailMessage(String from, String fromName, String to, String replyTo, String subject, String html, String text, String listUnsubscribe)

// The one seam between the mail service and the wire. The default refuses to send; production uses
// SmtpTransport and tests use a recording subclass (kernel.testkit.MailCapture) or SmtpTransport pointed at
// the in-process fake server. `send` throws a String describing the failure.
class MailTransport {
    public constructor() {}
    send(message: MailMessage) {
        throw "MAIL_TRANSPORT_NOT_WIRED"
    }
}
