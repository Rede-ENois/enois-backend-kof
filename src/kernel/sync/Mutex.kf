package kernel.sync

import java.util.concurrent.locks.ReentrantLock

// A mutual-exclusion lock for domain code (Java interop stays in the kernel). `tryLock` is the
// "skip if somebody else is already doing it" form used by background refreshes.
//
//   if (gate.tryLock()) { work(); gate.unlock() }
class Mutex {
    ReentrantLock gate = new ReentrantLock()
    lock() {
        gate.lock()
    }
    unlock() {
        gate.unlock()
    }
    Bool tryLock() = gate.tryLock()
}
