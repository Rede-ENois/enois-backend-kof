package kernel.text

import kernel.error.*

// Length limit of a text field. Every text column has a ceiling; going over it makes the INSERT fail
// with "Data too long", which the persistence layer turns into 409 CONFLICT ("Operacao conflita com o
// estado atual dos dados"), meaningless to the person. Checking here answers 400 naming the field and
// the ceiling, the same number the front shows and the column accepts.
//
//   TextFieldLimit.check("COMPANY_FIELD_TOO_LONG", "nome", name, 160)
class TextFieldLimit {
    // code: module error code; field: the name people know; value: null passes; max: the column size.
    static check(code: String, field: String, value: String?, max: Int) {
        if (value == null) {
            return
        }
        if (value.length() > max) {
            throw Errors.api(400, code, "O campo " + field + " aceita no máximo " + TextFieldLimit.thousands(max) + " caracteres.")
        }
    }
    // 2000 -> "2.000": how the number appears in the app.
    static String thousands(number: Int) {
        var digits = "" + number
        var out = ""
        var i = 0
        while (i < digits.length()) {
            if (i > 0 && (digits.length() - i) % 3 == 0) {
                out = out + "."
            }
            out = out + digits.substring(i, i + 1)
            i = i + 1
        }
        return out
    }
}
