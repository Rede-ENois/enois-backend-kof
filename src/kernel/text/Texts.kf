package kernel.text

import java.lang.Class
import java.lang.Enum
import java.lang.String

// Unicode helpers behind java.text.Normalizer, whose nested Form enum Kof cannot name (KOF_GAPS G24):
// reached by reflection once per call.
class Texts {
    // NFD with the combining marks removed: "São Paulo" -> "Sao Paulo".
    static String stripAccents(text: String) {
        var cls = Class.forName("java.text.Normalizer")
        var formCls = Class.forName("java.text.Normalizer$Form")
        var form = Enum.valueOf(formCls, "NFD")
        var types = new Class[2]
        types[0] = Class.forName("java.lang.CharSequence")
        types[1] = formCls
        var method = cls.getMethod("normalize", types)
        var args = new Object[2]
        args[0] = text as Object
        args[1] = form as Object
        var decomposed = method.invoke(null, args) as String
        return decomposed.replaceAll("\\p{M}+", "")
    }
    // The UTF-16 code unit written as 4 hex digits (a JSON `\\uXXXX` escape) as a one-char String; "" when a
    // digit is not hex.
    static String fromHex4(hex: String) {
        var digits = "0123456789abcdef"
        var value = 0
        var h = hex.toLowerCase()
        var i = 0
        while (i < h.length()) {
            var d = digits.indexOf(h.substring(i, i + 1))
            if (d < 0) {
                return ""
            }
            value = value * 16 + d
            i = i + 1
        }
        return String.valueOf(value as Char)
    }
    // Trimmed, lower-cased, runs of whitespace collapsed to one space.
    static String squash(text: String) = text.trim().toLowerCase().replaceAll("\\s+", " ")
    // Null, empty or only whitespace. Kof does not narrow through `||`/`&&` (KOF_GAPS G31), so callers
    // test blankness with this instead of `v == null || v.trim()...`.
    static Bool isBlank(v: String?) {
        if (v == null) {
            return true
        }
        return v.trim().length() == 0
    }
    static Bool hasText(v: String?) = !Texts.isBlank(v)
    // StringUtils.hasText ? trim : value (a blank value stays as it came).
    static String? trimIfText(v: String?) {
        if (v == null) {
            return null
        }
        if (v.trim().length() > 0) {
            return v.trim()
        }
        return v
    }
}
