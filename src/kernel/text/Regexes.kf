package kernel.text

import java.util.regex.Matcher
import java.util.regex.Pattern

// One match with its position and its capture groups (index 0 is the whole match; a group that did not take
// part is "").
record RegexMatch(String text, Int start, Int end, List<String> groups)

// Regex helpers the stdlib lacks. Replacements are LITERAL: unlike Matcher.replaceAll(Function) in
// Java, a `$` or `\` in what the callback returns is never read as a group reference or escape.
class Regexes {
    // Replaces every match with what `replacement` returns for it.
    static String replaceAll(pattern: Pattern, input: String, replacement: (Matcher) -> String) {
        var m = pattern.matcher(input)
        var out = new StringBuilder()
        var last = 0
        var matched = false
        while (m.find()) {
            matched = true
            Regexes.add(out, input.substring(last, m.start()))
            Regexes.add(out, replacement(m))
            last = m.end()
        }
        if (!matched) {
            return input
        }
        Regexes.add(out, input.substring(last))
        return out.toString()
    }
    // StringBuilder.append(x) as a statement leaves its result on the stack and crashes the frame
    // computation inside loops; this helper binds it (KOF_GAPS G30).
    static add(out: StringBuilder, text: String) {
        var ignored = out.append(text as Object)
    }
    // True when the WHOLE text matches the regex (Matcher.matches).
    static Bool matches(regex: String, text: String) = Pattern.compile(regex).matcher(text).matches()
    // Capture group text, or "" when the group did not take part in the match.
    static String group(m: Matcher, index: Int) {
        var g = m.group(index)
        if (g == null) {
            return ""
        }
        return g
    }
    // True when the group took part in the match (an empty capture counts).
    static Bool hasGroup(m: Matcher, index: Int) = m.group(index) != null
    // Every non-overlapping match of the regex in the text, with groups (Matcher.find loop).
    static List<RegexMatch> findAll(regex: String, input: String) {
        var out = new java.util.ArrayList<RegexMatch>()
        var m = Pattern.compile(regex).matcher(input)
        var count = m.groupCount()
        while (m.find()) {
            var groups = new java.util.ArrayList<String>()
            var i = 0
            while (i <= count) {
                groups.add(Regexes.group(m, i))
                i = i + 1
            }
            out.add(RegexMatch(Regexes.group(m, 0), m.start(), m.end(), groups))
        }
        return out
    }
    // The first match, or null.
    static RegexMatch? first(regex: String, input: String) {
        var all = Regexes.findAll(regex, input)
        if (all.size() == 0) {
            return null
        }
        return all.get(0)
    }
}
