package kernel.text

import java.lang.Math

// Rounding and powers for the domains (java.lang.Math stays in the kernel). Math.round(x).toDouble() breaks the verifier
// on this compiler, so the rounding goes through floor(x + 0.5), which is what Math.round does.
class Numbers {
    // Nearest whole number, halves up (Math.round).
    static Long round(value: Double) = Math.floor(value + 0.5) as Long
    // Two decimals: Math.round(x * 100) / 100.0.
    static Double round2(value: Double) {
        var hundredths = Numbers.round(value * 100.0)
        return hundredths.toDouble() / 100.0
    }
    static Double pow(base: Double, exponent: Double) = Math.pow(base, exponent)
}
