package kernel.text

import java.util.regex.Matcher
import java.util.regex.Pattern
import kernel.time.*

// The tiny subset of Thymeleaf the e-mail templates use (resources/templates/*.html): `th:text="${name}"`
// replaces the content of its element with the HTML-escaped value, `th:href="${name}"` becomes an escaped
// `href`, and the `xmlns:th` declaration is dropped. A name with no value renders empty, like Thymeleaf's null.
// The expression `#dates.format(#dates.createNow(), 'yyyy')` (the footer year of password-reset) renders the
// current year. Values are escaped for HTML text and attributes (`& < > " '`), so user text cannot inject markup.
class HtmlTemplate {
    static Pattern textElement() = Pattern.compile("<([a-zA-Z][a-zA-Z0-9]*)([^>]*?)(\\s+)th:text=\"\\$\\{((?:[A-Za-z0-9_.]+|#dates\\.format\\(#dates\\.createNow\\(\\), 'yyyy'\\)))\\}\"(\\s+(?=[^\\s>/]))?([^>]*)>(.*?)</\\1>", 32)
    static Pattern hrefAttribute() = Pattern.compile("\\s+th:href=\"\\$\\{([A-Za-z0-9_.]+)\\}\"")
    static Pattern thymeleafNamespace() = Pattern.compile("\\s+xmlns:th=\"[^\"]*\"")
    static String escape(text: String) = text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;").replace("'", "&#39;")
    static String value(vars: Map<String,String>, name: String) {
        if (name.startsWith("#dates.format(")) {
            return Time.todayIso().substring(0, 4)
        }
        var v = vars.get(name)
        if (v == null) {
            return ""
        }
        return v
    }
    // Thymeleaf drops the th:text attribute and the attribute that follows it inherits the whitespace the
    // removed one had (`<span th:text="${x}"\n   style="..">` renders `<span style="..">`).
    static String textElementOf(m: Matcher, vars: Map<String,String>) {
        var tag = Regexes.group(m, 1)
        var gap = ""
        if (Regexes.hasGroup(m, 5)) {
            gap = Regexes.group(m, 3)
        }
        return "<" + tag + Regexes.group(m, 2) + gap + Regexes.group(m, 6) + ">" + HtmlTemplate.escape(HtmlTemplate.value(vars, Regexes.group(m, 4))) + "</" + tag + ">"
    }
    static String render(template: String, vars: Map<String,String>) {
        var withText = Regexes.replaceAll(HtmlTemplate.textElement(), template, (m: Matcher) -> HtmlTemplate.textElementOf(m, vars))
        var withHref = Regexes.replaceAll(HtmlTemplate.hrefAttribute(), withText, (m: Matcher) -> " href=\"" + HtmlTemplate.escape(HtmlTemplate.value(vars, Regexes.group(m, 1))) + "\"")
        return Regexes.replaceAll(HtmlTemplate.thymeleafNamespace(), withHref, (m: Matcher) -> "")
    }
}
