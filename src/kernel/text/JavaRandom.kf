package kernel.text

import java.security.SecureRandom
import java.util.Random

// java.util.Random seeded with a long: the same LCG sequence the Java service draws from, so a daily
// challenge generated from a stored seed (maze, falling blocks) is byte-identical on both sides.
// `nextInt(bound)` is Random.nextInt(int); shuffles are written by the caller with it.
class JavaRandom {
    Random source
    public constructor(seed: Long) {
        this.source = new Random(seed)
    }
    Int nextInt(bound: Int) = source.nextInt(bound)
    // A fresh unpredictable seed (SecureRandom.nextLong), for challenges that must not be guessable.
    static Long secureLong() {
        var generator = new SecureRandom()
        return generator.nextLong()
    }
}
