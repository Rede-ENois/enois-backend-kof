package kernel.text

import java.util.Base64

// URL-safe Base64 without padding (java.util.Base64 url encoder), for opaque cursors.
class Base64Url {
    static String encode(text: String) = Base64.getUrlEncoder().withoutPadding().encodeToString(text.getBytes())
    // Throws (a String) when the text is not valid URL-safe Base64.
    static String decode(encoded: String) {
        var raw = Base64.getUrlDecoder().decode(encoded) as Byte[]
        return new String(raw, "UTF-8")
    }
}
