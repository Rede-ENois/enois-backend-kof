package kernel.text

import java.util.ArrayList
import java.util.HashSet

// The iteration order of a java.util.HashSet<String> filled with these ids. The Java service answered some
// lists straight from a HashSet (`Collectors.toSet()`), so their order was the hash order of the ids; this
// reproduces it so the front end sees the same sequence. Duplicates collapse like in a set.
class HashOrder {
    static List<String> of(ids: List<String>) {
        var set = new HashSet<String>()
        for (var id in ids) {
            set.add(id)
        }
        var copy = new ArrayList<String>()
        copy.addAll(set)
        var out = listOf<String>()
        for (var id in copy) {
            out.add(id)
        }
        return out
    }
}
