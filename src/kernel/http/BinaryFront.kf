package kernel.http

import java.io.BufferedInputStream
import java.io.IOException
import java.io.InputStream
import java.io.OutputStream
import java.net.ServerSocket
import java.net.Socket
import kernel.bytes.*
import kernel.error.*
import kernel.files.*
import kernel.log.*

// What the upstream (the web runtime) answered: raw bytes plus the parsed status and headers.
class FrontReply {
    Int status
    List<String> headerNames
    List<String> headerValues
    Byte[] raw
    public constructor(status: Int, headerNames: List<String>, headerValues: List<String>, raw: Byte[]) {
        this.status = status
        this.headerNames = headerNames
        this.headerValues = headerValues
        this.raw = raw
    }
    String headerOf(name: String) {
        var i = 0
        while (i < headerNames.size()) {
            if (headerNames.get(i).toLowerCase() == name.toLowerCase()) {
                return headerValues.get(i)
            }
            i = i + 1
        }
        return ""
    }
}

// Byte-level front of the public port for the binary lane (see BinaryLane). It forwards every
// connection to the web runtime listening on an internal port, byte for byte, except:
//   - `PUT` under a claimed prefix with a Content-Length: the body is read from the client into a temp
//     file AFTER the route authorised it (two internal calls, tickets in BinaryLane);
//   - `GET` under a claimed prefix: when the route answers `X-Kernel-Stream`, the registered stream is
//     sent as the body.
// The client address travels as `X-Kernel-Peer`; headers named `X-Kernel-*` and `Expect` from the client
// are dropped, so the lane cannot be driven from outside. The internal port must not be published.
class BinaryFront {
    ServerSocket listener
    Int internalPort
    Long maxBody
    Bool running = true
    Log log = Log("kernel.binary-front")
    public constructor(listener: ServerSocket, internalPort: Int, maxBody: Long) {
        this.listener = listener
        this.internalPort = internalPort
        this.maxBody = maxBody
    }
    // Binds `publicPort` (0 = ephemeral) and serves in the background. `maxBody` caps one upload.
    static BinaryFront serve(publicPort: Int, internalPort: Int, maxBody: Long) {
        var front = BinaryFront(new ServerSocket(publicPort), internalPort, maxBody)
        var loop = __kof_spawn_expr(front.acceptLoop())
        return front
    }
    Int port() = listener.getLocalPort()
    close() {
        running = false
        try {
            listener.close()
        } catch (IOException e) {
        }
    }
    acceptLoop() {
        while (running) {
            try {
                var client = listener.accept()
                var task = __kof_spawn_expr(this.handle(client))
            } catch (IOException e) {
                running = false
            }
        }
    }
    // ---------------------------------------------------------------- one connection
    handle(client: Socket) {
        try {
            client.setSoTimeout(300000)
            var raw: InputStream = client.getInputStream()
            var input = new BufferedInputStream(raw)
            var out: OutputStream = client.getOutputStream()
            var head = BinaryFront.readHead(input)
            if (head.length() > 0) {
                this.route(client, input, out, head)
            }
        } catch (IOException e) {
            log.debug("front_connection_failed")
        } catch (String e) {
            log.warn("front_connection_error " + e)
        }
        try {
            client.close()
        } catch (IOException e) {
        }
    }
    route(client: Socket, input: BufferedInputStream, out: OutputStream, head: String) {
        var lines = head.split("\r\n")
        var parts = lines[0].split(" ")
        var method = parts[0]
        var target = "/"
        if (parts.length > 1) {
            target = parts[1]
        }
        var path = target
        var q = target.indexOf("?")
        if (q >= 0) {
            path = target.substring(0, q)
        }
        var kept = listOf<String>()
        var declared = -1L
        var expect = false
        var i = 1
        while (i < lines.length) {
            var line = lines[i]
            var colon = line.indexOf(":")
            if (colon > 0) {
                var name = line.substring(0, colon).trim().toLowerCase()
                var value = line.substring(colon + 1).trim()
                if (name.startsWith("x-kernel-")) {
                } else if (name == "connection") {
                } else if (name == "expect") {
                    expect = value.toLowerCase().startsWith("100")
                } else {
                    if (name == "content-length") {
                        declared = BinaryFront.parseLength(value)
                    }
                    kept.add(line)
                }
            }
            i = i + 1
        }
        var peer = BinaryFront.peerOf(client)
        if (method == "PUT" && BinaryLane.owns(path) && declared > 0L) {
            this.upload(client, input, out, lines[0], kept, peer, declared, expect)
        } else if (method == "GET" && BinaryLane.owns(path)) {
            this.download(out, lines[0], kept, peer)
        } else {
            this.forward(client, input, out, lines[0], kept, peer)
        }
    }
    static Long parseLength(value: String) {
        try {
            var n = value.toLong()
            if (n < 0L) {
                return -1L
            }
            return n
        } catch (String e) {
            return -1L
        }
    }
    static String peerOf(client: Socket) {
        var address = client.getInetAddress()
        if (address == null) {
            return ""
        }
        return address.getHostAddress()
    }
    // The head as sent upstream: `requestLine`, the kept headers, `extra` lines, close after the answer.
    static String headText(requestLine: String, kept: List<String>, extra: List<String>, peer: String) {
        var text = requestLine + "\r\n"
        for (var line in kept) {
            text = text + line + "\r\n"
        }
        for (var line in extra) {
            text = text + line + "\r\n"
        }
        return text + "X-Kernel-Peer: " + peer + "\r\nConnection: close\r\n\r\n"
    }
    // ---------------------------------------------------------------- plain forwarding
    forward(client: Socket, input: BufferedInputStream, out: OutputStream, requestLine: String, kept: List<String>, peer: String) {
        var upstream = new Socket("127.0.0.1", internalPort)
        var upOut: OutputStream = upstream.getOutputStream()
        var text = BinaryFront.headText(requestLine, kept, listOf<String>(), peer)
        var bytes = text.getBytes()
        upOut.write(bytes, 0, bytes.length)
        upOut.flush()
        // Client -> upstream in the background (the body), upstream -> client here (the answer).
        var pump = __kof_spawn_expr(BinaryFront.pump(input, upOut))
        var upIn: InputStream = upstream.getInputStream()
        try {
            upIn.transferTo(out)
            out.flush()
        } catch (IOException e) {
            log.debug("front_forward_closed")
        }
        try {
            upstream.close()
        } catch (IOException e) {
        }
    }
    static pump(input: BufferedInputStream, to: OutputStream) {
        try {
            input.transferTo(to)
            to.flush()
        } catch (IOException e) {
        }
    }
    // ---------------------------------------------------------------- upload (PUT)
    upload(client: Socket, input: BufferedInputStream, out: OutputStream, requestLine: String, kept: List<String>, peer: String, declared: Long, expect: Bool) {
        if (declared > maxBody) {
            BinaryFront.respond(out, 413, "{\"code\":\"PAYLOAD_TOO_LARGE\",\"message\":\"Corpo da requisicao grande demais.\"}")
            return
        }
        var withoutLength = listOf<String>()
        for (var line in kept) {
            if (!line.toLowerCase().startsWith("content-length:")) {
                withoutLength.add(line)
            }
        }
        withoutLength.add("Content-Length: 0")
        var first = this.exchange(BinaryFront.headText(requestLine, withoutLength, listOf("X-Kernel-Binary: authorize", "X-Kernel-Declared-Length: " + declared), peer))
        var ticket = first.headerOf("x-kernel-accept")
        if (first.status != 202 || ticket.length() == 0) {
            out.write(first.raw, 0, first.raw.length)
            out.flush()
            if (!expect && declared <= 65536) {
                // read the small body the client already sent, so closing does not reset the connection
                ByteStream(input).readUpTo(declared)
            }
            return
        }
        if (expect) {
            var go = "HTTP/1.1 100 Continue\r\n\r\n".getBytes()
            out.write(go, 0, go.length)
            out.flush()
        }
        var path = TempFiles.create("media-body-", ".bin")
        var failure = ""
        try {
            ByteStream(input).copyExactToFile(path, declared)
        } catch (String e) {
            failure = e
        }
        if (failure.length() > 0) {
            TempFiles.delete(path)
            BinaryLane.discard(ticket)
            BinaryFront.respond(out, 400, "{\"code\":\"MEDIA_UPLOAD_FAILED\",\"message\":\"Nao foi possivel ler o arquivo enviado.\"}")
            return
        }
        BinaryLane.attach(ticket, path)
        var second = this.exchange(BinaryFront.headText(requestLine, withoutLength, listOf("X-Kernel-Binary: commit", "X-Kernel-Ticket: " + ticket, "X-Kernel-Declared-Length: " + declared), peer))
        BinaryLane.discard(ticket)
        out.write(second.raw, 0, second.raw.length)
        out.flush()
    }
    // One internal request without body; the whole answer is read (the runtime closes after it).
    FrontReply exchange(head: String) {
        var upstream = new Socket("127.0.0.1", internalPort)
        upstream.setSoTimeout(600000)
        var upOut: OutputStream = upstream.getOutputStream()
        var bytes = head.getBytes()
        upOut.write(bytes, 0, bytes.length)
        upOut.flush()
        var upIn: InputStream = upstream.getInputStream()
        var raw = upIn.readAllBytes()
        upstream.close()
        return BinaryFront.parseReply(raw)
    }
    static FrontReply parseReply(raw: Byte[]) {
        var text = new String(raw, "UTF-8")
        var end = text.indexOf("\r\n\r\n")
        var head = text
        if (end >= 0) {
            head = text.substring(0, end)
        }
        var lines = head.split("\r\n")
        var names = listOf<String>()
        var values = listOf<String>()
        var status = 502
        var parts = lines[0].split(" ")
        if (parts.length > 1) {
            try {
                status = parts[1].toInt()
            } catch (String e) {
                status = 502
            }
        }
        var i = 1
        while (i < lines.length) {
            var colon = lines[i].indexOf(":")
            if (colon > 0) {
                names.add(lines[i].substring(0, colon).trim())
                values.add(lines[i].substring(colon + 1).trim())
            }
            i = i + 1
        }
        return FrontReply(status, names, values, raw)
    }
    static respond(out: OutputStream, status: Int, body: String) {
        var payload = body.getBytes()
        var head = "HTTP/1.1 " + status + " Error\r\nContent-Type: application/json; charset=utf-8\r\nContent-Length: " + payload.length + "\r\nConnection: close\r\n\r\n"
        var bytes = head.getBytes()
        out.write(bytes, 0, bytes.length)
        out.write(payload, 0, payload.length)
        out.flush()
    }
    // ---------------------------------------------------------------- download (GET)
    download(out: OutputStream, requestLine: String, kept: List<String>, peer: String) {
        var upstream = new Socket("127.0.0.1", internalPort)
        var upOut: OutputStream = upstream.getOutputStream()
        var bytes = BinaryFront.headText(requestLine, kept, listOf<String>(), peer).getBytes()
        upOut.write(bytes, 0, bytes.length)
        upOut.flush()
        var upRaw: InputStream = upstream.getInputStream()
        var upIn = new BufferedInputStream(upRaw)
        var head = BinaryFront.readHead(upIn)
        var lines = head.split("\r\n")
        var token = ""
        var statusLine = lines[0]
        var shown = ""
        var i = 1
        while (i < lines.length) {
            var colon = lines[i].indexOf(":")
            if (colon > 0) {
                var name = lines[i].substring(0, colon).trim().toLowerCase()
                var value = lines[i].substring(colon + 1).trim()
                if (name == "x-kernel-stream") {
                    token = value
                } else if (name != "content-length" && name != "connection" && name != "transfer-encoding") {
                    shown = shown + lines[i] + "\r\n"
                }
            }
            i = i + 1
        }
        var length = BinaryLane.streamLength(token)
        var body = BinaryLane.takeStream(token)
        if (token.length() > 0 && body != null) {
            var text = statusLine + "\r\n" + shown + "Content-Length: " + length + "\r\nConnection: close\r\n\r\n"
            var headBytes = text.getBytes()
            var failure = ""
            try {
                out.write(headBytes, 0, headBytes.length)
                body.transferTo(out)
                out.flush()
            } catch (IOException e) {
                failure = "closed"
            } catch (String e) {
                failure = e
            }
            body.close()
        } else {
            // A plain answer (JSON error, 404, ...): relay the head as read and the rest of the body.
            var again = head.getBytes()
            out.write(again, 0, again.length)
            var tail = "\r\n\r\n".getBytes()
            out.write(tail, 0, tail.length)
            upIn.transferTo(out)
            out.flush()
        }
        try {
            upstream.close()
        } catch (IOException e) {
        }
    }
    // Bytes up to and including the blank line ending the head, as text; "" at end of stream or when the
    // head exceeds 64 KB.
    static String readHead(input: BufferedInputStream) {
        var sink = ByteSink()
        var matched = 0
        while (true) {
            var b = input.read()
            if (b < 0) {
                return ""
            }
            sink.addByte(b)
            if ((matched == 0 || matched == 2) && b == 13) {
                matched = matched + 1
            } else if ((matched == 1 || matched == 3) && b == 10) {
                matched = matched + 1
            } else if (b == 13) {
                matched = 1
            } else {
                matched = 0
            }
            if (matched == 4) {
                var all = sink.toBytes()
                var text = new String(all, "UTF-8")
                return text.substring(0, text.length() - 4)
            }
            if (sink.size() > 65536) {
                return ""
            }
        }
        return ""
    }
}
