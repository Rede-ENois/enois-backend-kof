package kernel.http

import java.io.IOException
import java.io.InputStream
import java.net.HttpURLConnection
import java.net.URL

// A finished outbound GET: status, lower-cased Content-Type ("" when absent) and the body bytes
// (at most `maxBytes + 1` of them, so a caller detects "too large" without reading the rest).
class OutboundResponse {
    Int status
    String contentType
    Byte[] body
    public constructor(status: Int, contentType: String, body: Byte[]) {
        this.status = status
        this.contentType = contentType
        this.body = body
    }
    Int size() = body.length
    String text() = new String(body, "UTF-8")
}

// Outbound HTTP client for adapters that need what `kof.http` hides (status, content type, bytes, headers:
// KOF_GAPS G15). Redirects are NOT followed (the Java HttpClient default), so a provider cannot bounce
// the pod to another host. A network failure (timeout, refused, reset) throws `OUTBOUND_FAILED: ...`.
//
//   var res = OutboundHttp.get("https://cdn.example/x.png", listOf("Accept: image/*"), 4000, 6000, 1048576)
class OutboundHttp {
    static OutboundResponse get(url: String, headers: List<String>, connectTimeoutMs: Int, readTimeoutMs: Int, maxBytes: Int) {
        var failure = ""
        var out = OutboundResponse(0, "", new Byte[0])
        try {
            var conn = new URL(url).openConnection() as HttpURLConnection
            conn.setRequestMethod("GET")
            conn.setInstanceFollowRedirects(false)
            conn.setConnectTimeout(connectTimeoutMs)
            conn.setReadTimeout(readTimeoutMs)
            for (var h in headers) {
                var colon = h.indexOf(":")
                conn.setRequestProperty(h.substring(0, colon).trim(), h.substring(colon + 1).trim())
            }
            var status = conn.getResponseCode()
            var type = conn.getContentType()
            var kind = ""
            if (type != null) {
                kind = type.toLowerCase()
            }
            var bytes = new Byte[0]
            if (status >= 400) {
                var errors = conn.getErrorStream()
                if (errors != null) {
                    bytes = errors.readNBytes(maxBytes + 1)
                    errors.close()
                }
            }
            else {
                var stream = conn.getInputStream()
                bytes = stream.readNBytes(maxBytes + 1)
                stream.close()
            }
            conn.disconnect()
            out = OutboundResponse(status, kind, bytes)
        } catch (IOException e) {
            failure = "OUTBOUND_FAILED: " + e.getMessage()
        } catch (String e) {
            failure = "OUTBOUND_FAILED: " + e
        }
        if (failure.length() > 0) {
            throw failure
        }
        return out
    }
}
