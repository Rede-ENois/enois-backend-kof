package kernel.http

import java.net.InetSocketAddress
import java.net.ServerSocket

// Picks the ephemeral port for a background listener. The Kof runtime binds `listen(0)` on 0.0.0.0, and the OS may
// hand out a port another process already holds on 127.0.0.1 only (seen with the Lima SSH forward of Colima): a
// client that connects to 127.0.0.1 then reaches that process instead of ours. BinaryFront and the test clients
// connect to 127.0.0.1, so the port is reserved on 127.0.0.1 first (KOF_GAPS G402).
class LoopbackPorts {
    static Int pick() {
        var probe = new ServerSocket()
        probe.setReuseAddress(false)
        probe.bind(new InetSocketAddress("127.0.0.1", 0))
        var picked = probe.getLocalPort()
        probe.close()
        return picked
    }
}
