package kernel.http

import kernel.config.*
import kernel.error.*
import kernel.log.*

// A filter of the ordered middleware chain. Lower `order` runs first.
class HttpFilter {
    Int order
    String name
    () -> String run
    public constructor(order: Int, name: String, run: () -> String) {
        this.order = order
        this.name = name
        this.run = run
    }
}

// A hook run once per request after the response is decided (status and body known), for the
// filters that must look at the outcome: access log, abuse counters, duplicate-POST replay.
class HttpAfter {
    String name
    (Int, String) -> void run
    public constructor(name: String, run: (Int, String) -> void) {
        this.name = name
        this.run = run
    }
}

// A step that may rewrite the answer of a ROUTE (status, headers, body) before it is sent: ETag and
// 304 for the public reads. It never sees the answers of filters.
class HttpTransform {
    String name
    (String) -> String run
    public constructor(name: String, run: (String) -> String) {
        this.name = name
        this.run = run
    }
}

// One registered route (method + pattern with `:param` segments), used for the unknown-route
// fallback and the 405 answer.
record HttpRoute(String method, String pattern)

// Thin layer over web.app():
//   - route helpers wrap every handler so a thrown ApiError (or any String) becomes the JSON error;
//   - every route is also served under the `/v1` alias (Java V1AliasFilter: /api/v1/* == /api/*,
//     the gateway strips /api, and Kof middleware cannot rewrite the path);
//   - one ordered filter chain; built-ins sit at Http.orderFallback() (unknown path -> 200 empty)
//     and Http.orderMethod() (known path, wrong method -> 405).
class HttpServer {
    kof.web.App app
    List<HttpFilter> filters = listOf<HttpFilter>()
    List<HttpAfter> afters = listOf<HttpAfter>()
    List<HttpTransform> transforms = listOf<HttpTransform>()
    List<HttpRoute> routes = listOf<HttpRoute>()
    Log log = Log("kernel.http")
    public constructor() {
        this.app = web.app()
    }
    static Int orderFallback() = -1000
    static Int orderMethod() = 1000
    // Registers a filter. A filter returns Http.next() to continue, or a response
    // (Http.respond(status, body) / Http.blank()), or throws an ApiError.
    use(name: String, order: Int, run: () -> String) {
        filters.add(HttpFilter(order, name, run))
    }
    // Registers an after hook: it runs for every request, whoever produced the response (a route, a
    // filter, the 405/unknown-path answers), with the final status and body. A failing hook is logged
    // and never changes the response.
    useAfter(name: String, run: (Int, String) -> void) {
        afters.add(HttpAfter(name, run))
    }
    // Registers a transform of route answers (see HttpTransform). Applied in registration order.
    useTransform(name: String, run: (String) -> String) {
        transforms.add(HttpTransform(name, run))
    }
    runAfter(body: String) {
        var code = Http.currentStatus()
        for (var h in afters) {
            var step = h.run
            try {
                step(code, body)
            } catch (String e) {
                log.warn("after_hook_failed name=" + h.name)
            }
        }
    }
    get(path: String, handler: () -> String) {
        add("GET", path, handler)
    }
    post(path: String, handler: () -> String) {
        add("POST", path, handler)
    }
    put(path: String, handler: () -> String) {
        add("PUT", path, handler)
    }
    patch(path: String, handler: () -> String) {
        add("PATCH", path, handler)
    }
    delete(path: String, handler: () -> String) {
        add("DELETE", path, handler)
    }
    add(method: String, path: String, handler: () -> String) {
        register(method, path, path, handler)
        register(method, "/v1" + path, path, handler)
    }
    register(method: String, path: String, label: String, handler: () -> String) {
        routes.add(HttpRoute(method, path))
        if (method == "GET") {
            app.get(path, () -> guarded(label, handler))
        }
        else 
            if (method == "POST") {
                app.post(path, () -> guarded(label, handler))
            }
            else 
                if (method == "PUT") {
                    app.put(path, () -> guarded(label, handler))
                }
                else 
                    if (method == "PATCH") {
                        app.patch(path, () -> guarded(label, handler))
                    }
                    else 
                        if (method == "DELETE") {
                            app.delete(path, () -> guarded(label, handler))
                        }
                        else {
                            throw "unsupported method " + method
                        }
    }
    String guarded(label: String, handler: () -> String) {
        Http.setRoute(label)
        var out = ""
        try {
            out = handler()
        } catch (String e) {
            out = Http.render(e)
        }
        for (var t in transforms) {
            var step = t.run
            try {
                out = step(out)
            } catch (String e) {
                log.warn("transform_failed name=" + t.name)
            }
        }
        runAfter(out)
        return out
    }
    // A text/event-stream route (`GET path`, and its /v1 alias). The web runtime writes the response head and
    // then runs the handler on its own thread, so the session is checked first, in the filter chain (a refusal
    // is the bare status EventSource needs), and again on the stream thread to find the key. Frames come from
    // the hub: events as they are published, a "ping" heartbeat every `hub.heartbeatMs`. The runtime ends
    // the stream after `hub.timeoutMs`; EventSource reconnects. Register it BEFORE any route whose pattern could
    // also match `path` (the runtime serves the first match). See KOF_GAPS G312 and G313.
    sse(path: String, source: SseSource, hub: SseHub) {
        app.configure("idleMs", (hub.timeoutMs / 4L) as Int)
        this.registerSse(path, source, hub)
        this.registerSse("/v1" + path, source, hub)
    }
    registerSse(path: String, source: SseSource, hub: SseHub) {
        routes.add(HttpRoute("GET", path))
        use("sse-session:" + path, 900, () -> {
    if (method() != "GET" || path() != path) {
        return Http.next()
    }
    try {
        source.authorize()
    } catch (String rejected) {
        return status(Errors.parse(rejected).status(), "")
    }
    return Http.next()
})
        app.sse(path, () -> {
    Req.captureAuthorization()
    var key = source.authorize()
    var sub = hub.open(key)
    sse.event("open", "{}")
    while (sse.isOpen() && sub.isLive()) {
        var frame = sub.next(hub.heartbeatMs)
        var name = SseSubscriber.nameOf(frame)
        if (name == "close") {
            sse.close()
        }
        else {
            sse.event(name, SseSubscriber.dataOf(frame))
        }
    }
    hub.remove(sub)
})
    }
    // True when some route has this path (any method).
    Bool knowsPath(p: String) {
        for (var r in routes) {
            if (HttpServer.matches(r.pattern(), p)) {
                return true
            }
        }
        return false
    }
    Bool knowsMethod(m: String, p: String) {
        for (var r in routes) {
            if (r.method() == m && HttpServer.matches(r.pattern(), p)) {
                return true
            }
        }
        return false
    }
    // `/users/:id` matches `/users/7` (a segment is never empty); `/users/` does not match.
    static Bool matches(pattern: String, p: String) {
        var a = pattern.split("/")
        var b = p.split("/")
        if (p.endsWith("/") || pattern.endsWith("/")) {
            return pattern == p
        }
        if (a.length != b.length) {
            return false
        }
        var i = 0
        while (i < a.length) {
            if (a[i].startsWith(":")) {
                if (b[i].length() == 0) {
                    return false
                }
            }
            else 
                if (a[i] != b[i]) {
                    return false
                }
            i = i + 1
        }
        return true
    }
    // Filters sorted by order (stable).
    List<HttpFilter> ordered() {
        var all = listOf<HttpFilter>()
        for (var f in filters) {
            all.add(f)
        }
        var i = 1
        while (i < all.size()) {
            var cur = all.get(i)
            var j = i - 1
            while (j >= 0 && all.get(j).order > cur.order) {
                all.set(j + 1, all.get(j))
                j = j - 1
            }
            all.set(j + 1, cur)
            i = i + 1
        }
        return all
    }
    // Installs the dispatcher as the single web middleware. Call after every route and filter is
    // registered, right before listen.
    install(cfg: Config) {
        Req.useResolver(ClientIp.fromConfig(cfg))
        var server = this
        use("fallback-surface", HttpServer.orderFallback(), () -> server.fallbackFilter())
        use("method-not-allowed", HttpServer.orderMethod(), () -> server.methodFilter())
        var chain = ordered()
        // The runtime's own hardening headers (CSP, nosniff, ...) come from its security pipeline; switch
        // them off so kernel.security writes exactly the Java header set (KOF_GAPS G27). CSRF is ours too.
        app.security(mapOf("headers", false, "csrf", false))
        app.use(() -> {
    Cookies.reset()
    ResponseHeaders.reset()
    Http.setRoute("")
    Req.captureAuthorization()
    try {
        for (var f in chain) {
            var step = f.run
            var r = step()
            if (r != Http.next()) {
                server.runAfter(r)
                return r
            }
        }
        return null
    } catch (String e) {
        var out = Http.render(e)
        server.runAfter(out)
        return out
    }
})
    }
    String fallbackFilter() {
        if (knowsPath(path())) {
            return Http.next()
        }
        return Http.blank()
    }
    String methodFilter() {
        if (knowsMethod(method(), path())) {
            return Http.next()
        }
        return Http.methodNotAllowed()
    }
    // Blocks serving on `port`.
    listen(port: Int) {
        app.listen(port)
    }
    // Serves in the background on `port` (0 = a free loopback port, see LoopbackPorts) and returns the bound port.
    Int listenAsync(port: Int) {
        var bindPort = port
        if (bindPort == 0) {
            bindPort = LoopbackPorts.pick()
        }
        var running = __kof_spawn_expr(app.listen(bindPort))
        var i = 0
        while (i < 800 && app.port() <= 0) {
            time.sleep(25)
            i = i + 1
        }
        return app.port()
    }
    Int port() = app.port()
    close() {
        app.close()
    }
}
