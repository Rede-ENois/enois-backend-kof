package kernel.http

import java.util.concurrent.ConcurrentHashMap
import kernel.files.*
import kernel.id.*
import kernel.time.*

// The binary lane: raw request bodies and response bodies that the web runtime cannot carry.
//
// The runtime reads every request body as a UTF-8 String (bytes that are not valid UTF-8 become U+FFFD,
// measured in KOF_GAPS G160) and writes every response body as a UTF-8 String, so an image or video
// upload (`PUT /storage/{key}`, up to 500 MB) and a binary download cannot go through an ordinary route.
// A route prefix claimed here is served behind `BinaryFront` (a byte-level front on the public port that
// forwards everything else untouched); the route handlers keep the whole security pipeline and only
// exchange small tickets with the front:
//
//   upload   front -> route "PUT" with `X-Kernel-Binary: authorize` and `X-Kernel-Declared-Length: N`
//            (no body): the handler runs every check, then `BinaryLane.accept(user, key, N)` and answers 202
//            with `X-Kernel-Accept: <ticket>`. The front then reads N bytes from the client into a temp file,
//            calls the route again with `X-Kernel-Binary: commit` and `X-Kernel-Ticket`, and the handler
//            takes the file with `BinaryLane.bodyPath(ticket, user, key)` and answers the client.
//   multipart POST (claimRoute) the same two calls, but the front parses the multipart/form-data body itself while it
//            streams it (MultipartParser: every file part to its own temp file, text parts as strings) and the
//            handler takes the parsed form with `BinaryUploads.receive`; see BinaryUploads.
//   download the handler registers the stream (`BinaryLane.stream(body, length)`) and answers with
//            `X-Kernel-Stream: <token>`; the front streams the bytes with the status and headers it got.
//
// Tickets and streams live in this process only; a ticket nobody claims expires after two minutes.
class BinaryLane {
    static List<String> binaryLanePrefixes = listOf<String>()
    static Map<String,String> binaryTicketUser = new ConcurrentHashMap<String, String>()
    static Map<String,String> binaryTicketKey = new ConcurrentHashMap<String, String>()
    static Map<String,String> binaryTicketLength = new ConcurrentHashMap<String, String>()
    static Map<String,String> binaryTicketPath = new ConcurrentHashMap<String, String>()
    static Map<String,String> binaryTicketExpiry = new ConcurrentHashMap<String, String>()
    static Map<String,MultipartForm> binaryTicketForm = new ConcurrentHashMap<String, MultipartForm>()
    static Map<String,String> binaryRouteClaims = new ConcurrentHashMap<String, String>()
    static Map<String,ByteStream> binaryStreamBody = new ConcurrentHashMap<String, ByteStream>()
    static Map<String,String> binaryStreamLength = new ConcurrentHashMap<String, String>()
    static Map<String,String> binaryStreamExpiry = new ConcurrentHashMap<String, String>()
    // Claims a route prefix (`/storage/`): requests under it (also under `/v1`) go through the lane.
    static claim(prefix: String) {
        if (!binaryLanePrefixes.contains(prefix)) {
            binaryLanePrefixes.add(prefix)
        }
    }
    // Claims one GET route (`/pages/:postId/og.png`) whose handler answers bytes with `X-Kernel-Stream`; its neighbours
    // (`/pages/:postId`) stay ordinary routes.
    static claimDownload(pattern: String) {
        BinaryLane.claimRoute("GET", pattern, 0L)
    }
    // Claims one multipart POST route by method and exact path pattern (`/me/import/resume/prefill/:jobId`, a
    // `:param` segment matches any one segment). Unlike a prefix claim, neighbours of the path (other methods, other
    // paths below it) keep going to the web runtime. `maxBytes` (POST) caps the whole request body (Content-Length) and
    // each file part; the front answers 413 FILE_TOO_LARGE above it.
    static claimRoute(method: String, pattern: String, maxBytes: Long) {
        binaryRouteClaims.put(method + " " + pattern, "" + maxBytes)
    }
    static Bool enabled() = binaryLanePrefixes.size() > 0 || binaryRouteClaims.size() > 0
    // The body cap of the route claim that matches `method` and `path` (raw, `/v1` alias allowed), -1 when none.
    static Long routeMax(method: String, path: String) {
        var bare = path
        if (bare.startsWith("/v1/")) {
            bare = bare.substring(3)
        }
        if (bare.length() > 1 && bare.endsWith("/")) {
            // `split` drops trailing empty segments: `/a/b/` would match `/a/b`.
            return -1L
        }
        var segments = bare.split("/")
        for (var claim in binaryRouteClaims.keys()) {
            var space = claim.indexOf(" ")
            if (claim.substring(0, space) == method && BinaryLane.matches(claim.substring(space + 1).split("/"), segments)) {
                var max = binaryRouteClaims.get(claim)
                if (max != null) {
                    return max.toLong()
                }
            }
        }
        return -1L
    }
    static Bool matches(pattern: String[], segments: String[]) {
        if (pattern.length != segments.length) {
            return false
        }
        var i = 0
        while (i < pattern.length) {
            if (pattern[i].startsWith(":")) {
                if (segments[i].length() == 0) {
                    return false
                }
            }
            else 
                if (pattern[i] != segments[i]) {
                    return false
                }
            i = i + 1
        }
        return true
    }
    // Whether `path` (raw, `/v1` alias allowed) is under a claimed prefix.
    static Bool owns(path: String) {
        var bare = path
        if (bare.startsWith("/v1/")) {
            bare = bare.substring(3)
        }
        for (var prefix in binaryLanePrefixes) {
            if (bare.startsWith(prefix)) {
                return true
            }
        }
        return false
    }
    // ---------------------------------------------------------------- upload
    // Registers an authorised upload of `length` bytes and returns its ticket.
    static String accept(user: String, key: String, length: Long) {
        BinaryLane.sweep()
        var ticket = Ids.prefixed("bt_")
        binaryTicketUser.put(ticket, user)
        binaryTicketKey.put(ticket, key)
        binaryTicketLength.put(ticket, "" + length)
        binaryTicketExpiry.put(ticket, "" + (Time.nowMillis() + 120000L))
        return ticket
    }
    // The front stores the received body here.
    static attach(ticket: String, path: String) {
        binaryTicketPath.put(ticket, path)
    }
    // The front stores the parsed multipart form (its file parts are temp files) here.
    static attachForm(ticket: String, form: MultipartForm) {
        binaryTicketForm.put(ticket, form)
    }
    // The parsed form of a received multipart body, for the user and key that were authorised (null otherwise).
    static MultipartForm? form(ticket: String, user: String, key: String) {
        var owner = binaryTicketUser.get(ticket)
        var target = binaryTicketKey.get(ticket)
        if (owner == null || target == null || owner != user || target != key) {
            return null
        }
        return binaryTicketForm.get(ticket)
    }
    // The temp file of a received body, once, for the user and key that were authorised ("" otherwise).
    static String bodyPath(ticket: String, user: String, key: String) {
        var owner = binaryTicketUser.get(ticket)
        if (owner == null) {
            return ""
        }
        var target = binaryTicketKey.get(ticket)
        if (target == null) {
            return ""
        }
        var path = binaryTicketPath.get(ticket)
        if (path == null) {
            return ""
        }
        if (owner != user || target != key) {
            return ""
        }
        return path
    }
    // Forgets the ticket and deletes its temp file.
    static discard(ticket: String) {
        var path = binaryTicketPath.get(ticket)
        if (path != null) {
            TempFiles.delete(path)
        }
        var form = binaryTicketForm.get(ticket)
        if (form != null) {
            form.discard()
        }
        binaryTicketForm.remove(ticket)
        binaryTicketUser.remove(ticket)
        binaryTicketKey.remove(ticket)
        binaryTicketLength.remove(ticket)
        binaryTicketPath.remove(ticket)
        binaryTicketExpiry.remove(ticket)
    }
    // ---------------------------------------------------------------- download
    // Registers a body to stream to the client; returns the token for `X-Kernel-Stream`.
    static String stream(body: ByteStream, length: Long) {
        BinaryLane.sweep()
        var token = Ids.prefixed("bs_")
        binaryStreamBody.put(token, body)
        binaryStreamLength.put(token, "" + length)
        binaryStreamExpiry.put(token, "" + (Time.nowMillis() + 120000L))
        return token
    }
    // The registered body (once); null when unknown or taken.
    static ByteStream? takeStream(token: String) {
        var body = binaryStreamBody.get(token)
        binaryStreamBody.remove(token)
        binaryStreamLength.remove(token)
        binaryStreamExpiry.remove(token)
        return body
    }
    static Long streamLength(token: String) {
        var raw = binaryStreamLength.get(token)
        if (raw == null) {
            return 0L
        }
        return raw.toLong()
    }
    // Drops tickets and streams nobody claimed (closing the streams, deleting the files).
    static sweep() {
        var now = Time.nowMillis()
        for (var ticket in binaryTicketExpiry.keys()) {
            var at = binaryTicketExpiry.get(ticket)
            if (at != null && at.toLong() < now) {
                BinaryLane.discard(ticket)
            }
        }
        for (var token in binaryStreamExpiry.keys()) {
            var at = binaryStreamExpiry.get(token)
            if (at != null && at.toLong() < now) {
                var body = BinaryLane.takeStream(token)
                if (body != null) {
                    body.close()
                }
            }
        }
    }
    static Int pendingTickets() = binaryTicketUser.size()
    static Int pendingStreams() = binaryStreamBody.size()
}
