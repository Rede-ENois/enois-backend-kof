package kernel.http

import java.io.IOException
import java.io.InputStream
import java.io.OutputStream
import java.lang.String
import java.net.HttpURLConnection
import java.net.URI
import java.net.URL
import kernel.files.*
import org.apache.http.client.config.RequestConfig
import org.apache.http.client.methods.HttpPatch
import org.apache.http.HttpEntity
import org.apache.http.HttpResponse
import java.io.Closeable
import java.lang.Class
import org.apache.http.impl.client.HttpClients
import org.apache.http.util.EntityUtils

record OutboundReply(Int status, String body)

// A finished outbound GET: status, lower-cased Content-Type ("" when absent), the Location header ("" when absent: a caller
// that follows redirects by hand re-checks every hop) and the body bytes (at most `maxBytes + 1` of them, so a caller
// detects "too large" without reading the rest).
class OutboundResponse {
    Int status
    String contentType
    String location
    Byte[] body
    public constructor(status: Int, contentType: String, location: String, body: Byte[]) {
        this.status = status
        this.contentType = contentType
        this.location = location
        this.body = body
    }
    Int size() = body.length
    String text() = new String(body, "UTF-8")
    // The body decoded in the named charset; an unknown charset name falls back to UTF-8.
    String textAs(charset: String) {
        try {
            return new String(body, charset)
        } catch (IOException e) {
            return new String(body, "UTF-8")
        } catch (String e) {
            return new String(body, "UTF-8")
        }
    }
}

// Result of a HEAD/GET probe: status (0 = unreachable) and the Content-Type header ("" when absent).
record OutboundProbe(Int status, String contentType)

// Outgoing HTTP for the integrations (Turnstile, OAuth providers, Gov.br): one blocking call with
// timeouts, any method and headers, status and body back (kof.http returns only the body, G15).
// A failure to connect or read (refused, timeout, bad URL) is thrown as exactly "OUTBOUND_FAILED", with no
// URL, address or header in the message, so callers map it to their own 503 without leaking secrets.
// Byte-reading GET, probe and size-capped download live here too: this is the only outbound HTTP client.
// Callers that must be testable wrap this in a small overridable class and stub it: tests never hit the
// network.
class Outbound {
    // headers: "Name: value" lines. body "" sends no payload.
    static OutboundReply request(method: String, url: String, headers: List<String>, body: String, timeoutMs: Int) {
        // HttpURLConnection refuses PATCH (ProtocolException): that verb goes through the Apache client.
        if (method == "PATCH") {
            return Outbound.patch(url, headers, body, timeoutMs)
        }
        return Outbound.plain(method, url, headers, body, timeoutMs)
    }
    static OutboundReply plain(method: String, url: String, headers: List<String>, body: String, timeoutMs: Int) {
        var status = 0
        var text = ""
        var failure = ""
        try {
            var conn = new URL(url).openConnection() as HttpURLConnection
            conn.setRequestMethod(method)
            conn.setConnectTimeout(timeoutMs)
            conn.setReadTimeout(timeoutMs)
            conn.setInstanceFollowRedirects(false)
            for (var h in headers) {
                var colon = h.indexOf(":")
                if (colon > 0) {
                    conn.setRequestProperty(h.substring(0, colon).trim(), h.substring(colon + 1).trim())
                }
            }
            if (body.length() > 0) {
                conn.setDoOutput(true)
                var payload = body.getBytes()
                var out = conn.getOutputStream()
                out.write(payload, 0, body.getBytes().length)
                out.flush()
                out.close()
            }
            status = conn.getResponseCode()
            if (status >= 400) {
                text = Outbound.readAll(conn.getErrorStream())
            }
            else {
                text = Outbound.readAll(conn.getInputStream())
            }
            conn.disconnect()
        } catch (String e) {
            failure = "OUTBOUND_FAILED"
        } catch (IOException e) {
            failure = "OUTBOUND_FAILED"
        }
        if (failure.length() > 0) {
            throw failure
        }
        return OutboundReply(status, text)
    }
    static OutboundReply patch(url: String, headers: List<String>, body: String, timeoutMs: Int) {
        var status = 0
        var text = ""
        var failure = ""
        try {
            var config = RequestConfig.custom().setConnectTimeout(timeoutMs).setSocketTimeout(timeoutMs).setConnectionRequestTimeout(timeoutMs).build()
            var request = new HttpPatch(URI.create(url))
            request.setConfig(config)
            for (var h in headers) {
                var colon = h.indexOf(":")
                if (colon > 0) {
                    request.setHeader(h.substring(0, colon).trim(), h.substring(colon + 1).trim())
                }
            }
            if (body.length() > 0) {
                request.setEntity(Outbound.textBody(body))
            }
            var client = HttpClients.createDefault()
            var reply = client.execute(request) as HttpResponse
            status = reply.getStatusLine().getStatusCode()
            var answer = reply.getEntity()
            if (answer != null) {
                var raw = EntityUtils.toByteArray(answer) as Byte[]
                text = new String(raw, "UTF-8")
            }
            var closer = client as Closeable
            closer.close()
        } catch (String e) {
            failure = "OUTBOUND_FAILED"
        } catch (IOException e) {
            failure = "OUTBOUND_FAILED"
        }
        if (failure.length() > 0) {
            throw failure
        }
        return OutboundReply(status, text)
    }
    // StringEntity by reflection: `entity` is a Kof keyword, so `org.apache.http.entity.StringEntity` cannot be imported.
    static HttpEntity textBody(body: String) {
        var strCls = Class.forName("java.lang.String")
        var types = new Class[2]
        types[0] = strCls
        types[1] = strCls
        var args = new Object[2]
        args[0] = body as Object
        args[1] = "UTF-8" as Object
        return Class.forName("org.apache.http.entity.StringEntity").getConstructor(types).newInstance(args) as HttpEntity
    }
    static OutboundReply postJson(url: String, headers: List<String>, body: String, timeoutMs: Int) = Outbound.request("POST", url, headers, body, timeoutMs)
    static OutboundReply postForm(url: String, form: String, timeoutMs: Int) = Outbound.request("POST", url, listOf("Content-Type: application/x-www-form-urlencoded"), form, timeoutMs)
    static OutboundReply get(url: String, headers: List<String>, timeoutMs: Int) = Outbound.request("GET", url, headers, "", timeoutMs)
    // Like `request`, but a transport failure answers status 0 and an empty body instead of throwing, for
    // callers that map "unreachable" to their own outcome.
    static OutboundReply attempt(method: String, url: String, headers: List<String>, body: String, timeoutMs: Int) {
        var reply = OutboundReply(0, "")
        try {
            reply = Outbound.request(method, url, headers, body, timeoutMs)
        } catch (String e) {
            reply = OutboundReply(0, "")
        }
        return reply
    }
    // GET returning status, lower-cased Content-Type and raw bytes (at most `maxBytes + 1`), for adapters that need
    // what `kof.http` hides (KOF_GAPS G15). Redirects are NOT followed. A network failure throws "OUTBOUND_FAILED".
    //   var res = Outbound.getBytes("https://cdn.example/x.png", listOf("Accept: image/*"), 4000, 6000, 1048576)
    static OutboundResponse getBytes(url: String, headers: List<String>, connectTimeoutMs: Int, readTimeoutMs: Int, maxBytes: Int) {
        var failure = ""
        var out = OutboundResponse(0, "", "", new Byte[0])
        try {
            var conn = new URL(url).openConnection() as HttpURLConnection
            conn.setRequestMethod("GET")
            conn.setInstanceFollowRedirects(false)
            conn.setConnectTimeout(connectTimeoutMs)
            conn.setReadTimeout(readTimeoutMs)
            for (var h in headers) {
                var colon = h.indexOf(":")
                if (colon > 0) {
                    conn.setRequestProperty(h.substring(0, colon).trim(), h.substring(colon + 1).trim())
                }
            }
            var status = conn.getResponseCode()
            var type = conn.getContentType()
            var kind = ""
            if (type != null) {
                kind = type.toLowerCase()
            }
            var place = conn.getHeaderField("Location")
            var where = ""
            if (place != null) {
                where = place
            }
            var bytes = new Byte[0]
            if (status >= 400) {
                var errors = conn.getErrorStream()
                if (errors != null) {
                    bytes = errors.readNBytes(maxBytes + 1)
                    errors.close()
                }
            }
            else {
                var stream = conn.getInputStream()
                bytes = stream.readNBytes(maxBytes + 1)
                stream.close()
            }
            conn.disconnect()
            out = OutboundResponse(status, kind, where, bytes)
        } catch (IOException e) {
            failure = "OUTBOUND_FAILED"
        } catch (String e) {
            failure = "OUTBOUND_FAILED"
        }
        if (failure.length() > 0) {
            throw failure
        }
        return out
    }
    // HEAD, and a one-byte ranged GET when the server answers 405. Redirects are followed (a CDN may
    // redirect to its edge). Status 0 = unreachable.
    static OutboundProbe probe(url: String, timeoutMs: Int) {
        var first = Outbound.probeOnce(url, "HEAD", timeoutMs)
        if (first.status() == 405) {
            return Outbound.probeOnce(url, "GET", timeoutMs)
        }
        return first
    }
    static OutboundProbe probeOnce(url: String, method: String, timeoutMs: Int) {
        try {
            var connection = new URL(url).openConnection() as HttpURLConnection
            connection.setRequestMethod(method)
            connection.setConnectTimeout(5000)
            connection.setReadTimeout(timeoutMs)
            connection.setInstanceFollowRedirects(true)
            if (method == "GET") {
                connection.setRequestProperty("Range", "bytes=0-0")
            }
            var status = connection.getResponseCode()
            var type = connection.getContentType()
            if (type == null) {
                type = ""
            }
            return OutboundProbe(status, type)
        } catch (IOException e) {
            return OutboundProbe(0, "")
        }
    }
    // Downloads `url` (200 only, no redirects) into a new temp file and returns its path. Throws
    // "download falhou: ..." (the Java message) on any refusal; an empty body or one above `maxBytes`
    // is refused and the temp file removed.
    static String download(url: String, maxBytes: Long) {
        var path = ""
        var failure = ""
        try {
            var connection = new URL(url).openConnection() as HttpURLConnection
            connection.setRequestMethod("GET")
            connection.setConnectTimeout(10000)
            connection.setReadTimeout(180000)
            connection.setInstanceFollowRedirects(false)
            var status = connection.getResponseCode()
            if (status != 200) {
                failure = "origem respondeu " + status
            }
            else {
                path = TempFiles.create("media-migration-", ".bin")
                var stream = ByteStream(connection.getInputStream())
                var total = stream.copyToFile(path, maxBytes)
                stream.close()
                if (total == 0L) {
                    failure = "origem respondeu vazio"
                }
            }
        } catch (IOException e) {
            failure = "io"
        } catch (String e) {
            if (e == "STREAM_TOO_LARGE") {
                failure = "objeto maior que o teto de migracao"
            }
            else {
                failure = e
            }
        }
        if (failure.length() > 0) {
            if (path.length() > 0) {
                TempFiles.delete(path)
            }
            throw "download falhou: " + failure
        }
        return path
    }
    static String readAll(s: InputStream?) {
        if (s == null) {
            return ""
        }
        var bytes = s.readAllBytes()
        s.close()
        return new String(bytes, "UTF-8")
    }
}
