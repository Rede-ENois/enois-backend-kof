package kernel.http

import java.lang.Class
import java.lang.ThreadLocal
import java.util.HashMap
import kernel.error.*

// Request helpers for handlers and filters. Names avoid the web runtime's own context functions
// (param, query, header, body, method, path), which stay available unqualified.
class Req {
    static ClientIp resolver = ClientIp("", "")
    // Installed by HttpServer.
    static useResolver(r: ClientIp) {
        Req.resolver = r
    }
    static String bodyText() {
        var b = body()
        if (b == null) {
            return ""
        }
        return b
    }
    static String pathParam(name: String) = param(name)
    static String queryStr(name: String, fallback: String) {
        var v = query(name)
        if (v == null) {
            return fallback
        }
        return v
    }
    // Absent -> fallback. Malformed -> 400 BAD_REQUEST (Spring MethodArgumentTypeMismatchException).
    static Int queryInt(name: String, fallback: Int) {
        var v = query(name)
        if (v == null) {
            return fallback
        }
        if (v.trim().length() == 0) {
            return fallback
        }
        try {
            return v.trim().toInt()
        } catch (String e) {
            throw Errors.badRequest()
        }
    }
    static Long queryLong(name: String, fallback: Long) {
        var v = query(name)
        if (v == null) {
            return fallback
        }
        if (v.trim().length() == 0) {
            return fallback
        }
        try {
            return v.trim().toLong()
        } catch (String e) {
            throw Errors.badRequest()
        }
    }
    static Bool queryBool(name: String, fallback: Bool) {
        var v = query(name)
        if (v == null) {
            return fallback
        }
        if (v.trim().length() == 0) {
            return fallback
        }
        var t = v.trim().toLowerCase()
        if (t == "true") {
            return true
        }
        if (t == "false") {
            return false
        }
        throw Errors.badRequest()
    }
    // Header value or null; names are case-insensitive.
    static String? headerOrNull(name: String) = header(name)
    // Parsed Cookie header (first occurrence wins).
    static Map<String,String> cookies() {
        var out = new HashMap<String, String>()
        var raw = header("cookie")
        if (raw == null) {
            return out
        }
        for (var part in raw.split(";")) {
            var eq = part.indexOf("=")
            if (eq > 0) {
                var k = part.substring(0, eq).trim()
                var v = part.substring(eq + 1).trim()
                if (!out.containsKey(k)) {
                    out.put(k, v)
                }
            }
        }
        return out
    }
    static String? cookie(name: String) = Req.cookies().get(name)
    // The Authorization header of the current request. The web runtime answers 401 to ANY request that
    // carries one before it reaches a route (KOF_GAPS G28), so HttpServer moves it out of the request
    // headers at the start of every request and keeps it here.
    static ThreadLocal authorization = new ThreadLocal()
    static captureAuthorization() {
        var raw = header("authorization")
        if (raw == null) {
            authorization.remove()
        }
        else {
            authorization.set(raw)
        }
        try {
            var c = Class.forName("dev.kof.runtime.KofRuntime")
            var f = c.getDeclaredField("KOF_WEB_REQUEST")
            f.setAccessible(true)
            var tl = f.get(null) as ThreadLocal
            var req = tl.get()
            var hf = req.getClass().getDeclaredField("headers")
            hf.setAccessible(true)
            var m = hf.get(req) as HashMap
            m.remove("authorization")
        } catch (String e) {
            authorization.remove()
        }
    }
    static String? authorizationHeader() {
        var v = authorization.get()
        if (v == null) {
            return null
        }
        return v.toString()
    }
    // Bearer token of `Authorization: Bearer <token>`, or null.
    static String? bearerToken() {
        var h = Req.authorizationHeader()
        if (h == null) {
            return null
        }
        if (h.length() > 7 && h.substring(0, 7).toLowerCase() == "bearer ") {
            return h.substring(7).trim()
        }
        return null
    }
    // Raw query string of the current request (no leading `?`), "" when absent.
    static String rawQuery() {
        try {
            var c = Class.forName("dev.kof.runtime.KofRuntime")
            var f = c.getDeclaredField("KOF_WEB_REQUEST")
            f.setAccessible(true)
            var tl = f.get(null) as ThreadLocal
            var req = tl.get()
            var qf = req.getClass().getDeclaredField("query")
            qf.setAccessible(true)
            return qf.get(req).toString()
        } catch (String e) {
            return ""
        }
    }
    // The TCP peer of the current request (the runtime does not expose it, see KOF_GAPS G14). Behind the
    // binary lane's front the TCP peer is the loopback front and the client address is `X-Kernel-Peer`
    // (the front drops any such header sent by a client, and it is read only from a loopback peer).
    static String peerAddress() {
        var raw = Req.rawPeerAddress()
        if (raw == "127.0.0.1" || raw == "0:0:0:0:0:0:0:1") {
            var fronted = header("x-kernel-peer")
            if (fronted != null && fronted.length() > 0) {
                return fronted
            }
        }
        return raw
    }
    static String rawPeerAddress() {
        try {
            var c = Class.forName("dev.kof.runtime.KofRuntime")
            var f = c.getDeclaredField("KOF_WEB_REQUEST")
            f.setAccessible(true)
            var tl = f.get(null) as ThreadLocal
            var req = tl.get()
            var rf = req.getClass().getDeclaredField("remoteAddr")
            rf.setAccessible(true)
            return rf.get(req).toString()
        } catch (String e) {
            return ""
        }
    }
    // Client IP with the ClientIpResolver rules (TRUSTED_PROXY_IPS, Cloudflare).
    static String clientIp() = Req.resolver.resolve(Req.peerAddress(), header("x-forwarded-for"), header("cf-connecting-ip"))
}
