package kernel.security

import java.lang.ThreadLocal
import java.util.HashMap

// Per-request logging context (the Java MDC): requestId, clientIp, userId, deviceId, http.method,
// http.path. RequestObservability fills it, Auth adds userId, handlers may read it. Cleared at the
// start and at the end of every request.
class LogContext {
    static ThreadLocal logContextSlot = new ThreadLocal()
    static HashMap<String,String> map() {
        var m = logContextSlot.get()
        if (m == null) {
            var fresh = new HashMap<String, String>()
            logContextSlot.set(fresh)
            return fresh
        }
        return m as HashMap<String,String>
    }
    static put(key: String, value: String) {
        LogContext.map().put(key, value)
    }
    static String? get(key: String) = LogContext.map().get(key)
    static String getOr(key: String, fallback: String) {
        var v = LogContext.map().get(key)
        if (v == null) {
            return fallback
        }
        return v
    }
    static reset() {
        logContextSlot.set(new HashMap<String, String>())
    }
}
