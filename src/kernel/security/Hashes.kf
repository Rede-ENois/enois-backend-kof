package kernel.security

import java.security.MessageDigest
import java.util.HexFormat
import javax.crypto.Mac
import javax.crypto.spec.SecretKeySpec

// Hashes of single-use values (codes, tokens): only the hash is persisted (shared/security/Hashes).
class Hashes {
    // Lower-case hex SHA-256 of the UTF-8 bytes.
    static String sha256Hex(value: String) {
        var digest = MessageDigest.getInstance("SHA-256").digest(value.getBytes())
        return HexFormat.of().formatHex(digest)
    }
    // Lower-case hex HmacSHA256 of the UTF-8 bytes of `text` under the UTF-8 bytes of `secret` (GitHub webhook
    // signatures: `sha256=` + this). `getBytes()` is typed Object (G210): bind it `as Byte[]` first.
    static String hmacSha256Hex(secret: String, text: String) {
        var key = secret.getBytes() as Byte[]
        var mac = Mac.getInstance("HmacSHA256")
        mac.init(new SecretKeySpec(key, "HmacSHA256"))
        var data = text.getBytes() as Byte[]
        var out = mac.doFinal(data) as Byte[]
        return HexFormat.of().formatHex(out)
    }
}
