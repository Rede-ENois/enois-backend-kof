package kernel.security

import java.security.MessageDigest
import java.util.HexFormat

// Hashes of single-use values (codes, tokens): only the hash is persisted (shared/security/Hashes).
class Hashes {
    // Lower-case hex SHA-256 of the UTF-8 bytes.
    static String sha256Hex(value: String) {
        var digest = MessageDigest.getInstance("SHA-256").digest(value.getBytes())
        return HexFormat.of().formatHex(digest)
    }
}
