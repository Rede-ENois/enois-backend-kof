package kernel.security

import java.security.GeneralSecurityException
import java.security.MessageDigest
import java.security.SecureRandom
import java.util.Base64
import java.util.HashSet
import javax.crypto.SecretKeyFactory
import javax.crypto.spec.PBEKeySpec
import kernel.config.*
import kernel.error.*

// Password hashing and strength rules, byte-compatible with the Java PasswordHasher/AuthService:
// PBKDF2WithHmacSHA256, 120000 iterations, 256 bit key, 16 byte random salt, stored as
// "iterations:base64(salt):base64(key)". Hashes written by the Java service verify here (and the
// stored iteration count is honoured, so older, cheaper hashes still verify).
//
//   var stored = Passwords.hash(password)
//   if (!Passwords.matches(password, stored)) { throw Errors.api(401, "INVALID_CREDENTIALS", "...") }
//   Passwords.validateStrength(password)       // 400 WEAK_PASSWORD
class Passwords {
    static HashSet<String>? commonCache = null
    static Int iterations() = 120000
    static Int maxLength() = 128
    static String hash(password: String) {
        var salt = new byte[16]
        new SecureRandom().nextBytes(salt)
        var encoded = Passwords.pbkdf2(password, salt, Passwords.iterations())
        return "" + Passwords.iterations() + ":" + Base64.getEncoder().encodeToString(salt) + ":" + Base64.getEncoder().encodeToString(encoded)
    }
    // False for a malformed stored value (the Java version answered 500 for a bad base64 part).
    static Bool matches(password: String, storedHash: String) {
        var parts = storedHash.split(":")
        if (parts.length != 3) {
            return false
        }
        var count = 0
        var salt = new byte[0]
        var expected = new byte[0]
        try {
            count = parts[0].trim().toInt()
            salt = Base64.getDecoder().decode(parts[1])
            expected = Base64.getDecoder().decode(parts[2])
        } catch (String e) {
            return false
        }
        if (count < 1) {
            return false
        }
        var actual = Passwords.pbkdf2(password, salt, count)
        return MessageDigest.isEqual(expected, actual)
    }
    static Byte[] pbkdf2(password: String, salt: Byte[], count: Int) {
        var failed = false
        var key = new byte[0]
        try {
            var spec = new PBEKeySpec(password.toCharArray(), salt, count, 256)
            key = SecretKeyFactory.getInstance("PBKDF2WithHmacSHA256").generateSecret(spec).getEncoded() as Byte[]
        } catch (GeneralSecurityException e) {
            failed = true
        } catch (String e) {
            failed = true
        }
        if (failed) {
            throw Errors.api(500, "PASSWORD_HASH_FAILURE", "Nao foi possivel processar credenciais.")
        }
        return key
    }
    // The bundled blocklist (resources/security/common-passwords.txt, lower-cased, `#` comments).
    // SECURITY_RESOURCES_DIR overrides the directory, like MIGRATIONS_DIR does for migrations.
    static HashSet<String> loadCommon(dir: String) {
        var set = new HashSet<String>()
        var text = File(dir + "/common-passwords.txt").readText()
        if (text == null) {
            throw "CONFIG_MISSING: " + dir + "/common-passwords.txt is missing"
        }
        for (var line in text.split("\n")) {
            var t = line.trim()
            if (t.length() > 0 && !t.startsWith("#")) {
                set.add(t.toLowerCase())
            }
        }
        return set
    }
    static HashSet<String> common() {
        var cached = Passwords.commonCache
        if (cached != null) {
            return cached
        }
        var dir = Config.env().getStr("SECURITY_RESOURCES_DIR", "resources/security")
        var loaded = Passwords.loadCommon(dir)
        Passwords.commonCache = loaded
        return loaded
    }
    static Bool isCommon(password: String) = Passwords.common().contains(password.toLowerCase())
    // AuthService.validatePasswordStrength: 8..128 characters and not a common password.
    static validateStrength(password: String?) {
        if (password == null) {
            throw Errors.api(400, "WEAK_PASSWORD", "Senha deve ter pelo menos 8 caracteres.")
        }
        if (password.trim().length() == 0 || password.length() < 8) {
            throw Errors.api(400, "WEAK_PASSWORD", "Senha deve ter pelo menos 8 caracteres.")
        }
        if (password.length() > Passwords.maxLength()) {
            throw Errors.api(400, "WEAK_PASSWORD", "Senha deve ter no maximo 128 caracteres.")
        }
        if (Passwords.isCommon(password)) {
            throw Errors.api(400, "WEAK_PASSWORD", "Escolha uma senha menos previsivel.")
        }
    }
}
