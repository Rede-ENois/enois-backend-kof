package kernel.security

import java.net.URLEncoder
import java.io.ByteArrayOutputStream
import java.nio.ByteBuffer
import java.security.SecureRandom
import javax.crypto.Mac
import javax.crypto.spec.SecretKeySpec

// TOTP (RFC 6238): HMAC-SHA1, 6 digits, 30 second step, as every authenticator app expects.
// Port of shared/security/Totp, covered by the RFC test vectors.
class Totp {
    static Int defaultWindow() = 1
    static String alphabet() = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
    // 20 random bytes, base32 (32 characters).
    static String generateSecret() {
        var bytes = new byte[20]
        new SecureRandom().nextBytes(bytes)
        return Totp.base32Encode(bytes)
    }
    // Code accepted inside `window` steps on each side (default 1: clock drift of one step).
    static Bool verify(secretBase32: String?, code: String?, epochSecond: Long, window: Int) = Totp.matchingStep(secretBase32, code, epochSecond, window) >= 0L
    static Bool verifyDefault(secretBase32: String?, code: String?, epochSecond: Long) = Totp.verify(secretBase32, code, epochSecond, 1)
    // Time step the code belongs to, or -1 when it matches none inside the window. Callers persist the
    // step so the same code cannot be accepted twice.
    static Long matchingStep(secretBase32: String?, code: String?, epochSecond: Long, window: Int) {
        if (secretBase32 == null) {
            return -1L
        }
        if (code == null) {
            return -1L
        }
        if (code.trim().length() == 0) {
            return -1L
        }
        var digits = code.replaceAll("\\D", "")
        if (digits.length() != 6) {
            return -1L
        }
        var step = epochSecond / 30L
        var offset = 0L - window
        while (offset <= window) {
            if (digits == Totp.codeAt(secretBase32, step + offset)) {
                return step + offset
            }
            offset = offset + 1L
        }
        return -1L
    }
    static String codeAt(secretBase32: String, step: Long) {
        var key = Totp.base32Decode(secretBase32)
        // Big-endian counter. (a Long cast `as Byte` emits invalid bytecode: G29.)
        var counter = ByteBuffer.allocate(8).putLong(step).array()
        var mac = Mac.getInstance("HmacSHA1")
        mac.init(new SecretKeySpec(key, "HmacSHA1"))
        var hash = mac.doFinal(counter)
        var offset = Totp.unsigned(hash[hash.length - 1]) & 15
        var binary = (Totp.unsigned(hash[offset]) & 127) << 24 | Totp.unsigned(hash[offset + 1]) << 16 | Totp.unsigned(hash[offset + 2]) << 8 | Totp.unsigned(hash[offset + 3])
        // Zero-padded to 6 digits.
        var padded = "000000" + binary % 1000000
        return padded.substring(padded.length() - 6)
    }
    static Int unsigned(b: Byte) = b as Int & 255
    // Standard otpauth:// URI the apps read (Google Authenticator, 1Password, ...).
    static String otpauthUri(issuer: String, account: String, secretBase32: String) {
        var label = URLEncoder.encode(issuer + ":" + account, "UTF-8")
        return "otpauth://totp/" + label + "?secret=" + secretBase32 + "&issuer=" + URLEncoder.encode(issuer, "UTF-8") + "&algorithm=SHA1&digits=6&period=30"
    }
    static String base32Encode(data: Byte[]) {
        var result = ""
        var buffer = 0
        var bitsLeft = 0
        var chars = Totp.alphabet()
        var i = 0
        while (i < data.length) {
            buffer = (buffer << 8 | Totp.unsigned(data[i])) & 65535
            bitsLeft = bitsLeft + 8
            while (bitsLeft >= 5) {
                result = result + chars.substring(buffer >> bitsLeft - 5 & 31, (buffer >> bitsLeft - 5 & 31) + 1)
                bitsLeft = bitsLeft - 5
            }
            i = i + 1
        }
        if (bitsLeft > 0) {
            var idx = buffer << 5 - bitsLeft & 31
            result = result + chars.substring(idx, idx + 1)
        }
        return result
    }
    static Byte[] base32Decode(encoded: String) {
        var normalized = encoded.trim().replace("=", "").replace(" ", "").toUpperCase()
        var out = new ByteArrayOutputStream()
        var buffer = 0
        var bitsLeft = 0
        var chars = Totp.alphabet()
        var i = 0
        while (i < normalized.length()) {
            var index = chars.indexOf(normalized.substring(i, i + 1))
            if (index < 0) {
                throw "TOTP_INVALID_SECRET: Caractere invalido no segredo do TOTP"
            }
            buffer = (buffer << 5 | index) & 65535
            bitsLeft = bitsLeft + 5
            if (bitsLeft >= 8) {
                out.write(buffer >> bitsLeft - 8 & 255)
                bitsLeft = bitsLeft - 8
            }
            i = i + 1
        }
        return out.toByteArray()
    }
}
