package kernel.security

import java.io.ByteArrayOutputStream
import java.security.GeneralSecurityException
import java.security.SecureRandom
import java.util.Base64
import javax.crypto.Cipher
import javax.crypto.spec.GCMParameterSpec
import javax.crypto.spec.SecretKeySpec
import kernel.config.*
import kernel.error.*

// Secrets at rest (the TOTP secret, OAuth tokens) with AES-256-GCM, byte-compatible with the Java
// SecretCipher: output is base64(iv(12) || ciphertext || tag(16)), key = 32 bytes in base64 from
// REDE_SECURITY_ENCRYPTION_KEY. Without a key the feature is UNAVAILABLE with an explicit error:
// keeping a second-factor secret in clear text would be worse than not offering it.
//
//   var cipher = SecretCipher.fromConfig(platform.cfg)      // fails fast at boot outside the dev profile
//   var stored = cipher.encrypt(secret)   var back = cipher.decrypt(stored)
class SecretCipher {
    SecretKeySpec? key = null
    public constructor(base64Key: String, required: Bool) {
        if (base64Key.trim().length() == 0) {
            if (required) {
                throw "CONFIG_MISSING: REDE_SECURITY_ENCRYPTION_KEY is required (32 bytes, base64). Only the dev profile may omit it."
            }
            return
        }
        var decoded = SecretCipher.decodeKey(base64Key.trim())
        if (decoded.length != 32) {
            throw "CONFIG_INVALID: REDE_SECURITY_ENCRYPTION_KEY precisa ter 32 bytes (chave AES-256)."
        }
        this.key = new SecretKeySpec(decoded, "AES")
    }
    static Byte[] decodeKey(base64Key: String) {
        try {
            return Base64.getDecoder().decode(base64Key)
        } catch (String e) {
            throw "CONFIG_INVALID: REDE_SECURITY_ENCRYPTION_KEY nao e base64 valido."
        }
    }
    // The key is required outside the dev profile (SPRING_PROFILES_ACTIVE, default dev), unless
    // REDE_SECURITY_ENCRYPTION_KEY_REQUIRED says otherwise (rede.security.encryption-key-required).
    static SecretCipher fromConfig(cfg: Config) {
        var profile = cfg.getStr("SPRING_PROFILES_ACTIVE", "dev")
        var required = cfg.getBool("REDE_SECURITY_ENCRYPTION_KEY_REQUIRED", profile != "dev")
        var raw = cfg.lookup("REDE_SECURITY_ENCRYPTION_KEY")
        if (raw == null) {
            return SecretCipher("", required)
        }
        return SecretCipher(raw, required)
    }
    Bool isEnabled() = key != null
    requireEnabled() {
        if (key == null) {
            throw Errors.api(503, "SECURITY_KEY_NOT_CONFIGURED", "O segundo fator ainda nao esta disponivel nesta instalacao. Avise o time de suporte.")
        }
    }
    // base64(iv || ciphertext+tag); a fresh random IV per call.
    String encrypt(plaintext: String) {
        this.requireEnabled()
        var iv = new byte[12]
        new SecureRandom().nextBytes(iv)
        var out = new ByteArrayOutputStream()
        var failed = false
        try {
            var cipher = Cipher.getInstance("AES/GCM/NoPadding")
            cipher.init(1, key as SecretKeySpec, new GCMParameterSpec(128, iv))
            var enc = cipher.doFinal(plaintext.getBytes())
            // write(b, off, len): ByteArrayOutputStream.writeBytes(byte[]) crashes the frame computation (G29).
            out.write(iv, 0, 12)
            out.write(enc, 0, enc.length)
        } catch (GeneralSecurityException e) {
            failed = true
        } catch (String e) {
            failed = true
        }
        if (failed) {
            throw "SECRET_CIPHER_FAILURE: Falha ao cifrar o segredo"
        }
        return Base64.getEncoder().encodeToString(out.toByteArray())
    }
    // A wrong key or a corrupted value fails loudly: the secret cannot be recovered.
    String decrypt(encoded: String) {
        this.requireEnabled()
        var plain = ""
        var failed = false
        try {
            var payload = Base64.getDecoder().decode(encoded)
            var cipher = Cipher.getInstance("AES/GCM/NoPadding")
            cipher.init(2, key as SecretKeySpec, new GCMParameterSpec(128, payload, 0, 12))
            var raw = cipher.doFinal(payload, 12, payload.length - 12) as Byte[]
            plain = new String(raw, "UTF-8")
        } catch (GeneralSecurityException e) {
            failed = true
        } catch (String e) {
            failed = true
        }
        if (failed) {
            throw "SECRET_CIPHER_FAILURE: Falha ao decifrar o segredo guardado"
        }
        return plain
    }
    // A fresh key for the docs: 32 random bytes, base64.
    static String generateKeyBase64() {
        var bytes = new byte[32]
        new SecureRandom().nextBytes(bytes)
        return Base64.getEncoder().encodeToString(bytes)
    }
}
