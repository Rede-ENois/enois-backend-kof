package kernel.security

import kernel.db.*
import kernel.time.*

// Which user a session token belongs to. The filters that key buckets by user (RateLimitSessions)
// code against this type so tests can count lookups. An abstract class, not an interface: a Kof
// interface declared in a package cannot be implemented (KOF_GAPS G30).
abstract class SessionLookup {
    // User id of a live session (not revoked, not expired), or null.
    String? findActiveUserId(token: String) = null
}

// auth_sessions / users, read directly with tiny queries (the owning identity and profile domains
// come later). Mirror of AuthSessionPersistenceAdapter.findActiveUserId and UserProfile.identityVerified.
class AuthStore extends SessionLookup {
    Db store
    public constructor(store: Db) {
        this.store = store
    }
    // The table holds only the SHA-256 of the token. A raw (unhashed) row is still honoured for the
    // deploy window in which an old pod may write one, unless the presented value has the shape of a
    // stored hash: a hash copied out of the table must not turn back into a live session.
    String? findActiveUserId(token: String) {
        var now = Time.nowIso()
        var hashed = SecurityDigest.sha256Hex(token)
        var row = lookup(hashed)
        if (row == null && !AuthStore.looksLikeStoredHash(token)) {
            row = lookup(token)
        }
        if (row == null) {
            return null
        }
        if (row.isNull("revoked_at") == false) {
            return null
        }
        var expires = row.getInstantOrNull("expires_at")
        if (expires == null) {
            return null
        }
        if (Time.toMillis(expires) <= Time.toMillis(now)) {
            return null
        }
        return row.getStr("user_id")
    }
    DbRow? lookup(key: String) = store.queryOptional("select user_id, expires_at, revoked_at from auth_sessions where token = ?", DbParams().bindStr(key))
    // A deleted account has no row: the session is not refused here (same as the Java check).
    Bool identityVerified(userId: String) {
        var row = store.queryOptional("select email_verified_at, totp_enabled_at, email_otp_enabled_at, federated_second_factor_at from users where id = ?", DbParams().bindStr(userId))
        if (row == null) {
            return true
        }
        return !row.isNull("email_verified_at") || !row.isNull("totp_enabled_at") || !row.isNull("email_otp_enabled_at") || !row.isNull("federated_second_factor_at")
    }
    // Issued tokens are base64url, never 64 lower-case hex.
    static Bool looksLikeStoredHash(value: String) {
        if (value.length() != 64) {
            return false
        }
        var i = 0
        while (i < 64) {
            if ("0123456789abcdef".indexOf(value.substring(i, i + 1)) < 0) {
                return false
            }
            i = i + 1
        }
        return true
    }
}
