package kernel.security

import kernel.config.*

// Text carrying the vocabulary of the serial attack (content titles/names, not only accounts). Every
// module's showcase uses it to avoid showing content created with the attack pattern even when the
// author was not (yet) banned ("MSM..." events, "Probe Escrow" listings).
//
//   var suspicious = SuspiciousText.fromConfig(platform.cfg)          // CONTENT_SWEEP_PATTERNS
//   if (suspicious.matches1(title) || suspicious.matchesAny(listOf(title, description))) { ... }
class SuspiciousText {
    List<String> patterns
    public constructor(patternList: String) {
        this.patterns = listOf<String>()
        for (var part in patternList.split(",")) {
            var p = part.trim().toLowerCase()
            if (p.length() > 0) {
                patterns.add(p)
            }
        }
    }
    // The deployed default of application.properties (rede.moderation.content-sweep.patterns).
    static String defaultPatterns() = "probe,idor,redteam,red team,duplo aceite,reembolso integral,teste de escrow,autorizacao de objetos,contrato para testar,msm"
    static SuspiciousText fromConfig(cfg: Config) = SuspiciousText(cfg.getStr("CONTENT_SWEEP_PATTERNS", SuspiciousText.defaultPatterns()))
    // Null/blank never matches.
    Bool matches1(field: String?) {
        if (patterns.size() == 0) {
            return false
        }
        if (field == null) {
            return false
        }
        if (field.trim().length() == 0) {
            return false
        }
        var normalized = field.toLowerCase()
        for (var p in patterns) {
            if (normalized.contains(p)) {
                return true
            }
        }
        return false
    }
    // Any of the fields carries the pattern?
    Bool matchesAny(fields: List<String>) {
        for (var f in fields) {
            if (this.matches1(f)) {
                return true
            }
        }
        return false
    }
}
