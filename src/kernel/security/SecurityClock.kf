package kernel.security

import java.lang.System

// Wall clock of every limiter and guard. Tests move it with advanceSeconds instead of sleeping
// (the Java tests injected a java.time.Clock).
class SecurityClock {
    static Long skewMs = 0L
    static Long nowMillis() = System.currentTimeMillis() + SecurityClock.skewMs
    static advanceSeconds(seconds: Long) {
        SecurityClock.skewMs = SecurityClock.skewMs + seconds * 1000L
    }
    static reset() {
        SecurityClock.skewMs = 0L
    }
}
