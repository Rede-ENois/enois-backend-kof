package kernel.time

import java.lang.System
import java.time.Instant

// Instants travel through the domain as ISO-8601 UTC strings, exactly what the Java app
// serialises (`2026-11-04T16:05:00.123456Z`). Use millis only for arithmetic.
class Time {
    static String nowIso() = Instant.now().toString()
    static Long nowMillis() = System.currentTimeMillis()
    static Long toMillis(iso: String) = Instant.parse(iso).toEpochMilli()
    static String fromMillis(millis: Long) = Instant.ofEpochMilli(millis).toString()
    static String plusSeconds(iso: String, seconds: Long) = Instant.parse(iso).plusSeconds(seconds).toString()
    // `2026-11-04` (UTC), the format of LocalDate columns.
    static String todayIso() = Instant.now().toString().substring(0, 10)
    // A database TIMESTAMP rendered by JDBC (`2026-11-04 16:05:00.123456`, UTC) as the ISO instant.
    static String fromDbTimestamp(raw: String) {
        var t = raw.trim().replace(" ", "T")
        if (!t.endsWith("Z")) {
            t = t + "Z"
        }
        return Instant.parse(t).toString()
    }
}
