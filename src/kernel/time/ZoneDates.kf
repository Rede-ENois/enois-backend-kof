package kernel.time

import java.time.Instant
import java.time.LocalDate
import java.time.ZoneId

// Calendar days in a named zone (the Java `LocalDate.ofInstant(instant, ZoneId.of("America/Sao_Paulo"))`). A sign-up at 22:00 in
// Sao Paulo belongs to that day, not to the next UTC day. Days travel as `YYYY-MM-DD` text.
//
//   ZoneDates.dayOf("2026-11-05T01:30:00Z", "America/Sao_Paulo")      // "2026-11-04"
//   ZoneDates.startOfDay("2026-11-04", "America/Sao_Paulo")          // "2026-11-04T03:00:00Z"
//   ZoneDates.plusDays("2026-11-04", 3)                              // "2026-11-07"
class ZoneDates {
    static String dayOf(iso: String, zone: String) = Instant.parse(iso).atZone(ZoneId.of(zone)).toLocalDate().toString()
    static String startOfDay(day: String, zone: String) = LocalDate.parse(day).atStartOfDay(ZoneId.of(zone)).toInstant().toString()
    static String plusDays(day: String, days: Int) = LocalDate.parse(day).plusDays(days as Long).toString()
    static String today(zone: String) = ZoneDates.dayOf(Instant.now().toString(), zone)
}
