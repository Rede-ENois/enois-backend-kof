package kernel.time

import java.time.LocalDate

// ISO-8601 week of a calendar day (WeekFields.ISO: weeks start on Monday, week 1 holds the first
// Thursday of the year). Rendered like the Java `weekBasedYear + "-W" + weekOfWeekBasedYear`, no zero padding.
//
//   IsoWeeks.key("2026-11-04")    // "2026-W45"
class IsoWeeks {
    static String key(day: String) {
        var date = LocalDate.parse(day)
        var dayOfWeek = date.getDayOfWeek().getValue()
        var thursday = date.plusDays(4 - dayOfWeek as Long)
        var week = (thursday.getDayOfYear() - 1) / 7 + 1
        return "" + thursday.getYear() + "-W" + week
    }
}
