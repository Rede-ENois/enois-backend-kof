package kernel.jobs

import java.util.concurrent.locks.ReentrantLock

// A mutual exclusion lock for a critical section of one process (the Java `synchronized` methods): callers wait
// their turn. There is no cross-pod lock, like the rest of kernel.jobs. Pair every `enter` with one `leave`; since a
// `finally` after a rethrow is unsafe (KOF_GAPS G12), capture the failure, leave, then rethrow.
//
//   var gate = ProcessLock()
//   gate.enter()
//   var failure = ""
//   try { work() } catch (String e) { failure = e }
//   gate.leave()
//   if (failure.length() > 0) { throw failure }
class ProcessLock {
    ReentrantLock gate = new ReentrantLock()
    public constructor() {}
    enter() {
        gate.lock()
    }
    leave() {
        gate.unlock()
    }
}
