package kernel.push

// Fixed P-256 key pairs in the base64url form `npx web-push generate-vapid-keys` prints, for tests only:
// a VAPID identity and a "device" (browser) key. They protect nothing: production keys come from
// VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY. (Generating them at runtime needs Utils.encode(ECPrivateKey),
// which the compiler binds to the wrong overload, KOF_GAPS G51.)
class WebPushKeys {
    // [publicKey, privateKey] of the test VAPID identity.
    static List<String> vapid() = listOf<String>("BEKiAeRKvrN_Kaf7NKiXztMiMomiZITgSd8h2ijFMI6ZYpg3Q1HKhII6c5qlaC_gtmCOE777jiRgZJQ8LOyLggw", "Jq7ynkbuzr09ZsGjBOgeYzTspxGVsu4VVsduts0i7BU")
    // [publicKey, privateKey] of a test device.
    static List<String> device() = listOf<String>("BA7mp7BmfVBFdp6fOTe6JrheXHN6qQ_SLjQgnseys3tJvknMQmqDDxKeff9pwJmy6DDSYkmDqMaXB53IKprZXTM", "AM9GbYRauDfb8Lp-MrB6QQJ3LfCXAaaGZ1R2Au60Qvog")
}
