package kernel.id

import java.util.UUID

// Identifier helpers shared by the stores.
class Ids {
    // Random UUID text, like UUID.randomUUID().toString() in the Java services.
    static String uuid() = UUID.randomUUID().toString()
    // Prefixed id without dashes, e.g. Ids.prefixed("risk_") -> risk_3f2a... (RiskEngine ids).
    static String prefixed(prefix: String) = prefix + UUID.randomUUID().toString().replace("-", "")
}
