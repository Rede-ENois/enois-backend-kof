package kernel.search

// Recursive-descent parser of BooleanQuery (precedence NOT > AND > OR). Never fails on bad syntax:
// unbalanced input is read as literal text. Only size and depth limits reject, through `rejection`.
class BooleanParser {
    List<BooleanToken> tokens
    Int position = 0
    String rejection = ""
    public constructor(tokens: List<BooleanToken>) {
        this.tokens = tokens
    }
    // OR has the lowest precedence: it joins the AND blocks.
    BooleanNode? parseExpression(depth: Int) {
        if (depth > BooleanQuery.maxDepth()) {
            rejection = "Busca com parenteses aninhados demais."
            return null
        }
        var branches = listOf<BooleanNode>()
        var left = this.parseAnd(depth)
        if (left != null) {
            branches.add(left)
        }
        while (rejection == "" && this.peekIs("OR")) {
            position = position + 1
            var right = this.parseAnd(depth)
            if (right != null) {
                branches.add(right)
            }
        }
        if (branches.size() == 0) {
            return null
        }
        if (branches.size() == 1) {
            return branches.get(0)
        }
        return BooleanNode.group("OR", branches)
    }
    // Neighbouring terms are an AND (the search default), also after NOT.
    BooleanNode? parseAnd(depth: Int) {
        var children = listOf<BooleanNode>()
        var going = true
        while (going && rejection == "") {
            if (this.peekIs("AND")) {
                position = position + 1
            }
            else {
                if (!this.startsPrimary()) {
                    going = false
                }
                else {
                    var node = this.parseUnary(depth)
                    if (node != null) {
                        children.add(node)
                    }
                }
            }
        }
        if (children.size() == 0) {
            return null
        }
        if (children.size() == 1) {
            return children.get(0)
        }
        return BooleanNode.group("AND", children)
    }
    BooleanNode? parseUnary(depth: Int) {
        if (this.peekIs("NOT")) {
            position = position + 1
            var child = this.parseUnary(depth)
            if (child == null) {
                return null
            }
            return BooleanNode.negate(child)
        }
        return this.parsePrimary(depth)
    }
    BooleanNode? parsePrimary(depth: Int) {
        if (position >= tokens.size()) {
            return null
        }
        var token = tokens.get(position)
        position = position + 1
        if (token.kind == "OPEN") {
            var inner = this.parseExpression(depth + 1)
            // Unclosed parenthesis: go on as if it closed at the end.
            if (this.peekIs("CLOSE")) {
                position = position + 1
            }
            return inner
        }
        if (token.kind == "PHRASE") {
            return BooleanNode.phrase(token.text)
        }
        if (token.kind == "TERM") {
            return BooleanNode.term(token.text)
        }
        // A stray ")" or an operator where a term should be: ignored.
        return null
    }
    Bool startsPrimary() {
        if (position >= tokens.size()) {
            return false
        }
        var kind = tokens.get(position).kind
        return kind == "OPEN" || kind == "PHRASE" || kind == "TERM" || kind == "NOT"
    }
    Bool peekIs(kind: String) {
        if (position >= tokens.size()) {
            return false
        }
        return tokens.get(position).kind == kind
    }
}
