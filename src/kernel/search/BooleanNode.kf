package kernel.search

// A node of a parsed boolean search. `kind` is MATCH_ALL, TERM, PHRASE, AND, OR or NOT; `text` holds
// the term/phrase; `children` the operands (AND/OR: two or more, NOT: exactly one).
class BooleanNode {
    String kind
    String text
    List<BooleanNode> children
    public constructor(kind: String, text: String, children: List<BooleanNode>) {
        this.kind = kind
        this.text = text
        this.children = children
    }
    static BooleanNode matchAll() = BooleanNode("MATCH_ALL", "", listOf<BooleanNode>())
    static BooleanNode term(text: String) = BooleanNode("TERM", text, listOf<BooleanNode>())
    static BooleanNode phrase(text: String) = BooleanNode("PHRASE", text, listOf<BooleanNode>())
    static BooleanNode group(kind: String, children: List<BooleanNode>) = BooleanNode(kind, "", children)
    static BooleanNode negate(child: BooleanNode) {
        var one = listOf<BooleanNode>()
        one.add(child)
        return BooleanNode("NOT", "", one)
    }
    // Compact form for logs and tests: `AND(java,OR(kotlin,"a b"),NOT(x))`.
    String describe() {
        if (kind == "MATCH_ALL") {
            return "*"
        }
        if (kind == "TERM") {
            return text
        }
        if (kind == "PHRASE") {
            return "\"" + text + "\""
        }
        var parts = ""
        var first = true
        for (var c in children) {
            if (!first) {
                parts = parts + ","
            }
            parts = parts + c.describe()
            first = false
        }
        return kind + "(" + parts + ")"
    }
}
