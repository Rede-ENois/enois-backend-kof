package kernel.cache

import java.util.concurrent.CountDownLatch

// A load in progress for one key: the first caller runs it, the others wait on the latch and read
// its outcome (the `sync = true` of @Cacheable).
class CacheFlight {
    CountDownLatch done = new CountDownLatch(1)
    String value = ""
    String failure = ""
    Bool failed = false
}
