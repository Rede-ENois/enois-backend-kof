package services

import profile.*

record ServiceListingView(String id, String sellerId, String? sellerName, String? sellerAvatar, ProfileNameStyle? sellerStyle, String category, String title, String description, String deliverables, Long price, String currency, Int deliveryDays, String status, String createdAt)

record ServiceRequestView(String id, String requesterId, String category, String title, String description, String deliverables, Long budgetMin, Long budgetMax, String? deadline, String status, String createdAt)

record ServiceProposalView(String id, String requestId, String userId, String message, Long price, String status, String createdAt)

record ServiceContractView(String id, String? listingId, String? requestId, String buyerId, String sellerId, Long price, String escrowState, String? deliverableNote, String createdAt, String? acceptedAt)

record ServiceCatalogView(List<ServiceListingView> ofertas, List<ServiceRequestView> pedidos)

record ServiceMineView(List<ServiceListingView> ofertas, List<ServiceContractView> contratosComoComprador, List<ServiceContractView> contratosComoVendedor)

record ServiceIdStatus(String id, String status)

record ServiceContractState(String contractId, String state)

record ServiceChatView(String conversationId, String assunto, String listingId, String sellerId)

// The directory offer. `username` resolves the public address; `owned` tells whether the reader is the provider.
record ServiceOfferView(String id, String? username, String slug, String title, String description, String? link, String category, String status, String? reviewNote, Bool owned)

record ServiceOfferCreated(String id, String slug, String status)

record ServiceOfferResubmitted(String id, String status)

record ServiceDeleted(Bool deleted)

class ServicesViews {
    static ServiceListingView listing(l: ServiceListing, seller: ServiceSeller?) {
        if (seller == null) {
            return ServiceListingView(l.id(), l.sellerId(), null, null, null, l.category(), l.title(), l.description(), l.deliverables(), l.price(), l.currency(), l.deliveryDays(), l.status(), l.createdAt())
        }
        return ServiceListingView(l.id(), l.sellerId(), seller.name(), seller.avatar(), seller.nameStyle(), l.category(), l.title(), l.description(), l.deliverables(), l.price(), l.currency(), l.deliveryDays(), l.status(), l.createdAt())
    }
    static List<ServiceListingView> listings(listings: List<ServiceListing>, sellers: Map<String,ServiceSeller>) {
        var out = listOf<ServiceListingView>()
        for (var l in listings) {
            out.add(ServicesViews.listing(l, sellers.get(l.sellerId())))
        }
        return out
    }
    static ServiceRequestView request(r: ServiceRequest) = ServiceRequestView(r.id(), r.requesterId(), r.category(), r.title(), r.description(), r.deliverables(), r.budgetMin(), r.budgetMax(), r.deadline(), r.status(), r.createdAt())
    static ServiceProposalView proposal(p: ServiceProposal) = ServiceProposalView(p.id(), p.requestId(), p.userId(), p.message(), p.price(), p.status(), p.createdAt())
    static ServiceContractView contract(c: ServiceContract) = ServiceContractView(c.id(), c.listingId(), c.requestId(), c.buyerId(), c.sellerId(), c.price(), c.escrowState(), c.deliverableNote(), c.createdAt(), c.acceptedAt())
    static List<ServiceContractView> contracts(list: List<ServiceContract>) {
        var out = listOf<ServiceContractView>()
        for (var c in list) {
            out.add(ServicesViews.contract(c))
        }
        return out
    }
    static ServiceOfferView offer(o: ServiceOffer, username: String?, viewerId: String?) {
        var owned = false
        if (viewerId != null) {
            owned = o.userId() == viewerId
        }
        return ServiceOfferView(o.id(), username, o.slug(), o.title(), o.description(), o.link(), o.category(), o.status(), o.reviewNote(), owned)
    }
}
