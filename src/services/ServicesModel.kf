package services

import profile.*

// A paid service offered by a professional (Fiverr model). status: ACTIVE, REMOVED. currency: FAISCA or BRL.
record ServiceListing(String id, String sellerId, String category, String title, String description, String deliverables, Long price, String currency, Int deliveryDays, String status, String createdAt, String updatedAt)

// What a person needs, with a budget range. status: OPEN, CHOSEN, CLOSED.
record ServiceRequest(String id, String requesterId, String category, String title, String description, String deliverables, Long budgetMin, Long budgetMax, String? deadline, String status, String createdAt, String updatedAt)

// status: SENT, CHOSEN, DECLINED.
record ServiceProposal(String id, String requestId, String userId, String message, Long price, String status, String createdAt)

// The escrow. escrowState: HELD, RELEASED, REFUNDED. `acceptedAt` is the decision time.
record ServiceContract(String id, String? listingId, String? requestId, String buyerId, String sellerId, Long price, String escrowState, String? deliverableNote, String createdAt, String? acceptedAt)

// A service of the community directory (same mechanics as the games): submitted, the moderation publishes or
// rejects, the owner edits and resubmits. status: SUBMITTED, PUBLISHED, REJECTED, SUSPENDED.
record ServiceOffer(String id, String userId, String slug, String title, String description, String? link, String category, String status, String? reviewedBy, String? reviewNote, String createdAt, String updatedAt)

// Who provides the services (name, photo and name style); null fields when the account is gone.
record ServiceSeller(String? name, String? avatar, ProfileNameStyle? nameStyle)

// Request bodies. A missing number reads as 0 and a missing text as null, like the Java records.
record ServiceListingBody(String? category, String? title, String? description, String? deliverables, Long? price, String? currency, Int? deliveryDays)

record ServiceRequestBody(String? category, String? title, String? description, String? deliverables, Long? budgetMin, Long? budgetMax, String? deadline)

record ServiceProposeBody(String? message, Long? price)

record ServiceChooseBody(String? proposalId)

record ServiceDeliverBody(String? note)

record ServiceChatBody(String? message)

record ServiceOfferBody(String? title, String? description, String? link, String? category)

class ServiceCategories {
    static List<String> all() = listOf("DESENVOLVIMENTO", "FRONTEND", "BACKEND", "DESIGN", "COPYWRITING", "SEO", "MARKETING", "OUTROS")
}
