package services

import coin.*
import kernel.*
import messaging.*
import profile.*

// Composition of the services domain: the freelance escrow (/servicos) and the community directory (/services).
// Main.kf calls ServicesModule.install(platform, shared, coin, profiles, messaging) after those modules; the games
// domain, when ported, passes its own ServiceLinkGuard subclass to installWith.
class ServicesModule {
    ServicesService services
    ServiceOfferService offers
    public constructor(services: ServicesService, offers: ServiceOfferService) {
        this.services = services
        this.offers = offers
    }
    static ServicesModule install(platform: Platform, shared: SharedServices, coin: CoinModule, profiles: ProfileModule, messaging: MessagingModule) = ServicesModule.installWith(platform, shared, coin, profiles, messaging, ServiceLinkGuard())
    static ServicesModule installWith(platform: Platform, shared: SharedServices, coin: CoinModule, profiles: ProfileModule, messaging: MessagingModule, linkGuard: ServiceLinkGuard) {
        var store = ServicesStore(platform.db)
        var services = ServicesService(platform.db, store, coin.service, profiles.directory, messaging.service, shared.suspiciousText)
        var offers = ServiceOfferService(platform.db, store, profiles.directory, linkGuard)
        ServicesRoutes.register(platform.server, services)
        ServiceOfferRoutes.register(platform.server, offers)
        return ServicesModule(services, offers)
    }
}
