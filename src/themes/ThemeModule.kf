package themes

import kernel.*
import kernel.security.*

class ThemeModule {
    ThemeService service
    public constructor(service: ThemeService) {
        this.service = service
    }
    static ThemeModule install(platform: Platform, shared: SharedServices, hooks: SecurityHooks) {
        var service = ThemeService(ThemeStore(platform.db))
        ThemeRoutes.register(platform.server, service)
        return ThemeModule(service)
    }
}
