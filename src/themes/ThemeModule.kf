package themes

import kernel.*
import kernel.security.*

class ThemeModule {
    ThemeService service
    public constructor(service: ThemeService) {
        this.service = service
    }
    static ThemeModule install(platform: Platform, shared: SharedServices, hooks: SecurityHooks) = ThemeModule.withService(platform, ThemeService(ThemeStore(platform.db)))
    // The composition builds the service first because preferences asks it whether a gallery theme is published.
    static ThemeModule withService(platform: Platform, service: ThemeService) {
        ThemeRoutes.register(platform.server, service)
        return ThemeModule(service)
    }
}
