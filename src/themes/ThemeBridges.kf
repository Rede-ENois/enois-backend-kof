package themes

import kernel.db.*
import preferences.*

// preferences: does a published community theme with this id exist (ThemeGalleryUseCase.isPublished), asked to the
// themes service instead of reading `theme_gallery`.
class ThemesPreferencesGallery extends PreferencesThemeGallery {
    ThemeService service
    public constructor(store: Db, service: ThemeService) {
        super(store)
        this.service = service
    }
    Bool isPublished(themeId: String) = service.isPublished(themeId)
}
