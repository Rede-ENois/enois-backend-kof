package themes

// A theme published in the community gallery. The package is a JSON of design TOKENS (no free CSS, no
// images); `status` is PUBLISHED or HIDDEN.
record ThemePackage(String id, String authorId, String name, String? description, String packageJson, String modeDefault, Int installs, String status, Int reported, String createdAt)

// What the gallery endpoints answer. The package leaves as `packageJson`, the key the front and the public
// documentation already use.
record ThemeGalleryView(String id, String name, String description, String packageJson, String modeDefault, Int installs, String createdAt)

// POST and PATCH body. On PATCH whatever is left out of the body stays as it is.
record ThemeRequest(String? name, String? description, String? packageJson, String? modeDefault)

class ThemeViews {
    static ThemeGalleryView of(t: ThemePackage) {
        var description = t.description()
        if (description == null) {
            return ThemeGalleryView(t.id(), t.name(), "", t.packageJson(), t.modeDefault(), t.installs(), t.createdAt())
        }
        return ThemeGalleryView(t.id(), t.name(), description, t.packageJson(), t.modeDefault(), t.installs(), t.createdAt())
    }
}
