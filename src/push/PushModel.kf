package push

// A device registered for Web Push (table `push_subscriptions`).
record PushSubscriptionRecord(String id, String userId, String endpoint, String p256dh, String auth, String createdAt, String? lastSeenAt)

// What reaches the device: the notification id, the texts, where it opens and the replace-tag.
record PushMessage(String notificationId, String title, String body, String? url, String? tag)

// GET /push/config (PushConfigView). `publicKey` is null while push is off.
record PushConfigView(Bool enabled, String? publicKey)

// POST /push/subscriptions answer (SubscriptionView).
record PushSubscriptionView(String id)

// POST /push/subscriptions body (SubscriptionRequest); every field may be absent.
record PushKeysBody(String? p256dh, String? auth)

record PushSubscriptionBody(String? endpoint, PushKeysBody? keys)
