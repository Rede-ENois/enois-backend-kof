package push

import kernel.db.*
import presence.*

// push asks the presence domain (PresenceService.allowPush: anything but DO_NOT_DISTURB) instead of reading
// `user_presence`. AppWiring passes it to PushModule.withPresence.
class PresencePushBridge extends PushPresence {
    PresenceService service
    public constructor(database: Db, service: PresenceService) {
        super(database)
        this.service = service
    }
    Bool allowPush(userId: String) = service.allowPush(userId)
}
