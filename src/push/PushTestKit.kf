package push

// Test double of the outgoing push: records every message instead of calling a push service.
class RecordingPushSender extends PushSender {
    List<String> users = listOf<String>()
    List<PushMessage> messages = listOf<PushMessage>()
    Bool enabled = true
    public constructor() {
        super()
    }
    Bool isEnabled() = enabled
    String? publicKey() {
        if (enabled) {
            return "test-public-key"
        }
        return null
    }
    sendToUser(userId: String, message: PushMessage) {
        users.add(userId)
        messages.add(message)
    }
    // How many messages went to this user.
    Int countFor(userId: String) {
        var n = 0
        for (var u in users) {
            if (u == userId) {
                n = n + 1
            }
        }
        return n
    }
    clear() {
        users.clear()
        messages.clear()
    }
}
