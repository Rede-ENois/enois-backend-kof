package jobs

import profile.*

// Records of the jobs domain. Instants are ISO-8601 strings (Instant.toString() of the Java service),
// money is kept in cents (`Long?`, null on the old free-text jobs) and stored as DECIMAL(12,2).
// A field of the application form the author defines (JobApplicationField).
record JobFieldRecord(String id, String label, String type, Bool required, Int position)

// A job of the platform (Job + JobJpaEntity).
record JobRecord(String id, String title, String company, String? logo, String? location, String type, String level, String? salary, String currency, Long? salaryMin, Long? salaryMax, String? salaryPeriod, String? description, List<String> skills, List<JobFieldRecord> applicationFields, String postedBy, String? communityAgreedAt, String postedAt, String updatedAt, String status, String? closedAt, String? companyId)

// The answer to one field, with the label frozen at submission time.
record JobAnswerRecord(String fieldId, String label, String value, Int position)

// An application (JobApplication). `candidateSnapshot` is the JSON frozen at submission.
record JobApplicationRecord(String id, String jobId, String userId, String? message, String? candidateSnapshot, String appliedAt, List<JobAnswerRecord> answers, String status, String? feedback, String? reviewedAt)

// A job of an outside platform or one a person of the community listed (ExternalJob).
record ExternalJobRecord(String id, String platform, String externalId, String title, String? company, String? location, String? salary, String? currency, String url, String importedAt, String lastCheckedAt, String status, String? canonicalUrl, String? applyEmail, String? submittedBy, String? description, String? salaryMin, String? salaryMax, String? salaryPeriod, Bool salaryNotInformed)

// What a source (JobRadar, open APIs) found, normalised (JobImportSource.ExternalJob).
record JobSourceItem(String externalId, String? title, String? company, String? location, String? description, String? salary, String? employmentType, String url, String? applyUrl, String platform, String? publishedAt)

// ---- JSON views (field order is the Jackson record order of the Java DTOs) ----
record JobAuthorView(String id, String username, String name, String? avatar, String? headline, Int reputation, Bool identityVerified, ProfileNameStyle? nameStyle)

record JobFieldView(String id, String label, String type, Bool required)

record JobView(String id, String title, String company, String? logo, String? location, String? type, String? level, String? salary, String? currency, List<String> skills, String? postedAt, Int matchScore, Bool applied, Bool saved, Bool owner, Int applicationsCount, JobAuthorView? author, List<JobFieldView> applicationFields, String status, String? closedAt, String sourceType, String? sourceUrl, String? sourcePlatform, String? applyEmail, String? description, String? salaryMin, String? salaryMax, String? salaryPeriod, String? salaryLabel, Bool salaryNotInformed, String? companySlug)

record JobPageView(List<JobView> items, String? nextCursor)

record JobCandidateView(String userId, String name, String socialName, String username, String headline, String location, String avatar, List<String> skills, Int experienceYears, Int experiencesCount, Int reputation, Bool identityVerified, String resumeUrl, String resumeName, String identity, String industry)

record JobAnswerView(String label, String value)

record JobApplicationView(String id, String jobId, String status, String appliedAt, Int answersCount, JobCandidateView? candidate, String? message, List<JobAnswerView> answers, String? feedback, String? reviewedAt)

record JobMyApplicationView(String id, String jobId, String jobTitle, String jobCompany, String status, String? feedback, String? reviewedAt, String appliedAt)

record JobDeleteView(String jobId, Int unanswered, Bool penalized)

record JobStatusView(String id, String status)

record JobCompanySummary(String name, String logo, Long openJobs, String origem)

record JobNamedCount(String name, String? logo, Long count)

record JobPageJob(String id, String title, String? location, String type, String level, String postedAt)

record JobEligibilityDecision(Bool allowed, Int reputation, Int requiredReputation, Bool identityVerified, Bool identityEnforced, String? reason)

// ---- request bodies ----
record JobFieldBody(String? label, String? type, Bool required)

record JobCreateBody(String? title, String? company, String? logo, String? location, String? type, String? level, String? salary, String? currency, String? salaryMin, String? salaryMax, String? salaryPeriod, String? description, List<String>? skills, Bool communityAgreement, List<JobFieldBody>? applicationFields, String? companyId)

record JobExternalBody(String? title, String? company, String? location, String? url, String? description, String? salaryMin, String? salaryMax, String? salaryPeriod, String? applyEmail, Bool communityAgreement, Bool salaryNotInformed)

record JobAnswerBody(String? fieldId, String? value)

record JobApplyBody(String? message, List<JobAnswerBody>? answers)

record JobStatusBody(String? status, String? feedback)

// What the author typed for one field / the candidate answered (JobService.JobFieldInput / JobAnswerInput).
record JobFieldInput(String? label, String? type, Bool required)

record JobAnswerInput(String? fieldId, String? value)

record JobDeleteResult(String jobId, Int unanswered, Bool penalized)

// The professional identity of a person (corporate_profiles), what an application carries.
record JobProfessional(String userId, String username, String name, String? headline, String? avatar, String? location, String? industry)

// A company page (companies).
record JobCompanyPage(String id, String slug, String name, String? logo, String ownerUserId, String status)
