package search

import kernel.*
import kernel.security.*

class SearchModule {
    SearchService service
    public constructor(service: SearchService) {
        this.service = service
    }
    static SearchModule install(platform: Platform, shared: SharedServices, hooks: SecurityHooks) {
        var service = SearchService(SearchStore(platform.db), shared.blockedUsers)
        SearchRoutes.register(platform.server, service, NamedRateLimiters(platform.cfg))
        return SearchModule(service)
    }
}
