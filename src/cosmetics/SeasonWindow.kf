package cosmetics

import kernel.text.*

// A yearly sale window as inclusive month-days ("10-15" to "11-02"). A window whose start comes after its end
// wraps the year (Reveillon: "12-26" to "01-06"). A month-day is the Int month * 100 + day (1015 is October 15th).
class SeasonWindow {
    Int start
    Int end
    public constructor(start: Int, end: Int) {
        this.start = start
        this.end = end
    }
    // February has 29 days here: MonthDay accepts "02-29".
    static Int daysIn(month: Int) {
        if (month == 2) {
            return 29
        }
        if (month == 4 || month == 6 || month == 9 || month == 11) {
            return 30
        }
        return 31
    }
    // Parses "MM-dd"; invalid text throws (the catalog is validated at startup).
    static Int monthDay(text: String?) {
        if (text == null) {
            throw "INVALID_SEASON_WINDOW: a season window needs a start and an end."
        }
        if (!Regexes.matches("[0-9]{2}-[0-9]{2}", text)) {
            throw "INVALID_SEASON_WINDOW: " + text
        }
        var month = text.substring(0, 2).toInt()
        var day = text.substring(3, 5).toInt()
        if (month < 1 || month > 12 || day < 1 || day > SeasonWindow.daysIn(month)) {
            throw "INVALID_SEASON_WINDOW: " + text
        }
        return month * 100 + day
    }
    static SeasonWindow parse(start: String?, end: String?) {
        var from = SeasonWindow.monthDay(start)
        var to = SeasonWindow.monthDay(end)
        return SeasonWindow(from, to)
    }
    // The month-day of an ISO day ("2026-11-02" -> 1102).
    static Int ofDay(isoDay: String) = SeasonWindow.monthDay(isoDay.substring(5, 10))
    Bool contains(day: Int) {
        if (start <= end) {
            return day >= start && day <= end
        }
        return day >= start || day <= end
    }
    static String text(monthDay: Int) {
        var month = monthDay / 100
        var day = monthDay % 100
        var out = ""
        if (month < 10) {
            out = "0"
        }
        out = out + month + "-"
        if (day < 10) {
            out = out + "0"
        }
        return out + day
    }
    String startText() = SeasonWindow.text(start)
    String endText() = SeasonWindow.text(end)
}
