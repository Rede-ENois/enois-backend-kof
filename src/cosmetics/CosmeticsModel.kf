package cosmetics

// The shop catalog file (resources/cosmetics/catalog.json) as it is read, and the validated records built from it.
// Absent optional properties read as null.
record CatalogItemFile(Int releaseOrder, String? id, String? kind, String? collection, String? name, String? description, Long priceMf, String? cssRing, Bool purchasable, String? icon)

record CatalogWindowFile(String? start, String? end)

record CatalogCollectionFile(String? id, String? name, List<CatalogWindowFile> windows)

// `id` is optional: without it the look keeps the historical `look-<collection>`.
record CatalogLookFile(String? id, String? collection, String? title, List<String> items, String? statusIcon, String? statusText)

record CatalogFile(List<CatalogCollectionFile> collections, List<CatalogItemFile> items, List<CatalogLookFile> looks)

// One shop item. `kind` is FRAME, BADGE, NAME_STYLE, CARD_THEME, NAMEPLATE, BANNER, PROFILE_EFFECT or GARDEN.
// `collection` is null for the original frames, which are always on sale.
record CosmeticItem(Int releaseOrder, String id, String kind, String? collection, String name, String description, Long priceMf, String cssRing, Bool purchasable, String? icon)

// A ready-made outfit: theme, frame, name style, effect, banner (optional), plate, then badges.
record CosmeticLook(String id, String collection, String title, List<String> items, String? statusIcon, String? statusText)

class CosmeticCollection {
    String id
    String name
    List<SeasonWindow> windows
    public constructor(id: String, name: String, windows: List<SeasonWindow>) {
        this.id = id
        this.name = name
        this.windows = windows
    }
    Bool availableOn(monthDay: Int) {
        for (var w in windows) {
            if (w.contains(monthDay)) {
                return true
            }
        }
        return false
    }
}

// One shop row. `viewer` false means no session: owned/equipped are not sent.
record ShopRow(CosmeticItem item, Bool available, Bool owned, Bool equipped, Bool viewer)

// One ready-made look with the viewer state.
record LookRow(CosmeticLook look, Bool owned, Bool equipped, Bool viewer)

// One collection with its season state and looks.
record CollectionRow(CosmeticCollection collection, Bool available, List<LookRow> looks)

record CosmeticLookPurchase(String id, List<String> bought, Long priceMf)

// ---- shop JSON (field order of the Java views). The guest variants leave owned/equipped out (NON_NULL in Java).
record ShopItemGuestView(String id, String kind, String? collection, String name, String description, Long priceMf, String cssRing, Int releaseOrder, Bool available, Bool purchasable)

record ShopItemView(String id, String kind, String? collection, String name, String description, Long priceMf, String cssRing, Int releaseOrder, Bool available, Bool purchasable, Bool owned, Bool equipped)

record ShopWindowView(String start, String end)

record LookGuestView(String id, String title, List<String> items, String? statusIcon, String? statusText)

record LookView(String id, String title, List<String> items, String? statusIcon, String? statusText, Bool owned, Bool equipped)

record CollectionGuestView(String id, String name, Bool available, List<ShopWindowView> windows, List<LookGuestView> looks)

record CollectionView(String id, String name, Bool available, List<ShopWindowView> windows, List<LookView> looks)

record OwnedView(String id, Bool owned)

record EquippedView(String id, Bool equipped)

record StatusBody(String? text, String? icon)

// ---- events
record CosmeticDuelView(Bool active, String startsAt, String endsAt, Map<String,Long> counts, String? myChoice, String? winner)

record CosmeticHuntView(Bool active, String startsAt, String endsAt, Int spots, List<String> found, Bool completed)

record ChoiceBody(String? choice)

// ---- community cosmetics
record CommunityCosmetic(String id, String creatorId, String kind, String name, String? description, String manifestJson, String license, Bool rightsConfirmed, String status, Int version, Int reported, String createdAt, String updatedAt)

record CommunityCosmeticView(String id, String creatorId, String kind, String name, String description, String manifestJson, String license, String status, Int version, Int reported, String createdAt, String updatedAt)

record CreateCosmeticBody(String? kind, String? name, String? description, String? manifestJson, String? license, Troolean rightsConfirmed)

record UpdateCosmeticBody(String? name, String? description, String? manifestJson, String? license, Troolean rightsConfirmed)

record NameStyleBody(String? theme, String? font, String? color)

record ContributorTagBody(String? color)

record NameStyleView(String? theme, String? font, String? color)

record ContributorTagView(String? color)

record CommunityCosmeticSubmitted(String id, String status)

record CommunityCosmeticReported(String status)
