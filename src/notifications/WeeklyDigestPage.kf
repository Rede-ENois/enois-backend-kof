package notifications

// The HTML of the weekly digest e-mail (resources/templates/email-weekly-digest.html, Thymeleaf in Java):
// same structure and copy, every dynamic text escaped.
class WeeklyDigestPage {
    static String esc(v: String) = v.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;").replace("\'", "&#39;")
    static String h2() = "margin: 0 0 8px 0; color: #1a1a2e; font-size: 16px; font-weight: 600;"
    static String section(title: String, rows: String) = "<tr><td style=\"padding: 24px 40px 0 40px;\"><h2 style=\"" + WeeklyDigestPage.h2() + "\">" + title + "</h2><table role=\"presentation\" style=\"width: 100%; border-collapse: collapse;\">" + rows + "</table></td></tr>"
    static String row(appUrl: String, item: DigestItem, contextPrefix: String) {
        var out = "<tr><td style=\"padding: 12px 0; border-bottom: 1px solid #ecebf5;\"><a href=\"" + WeeklyDigestPage.esc(appUrl + item.path()) + "\" style=\"color: #1a1a2e; text-decoration: none; font-size: 15px; line-height: 1.5;\">" + WeeklyDigestPage.esc(item.title()) + "</a>"
        var context = item.context()
        if (context != null) {
            out = out + "<p style=\"margin: 4px 0 0 0; color: #8b8ba3; font-size: 13px;\">" + WeeklyDigestPage.esc(contextPrefix + context) + "</p>"
        }
        return out + "</td></tr>"
    }
    static String rows(appUrl: String, items: List<DigestItem>, contextPrefix: String) {
        var out = ""
        for (var item in items) {
            out = out + WeeklyDigestPage.row(appUrl, item, contextPrefix)
        }
        return out
    }
    static String render(name: String, appUrl: String, unread: Int, posts: List<DigestItem>, jobs: List<DigestItem>, events: List<DigestItem>, unsubscribeLink: String, year: Int) {
        var greeting = "Oi"
        if (name.length() > 0) {
            greeting = greeting + ", " + WeeklyDigestPage.esc(name)
        }
        var html = "<!DOCTYPE html><html lang=\"pt-BR\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><title>Sua semana no Énóis</title></head>"
        html = html + "<body style=\"margin: 0; padding: 0; background-color: #f8f7ff; font-family: \'Inter\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\">"
        html = html + "<table role=\"presentation\" style=\"width: 100%; border-collapse: collapse; background-color: #f8f7ff;\"><tr><td align=\"center\" style=\"padding: 40px 16px;\">"
        html = html + "<table role=\"presentation\" style=\"width: 100%; max-width: 560px; border-collapse: collapse; background-color: #ffffff; border-radius: 16px;\">"
        html = html + "<tr><td style=\"padding: 32px 40px 8px 40px;\"><p style=\"margin: 0 0 4px 0; color: #8b8ba3; font-size: 13px; font-weight: 600;\">Énóis · resumo da semana</p>"
        html = html + "<h1 style=\"margin: 0 0 12px 0; color: #1a1a2e; font-size: 22px; font-weight: 600;\">" + greeting + ". Foi isso que rolou por perto.</h1>"
        html = html + "<p style=\"margin: 0; color: #4b5563; font-size: 15px; line-height: 1.6;\">Um resumo curto, uma vez por semana. Leia quando der, sem pressa.</p>"
        if (unread == 1) {
            html = html + "<p style=\"margin: 12px 0 0 0; color: #4b5563; font-size: 15px; line-height: 1.6;\">Tem 1 notificação esperando por você.</p>"
        }
        else 
            if (unread > 1) {
                html = html + "<p style=\"margin: 12px 0 0 0; color: #4b5563; font-size: 15px; line-height: 1.6;\">Tem " + unread + " notificações esperando por você.</p>"
            }
        html = html + "</td></tr>"
        if (!posts.isEmpty()) {
            html = html + WeeklyDigestPage.section("Nas suas comunidades e grupos", WeeklyDigestPage.rows(appUrl, posts, "em "))
        }
        if (!jobs.isEmpty()) {
            html = html + WeeklyDigestPage.section("Vagas que combinam com você", WeeklyDigestPage.rows(appUrl, jobs, ""))
        }
        if (!events.isEmpty()) {
            html = html + WeeklyDigestPage.section("Seus eventos nos próximos dias", WeeklyDigestPage.rows(appUrl, events, ""))
        }
        html = html + "<tr><td align=\"center\" style=\"padding: 32px 40px;\"><a href=\"" + WeeklyDigestPage.esc(appUrl + "/feed") + "\" style=\"display: inline-block; padding: 12px 28px; background-color: #6366f1; color: #ffffff; text-decoration: none; border-radius: 999px; font-weight: 600; font-size: 15px;\">Abrir o Énóis</a></td></tr>"
        html = html + "<tr><td style=\"padding: 24px 40px 32px 40px; border-top: 1px solid #ecebf5; text-align: center;\"><p style=\"margin: 0 0 8px 0; color: #8b8ba3; font-size: 12px; line-height: 1.6;\">Você recebe este resumo porque tem uma conta no Énóis. <a href=\"" + WeeklyDigestPage.esc(unsubscribeLink) + "\" style=\"color: #6366f1; text-decoration: underline;\">Não quero mais receber</a>.</p>"
        html = html + "<p style=\"margin: 0; color: #b9b8c9; font-size: 11px;\">Énóis · " + year + "</p></td></tr></table></td></tr></table></body></html>"
        return html
    }
}
