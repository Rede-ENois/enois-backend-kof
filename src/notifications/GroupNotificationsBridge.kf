package notifications

import groups.*
import kernel.db.*

// The groups domain writes notices through its own seam (`groups.GroupNotifications`, a plain insert into
// `notifications`), which sends no push and publishes no event. This subclass routes the same two calls
// through the Notifications API, so a group notice also pushes (after commit) and honours the preferences.
// Switch it on in Main.kf:
//
//   GroupsModule.installWith(platform, shared, GroupProfileLookup(platform.db), GroupAgeGate(platform.db),
//       GroupMediaLookup(platform.db), GroupNotificationsBridge(platform.db, notificationsModule.notifications), GroupCoins())
class GroupNotificationsBridge extends GroupNotifications {
    Notifications api
    public constructor(store: Db, api: Notifications) {
        super(store)
        this.api = api
    }
    create(userId: String, kind: String, actorId: String, title: String, body: String, href: String, ctaLabel: String) {
        api.create(userId, kind, actorId, title, body, href, ctaLabel)
    }
    createCounted(userId: String, kind: String, groupKey: String, actorId: String, title: String, body: String, countedSuffix: String, href: String, ctaLabel: String) {
        api.createCounted(userId, kind, groupKey, actorId, title, body, (count: Int) -> count + countedSuffix, href, ctaLabel)
    }
}
