package notifications

import java.time.Instant
import kernel.error.*

// CursorCodec: page cursors are the ISO instant of the last item. Blank is "no cursor"; anything that
// is not an instant is 400 INVALID_CURSOR. Also used by messaging.
class NotificationCursor {
    static String? decode(cursor: String) {
        if (cursor.trim().length() == 0) {
            return null
        }
        try {
            return Instant.parse(cursor).toString()
        } catch (String bad) {
            throw Errors.api(400, "INVALID_CURSOR", "Cursor invalido.")
        }
    }
}
