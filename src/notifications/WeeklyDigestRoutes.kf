package notifications

import kernel.http.*

// GET and POST /notifications/digest/unsubscribe?token=: public links from the e-mail (the origin gate and
// the write gate already exempt them). GET answers a small HTML page, POST is the RFC 8058 one-click:
// 200 with an empty body, or 400.
class WeeklyDigestRoutes {
    static register(server: HttpServer, digest: WeeklyDigest) {
        server.get("/notifications/digest/unsubscribe", () -> WeeklyDigestRoutes.page(digest.unsubscribeByToken(query("token"))))
        server.post("/notifications/digest/unsubscribe", () -> WeeklyDigestRoutes.oneClick(digest.unsubscribeByToken(query("token"))))
    }
    static String oneClick(ok: Bool) {
        if (ok) {
            return status(200, "")
        }
        return status(400, "")
    }
    // ConfirmationPage.of: fixed server copy, 200 on success and 400 otherwise.
    static String page(ok: Bool) {
        var title = "Link inválido"
        var message = "Este link não é válido. Entre no Énóis e desligue o resumo semanal nas preferências de notificação."
        var code = 400
        if (ok) {
            title = "Resumo semanal desligado"
            message = "Pronto: você não vai mais receber o resumo semanal por e-mail. Se mudar de ideia, dá para religar nas preferências de notificação."
            code = 200
        }
        ResponseHeaders.set("Content-Type", "text/html;charset=UTF-8")
        return status(code, "<!DOCTYPE html><html lang=\"pt-BR\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><title>" + title + "</title></head><body style=\"margin:0;background:#f8f7ff;font-family:\'Inter\',system-ui,sans-serif;display:grid;place-items:center;min-height:100vh\"><div style=\"max-width:440px;background:#fff;border-radius:16px;padding:32px;margin:16px;box-shadow:0 8px 24px -8px rgba(99,102,241,.15);text-align:center\"><h1 style=\"margin:0 0 12px;color:#1a1a2e;font-size:20px\">" + title + "</h1><p style=\"margin:0 0 20px;color:#4b5563;font-size:14px;line-height:1.6\">" + message + "</p><a href=\"https://enois.ia.br\" style=\"display:inline-block;padding:12px 24px;background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;text-decoration:none;border-radius:999px;font-weight:600;font-size:14px\">Ir para o Énóis</a></div></body></html>")
    }
}
