package githubprofile

record GithubUserRepository(String fullName, String name, String? description, String htmlUrl, String? homepage, String? language, List<String> topics, Int stars, Int forks, Bool fork, Bool archived, String? updatedAt, String defaultBranch)
record GithubProfileReadme(String markdown, String repoUrl, String defaultBranch)

// Responses.
record GithubRepoView(String fullName, String name, String? description, String url, String? homepage, String? language, List<String> topics, Int stars, Int forks, Bool fork, Bool archived, String? updatedAt, String defaultBranch)
record GithubReadmeView(String html, String repoUrl)
record GithubImportResult(Int created, List<String> imported, List<String> skipped, List<String> invalid, Bool limitReached)
record GithubImportBody(List<String>? repos)

class GithubProfileViews {
    static GithubRepoView repo(r: GithubUserRepository) = GithubRepoView(r.fullName(), r.name(), r.description(), r.htmlUrl(), r.homepage(), r.language(), r.topics(), r.stars(), r.forks(), r.fork(), r.archived(), r.updatedAt(), r.defaultBranch())
    static List<GithubRepoView> repos(rows: List<GithubUserRepository>) {
        var out = listOf<GithubRepoView>()
        for (var r in rows) {
            out.add(GithubProfileViews.repo(r))
        }
        return out
    }
}
