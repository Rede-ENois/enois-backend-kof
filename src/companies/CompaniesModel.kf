package companies

// Company page (Company): its own identity, NOT a user with another name. One owner (transfer is explicit), the
// team with roles lives in CompanyMember. status: ACTIVE, RESTRICTED, CLOSED.
record Company(String id, String slug, String name, String? description, String? sector, String? size, String? location, String? website, String? logo, String? cover, String ownerUserId, String status, String createdAt, String updatedAt) {
    Bool active() = status == "ACTIVE"
    Bool ownedBy(userId: String) = ownerUserId == userId
}

// role: OWNER (only one), ADMIN, EDITOR, RECRUITER.
record CompanyMember(String id, String companyId, String userId, String role, String createdAt)

// A real problem a company publishes: a paid pilot with deliverables and acceptance criteria. status: OPEN,
// IN_PROGRESS, COMPLETED, CANCELLED. Payment happens outside the platform.
record MicroProject(String id, String companyId, String createdBy, String title, String problem, String? scope, String? deliverables, String? acceptanceCriteria, String? budget, String? deadline, String status, String? selectedProposalId, String createdAt, String updatedAt) {
    Bool isOpen() = status == "OPEN"
}

// status: SENT, SELECTED, DECLINED. `conversationId` is the professional conversation the proposal opened.
record MicroProjectProposal(String id, String projectId, String userId, String message, String status, String proposedAt, String? decidedAt, String? conversationId) {
    Bool isSent() = status == "SENT"
}

// The company's review of the professional it selected, written when it completes the project.
record MicroProjectReview(String projectId, String companyId, String userId, Int rating, String? text, String createdAt)

// A page, the role of the viewer in it (null for a visitor).
record CompanyAccess(Company company, String? role)

// ---------------------------------------------------------------- JSON views (Java records of CompanyController)
record CompanySummaryView(String id, String slug, String name, String? description, String? sector, String? location, String? logo, String? cover)

record CompanyCreatedView(String id, String slug, String name)

record DirectoryEntryView(String kind, String? slug, String name, String? logo, String? sector, String? location, Long openJobs, Long openProjects, Long followers)

record CompanyFollowView(Bool following, Long followers)

record CompanyPageJobView(String id, String title, String? location, String type, String level, String createdAt)

record CompanyStatsView(Long openProjects, Long completedProjects, Long openJobs, Long followers)

// The person behind a member, a proposal or a review. identity CORPORATE = the active professional profile,
// SOCIAL = the fallback.
record CompanyPersonView(String id, String username, String name, String? headline, String? avatar, String identity, String href)

record CompanyReviewView(String projectId, String projectTitle, Int rating, String? text, String createdAt, CompanyPersonView? person)

record CompanyMemberView(String userId, String role, String createdAt, CompanyPersonView? person)

// myProposal: the viewer's proposal status on this project; proposalCount: only for the team.
record MicroProjectView(String id, String companyId, String title, String problem, String? scope, String? deliverables, String? acceptanceCriteria, String? budget, String? deadline, String status, String createdAt, String? myProposal, Int? proposalCount)

record MicroProjectProposalView(String id, String userId, String message, String status, String proposedAt, CompanyPersonView? person, String? conversationId)

record CompanyDetailView(String id, String slug, String name, String? description, String? sector, String? size, String? location, String? website, String? logo, String? cover, String? myRole, List<MicroProjectView> projects, List<CompanyPageJobView> jobs, CompanyStatsView stats, Bool following, List<CompanyReviewView> reviews, String canPropose)

record MicroProjectDetailView(MicroProjectView project, List<MicroProjectProposalView> proposals)

record MicroProjectIdStatus(String id, String status)

record MicroProjectProposalCreated(String id, String status, String? conversationId)

record MicroProjectStatusView(String status)

// ---------------------------------------------------------------- request bodies
record CompanyCreateBody(String? name, String? description, String? sector, String? size, String? location, String? website)

record CompanyUpdateBody(String? name, String? description, String? sector, String? size, String? location, String? website, String? logo, String? cover)

record CompanyAddMemberBody(String? userId, String? role)

record MicroProjectBody(String? title, String? problem, String? scope, String? deliverables, String? acceptanceCriteria, String? budget, String? deadline)

record MicroProjectProposeBody(String? message)

record MicroProjectCompleteBody(Int? rating, String? text)
