package corporate

import kernel.*
import profile.*

// Composition of the corporate domain (professional identity). AppWiring installs it right after profile, before
// the domains that read the identity (feed, messaging, notifications, jobs): they take `service` through their seams.
class CorporateModule {
    CorporateService service
    CorporateStore store
    public constructor(service: CorporateService, store: CorporateStore) {
        this.service = service
        this.store = store
    }
    static CorporateModule install(platform: Platform, profiles: ProfileModule) {
        var store = CorporateStore(platform.db)
        var service = CorporateService(store, profiles.directory)
        CorporateRoutes.register(platform.server, service, ProfileExtensionStore(platform.db))
        return CorporateModule(service, store)
    }
}
