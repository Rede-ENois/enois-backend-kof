package corporate

import profile.*

// The professional identity of an account (CorporateProfile): the same person, a work-facing presentation.
// status: DRAFT (being set up), ACTIVE (ready, public), DISABLED (hidden, nothing deleted).
record CorporateProfile(String userId, String username, String name, String? headline, String? bio, String? avatar, String? banner, String? bannerHtml, String? location, String? industry, String? externalLinks, String status, String createdAt, String updatedAt) {
    Bool active() = status == "ACTIVE"
    CorporateProfile withDetails(headline: String?, bio: String?, avatar: String?, banner: String?, bannerHtml: String?, location: String?, industry: String?, externalLinks: String?, now: String) = CorporateProfile(userId, username, name, headline, bio, avatar, banner, bannerHtml, location, industry, externalLinks, status, createdAt, now)
    CorporateProfile withName(newName: String, now: String) = CorporateProfile(userId, username, CorporateRules.validName(newName), headline, bio, avatar, banner, bannerHtml, location, industry, externalLinks, status, createdAt, now)
    CorporateProfile withUsername(newUsername: String, now: String) = CorporateProfile(userId, CorporateRules.validUsername(newUsername), name, headline, bio, avatar, banner, bannerHtml, location, industry, externalLinks, status, createdAt, now)
    CorporateProfile withStatus(newStatus: String, now: String) = CorporateProfile(userId, username, name, headline, bio, avatar, banner, bannerHtml, location, industry, externalLinks, newStatus, createdAt, now)
}

// Pure rules of the identity. The Java domain threw IllegalArgumentException; the callers here map it.
class CorporateRules {
    // Same format rules as the social @, in a namespace of its own.
    static String usernamePattern() = "^[a-z0-9](?:[a-z0-9._-]{1,28})[a-z0-9]$"
    static String normalize(username: String?) {
        if (username == null) {
            return ""
        }
        return username.trim().toLowerCase()
    }
    static Bool usernameOk(username: String?) = Regexes.matches(CorporateRules.usernamePattern(), CorporateRules.normalize(username))
    static String validUsername(username: String?) {
        if (!CorporateRules.usernameOk(username)) {
            throw "INVALID_CORPORATE_USERNAME"
        }
        return CorporateRules.normalize(username)
    }
    static String validName(name: String?) {
        if (name == null) {
            throw "INVALID_CORPORATE_NAME"
        }
        if (name.trim().length() < 3) {
            throw "INVALID_CORPORATE_NAME"
        }
        return name.trim()
    }
    static CorporateProfile create(userId: String, username: String?, name: String?, now: String) = CorporateProfile(userId, CorporateRules.validUsername(username), CorporateRules.validName(name), null, null, null, null, null, null, null, null, "DRAFT", now, now)
}

// JSON of GET/POST/PATCH /me/business-profile (the Java Map: absent profile -> {"exists":false}).
record CorporateProfileView(Bool exists, String username, String name, String headline, String bio, String avatar, String banner, String bannerHtml, String location, String industry, String externalLinks, String status)

record CorporateMissingView(Bool exists)

// GET /corporate/{username}: the view plus the public portfolio of the account, never the social handle.
record CorporatePublicView(Bool exists, String username, String name, String headline, String bio, String avatar, String banner, String bannerHtml, String location, String industry, String externalLinks, String status, String userId, Bool identityVerified, String? memberSince, List<String> skills, List<ProfileExperienceView> experiences, List<ProfileEducationView> educations, List<ProfileCertificationView> certifications, ProfileLook profileLook)

// GET /me/business-profile/import-preview: what the social profile offers, already fitted to the limits.
record CorporateImportPreview(String? name, String? headline, String? bio, String? avatar, String? banner, String? bannerHtml, String? location)

record CorporateCreateBody(String? username, String? name)

record CorporateDetailsBody(String? headline, String? bio, String? avatar, String? banner, String? bannerHtml, String? location, String? industry, String? externalLinks)

record CorporateNameBody(String? name)

record CorporateUsernameBody(String? username)

record CorporateImportBody(List<String>? fields)
