package suggestions

// Opens the public issue of an approved suggestion. Without a token or a repository for the target the
// gateway is off for that target and the suggestion stays pending. A base class with safe defaults (a Kof
// interface cannot be implemented across packages, KOF_GAPS G30): tests and the real client extend it.
class SuggestionIssueGateway {
    Bool enabled(target: String) = false
    // null when GitHub did not answer; the caller puts the suggestion back in the queue.
    SuggestionIssueRef? createIssue(target: String, title: String, body: String) = null
}
