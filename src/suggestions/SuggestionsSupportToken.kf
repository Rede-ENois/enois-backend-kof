package suggestions

import kernel.security.*
import kernel.db.*
import support.*

// The GitHub token of the suggestions is the one of the support issues (the team standard, rotated together), read on
// every use from the support settings (encrypted value, then the GITHUB_ISSUES_TOKEN fallback), so a change in the
// panel takes effect without a restart.
class SuggestionsSupportToken extends SuggestionsGithubToken {
    SupportGithubConfig settings
    public constructor(store: Db, cipher: SecretCipher, settings: SupportGithubConfig) {
        super(store, cipher, "")
        this.settings = settings
    }
    String token() = settings.token()
}
