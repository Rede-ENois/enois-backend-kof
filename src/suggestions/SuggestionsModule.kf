package suggestions

import kernel.*
import kernel.security.*

class SuggestionsModule {
    SuggestionService service
    public constructor(service: SuggestionService) {
        this.service = service
    }
    static SuggestionsModule install(platform: Platform, shared: SharedServices, hooks: SecurityHooks) {
        var tokens = SuggestionsGithubToken(platform.db, shared.cipher, platform.cfg.getStr("GITHUB_ISSUES_TOKEN", ""))
        return SuggestionsModule.withGateway(platform, SuggestionIssueClient.fromConfig(platform.cfg, tokens))
    }
    // Tests (and the support domain, with its own token source) pass the gateway.
    static SuggestionsModule withGateway(platform: Platform, gateway: SuggestionIssueGateway) {
        var service = SuggestionService(SuggestionStore(platform.db), gateway)
        SuggestionRoutes.register(platform.server, service)
        return SuggestionsModule(service)
    }
}
