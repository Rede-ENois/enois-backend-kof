package suggestions

// A suggestion of improvement sent by a person. The author exists only in here: nothing that identifies
// them goes into the public issue. target is BACKEND, FRONTEND or DESIGN_SYSTEM; status is PENDING (waits for
// a moderator), PUBLISHED (became a public issue) or REJECTED (never leaves the app).
record SuggestionRecord(String id, String userId, String target, String title, String body, String status, String createdAt, String? reviewedBy, String? reviewedAt, Int? githubIssueNumber, String? githubIssueUrl)

// POST /suggestions body. The target is optional on the wire so a missing one is a domain error.
record SuggestionRequest(String? target, String? title, String? body)

// What the author sees: what they wrote and the progress.
record SuggestionView(String id, String target, String title, String body, String status, String? githubIssueUrl, String createdAt)

// What the panel sees: the author id serves moderation actions and never goes to the issue.
record SuggestionAdminView(String id, String userId, String target, String title, String body, String status, String? githubIssueNumber, String? githubIssueUrl, String? reviewedBy, String? reviewedAt, String createdAt)

// A public issue that was opened.
record SuggestionIssueRef(Int number, String? url)

class SuggestionViews {
    static SuggestionView of(s: SuggestionRecord) = SuggestionView(s.id(), s.target(), s.title(), s.body(), s.status(), s.githubIssueUrl(), s.createdAt())
    static SuggestionAdminView admin(s: SuggestionRecord) {
        var number = s.githubIssueNumber()
        if (number == null) {
            return SuggestionAdminView(s.id(), s.userId(), s.target(), s.title(), s.body(), s.status(), null, s.githubIssueUrl(), s.reviewedBy(), s.reviewedAt(), s.createdAt())
        }
        return SuggestionAdminView(s.id(), s.userId(), s.target(), s.title(), s.body(), s.status(), "" + number, s.githubIssueUrl(), s.reviewedBy(), s.reviewedAt(), s.createdAt())
    }
    static List<SuggestionView> views(items: List<SuggestionRecord>) {
        var out = listOf<SuggestionView>()
        for (var s in items) {
            out.add(SuggestionViews.of(s))
        }
        return out
    }
    static List<SuggestionAdminView> adminViews(items: List<SuggestionRecord>) {
        var out = listOf<SuggestionAdminView>()
        for (var s in items) {
            out.add(SuggestionViews.admin(s))
        }
        return out
    }
    static List<String> targets() = listOf("BACKEND", "FRONTEND", "DESIGN_SYSTEM")
    static List<String> statuses() = listOf("PENDING", "PUBLISHED", "REJECTED")
}
