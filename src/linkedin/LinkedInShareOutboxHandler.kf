package linkedin

import kernel.outbox.*

// PostPublished -> LinkedIn, when the person turned the sync on. Only posts of the PROFESSIONAL identity
// (CORPORATE) go out: LinkedIn is a work showcase and the social side of Enois does not leak there.
// MOMENT stays out on purpose: it vanishes in 24 h on Enois and would become a permanent LinkedIn post.
class LinkedInShareOutboxHandler extends OutboxEventHandler {
    LinkedInPostLookup posts
    LinkedInService linkedin
    public constructor(posts: LinkedInPostLookup, linkedin: LinkedInService) {
        super()
        this.posts = posts
        this.linkedin = linkedin
    }
    handle(eventType: String, aggregateId: String, payload: String) {
        if (eventType != "PostPublished") {
            return
        }
        var post = posts.findById(aggregateId)
        if (post == null) {
            return
        }
        if (post.status != "ACTIVE" || post.type == "MOMENT" || post.identity != "CORPORATE") {
            return
        }
        linkedin.sharePublishedPost(post.authorId, post.id, post.content, "Publicação no Énóis")
    }
}
