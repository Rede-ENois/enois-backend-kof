package linkedin

import kernel.error.*
import kernel.http.*
import kernel.security.*
import kernel.url.*

// HTTP adapter: GET and PUT /me/integrations/linkedin.
class LinkedInRoutes {
    static register(server: HttpServer, service: LinkedInService) {
        server.get("/me/integrations/linkedin", () -> {
    var userId = Auth.requireUser()
    return json.encode(service.status(userId))
})
        server.put("/me/integrations/linkedin", () -> {
    var userId = Auth.requireUser()
    var enabled = LinkedInRoutes.parsePostSync()
    return json.encode(service.setPostSync(userId, enabled))
})
    }
    // Bad JSON is a 400; a missing/null postSync is the pt-BR 400 of the controller.
    static Bool parsePostSync() {
        SafeLinks.checkRequest()
        var body = LinkedInRoutes.parseBody()
        var raw = body.postSync()
        if (raw == null) {
            throw Errors.api(400, "BAD_REQUEST", "Informe a preferencia de sincronizacao.")
        }
        if (raw == "true") {
            return true
        }
        if (raw == "false") {
            return false
        }
        throw Errors.badRequest()
    }
    static LinkedInUpdateRequest parseBody() {
        try {
            return json.decode<LinkedInUpdateRequest>(Req.bodyText())
        } catch (String e) {
            throw Errors.badRequest()
        }
    }
}
