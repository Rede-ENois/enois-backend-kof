package marketplace

import profile.*

// Listings carry the publisher's name ("by @someone") and its name style.
record MarketplaceListingView(String id, String sellerId, String? sellerName, String? sellerUsername, ProfileNameStyle? sellerStyle, String itemKind, String itemId, String title, String? description, Long price, String status, String createdAt)

record MarketplacePurchaseView(String id, String listingId, String buyerId, String sellerId, Long price, String state, String createdAt, String? decidedAt, String? itemKind, String? title, String? itemId)

record MarketplaceListedView(String id, String status)

record MarketplacePurchaseStateView(String purchaseId, String state)

record MarketplaceBoughtView(String purchaseId, String state, Long price)

record MarketplaceContentView(String kind, String title, String itemId, String content)

record MarketplaceSanitizeView(Int removed, Int listings)

class MarketplaceViews {
    static MarketplacePurchaseView purchase(p: MarketplacePurchase, kind: String?, title: String?, itemId: String?) = MarketplacePurchaseView(p.id(), p.listingId(), p.buyerId(), p.sellerId(), p.price(), p.state(), p.createdAt(), p.decidedAt(), kind, title, itemId)
    static List<MarketplaceListingView> listings(listings: List<MarketplaceListing>, directory: ProfileDirectory) {
        var ids = listOf<String>()
        for (var l in listings) {
            if (!ids.contains(l.sellerId())) {
                ids.add(l.sellerId())
            }
        }
        var byId = new HashMap<String, ProfileRecord>()
        for (var p in directory.findAllByIds(ids)) {
            byId.put(p.id, p)
        }
        var out = listOf<MarketplaceListingView>()
        for (var l in listings) {
            var p = byId.get(l.sellerId())
            if (p == null) {
                out.add(MarketplaceListingView(l.id(), l.sellerId(), null, null, null, l.itemKind(), l.itemId(), l.title(), l.description(), l.price(), l.status(), l.createdAt()))
            }
            else {
                out.add(MarketplaceListingView(l.id(), l.sellerId(), p.name, p.username, ProfileDirectory.nameStyle(p), l.itemKind(), l.itemId(), l.title(), l.description(), l.price(), l.status(), l.createdAt()))
            }
        }
        return out
    }
}
