package marketplace

// A listing: v1 sells a gallery THEME; the other kinds point at marketplace_items. Price in thousandths of a spark.
// status: ACTIVE, SOLD, REMOVED.
record MarketplaceListing(String id, String sellerId, String itemKind, String itemId, String title, String? description, Long price, String status, String createdAt, String updatedAt)

// A purchase held in ESCROW. state: HELD, RELEASED, REFUNDED.
record MarketplacePurchase(String id, String listingId, String buyerId, String sellerId, Long price, String state, String createdAt, String? decidedAt)

// Content sold outside the theme gallery (template, banner, page, post, blog, service).
record MarketplaceItem(String id, String sellerId, String kind, String title, String? description, String? content, String createdAt)

// A purchase with the kind, title and item of its listing (the "my purchases" grouping).
record MarketplacePurchaseDetail(MarketplacePurchase purchase, String? kind, String? title, String? itemId)

// What a buyer opens: the content (null for a theme, which installs from the gallery).
record MarketplacePurchased(String kind, String title, String itemId, String? content)

// POST /marketplace (theme) and POST /marketplace/items bodies. A missing number is 0, like the Java primitive.
record MarketplacePublishRequest(String? itemKind, String? itemId, String? title, String? description, Long? price)

record MarketplaceItemRequest(String? kind, String? title, String? description, String? content, Long? price)

class MarketplaceKinds {
    static List<String> all() = listOf("THEME", "TEMPLATE", "BANNER", "PAGE", "POST", "BLOG", "SERVICE")
}
