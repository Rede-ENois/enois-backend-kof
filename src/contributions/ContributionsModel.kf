package contributions

// Enum values travel as Strings (G43); the lists below are the Java enums, in declaration order.
class ContribText {
    static String? none() = null
    static Int? noInt() = null
    static SealTier? noTier() = null
    static GhRepository? noRepo() = null
}

// One tier of the seals (SealType): the level derived from the count of verified evidence.
record SealTier(String name, String category, String displayName, String emblem, Int minCount, Int maxCount, String description)

class SealTypes {
    static Int unbounded() = 2147483647
    static List<SealTier> all() {
        var out = listOf<SealTier>()
        out.add(SealTier("AJUDANTE", "CODE", "Ajudante", "ajudante", 1, 10, "Reconhece de 1 a 10 pull requests integrados nos repositórios oficiais."))
        out.add(SealTier("CONTRIBUINTE_SERIO", "CODE", "Contribuinte sério", "contribuinte-serio", 11, 50, "Reconhece de 11 a 50 pull requests integrados nos repositórios oficiais."))
        out.add(SealTier("HARDCORE", "CODE", "Hardcore", "hardcore", 51, 100, "Reconhece de 51 a 100 pull requests integrados nos repositórios oficiais."))
        out.add(SealTier("TRYHARD", "CODE", "Tryhard", "tryhard", 101, 1000, "Reconhece de 101 a 1.000 pull requests integrados nos repositórios oficiais."))
        out.add(SealTier("GET_A_LIFE", "CODE", "Get a life", "get-a-life", 1001, SealTypes.unbounded(), "Reconhece mais de 1.000 pull requests integrados nos repositórios oficiais."))
        out.add(SealTier("BETA_TESTER", "ISSUES", "Beta tester", "beta-tester", 1, 10, "Reconhece de 1 a 10 issues qualificadas nos repositórios oficiais."))
        out.add(SealTier("EXIGENTE", "ISSUES", "Exigente", "exigente", 11, 20, "Reconhece de 11 a 20 issues qualificadas nos repositórios oficiais."))
        out.add(SealTier("ESFORCO_MAXIMO", "ISSUES", "Esforço máximo", "esforco-maximo", 21, 50, "Reconhece de 21 a 50 issues qualificadas nos repositórios oficiais."))
        out.add(SealTier("PLUS_ULTRA", "ISSUES", "Plus ultra", "plus-ultra", 51, 100, "Reconhece de 51 a 100 issues qualificadas nos repositórios oficiais."))
        out.add(SealTier("GENKIDAMA", "ISSUES", "Genkidama", "genkidama", 101, SealTypes.unbounded(), "Reconhece mais de 100 issues qualificadas nos repositórios oficiais."))
        return out
    }
    static List<SealTier> of(category: String) {
        var out = listOf<SealTier>()
        for (var t in SealTypes.all()) {
            if (t.category() == category) {
                out.add(t)
            }
        }
        return out
    }
    static Bool known(name: String) = SealTypes.find(name) != null
    static SealTier? find(name: String) {
        for (var t in SealTypes.all()) {
            if (t.name() == name) {
                return t
            }
        }
        return null
    }
    // The highest tier reached by the count: null for 0 or for a category without tiers.
    static SealTier? forCount(category: String, count: Int) {
        var selected = ContribText.noTier()
        if (count <= 0) {
            return selected
        }
        for (var t in SealTypes.of(category)) {
            if (count >= t.minCount()) {
                selected = t
            }
        }
        return selected
    }
}

class ContribEnums {
    static List<String> categories() = listOf("CODE", "ISSUES", "DOCUMENTATION", "SECURITY", "COMMUNITY", "DONATION", "INFRASTRUCTURE")
    static List<String> statuses() = listOf("PENDING", "VALIDATED", "REJECTED", "CONTESTED", "REVOKED")
    static List<String> kinds() = listOf("PULL_REQUEST", "ISSUE")
    static String categoryName(category: String) {
        if (category == "CODE") {
            return "Código"
        }
        if (category == "ISSUES") {
            return "Issues"
        }
        if (category == "DOCUMENTATION") {
            return "Documentação"
        }
        if (category == "SECURITY") {
            return "Segurança"
        }
        if (category == "COMMUNITY") {
            return "Comunidade"
        }
        if (category == "DONATION") {
            return "Apoio"
        }
        return "Infraestrutura"
    }
    static String categoryDescription(category: String) {
        if (category == "CODE") {
            return "Pull requests integrados nos repositórios oficiais do projeto."
        }
        if (category == "ISSUES") {
            return "Problemas, melhorias e documentação reconhecidos pelos mantenedores."
        }
        if (category == "DOCUMENTATION") {
            return "Contribuições de documentação verificadas."
        }
        if (category == "SECURITY") {
            return "Vulnerabilidades válidas reportadas e confirmadas."
        }
        if (category == "COMMUNITY") {
            return "Testes, suporte e outras contribuições comunitárias verificáveis."
        }
        if (category == "DONATION") {
            return "Apoio financeiro confirmado, independente da reputação técnica."
        }
        return "Recursos e serviços fornecidos ao projeto."
    }
    static Int ordinal(category: String) {
        var i = 0
        for (var c in ContribEnums.categories()) {
            if (c == category) {
                return i
            }
            i = i + 1
        }
        return i
    }
}

// An evidence row (github_contributions). Mutable on purpose: the sync and the reviews change a few fields and
// save the row, instead of copying 35 members. Nullable members are set through ContribText helpers.
class GhContribution {
    String id
    String? userId = ContribText.none()
    String githubUserId
    String githubLogin
    String repository
    String kind
    Int number
    String? objectId = ContribText.none()
    String title = ""
    String url = ""
    String state = "closed"
    String? openedAt = ContribText.none()
    String? mergedAt = ContribText.none()
    String? closedAt = ContribText.none()
    String? githubUpdatedAt = ContribText.none()
    Bool detailsFetched = false
    Int additions = 0
    Int deletions = 0
    Int changedFiles = 0
    String? filesJson = ContribText.none()
    String? labels = ContribText.none()
    Int reviewsCount = 0
    Int approvalsCount = 0
    Int changesRequestedCount = 0
    Bool hasTests = false
    Bool reverted = false
    String category
    String status
    Int score = 0
    String? signalsJson = ContribText.none()
    String? reviewNote = ContribText.none()
    String? reviewedBy = ContribText.none()
    String? reviewedAt = ContribText.none()
    String createdAt
    String updatedAt
    public constructor(id: String, githubUserId: String, githubLogin: String, repository: String, kind: String, number: Int, category: String, status: String, now: String) {
        this.id = id
        this.githubUserId = githubUserId
        this.githubLogin = githubLogin
        this.repository = repository
        this.kind = kind
        this.number = number
        this.category = category
        this.status = status
        this.createdAt = now
        this.updatedAt = now
    }
    Bool countable() = status == "VALIDATED" && !reverted
}

record GhIdentity(String id, String userId, String githubUserId, String githubLogin, String linkedAt, String? lastSyncedAt, String? syncState, String? lastSyncError)
record GhRepository(String repository, Bool enabled, String addedAt, String? lastSyncedAt)
record UserSealRecord(String id, String userId, String sealType, String category, String status, String grantedAt, String? grantedBy, String? revokedAt, String? revokedBy, String? revokeReason, Int evidenceCount)
record ContributionAuditEvent(String id, String contributionId, String? actorUserId, String action, String? fromStatus, String? toStatus, String? note, String createdAt)

// What the GitHub API gave for a merged or open pull request, an issue.
record GhPullRequest(Long number, String nodeId, String title, String url, String body, String authorId, String authorLogin, String state, String? openedAt, String? mergedAt, String? updatedAt, Int additions, Int deletions, Int changedFiles, List<String> files, Int reviewsCount, Int approvalsCount, Int changesRequestedCount)
record GhIssue(Long number, String nodeId, String title, String url, String authorId, String authorLogin, String state, String? openedAt, String? closedAt, String? updatedAt, List<String> labels)

// Bodies (Troolean for the optional booleans, G140).
record ContribReviewBody(String? status, String? note)
record ContribSealBody(String? type, String? reason)
record ContribSyncBody(Troolean dryRun, Troolean full, List<String>? repositories)
record ContribRepositoryBody(String? repository, Troolean enabled)
record ContribPullReviewBody(String? repository, Long? number, String? decision, String? comment)

// Responses.
record PublicSealView(String type, String name, String description, String category, String categoryName, String grantedAt, Int evidenceCount, Int minCount, Int? maxCount, String emblem)
record EvidenceView(String kind, String repository, Int number, String title, String url, String? happenedAt, String category)
record EvidencePage(List<EvidenceView> items, Int total, Int page, Int size, Bool hasMore)
record TierCriteria(String type, String name, String description, Int minCount, Int? maxCount, String emblem)
record CategoryCriteria(String category, String name, String description, List<TierCriteria> tiers)
record CriteriaView(List<String> repositories, List<CategoryCriteria> categories, List<String> policies, List<String> states)
record AdminContributionView(String id, String? userId, String? username, String githubLogin, String repository, String kind, Int number, String title, String url, String? labels, String? mergedAt, String? closedAt, Int changedFiles, Int additions, Int deletions, Bool hasTests, Bool reverted, String status, Int score, String? reviewNote, String? reviewedBy, String? reviewedAt, String createdAt)
record AdminContributionDetail(AdminContributionView contribution, List<ContributionAuditEvent> audit)
record RepositoryView(String repository, Bool enabled, String? lastSyncedAt)
record ContribStatusView(String status)
record ContribUsersView(Int users)
record GithubIdentityView(Bool linked, String? login, String? linkedAt, String? lastSyncedAt, String? syncState, String? lastSyncError, Bool writeAccess)
record GithubSyncResult(Int contributions, Int issues, Int seals, Bool rateLimited)
record OpenPullRequestView(String repository, Long number, String title, String url, String authorLogin, String? authorAvatarUrl, String? createdAt, String? updatedAt)
record PullReviewedView(String id, String status)
record SyncReport(Bool dryRun, Bool full, List<String> repositories, Int fetched, Int created, Int updated, Int skipped, Int detailsFetched, Int revertedFlagged, Int issuesFetched, Int issuesCreated, Int issuesUpdated, Int sealsRecalculated, Bool rateLimited, List<String> errors, String startedAt, String finishedAt)
