#!/bin/sh
# Boots the app (src/Main.kf) with the kofdeps jars on the classpath. kof run 0.7.1 resolves
# imports from the kof.toml root and cannot see src/ (docs/KOF_GAPS.md G10).
# Env: PORT (default 8081), DB_* / DB_URL (default in-memory H2). Usage: scripts/kof-run
set -e
ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT"
DEPS=$("$HOME/.local/kof/kof" deps resolve 2>/dev/null | tail -n 1)
exec java -cp "$HOME/.local/kof/kof-cli-0.7.1.jar" "$ROOT/scripts/KofTool.java" run src "$DEPS" src/Main.kf
