import app.*
import kernel.testkit.*
import kernel.text.*

// Port of the freelance case of TextFieldLimitTests: a title above the column ceiling is refused naming the field
// and the number, instead of a 409 "Data too long" from the database.
test "freelaComTituloLongoRecusaDizendoOCampo" {
    var dono = OrgsTestKit.login("tfl_freela")
    var res = dono.callKey("POST", "/freelances", "tfl-freela-longo", FreelanceTestKit.body(strings.repeat("T", 300), "Escopo com pelo menos vinte caracteres para passar da validacao minima.", 10, 20, "2030-01-02", "FAISCAS"))
    Check.apiError(res, 400, "FREELANCE_FIELD_TOO_LONG")
    var message = OrgsTestKit.str(res, "message")
    Check.isTrue("message names the field: " + message, message.contains("titulo"))
    Check.isTrue("message names the ceiling: " + message, message.contains("200"))
    OrgsTestKit.finish()
}
