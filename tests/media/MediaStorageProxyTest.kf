import kernel.*
import kernel.bytes.*
import kernel.db.*
import kernel.files.*
import kernel.http.*
import kernel.security.*
import kernel.testkit.*
import media.*

// Port of MediaStorageProxyTests: `/storage/{key}` served by the app itself (S3 mode, proxy base URL).
// The fake store replaces the bucket; uploads and downloads cross the binary lane with real bytes.
class ProxyFakeStore extends MediaObjectStore {
    Byte[] content = "conteudo-da-midia".getBytes()
    String tipo = "image/jpeg"
    String lastRange = ""
    String writtenKey = ""
    Byte[] written = "".getBytes()
    // Non-empty makes the write fail like a gateway that is down.
    String writeFailure = ""
    public constructor() {
        super()
    }
    MediaStoredObject read(key: String, range: String?) {
        lastRange = ""
        var partial = false
        if (range != null) {
            lastRange = range
            partial = true
        }
        return MediaStoredObject(ByteStream.ofBytes(content), content.length as Long, tipo, rangeFor(partial), "\"etag-teste\"")
    }
    String? rangeFor(partial: Bool) {
        if (partial) {
            return "bytes 0-4/" + content.length
        }
        return null
    }
    write(key: String, contentType: String, filePath: String) {
        if (writeFailure.length() > 0) {
            throw writeFailure
        }
        writtenKey = key
        written = TempFiles.readAll(filePath)
    }
}

class ProxyHolder {
    static TestApp? app = null
    static MediaModule? module = null
    static SharedServices? shared = null
    static ProxyFakeStore fake = ProxyFakeStore()
    static TestApp get() {
        var cur = ProxyHolder.app
        if (cur != null) {
            return cur
        }
        var overrides = mapOf("REDE_ORIGINS_ENFORCE", "false", "REDE_MEDIA_STORAGE", "s3", "REDE_MEDIA_S3_BUCKET", "bucket-de-teste", "REDE_MEDIA_S3_PUBLIC_BASE_URL", "https://enois.exemplo.com/api/storage", "REDE_MEDIA_DELETION_WORKER_DELAY_MS", "3600000", "REDE_MEDIA_NSFW_ENABLED", "false", "REDE_MEDIA_DIMENSIONS_BACKFILL_ENABLED", "false")
        SecurityClock.reset()
        var created = TestApp.bootWith("mediaproxy", overrides, (p: Platform) -> ProxyHolder.wire(p))
        ProxyHolder.app = created
        return created
    }
    static wire(p: Platform) {
        var shared = SharedServices.create(p)
        ProxyHolder.shared = shared
        var hooks = SecurityHooks.defaults(p.db)
        Security.install(p, hooks)
        var module = MediaModule.install(p, shared, hooks)
        module.objectStore = ProxyHolder.fake
        ProxyHolder.module = module
    }
}

String pxLogin(user: String) {
    SecurityFixtures.login(ProxyHolder.get().db(), user, "tok-" + user + "-1234567890")
    return "tok-" + user + "-1234567890"
}

BinaryClient pxBinary() = BinaryClient(ProxyHolder.get().port)

// Creates the asset (POST /media/uploads) and returns the JSON response.
TestResponse pxCreate(token: String, key: String, name: String, mime: String, size: Int, purpose: String) {
    var body = "{\"fileName\":\"" + name + "\",\"mimeType\":\"" + mime + "\",\"size\":" + size + ",\"purpose\":\"" + purpose + "\"}"
    return ProxyHolder.get().client.send("POST", "/media/uploads", listOf("X-Session-Token: " + token, "Idempotency-Key: " + key, "Content-Type: application/json"), "", body)
}

test "reading works without a session and with a long cache" {
    var res = pxBinary().get("/storage/uploads/media_abc/media/x/foto.jpg", listOf<String>())
    Check.eqInt("status", 200, res.status)
    Check.eqStr("content type", "image/jpeg", res.header("Content-Type"))
    Check.eqStr("accept ranges", "bytes", res.header("Accept-Ranges"))
    Check.isTrue("immutable cache", res.header("Cache-Control").contains("immutable"))
    Check.eqStr("body", "conteudo-da-midia", res.text())
    Check.eqStr("length", "17", res.header("Content-Length"))
}

test "an allowed type is served inline and an unknown type as a download" {
    var inline = pxBinary().get("/storage/uploads/media_inline/file.jpg", listOf<String>())
    Check.eqInt("status", 200, inline.status)
    Check.eqStr("disposition", "inline", inline.header("Content-Disposition"))
    Check.eqStr("nosniff", "nosniff", inline.header("X-Content-Type-Options"))
    ProxyHolder.fake.tipo = "text/html"
    var legacy = pxBinary().get("/storage/uploads/media_legacy/page.html", listOf<String>())
    ProxyHolder.fake.tipo = "image/jpeg"
    Check.eqInt("legacy status", 200, legacy.status)
    Check.eqStr("legacy type", "application/octet-stream", legacy.header("Content-Type"))
    Check.eqStr("legacy disposition", "attachment", legacy.header("Content-Disposition"))
}

test "the object key is generated by the server and ignores the client file name" {
    var token = pxLogin("media_proxy_key")
    var res = pxCreate(token, "media-proxy-key-1", "../../x/evil name.html", "image/PNG; charset=binary", 1024, "POST_IMAGE")
    Check.status(res, 201)
    var objectKey = res.json("objectKey")
    Check.isTrue("generated key", objectKey.matches("uploads/media_[0-9a-f]+/file\\.png"))
    Check.isTrue("cdn url is clean", !res.json("cdnUrl").contains("evil") && !res.json("cdnUrl").contains(".."))
    Check.eqStr("signed content type", "image/png", res.json("uploadHeaders.Content-Type"))
}

test "the upload kind restricts the accepted types" {
    var token = pxLogin("media_proxy_kind")
    Check.apiError(pxCreate(token, "media-proxy-kind-1", "avatar.pdf", "application/pdf", 1024, "AVATAR"), 400, "MEDIA_TYPE_NOT_ALLOWED")
    Check.apiError(pxCreate(token, "media-proxy-kind-2", "cv.png", "image/png", 1024, "RESUME"), 400, "MEDIA_TYPE_NOT_ALLOWED")
}

test "a partial request answers 206 with Content-Range" {
    var res = pxBinary().get("/storage/uploads/media_abc/media/x/video.mp4", listOf("Range: bytes=0-4"))
    Check.eqInt("status", 206, res.status)
    Check.isTrue("content range", res.header("Content-Range").startsWith("bytes 0-4/"))
    Check.eqStr("range reached the store", "bytes=0-4", ProxyHolder.fake.lastRange)
}

test "a key with path traversal is refused" {
    var res = pxBinary().get("/storage/uploads/../../etc/passwd", listOf<String>())
    Check.eqInt("status", 400, res.status)
}

test "an upload without a session is refused" {
    var res = pxBinary().put("/storage/uploads/media_abc/media/x/foto.jpg", listOf("Content-Type: image/jpeg"), "bytes".getBytes())
    Check.eqInt("status", 401, res.status)
}

test "the owner uploads to the key of their own asset and nobody else does" {
    var owner = pxLogin("media_proxy_dono")
    var other = pxLogin("media_proxy_outro")
    var created = pxCreate(owner, "media-proxy-1", "media/xyz/foto.jpg", "image/jpeg", 1024, "POST_IMAGE")
    Check.status(created, 201)
    var objectKey = created.json("objectKey")
    Check.isTrue("key prefix", objectKey.startsWith("uploads/media_"))
    var intruder = pxBinary().put("/storage/" + objectKey, listOf("X-Session-Token: " + other, "Content-Type: image/jpeg"), "intruso".getBytes())
    Check.eqInt("intruder", 403, intruder.status)
    var photo = strings.repeat("foto", 256).getBytes()
    var res = pxBinary().put("/storage/" + objectKey, listOf("X-Session-Token: " + owner, "Content-Type: image/jpeg"), photo)
    Check.eqInt("owner", 200, res.status)
    Check.eqStr("status field", "STORED", res.json("status"))
    Check.eqStr("written key", objectKey, ProxyHolder.fake.writtenKey)
    Check.eqStr("written bytes", strings.repeat("foto", 256), new String(ProxyHolder.fake.written, "UTF-8"))
}

test "the owner uploads an mp4 through the proxy and the file reaches the bucket" {
    var owner = pxLogin("media_proxy_video")
    var video = strings.repeat("ftypisom-corpo-de-video-de-teste", 64).getBytes()
    var created = pxCreate(owner, "media-proxy-video-1", "clipe.mp4", "video/mp4", video.length, "POST_VIDEO")
    Check.status(created, 201)
    var objectKey = created.json("objectKey")
    Check.isTrue("mp4 key", objectKey.endsWith("/file.mp4"))
    // A body ffmpeg cannot read (or no ffmpeg): cleaning is best effort and the original goes to the bucket.
    var res = pxBinary().put("/storage/" + objectKey, listOf("X-Session-Token: " + owner, "Content-Type: video/mp4"), video)
    Check.eqInt("status", 200, res.status)
    Check.eqStr("stored", "STORED", res.json("status"))
    Check.eqStr("written key", objectKey, ProxyHolder.fake.writtenKey)
    Check.eqInt("written size", video.length, ProxyHolder.fake.written.length)
}

test "a bucket failure on write becomes 502 with its own code, not the generic error" {
    var owner = pxLogin("media_proxy_bucket_fora")
    var video = strings.repeat("ftypisom-video", 32).getBytes()
    var created = pxCreate(owner, "media-proxy-bucket-1", "clipe.mp4", "video/mp4", video.length, "POST_VIDEO")
    Check.status(created, 201)
    ProxyHolder.fake.writeFailure = "gateway recusou a gravacao"
    var res = pxBinary().put("/storage/" + created.json("objectKey"), listOf("X-Session-Token: " + owner, "Content-Type: video/mp4"), video)
    ProxyHolder.fake.writeFailure = ""
    Check.eqInt("status", 502, res.status)
    Check.eqStr("code", "MEDIA_STORAGE_WRITE_FAILED", res.json("code"))
    Check.isTrue("no infrastructure detail", !res.json("message").contains("gateway"))
}

test "a video above the in-memory limit also reaches the bucket" {
    var owner = pxLogin("media_proxy_video_grande")
    // Above MAX_IN_MEMORY the proxy works on a temp file (and ffmpeg), never the whole body in memory.
    var size = 41 * 1024 * 1024
    var video = new Byte[size]
    var created = pxCreate(owner, "media-proxy-video-2", "aula.mp4", "video/mp4", size, "POST_VIDEO")
    Check.status(created, 201)
    var res = pxBinary().put("/storage/" + created.json("objectKey"), listOf("X-Session-Token: " + owner, "Content-Type: video/mp4"), video)
    Check.eqInt("status", 200, res.status)
    Check.eqStr("stored", "STORED", res.json("status"))
    Check.eqStr("written key", created.json("objectKey"), ProxyHolder.fake.writtenKey)
    Check.eqInt("written size", size, ProxyHolder.fake.written.length)
}

// ---- the binary lane itself (no Java counterpart: Spring reads and writes raw bytes natively)
test "bytes above 0x7F survive the upload and the download unchanged" {
    var owner = pxLogin("media_proxy_binary")
    var png = Bytes.hex("89504e470d0a1a0a0000000d49484452ffff00fe80")
    var created = pxCreate(owner, "media-proxy-binary-1", "x.png", "image/png", png.length, "POST_IMAGE")
    var objectKey = created.json("objectKey")
    var res = pxBinary().put("/storage/" + objectKey, listOf("X-Session-Token: " + owner, "Content-Type: image/png"), png)
    Check.eqInt("upload", 200, res.status)
    Check.eqStr("uploaded bytes", Bytes.toHex(png), Bytes.toHex(ProxyHolder.fake.written))
    ProxyHolder.fake.content = png
    var back = pxBinary().get("/storage/" + objectKey, listOf<String>())
    ProxyHolder.fake.content = "conteudo-da-midia".getBytes()
    Check.eqInt("download", 200, back.status)
    Check.eqStr("downloaded bytes", Bytes.toHex(png), Bytes.toHex(back.body))
}

test "a body whose size differs from the declared one is refused before it is read" {
    var owner = pxLogin("media_proxy_size")
    var created = pxCreate(owner, "media-proxy-size-1", "x.png", "image/png", 2048, "POST_IMAGE")
    var res = pxBinary().put("/storage/" + created.json("objectKey"), listOf("X-Session-Token: " + owner, "Content-Type: image/png"), "short".getBytes())
    Check.eqInt("status", 400, res.status)
    Check.eqStr("code", "MEDIA_SIZE_MISMATCH", res.json("code"))
}

test "an upload without a length answers 411" {
    var owner = pxLogin("media_proxy_length")
    var created = pxCreate(owner, "media-proxy-length-1", "x.png", "image/png", 2048, "POST_IMAGE")
    var res = pxBinary().put("/storage/" + created.json("objectKey"), listOf("X-Session-Token: " + owner, "Content-Type: image/png"), "".getBytes())
    Check.eqInt("status", 411, res.status)
    Check.eqStr("code", "MEDIA_LENGTH_REQUIRED", res.json("code"))
}

test "a client cannot drive the lane with its own X-Kernel headers" {
    var owner = pxLogin("media_proxy_spoof")
    var created = pxCreate(owner, "media-proxy-spoof-1", "x.png", "image/png", 5, "POST_IMAGE")
    var res = pxBinary().put("/storage/" + created.json("objectKey"), listOf("X-Session-Token: " + owner, "X-Kernel-Binary: commit", "X-Kernel-Ticket: bt_forged", "X-Kernel-Declared-Length: 5"), "hello".getBytes())
    // The forged headers are dropped by the front: a normal upload happens (and succeeds on its own merit).
    Check.eqInt("status", 200, res.status)
    Check.eqInt("no ticket left behind", 0, BinaryLane.pendingTickets())
}

// The job loops would keep the test process alive: stop them (keep this the last test of the file).
test "zz background jobs stop" {
    var shared = ProxyHolder.shared
    if (shared != null) {
        shared.stop()
    }
    ProxyHolder.get().stop()
    assert(ProxyHolder.module != null)
}
