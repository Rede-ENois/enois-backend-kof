import contributions.*

// Port of SealTypeTests: the published boundaries of the tiers, one by one.
String codeAt(count: Int) {
    var t = SealTypes.forCount("CODE", count)
    if (t == null) {
        return "none"
    }
    return t.name()
}

String issuesAt(count: Int) {
    var t = SealTypes.forCount("ISSUES", count)
    if (t == null) {
        return "none"
    }
    return t.name()
}

test "code tiers follow the published boundaries" {
    assert(codeAt(0) == "none")
    assert(codeAt(1) == "AJUDANTE")
    assert(codeAt(10) == "AJUDANTE")
    assert(codeAt(11) == "CONTRIBUINTE_SERIO")
    assert(codeAt(50) == "CONTRIBUINTE_SERIO")
    assert(codeAt(51) == "HARDCORE")
    assert(codeAt(100) == "HARDCORE")
    assert(codeAt(101) == "TRYHARD")
    assert(codeAt(1000) == "TRYHARD")
    assert(codeAt(1001) == "GET_A_LIFE")
}

test "issue tiers follow the published boundaries" {
    assert(issuesAt(0) == "none")
    assert(issuesAt(1) == "BETA_TESTER")
    assert(issuesAt(10) == "BETA_TESTER")
    assert(issuesAt(11) == "EXIGENTE")
    assert(issuesAt(20) == "EXIGENTE")
    assert(issuesAt(21) == "ESFORCO_MAXIMO")
    assert(issuesAt(50) == "ESFORCO_MAXIMO")
    assert(issuesAt(51) == "PLUS_ULTRA")
    assert(issuesAt(100) == "PLUS_ULTRA")
    assert(issuesAt(101) == "GENKIDAMA")
}

test "categories do not leak tiers into each other" {
    assert(SealTypes.of("CODE").size() == 5)
    assert(SealTypes.of("ISSUES").size() == 5)
    for (var t in SealTypes.of("CODE")) {
        assert(t.category() == "CODE")
    }
    for (var t in SealTypes.of("ISSUES")) {
        assert(t.category() == "ISSUES")
    }
    assert(issuesAt(1001) == "GENKIDAMA")
    assert(SealTypes.forCount("DONATION", 10) == null)
}

test "every tier has its own fixed emblem" {
    var emblems = listOf<String>()
    for (var t in SealTypes.all()) {
        assert(!emblems.contains(t.emblem()))
        emblems.add(t.emblem())
    }
    assert(String.join(",", emblems) == "ajudante,contribuinte-serio,hardcore,tryhard,get-a-life,beta-tester,exigente,esforco-maximo,plus-ultra,genkidama")
}
