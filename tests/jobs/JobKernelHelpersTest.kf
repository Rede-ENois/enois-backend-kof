import kernel.db.*
import kernel.html.*
import kernel.testkit.*
import kernel.url.*
import jobs.*

// Tests of the kernel helpers the jobs domain brought: UrlCanonical (the dedupe key of the external jobs),
// HtmlEntities (feeds send HTML-escaped text) and Db.requiresNew (a nested transaction the caller can catch).

test "canonicalUrlIgnoresTrackingWwwFragmentAndTrailingSlashAndSortsTheQuery" {
    Check.eqStr("tracking", "https://acme.test/vagas/1", UrlCanonical.canonicalText("https://acme.test/vagas/1?utm_source=linkedin"))
    Check.eqStr("www", "https://acme.test/vagas/1", UrlCanonical.canonicalText("https://www.Acme.test/vagas/1"))
    Check.eqStr("fragment and slash", "https://acme.test/vagas/1", UrlCanonical.canonicalText("https://acme.test/vagas/1/#top"))
    Check.eqStr("query sorted", "https://acme.test/v?a=1&b=2", UrlCanonical.canonicalText("https://acme.test/v?b=2&a=1&gclid=x"))
    Check.eqStr("ref kept apart", "https://acme.test/vagas/1", UrlCanonical.canonicalText("https://acme.test/vagas/1?utm_medium=a&utm_campaign=b"))
}

test "canonicalUrlOfAnythingThatIsNotAUrlIsNull" {
    Check.isTrue("null", UrlCanonical.canonicalize(null) == null)
    Check.isTrue("blank", UrlCanonical.canonicalize("   ") == null)
    // An invalid URL keeps its trimmed lower-case text as the key (nothing is invented).
    Check.eqStr("not a url", "sem endereco", "" + UrlCanonical.canonicalize("Sem Endereco"))
}

test "htmlEntitiesAreReadTheWayPeopleSeeThem" {
    Check.eqStr("named", "Dev & Ops", HtmlEntities.unescape("Dev &amp; Ops"))
    Check.eqStr("decimal", "hims & hers", HtmlEntities.unescape("hims &#038; hers"))
    Check.eqStr("hex", "A", HtmlEntities.unescape("&#x41;"))
    Check.eqStr("accent", "Café", HtmlEntities.unescape("Caf&eacute;"))
    Check.eqStr("plain text is untouched", "100% plain", HtmlEntities.unescape("100% plain"))
    Check.eqStr("unknown entity is kept", "&notanentity;", HtmlEntities.unescape("&notanentity;"))
}

test "requiresNewRunsInsideItsOwnTransactionAndTheCallerMayCatchItsFailure" {
    var store = JobsTestKit.db()
    store.execute("delete from company_follows where company_id = 'rn-co'", DbParams())
    var failed = ""
    store.transaction(() -> {
    store.execute("insert into company_follows (company_id, user_id, created_at) values ('rn-co', 'outer', current_timestamp)", DbParams())
    try {
        store.requiresNew(() -> {
    store.execute("insert into company_follows (company_id, user_id, created_at) values ('rn-co', 'inner', current_timestamp)", DbParams())
    throw "inner failed"
})
    } catch (String e) {
        failed = e
    }
})
    // The inner failure rolled back only the inner work: the outer commit kept its own row.
    Check.eqStr("failure reached the caller", "inner failed", failed)
    Check.eqInt("outer row kept", 1, store.queryLong("select count(*) from company_follows where company_id = 'rn-co' and user_id = 'outer'", DbParams()).toInt())
    Check.eqInt("inner row rolled back", 0, store.queryLong("select count(*) from company_follows where company_id = 'rn-co' and user_id = 'inner'", DbParams()).toInt())
    // Outside a transaction it is a plain transaction.
    store.requiresNew(() -> {
    store.execute("insert into company_follows (company_id, user_id, created_at) values ('rn-co', 'plain', current_timestamp)", DbParams())
})
    Check.eqInt("plain row committed", 1, store.queryLong("select count(*) from company_follows where company_id = 'rn-co' and user_id = 'plain'", DbParams()).toInt())
    JobsTestKit.finish()
}
