import jobs.*
import kernel.testkit.*

// Port of ExternalJobEmailTests: the apply email extracted from an external ad (HTML survives, no-reply and
// asset addresses are skipped, case is normalised).
test "findsTheEmailInsideHtml" {
    var description = "<p>Mande seu curriculo para <strong>jobs@empresa.com</strong> com o assunto \"Vaga Back-end\".</p>"
    Check.eqStr("email", "jobs@empresa.com", "" + ExternalJobs.extractApplyEmail(description))
}

test "skipsNoreplyAndAssets" {
    var description = "contato: noreply@empresa.com e banner@empresa.com/logo.png | candidaturas: vagas@empresa.com"
    Check.eqStr("email", "vagas@empresa.com", "" + ExternalJobs.extractApplyEmail(description))
}

test "normalizesCaseAndHandlesMissingText" {
    Check.eqStr("case", "vagas@empresa.com", "" + ExternalJobs.extractApplyEmail("Envie para Vagas@Empresa.COM"))
    Check.isTrue("null text", ExternalJobs.extractApplyEmail(null) == null)
    Check.isTrue("no address", ExternalJobs.extractApplyEmail("sem endereco nenhum aqui") == null)
}
