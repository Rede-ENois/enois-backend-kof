import jobs.*
import kernel.testkit.*
import kernel.time.*

// Port of OwnJobAppliedFlagTests: the owner is never "applied" to their own job, even with an orphan application.
test "ownerIsNeverAppliedEvenWithOrphanApplication" {
    var owner = JobsTestKit.login("ownjob_owner")
    var jobId = "job_ownjob_" + owner
    JobsTestKit.insertJob(jobId, "Vaga do proprio dono", "Coiso", "Remoto", "FULL_TIME", "MID", listOf("Java"), Time.nowIso())
    JobsTestKit.setJobPostedBy(jobId, owner)
    JobsTestKit.insertApplication(jobId, owner)
    var res = JobsTestKit.get("/jobs/" + jobId, owner)
    Check.status(res, 200)
    Check.jsonEq(res, "owner", "true")
    Check.jsonEq(res, "applied", "false")
    JobsTestKit.finish()
}
