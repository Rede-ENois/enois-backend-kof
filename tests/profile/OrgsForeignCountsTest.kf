import app.*
import events.*
import kernel.testkit.*
import mentoring.*
import profile.*

// The chained profile seam of the orgs wave answers the events count and the mentoring count from one object, and
// leaves the other counts to the base class.
test "the chained foreign counts read both owners without failing" {
    var db = OrgsTestKit.db()
    var counts = OrgsForeignCounts(db, EventsStore(db))
    OrgsTestKit.login("ofc_user")
    Check.eqInt("events attended", 0, counts.eventsAttendedTotal("ofc_user"))
    Check.eqInt("mentoring as mentee", 0, counts.mentoringAsMentee("ofc_user"))
    Check.eqInt("social posts (base class)", 0, counts.socialPosts("ofc_user"))
    OrgsTestKit.finish()
}
