import kernel.jobs.*

test "the lock is reentrant and released by leave" {
    var gate = ProcessLock()
    gate.enter()
    gate.enter()
    gate.leave()
    gate.leave()
    gate.enter()
    gate.leave()
    assert(true)
}

test "a failure captured inside the section still leaves the lock" {
    var gate = ProcessLock()
    var failure = ""
    gate.enter()
    try {
        throw "boom"
    } catch (String e) {
        failure = e
    }
    gate.leave()
    assert(failure == "boom")
    // enter again from the same thread proves nothing is left locked by a stuck holder
    gate.enter()
    gate.leave()
}
