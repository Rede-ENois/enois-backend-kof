import kernel.log.*
import kernel.time.*

test "pii mask hides emails in text and values" {
    assert(PiiMask.email("a@b.com") == "***")
    assert(PiiMask.email("") == "")
    assert(PiiMask.text("contact joe.doe+x@mail.example.org now") == "contact *** now")
    assert(PiiMask.text("no address here") == "no address here")
}

test "log renders one json object per line with masked pii" {
    var log = Log("test")
    var line = log.render("INFO", "login joe@x.com", mapOf("user", "id-1"))
    assert(line.contains("\"level\":\"INFO\""))
    assert(line.contains("\"logger\":\"test\""))
    assert(line.contains("\"message\":\"login ***\""))
    assert(line.contains("\"user\":\"id-1\""))
    assert(!line.contains("joe@x.com"))
}

test "time helpers round trip iso instants" {
    var ms = Time.toMillis("2026-11-04T16:05:00.123Z")
    assert(Time.fromMillis(ms) == "2026-11-04T16:05:00.123Z")
    assert(Time.plusSeconds("2026-11-04T16:05:00Z", 60L) == "2026-11-04T16:06:00Z")
    assert(Time.fromDbTimestamp("2026-11-04 16:05:00.120000") == "2026-11-04T16:05:00.120Z")
    assert(Time.nowIso().endsWith("Z"))
}

class RecordingTap extends LogTap {
    List<String> seen = listOf<String>()
    public constructor() {
        super()
    }
    accept(level: String, logger: String, message: String) {
        seen.add(level + "|" + logger + "|" + message)
        // A line logged from inside the tap is not tapped again.
        Log("tap.inner").warn("from inside")
    }
}

test "log taps see every written line once and never loop" {
    var tap = RecordingTap()
    Log.installTap(tap)
    Log("tap.test").warn("careful")
    Log("tap.test").debug("below the threshold")
    Log.installTap(LogTap())
    assert(tap.seen.size() == 1)
    assert(tap.seen.get(0) == "WARN|tap.test|careful")
}
