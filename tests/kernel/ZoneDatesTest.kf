import kernel.time.*

test "a day belongs to the zone, not to UTC" {
    assert(ZoneDates.dayOf("2026-11-05T01:30:00Z", "America/Sao_Paulo") == "2026-11-04")
    assert(ZoneDates.dayOf("2026-11-05T03:00:00Z", "America/Sao_Paulo") == "2026-11-05")
    assert(ZoneDates.dayOf("2026-11-05T01:30:00Z", "UTC") == "2026-11-05")
}

test "the start of a zone day is its midnight in UTC" {
    assert(ZoneDates.startOfDay("2026-11-04", "America/Sao_Paulo") == "2026-11-04T03:00:00Z")
    assert(ZoneDates.plusDays("2026-11-30", 1) == "2026-12-01")
    assert(ZoneDates.plusDays("2026-11-04", -29) == "2026-10-06")
    assert(ZoneDates.today("America/Sao_Paulo").length() == 10)
}
