import kernel.time.*

test "a day belongs to the zone, not to UTC" {
    assert(ZoneDates.dayOf("2026-11-05T01:30:00Z", "America/Sao_Paulo") == "2026-11-04")
    assert(ZoneDates.dayOf("2026-11-05T03:00:00Z", "America/Sao_Paulo") == "2026-11-05")
    assert(ZoneDates.dayOf("2026-11-05T01:30:00Z", "UTC") == "2026-11-05")
}

test "the start of a zone day is its midnight in UTC" {
    assert(ZoneDates.startOfDay("2026-11-04", "America/Sao_Paulo") == "2026-11-04T03:00:00Z")
    assert(ZoneDates.plusDays("2026-11-30", 1) == "2026-12-01")
    assert(ZoneDates.plusDays("2026-11-04", -29) == "2026-10-06")
    assert(ZoneDates.today("America/Sao_Paulo").length() == 10)
}

test "a local date time becomes the UTC instant of its zone" {
    assert(ZoneDates.localToInstant("2026-10-31T00:00:00", "America/Sao_Paulo") == "2026-10-31T03:00:00Z")
    assert(ZoneDates.localToInstant("2026-10-31T23:59:59", "America/Sao_Paulo") == "2026-11-01T02:59:59Z")
    assert(ZoneDates.localToInstant("2026-10-31T12:00:00", "UTC") == "2026-10-31T12:00:00Z")
}

test "the ISO week starts on Monday" {
    // 2026-10-26 is a Monday
    assert(ZoneDates.dayOfWeek("2026-10-26") == 1)
    assert(ZoneDates.dayOfWeek("2026-11-01") == 7)
    assert(ZoneDates.weekStart("2026-10-26") == "2026-10-26")
    assert(ZoneDates.weekStart("2026-11-01") == "2026-10-26")
    assert(ZoneDates.weekStart("2026-11-02") == "2026-11-02")
}
