import kernel.http.*

test "untrusted peer ignores forwarding headers" {
    var ip = ClientIp("", ClientIp.cloudflareRanges())
    assert(ip.resolve("203.0.113.9", "1.2.3.4", null) == "203.0.113.9")
}

test "trusted loopback peer uses the right-most untrusted hop" {
    var ip = ClientIp("", ClientIp.cloudflareRanges())
    assert(ip.resolve("127.0.0.1", "6.6.6.6, 198.51.100.7", null) == "198.51.100.7")
    assert(ip.resolve("0:0:0:0:0:0:0:1", "198.51.100.7", null) == "198.51.100.7")
    assert(ip.resolve("10.0.0.5", "198.51.100.7, 10.0.0.9", null) == "198.51.100.7")
    assert(ip.resolve("127.0.0.1", null, null) == "127.0.0.1")
    assert(ip.resolve("127.0.0.1", "not an ip", null) == "127.0.0.1")
}

test "configured proxy ips and cidrs are trusted" {
    var ip = ClientIp("31.220.102.169, 203.0.113.0/24", ClientIp.cloudflareRanges())
    assert(ip.resolve("31.220.102.169", "198.51.100.7", null) == "198.51.100.7")
    assert(ip.resolve("203.0.113.77", "198.51.100.8", null) == "198.51.100.8")
    assert(ip.resolve("31.220.102.170", "198.51.100.7", null) == "31.220.102.170")
}

test "cf connecting ip only counts behind a cloudflare edge" {
    var ip = ClientIp("", ClientIp.cloudflareRanges())
    assert(ip.resolve("127.0.0.1", "172.68.1.1", "198.51.100.20") == "198.51.100.20")
    assert(ip.resolve("127.0.0.1", "198.51.100.7", "9.9.9.9") == "198.51.100.7")
}

test "private ranges are trusted proxies" {
    var ip = ClientIp("", ClientIp.cloudflareRanges())
    assert(ip.isTrustedProxy("172.16.0.1"))
    assert(ip.isTrustedProxy("172.31.255.255"))
    assert(!ip.isTrustedProxy("172.32.0.1"))
    assert(ip.isTrustedProxy("192.168.1.1"))
    assert(!ip.isTrustedProxy("8.8.8.8"))
    assert(ip.isTrustedProxy("::ffff:10.0.0.1"))
}
