import kernel.testkit.*
import kernel.text.*
import kernel.time.*

// The golden files in tests/identity/golden are the output of the real Thymeleaf engine (3.1.5, the one the
// Java service runs) for these exact variables over resources/templates; the year is the {{YEAR}} marker.
// HtmlTemplate must reproduce them byte for byte.
String golden(name: String) {
    var text = File("tests/identity/golden/" + name + ".html").readText()
    if (text == null) {
        throw "GOLDEN_MISSING: " + name
    }
    return text.replace("{{YEAR}}", Time.todayIso().substring(0, 4))
}

String rendered(name: String, vars: Map<String,String>) {
    var template = File("resources/templates/" + name + ".html").readText()
    if (template == null) {
        throw "TEMPLATE_MISSING: " + name
    }
    return HtmlTemplate.render(template, vars)
}

test "email-verification renders exactly what Thymeleaf renders" {
    var year = Time.todayIso().substring(0, 4)
    Check.eqStr("html", golden("email-verification"), rendered("email-verification", mapOf("userName", "Ana <b>&\"' Souza", "verificationLink", "https://app.test/auth/verify?token=a1&b=2", "currentYear", year)))
}

test "password-reset renders exactly what Thymeleaf renders, year expression included" {
    Check.eqStr("html", golden("password-reset"), rendered("password-reset", mapOf("userName", "Zé \"da\" Silva", "resetLink", "https://app.test/auth/reset?token=abc&x=1")))
}

test "two-factor-code renders exactly what Thymeleaf renders" {
    var year = Time.todayIso().substring(0, 4)
    Check.eqStr("html", golden("two-factor-code"), rendered("two-factor-code", mapOf("userName", "Bia & Cia", "code", "123456", "currentYear", year)))
}

test "parental-consent renders exactly what Thymeleaf renders" {
    var year = Time.todayIso().substring(0, 4)
    Check.eqStr("html", golden("parental-consent"), rendered("parental-consent", mapOf("minorName", "Caio <i>Jr</i>", "consentLink", "https://app.test/responsavel?token=t&u=1", "currentYear", year)))
}

test "email-blog-post renders exactly what Thymeleaf renders" {
    var year = Time.todayIso().substring(0, 4)
    Check.eqStr("html", golden("email-blog-post"), rendered("email-blog-post", mapOf("postTitle", "Título & <novo>", "blogTitle", "Blog do \"Zé\"", "authorName", "Zé", "preview", "Prévia do post 'legal'", "postLink", "https://app.test/blog/ze/post?a=1&b=2", "unsubscribeLink", "https://app.test/api/blog/unsubscribe?token=x&y=z", "currentYear", year)))
}
