import kernel.text.*
import kernel.testkit.*

test "th:text replaces the element content with the escaped value" {
    var html = HtmlTemplate.render("<p>Oi <span th:text=\"${name}\">fulano</span>!</p>", mapOf("name", "Ana <b>&\"'"))
    Check.eqStr("escaped", "<p>Oi <span>Ana &lt;b&gt;&amp;&quot;&#39;</span>!</p>", html)
}

test "th:href becomes an escaped href and the namespace declaration goes away" {
    var html = HtmlTemplate.render("<html xmlns:th=\"http://www.thymeleaf.org\"><a th:href=\"${link}\" style=\"x\">go</a></html>", mapOf("link", "https://a.example/x?a=1&b=2"))
    Check.eqStr("href", "<html><a href=\"https://a.example/x?a=1&amp;b=2\" style=\"x\">go</a></html>", html)
}

test "a missing value renders empty, several elements and attributes after th:text are kept" {
    var html = HtmlTemplate.render("<title th:text=\"${a}\">t</title><strong class=\"k\" th:text=\"${b}\" id=\"i\">x</strong><span th:text=\"${c}\">c</span>", mapOf("a", "A", "b", "B"))
    Check.eqStr("rendered", "<title>A</title><strong class=\"k\" id=\"i\">B</strong><span></span>", html)
}

test "a multi-line element body is replaced as a whole" {
    var html = HtmlTemplate.render("<p th:text=\"${x}\">\n  linha 1\n  linha 2\n</p>", mapOf("x", "ok"))
    Check.eqStr("whole", "<p>ok</p>", html)
}

test "the attribute after th:text inherits the whitespace of the removed one, like Thymeleaf" {
    var html = HtmlTemplate.render("<span th:text=\"${code}\"\n      style=\"a: b;\">\n  000000\n</span>", mapOf("code", "123456"))
    Check.eqStr("collapsed", "<span style=\"a: b;\">123456</span>", html)
}

test "the footer year expression renders the current year" {
    var html = HtmlTemplate.render("<span th:text=\"${#dates.format(#dates.createNow(), 'yyyy')}\">2020</span>", mapOf())
    Check.isTrue("a four digit year", html.matches("<span>20\\d\\d</span>"))
}
