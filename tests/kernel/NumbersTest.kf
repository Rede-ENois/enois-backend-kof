import kernel.text.*

test "round goes half up and round2 keeps two decimals" {
    assert(Numbers.round(2.5) == 3L)
    assert(Numbers.round(2.4) == 2L)
    assert(Numbers.round(0.0) == 0L)
    assert(Numbers.round2(3.14159) == 3.14)
    assert(Numbers.round2(2.0) == 2.0)
    assert(Numbers.round2(0.005) == 0.01)
    assert(Numbers.pow(2.0, 3.0) == 8.0)
}
