record JsonContractInner(String a, Long n)

record JsonContractRec(Long id, String name, String? nick, Bool ok, Double d, List<String> tags, JsonContractInner inner, Int? maybe)

// The Java app serialises with Jackson defaults (Spring Boot): record component names, nulls kept,
// declaration order, ISO strings for instants, unknown input properties ignored.
test "records encode like Jackson: names, order, nulls kept" {
    var r = JsonContractRec(1L, "Mel \"q\" é/<>", null, true, 1.5, listOf("a", "b"), JsonContractInner("x", 5L), null)
    assert(json.encode(r) == "{\"id\":1,\"name\":\"Mel \\\"q\\\" é/<>\",\"nick\":null,\"ok\":true,\"d\":1.5,\"tags\":[\"a\",\"b\"],\"inner\":{\"a\":\"x\",\"n\":5},\"maybe\":null}")
}

test "decode ignores unknown properties and leaves missing ones null" {
    var d = json.decode<JsonContractRec>("{\"id\":7,\"name\":\"n\",\"zzz\":1,\"ok\":true,\"tags\":[],\"inner\":{\"a\":\"q\",\"n\":1},\"d\":2}")
    assert(d.id() == 7L)
    assert(d.nick() == null)
    assert(d.maybe() == null)
}

test "malformed json and type mismatches throw" {
    var failures = 0
    try {
        json.decode<JsonContractRec>("not json")
    } catch (String e) {
        failures = failures + 1
    }
    try {
        json.decode<JsonContractRec>("{\"id\":\"abc\"}")
    } catch (String e) {
        failures = failures + 1
    }
    assert(failures == 2)
}
