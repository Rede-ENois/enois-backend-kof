import kernel.monitoring.*

test "the host sample fills the JVM fields and never throws on a missing cgroup" {
    var resources = HostResources()
    var view = resources.sample(null)
    assert(view.heapMaxBytes() > 0L)
    assert(view.heapUsedBytes() > 0L)
    assert(view.threads() > 0)
    assert(view.processors() > 0)
    assert(view.diskTotalBytes() > 0L)
    assert(view.dbPool() == null)
    // A second sample after a pause is allowed to answer -1 (no cgroup here) but must not fail.
    var again = resources.sample(null)
    assert(again.heapMaxBytes() == view.heapMaxBytes())
}

test "meminfo parsing keeps the digits of a kibibyte line" {
    assert(HostResources.kib("MemTotal:       16384000 kB") == 16384000L)
    assert(HostResources.kib("MemTotal: kB") == 0L)
    assert(HostResources.heapUsedNow() > 0L)
}
