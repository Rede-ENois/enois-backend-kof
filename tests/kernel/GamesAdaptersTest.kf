import kernel.text.*
import kernel.time.*
import kernel.url.*

// Kernel adapters added by the games port: each one touches Java, so each one is proven to load and run.
test "JavaRandom draws the java.util.Random sequence" {
    var rng = JavaRandom(42L)
    var out = ""
    var i = 0
    while (i < 5) {
        out = out + rng.nextInt(100) + ","
        i = i + 1
    }
    assert(out == "30,63,48,84,70,")
    assert(JavaRandom(-7L).nextInt(1000) == 662)
    assert(JavaRandom.secureLong() != JavaRandom.secureLong())
}

test "IsoWeeks renders the ISO week without padding" {
    assert(IsoWeeks.key("2026-11-04") == "2026-W45")
    assert(IsoWeeks.key("2026-01-01") == "2026-W1")
    // The 29th of December can already be week 1 of the next year, and Jan 1st week 53 of the last.
    assert(IsoWeeks.key("2025-12-29") == "2026-W1")
    assert(IsoWeeks.key("2021-01-01") == "2020-W53")
}

test "HostAddresses classifies literal addresses" {
    assert(HostAddresses.classify("8.8.8.8") == "OK")
    assert(HostAddresses.classify("127.0.0.1") == "INTERNAL")
    assert(HostAddresses.classify("10.1.2.3") == "INTERNAL")
    assert(HostAddresses.classify("192.168.0.9") == "INTERNAL")
    assert(HostAddresses.classify("169.254.169.254") == "INTERNAL")
    assert(HostAddresses.classify("0.0.0.0") == "INTERNAL")
    assert(HostAddresses.classify("224.0.0.1") == "INTERNAL")
    assert(HostAddresses.classify("::1") == "INTERNAL")
    assert(HostAddresses.classify("fd00::1") == "INTERNAL")
}

String urlSummary(value: String) {
    var parts = UrlParser.parse(value)
    if (parts == null) {
        return "none"
    }
    var host = "-"
    var h = parts.host()
    if (h != null) {
        host = h
    }
    var info = "-"
    var u = parts.userInfo()
    if (u != null) {
        info = u
    }
    return parts.scheme() + "|" + host + "|" + info
}

test "UrlParser reads strict and tolerant URLs" {
    assert(urlSummary("https://user:pw@jogo.itch.io/path?q=1") == "https|jogo.itch.io|user:pw")
    assert(urlSummary("https://jogo.itch.io/path") == "https|jogo.itch.io|-")
    // A space makes java.net.URI reject it; the tolerant path still finds scheme and host.
    assert(urlSummary("https://jogo.itch.io/a b") == "https|jogo.itch.io|-")
    assert(urlSummary("not a url") == "none")
}
