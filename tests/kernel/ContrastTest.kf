import kernel.text.*
import kernel.testkit.*

test "the WCAG ratio of black on white is 21 and a colour against itself is 1" {
    var r = Contrast.ratio("#000000", "#ffffff")
    assert(r > 20.99 && r < 21.01)
    var same = Contrast.ratio("#7c3aed", "#7C3AED")
    assert(same > 0.99 && same < 1.01)
    assert(Contrast.ratio("#fff", "#000000") == 0.0)
    assert(Contrast.ratio("not a colour", "#000000") == 0.0)
}

test "a translucent surface is mixed over its backdrop" {
    Check.eqStr("opaque", "#336699", Contrast.over("#336699", "#000000", 1.0))
    Check.eqStr("half", "#808080", Contrast.over("#ffffff", "#000000", 0.5))
    Check.eqStr("none", "#102030", Contrast.over("#ffffff", "#102030", 0.0))
}

test "the measured ratio is the whole part, like the integer division of the Java message" {
    assert(Contrast.wholePart(4.37) == 4L)
    assert(Contrast.wholePart(1.0) == 1L)
    assert(Contrast.wholePart(0.0) == 0L)
    assert(Contrast.wholePart(21.0) == 21L)
}

test "a JSON unicode escape becomes its character and a bad digit becomes empty" {
    Check.eqStr("A", "A", Texts.fromHex4("0041"))
    Check.eqStr("hash", "#", Texts.fromHex4("0023"))
    Check.eqStr("cedilla", "ç", Texts.fromHex4("00E7"))
    Check.eqStr("bad", "", Texts.fromHex4("00zz"))
}

test "Regexes.matches needs the whole text to match" {
    assert(Regexes.matches("#[0-9a-fA-F]{6}", "#7c3aed"))
    assert(!Regexes.matches("#[0-9a-fA-F]{6}", "#7c3aedx"))
    assert(!Regexes.matches("#[0-9a-fA-F]{6}", "x#7c3aed"))
    assert(!Regexes.matches("\\d+px", "8px\n"))
}
