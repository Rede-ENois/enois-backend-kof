import kernel.config.*
import java.util.HashMap

Config cfgWith(k: String, v: String) {
    var m = new HashMap<String, String>()
    m.put(k, v)
    return Config.of(m)
}

test "config returns typed values and defaults" {
    var c = cfgWith("APP_X", "42")
    assert(c.getInt("APP_X", 1) == 42)
    assert(c.getLong("APP_X", 1L) == 42L)
    assert(c.getInt("APP_MISSING_KEY", 7) == 7)
    assert(c.getStr("APP_MISSING_KEY", "d") == "d")
    assert(c.getBool("APP_MISSING_KEY", true))
    assert(c.has("APP_X"))
    assert(!c.has("APP_MISSING_KEY"))
}

test "config parses booleans" {
    assert(cfgWith("B", "true").getBool("B", false))
    assert(cfgWith("B", "1").getBool("B", false))
    assert(!cfgWith("B", "false").getBool("B", true))
}

test "blank value counts as unset" {
    assert(cfgWith("APP_BLANK", "  ").getStr("APP_BLANK", "dflt") == "dflt")
}

test "config reads the process environment" {
    assert(Config.env().getStr("HOME", "").length() > 0)
}

test "required secret fails fast" {
    var failed = false
    try {
        cfgWith("A", "b").required("APP_SECRET_NOPE")
    } catch (String e) {
        failed = e.startsWith("CONFIG_MISSING")
    }
    assert(failed, "required must throw CONFIG_MISSING")
}

test "invalid numbers and booleans fail fast" {
    var n = false
    try {
        cfgWith("N", "abc").getInt("N", 1)
    } catch (String e) {
        n = e.startsWith("CONFIG_INVALID")
    }
    assert(n)
    var b = false
    try {
        cfgWith("N", "maybe").getBool("N", false)
    } catch (String e) {
        b = e.startsWith("CONFIG_INVALID")
    }
    assert(b)
}
