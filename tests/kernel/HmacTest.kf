import kernel.security.*
import kernel.testkit.*

test "hmacSha256Hex matches the RFC 4231 case 2 vector" {
    Check.eqStr("hmac", "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843", Hashes.hmacSha256Hex("Jefe", "what do ya want for nothing?"))
}

test "hmacSha256Hex matches the GitHub webhook documentation vector" {
    Check.eqStr("hmac", "757107ea0eb2509fc211221cce984b8a37570b6d7586c22c46f4379c8b043e17", Hashes.hmacSha256Hex("It\'s a Secret to Everybody", "Hello, World!"))
}

test "hmacSha256Hex hashes the UTF-8 bytes of a non ASCII text" {
    var a = Hashes.hmacSha256Hex("segredo", "ação")
    Check.eqInt("length", 64, a.length())
    Check.isTrue("differs from the ASCII text", a != Hashes.hmacSha256Hex("segredo", "acao"))
}
