import feed.*
import kernel.testkit.*

// GET /feed/saved (no dedicated Java test): saved posts come back newest save first, deleted ones drop out.
test "the saved feed lists saved active posts" {
    var author = FeedTestSupport.user("saved_author")
    var reader = FeedTestSupport.user("saved_reader")
    var first = FeedFixtures.publish(author, "sv-pub-1", "Primeiro post salvo.")
    var second = FeedFixtures.publish(author, "sv-pub-2", "Segundo post salvo.")
    Check.status(FeedTestSupport.send("POST", "/feed/posts/" + first + "/saves", reader, "sv-1", ""), 200)
    Check.status(FeedTestSupport.send("POST", "/feed/posts/" + second + "/saves", reader, "sv-2", ""), 200)
    var res = FeedTestSupport.app().client.getWith("/feed/saved", FeedTestSupport.read(reader))
    Check.status(res, 200)
    Check.eqInt("two saved", 2, res.jsonSize("items"))
    Check.status(FeedTestSupport.send("DELETE", "/feed/posts/" + first, author, "sv-del", ""), 200)
    Check.eqInt("one left", 1, FeedTestSupport.app().client.getWith("/feed/saved", FeedTestSupport.read(reader)).jsonSize("items"))
    Check.status(FeedTestSupport.app().client.get("/feed/saved"), 401)
    FeedTestSupport.finish()
}
