import feed.*
import kernel.testkit.*

// Port of PostContentLimitsTests (the edit half needs PATCH /feed/posts/{id}, see PORTING_STATUS).
test "each type accepts exactly its limit" {
    var author = FeedTestSupport.user("plimits_author1")
    var limits = mapOf("QUESTION", 1200, "REVIEW", 600, "PROJECT", 2000, "NEWS", 2000, "OPPORTUNITY", 1500, "TUTORIAL", 5000, "INSIGHT", 1200)
    for (var type in limits.keys()) {
        var limit = limits.getOrDefault(type, 0)
        var ok = FeedTestSupport.post(author, "plimits-" + type + "-ok", "{\"topic\":\"TECNOLOGIA\",\"type\":\"" + type + "\",\"content\":\"" + strings.repeat("x", limit) + "\"}")
        Check.status(ok, 201)
        Check.apiError(FeedTestSupport.post(author, "plimits-" + type + "-long", "{\"topic\":\"TECNOLOGIA\",\"type\":\"" + type + "\",\"content\":\"" + strings.repeat("x", limit + 1) + "\"}"), 400, "CONTENT_TOO_LONG")
    }
}
