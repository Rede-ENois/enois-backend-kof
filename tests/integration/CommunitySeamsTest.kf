import app.*
import kernel.db.*
import kernel.testkit.*

// Production wiring (AppWiring): the feed serves the community and channel feeds and enforces the channel rules of a
// post (port of CommunityChannelTests.channelRulesAreEnforcedByTheBackend, which needs POST /feed/posts), and
// onboarding joins and connects through the services of communities and network.
String createCommunity(token: String, key: String, name: String) {
    var res = WiredApp.send("POST", "/communities", token, key, "{\"name\":\"" + name + "\",\"description\":\"Comunidade de teste.\",\"topic\":\"TECNOLOGIA\"}")
    Check.status(res, 201)
    var id = res.jsonStr("id")
    if (id == null) {
        throw "FAIL no community id"
    }
    return id
}

test "channel rules of a post are enforced and the channel feed is the real feed" {
    var member = WiredApp.adult("seamc_rules")
    var communityId = createCommunity(member, "seamc-c1", "Comunidade regras")
    var channel = WiredApp.send("POST", "/communities/" + communityId + "/channels", member, "seamc-ch1", "{\"name\":\"Geral\",\"topic\":\"PRODUTO\"}")
    Check.status(channel, 200)
    var channelId = channel.jsonStr("id")
    if (channelId == null) {
        throw "FAIL no channel id"
    }
    Check.apiError(WiredApp.send("POST", "/feed/posts", member, "seamc-p1", "{\"topic\":\"TECNOLOGIA\",\"type\":\"INSIGHT\",\"content\":\"Sem comunidade.\",\"channelId\":\"" + channelId + "\"}"), 400, "CHANNEL_REQUIRES_COMMUNITY")
    Check.apiError(WiredApp.send("POST", "/feed/posts", member, "seamc-p2", "{\"type\":\"INSIGHT\",\"content\":\"Com assunto.\",\"communityId\":\"" + communityId + "\",\"channelId\":\"" + channelId + "\",\"topic\":\"TECNOLOGIA\"}"), 400, "TOPIC_FROM_CHANNEL")
    var other = createCommunity(member, "seamc-c2", "Outra comunidade")
    Check.apiError(WiredApp.send("POST", "/feed/posts", member, "seamc-p3", "{\"type\":\"INSIGHT\",\"content\":\"Canal errado.\",\"communityId\":\"" + other + "\",\"channelId\":\"" + channelId + "\"}"), 404, "CHANNEL_NOT_FOUND")
    var ok = WiredApp.send("POST", "/feed/posts", member, "seamc-p4", "{\"type\":\"INSIGHT\",\"content\":\"Segredo do canal: o bastidor fica aqui.\",\"communityId\":\"" + communityId + "\",\"channelId\":\"" + channelId + "\"}")
    Check.status(ok, 201)
    var feed = WiredApp.get("/communities/" + communityId + "/channels/" + channelId + "/posts", member)
    Check.status(feed, 200)
    Check.eqInt("channel items", 1, feed.jsonSize("items"))
    Check.jsonEq(feed, "items.0.content", "Segredo do canal: o bastidor fica aqui.")
    var community = WiredApp.get("/communities/" + communityId + "/feed", member)
    Check.status(community, 200)
    Check.eqInt("a channel post never shows in the community feed", 0, community.jsonSize("items"))
}

test "a community post is pinned and read back through the feed" {
    var owner = WiredApp.adult("seamc_pin")
    var communityId = createCommunity(owner, "seamc-pin-c", "Comunidade fixada")
    var post = WiredApp.send("POST", "/feed/posts", owner, "seamc-pin-p", "{\"type\":\"INSIGHT\",\"content\":\"Post para fixar na comunidade.\",\"communityId\":\"" + communityId + "\"}")
    Check.status(post, 201)
    var postId = post.jsonStr("id")
    if (postId == null) {
        throw "FAIL no post id"
    }
    var pinned = WiredApp.send("POST", "/communities/" + communityId + "/pin", owner, "seamc-pin-1", "{\"postId\":\"" + postId + "\"}")
    Check.status(pinned, 200)
    Check.jsonEq(pinned, "id", postId)
    Check.jsonEq(pinned, "type", "INSIGHT")
}

test "onboarding joins the community and asks for the connection through their services" {
    var owner = WiredApp.adult("seamc_ob_owner")
    var newcomer = WiredApp.adult("seamc_ob_new")
    var friend = WiredApp.adult("seamc_ob_friend")
    var communityId = createCommunity(owner, "seamc-ob-c", "Comunidade onboarding")
    var done = WiredApp.send("POST", "/me/onboarding/complete", newcomer, "seamc-ob-1", "{\"topics\":[\"TECNOLOGIA\"],\"skills\":[\"kotlin\"],\"communityIds\":[\"" + communityId + "\"],\"groupIds\":[],\"connectUserIds\":[\"seamc_ob_friend\"]}")
    Check.status(done, 200)
    var db = WiredApp.app().db()
    Check.eqInt("joined", 1, db.queryLong("select count(*) from community_members where community_id = ? and user_id = ?", DbParams().bindStr(communityId).bindStr("seamc_ob_new")) as Int)
    Check.eqInt("requested", 1, db.queryLong("select count(*) from user_connections where requester_user_id = ? and receiver_user_id = ?", DbParams().bindStr("seamc_ob_new").bindStr("seamc_ob_friend")) as Int)
    Check.eqInt("skill saved by the profile update", 1, db.queryLong("select count(*) from user_skills where user_id = ? and lower(skill) = \'kotlin\'", DbParams().bindStr("seamc_ob_new")) as Int)
}

test "the stack is stopped at the end" {
    WiredApp.finish()
}
