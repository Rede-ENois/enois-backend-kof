import cosmetics.*
import kernel.testkit.*

Bool failsToParse(start: String?, end: String?) {
    try {
        SeasonWindow.parse(start, end)
    } catch (String e) {
        return true
    }
    return false
}

// Port of SeasonWindowTests.
test "a plain window includes both ends" {
    var saci = SeasonWindow.parse("10-15", "11-02")
    Check.isTrue("10-15", saci.contains(1015))
    Check.isTrue("10-31", saci.contains(1031))
    Check.isTrue("11-02", saci.contains(1102))
    Check.isTrue("10-14 is out", !saci.contains(1014))
    Check.isTrue("11-03 is out", !saci.contains(1103))
    Check.isTrue("03-01 is out", !saci.contains(301))
}

test "a window that wraps the year covers December and January" {
    var reveillon = SeasonWindow.parse("12-26", "01-06")
    Check.isTrue("12-26", reveillon.contains(1226))
    Check.isTrue("12-31", reveillon.contains(1231))
    Check.isTrue("01-01", reveillon.contains(101))
    Check.isTrue("01-06", reveillon.contains(106))
    Check.isTrue("01-07 is out", !reveillon.contains(107))
    Check.isTrue("12-25 is out", !reveillon.contains(1225))
    Check.isTrue("07-01 is out", !reveillon.contains(701))
}

test "a single day window and the text round trip" {
    var day = SeasonWindow.parse("02-29", "02-29")
    Check.isTrue("02-29", day.contains(229))
    Check.isTrue("03-01 is out", !day.contains(301))
    Check.eqStr("start text", "05-20", SeasonWindow.parse("05-20", "05-31").startText())
    Check.eqStr("end text", "05-31", SeasonWindow.parse("05-20", "05-31").endText())
}

test "an invalid month-day fails" {
    Check.isTrue("13-01", failsToParse("13-01", "01-02"))
    Check.isTrue("null end", failsToParse("10-15", null))
    Check.isTrue("11-31", failsToParse("10-15", "11-31"))
    Check.isTrue("not a date", failsToParse("ab-cd", "01-02"))
}
