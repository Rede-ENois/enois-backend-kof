import kernel.testkit.*
import moderation.*

// Port of ModeratorEligibilityTests: the real threshold (200 credibility) refuses an application from a new account.
test "a new account with low reputation cannot apply" {
    var user = ModerationTestKit.login("melow_mod")
    var me = ModerationTestKit.get(user, "/moderation/me")
    Check.status(me, 200)
    Check.jsonEq(me, "minReputation", "200")
    Check.jsonEq(me, "eligible", "false")
    Check.jsonEq(me, "moderator", "false")
    var res = ModerationTestKit.post(user, "/moderation/applications", "{\"motivation\":\"Quero muito ajudar a comunidade a crescer com seguranca.\"}")
    Check.status(res, 403)
    Check.jsonEq(res, "code", "LOW_REPUTATION")
    var brief = ModerationTestKit.post(user, "/moderation/applications", "{\"motivation\":\"curto\"}")
    Check.status(brief, 400)
    Check.jsonEq(brief, "code", "INVALID_MOTIVATION")
}

test "a direct sanction requires a moderator or an admin" {
    var user = ModerationTestKit.login("melow_notadmin")
    ModerationTestKit.login("melow_target")
    Check.status(ModerationTestKit.post(user, "/admin/users/melow_target/sanction", "{\"type\":\"RESTRICTION\",\"reason\":\"tentativa sem permissao\"}"), 403)
    ModerationTestKit.finish()
}
