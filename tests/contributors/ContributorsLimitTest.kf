import contributors.*
import kernel.*
import kernel.testkit.*

// The public landing form is limited per IP (CONTRIBUTION_RATE_LIMIT, 5 per hour by default); a request over the
// limit is refused before anything is read.
test "the public form is limited per IP" {
    var app = ContributorsTestKit.app()
    var n = 1
    while (n <= 5) {
        var ok = app.client.send("POST", "/contributors/applications", listOf("Content-Type: application/json"), "", "{\"name\":\"Pessoa " + n + "\",\"github\":\"limit-dev-" + n + "\",\"email\":\"limit" + n + "@example.com\",\"acceptedTerms\":true}")
        Check.status(ok, 201)
        n = n + 1
    }
    var limited = app.client.send("POST", "/contributors/applications", listOf("Content-Type: application/json"), "", "{\"name\":\"Pessoa 6\",\"github\":\"limit-dev-6\",\"email\":\"limit6@example.com\",\"acceptedTerms\":true}")
    Check.apiError(limited, 429, "RATE_LIMITED")
}

test "finish" {
    ContributorsTestKit.finish()
}
