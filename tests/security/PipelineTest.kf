import kernel.*
import kernel.config.*
import kernel.error.*
import kernel.http.*
import kernel.security.*
import kernel.testkit.*

// Port of SecurityHeadersFilterTests, MissingSessionHeaderTests, AutomatedWritePathsTests,
// WriteRouteInterceptor/AdminRouteInterceptor rules, FallbackSurfaceTests and RequestPathTests, plus the
// shape of the whole chain. One app, default limits.
wirePipeline(s: HttpServer) {
    s.get("/probe/open", () -> "{\"ok\":true}")
    s.get("/probe/cache", () -> "{\"cache\":true}")
    s.get("/feed/posts/:id", () -> feedMissing())
    s.post("/feed/posts", () -> "{\"posted\":true}")
    s.post("/games/tokens/validate", () -> badBody())
    s.post("/auth/login", () -> badBody())
    s.post("/auth/oauth/google/callback", () -> "{\"cb\":true}")
    s.post("/auth/oauth/google/token", () -> "{\"tok\":true}")
    s.post("/auth/logout", () -> "{\"bye\":true}")
    s.delete("/feed/posts/:id", () -> "{\"deleted\":true}")
    s.put("/feed/posts/:id", () -> "{\"put\":true}")
    s.patch("/feed/posts/:id", () -> "{\"patched\":true}")
    s.get("/admin/reports", () -> "{\"admin\":true}")
    s.get("/admin/support", () -> "{\"support\":true}")
    s.get("/admin/support/github", () -> "{\"infra\":true}")
    s.get("/admin/support/github/repos", () -> "{\"infra\":true}")
    s.get("/admin/appeals", () -> "{\"appeals\":true}")
    s.get("/admin/appeals/:id", () -> "{\"appeal\":true}")
    s.get("/admin/users/:id/sanction", () -> "{\"sanction\":true}")
    s.get("/admin/users/:id/ips", () -> "{\"ips\":true}")
    s.get("/admin/users/:id", () -> "{\"user\":true}")
    s.get("/admin/moderators", () -> "{\"mods\":true}")
    s.post("/admin/moderators", () -> "{\"mods\":true}")
    s.get("/moderation/me", () -> "{\"me\":true}")
    s.get("/users/:name", () -> "{\"profile\":true}")
    s.get("/administer/support", () -> "{\"profile\":true}")
    s.get("/auth/config", () -> "{\"captchaMode\":\"x\"}")
    s.get("/v1", () -> "{\"index\":true}")
}

String feedMissing() {
    throw Errors.api(404, "POST_NOT_FOUND", "Post nao encontrado.")
}

String badBody() {
    throw Errors.api(400, "BAD_REQUEST", "Requisicao invalida.")
}

class PipelineHolder {
    static TestApp? app = null
}

TestApp pipelineApp() {
    var cur = PipelineHolder.app
    if (cur != null) {
        return cur
    }
    var created = SecurityApp.boot("pipeline", mapOf("REDE_ADMIN_BOOTSTRAP_ENABLED", "true", "REDE_ADMIN_EMAILS", "mail-admin@test.invalid"), (s: HttpServer) -> wirePipeline(s))
    PipelineHolder.app = created
    return created
}

// SecurityHeadersFilterTests
test "isolation headers are set on every response and nothing is cached for anonymous reads" {
    var app = pipelineApp()
    var res = app.client.get("/probe/open")
    Check.status(res, 200)
    Check.eqStr("coop", "same-origin", res.header("Cross-Origin-Opener-Policy"))
    Check.eqStr("corp", "same-site", res.header("Cross-Origin-Resource-Policy"))
    Check.eqStr("cache", "", res.header("Cache-Control"))
}

test "the final header set is exactly the Java one, each header once" {
    var app = pipelineApp()
    var res = app.client.get("/probe/open")
    Check.eqStr("csp", "default-src \'none\'; frame-ancestors \'none\'; base-uri \'none\'; form-action \'none\'", res.header("Content-Security-Policy"))
    Check.eqStr("nosniff", "nosniff", res.header("X-Content-Type-Options"))
    Check.eqStr("frame", "DENY", res.header("X-Frame-Options"))
    Check.eqStr("referrer", "no-referrer", res.header("Referrer-Policy"))
    Check.eqStr("permissions", "geolocation=(), microphone=(), camera=()", res.header("Permissions-Policy"))
    Check.eqStr("hsts", "max-age=31536000; includeSubDomains", res.header("Strict-Transport-Security"))
    var names = listOf("Content-Security-Policy", "X-Content-Type-Options", "X-Frame-Options", "Referrer-Policy", "Cross-Origin-Opener-Policy", "Cross-Origin-Resource-Policy", "Permissions-Policy", "Strict-Transport-Security")
    for (var n in names) {
        Check.eqInt(n + " occurrences", 1, res.headersOf(n).size())
    }
    Check.isTrue("request id", res.header("X-Request-Id").length() >= 8)
}

test "error responses of routes and of the 405 gate keep the headers too" {
    var app = pipelineApp()
    var missing = app.client.get("/feed/posts/zz_1")
    Check.status(missing, 404)
    Check.eqStr("csp", "default-src \'none\'; frame-ancestors \'none\'; base-uri \'none\'; form-action \'none\'", missing.header("Content-Security-Policy"))
    var wrong = app.client.send("DELETE", "/probe/open", listOf<String>(), "", "")
    Check.apiError(wrong, 405, "METHOD_NOT_ALLOWED")
    Check.eqStr("405 hsts", "max-age=31536000; includeSubDomains", wrong.header("Strict-Transport-Security"))
}

test "authenticated by header is not cached" {
    var app = pipelineApp()
    var res = app.client.getWith("/probe/cache", listOf("X-Session-Token: token"))
    Check.eqStr("cache", "no-store", res.header("Cache-Control"))
}

test "authenticated by cookie is not cached" {
    var app = pipelineApp()
    var res = app.client.send("GET", "/probe/cache", listOf<String>(), "enois_session=token", "")
    Check.eqStr("cache", "no-store", res.header("Cache-Control"))
}

// MissingSessionHeaderTests
test "protected admin and moderation routes answer 401 without a session or with an invalid one" {
    var app = pipelineApp()
    Check.apiError(app.client.get("/admin/reports"), 401, "UNAUTHENTICATED")
    var invalid = app.client.getWith("/admin/reports", listOf("X-Session-Token: invalido"))
    Check.apiError(invalid, 401, "UNAUTHENTICATED")
    var viaV1 = app.client.get("/v1/admin/reports")
    Check.apiError(viaV1, 401, "UNAUTHENTICATED")
}

test "a write route requires a session unless it is a public flow" {
    var app = pipelineApp()
    var res = app.client.postJson("/feed/posts", "{}")
    Check.apiError(res, 401, "UNAUTHENTICATED")
    Check.status(app.client.postJson("/games/tokens/validate", "{}"), 400)
    Check.status(app.client.postJson("/auth/login", "{}"), 400)
    Check.status(app.client.postJson("/auth/oauth/google/callback", "{}"), 200)
    Check.status(app.client.postJson("/auth/oauth/google/token", "{}"), 200)
    Check.apiError(app.client.postJson("/v1/feed/posts", "{}"), 401, "UNAUTHENTICATED")
    Check.status(app.client.postJson("/v1/auth/login", "{}"), 400)
    var put = app.client.putJson("/feed/posts/p1", "{}")
    Check.apiError(put, 401, "UNAUTHENTICATED")
    Check.apiError(app.client.patchJson("/feed/posts/p1", "{}"), 401, "UNAUTHENTICATED")
    Check.apiError(app.client.remove("/feed/posts/p1"), 401, "UNAUTHENTICATED")
}

test "an unknown method is a 405 before the write gate" {
    var app = pipelineApp()
    var res = app.client.postJson("/probe/open", "{}")
    Check.apiError(res, 405, "METHOD_NOT_ALLOWED")
}

// AutomatedWritePathsTests
test "the public write flows are exactly the known catalogue" {
    var expected = listOf("/auth/signup", "/auth/login", "/auth/refresh", "/auth/logout", "/auth/email/verify", "/auth/email/resend", "/auth/password/forgot", "/auth/password/reset", "/auth/2fa/verify", "/auth/2fa/resend", "/auth/2fa/email/request", "/auth/2fa/email/confirm", "/contributors/applications", "/auth/oauth/*/callback", "/auth/oauth/*/token", "/games/tokens/validate", "/webhooks/github", "/blogs/descadastrar", "/notifications/digest/unsubscribe")
    var actual = WriteGate.publicWrites()
    Check.eqInt("count", expected.size(), actual.size())
    for (var e in expected) {
        Check.isTrue("catalogue has " + e, actual.contains(e))
    }
    assert(WriteGate.isPublicWrite("/auth/oauth/github/callback"))
    assert(!WriteGate.isPublicWrite("/auth/oauth/github/callback/extra"))
    assert(!WriteGate.isPublicWrite("/auth/oauth/callback"))
    assert(!WriteGate.isPublicWrite("/feed/posts"))
}

test "no write route accepts a missing session unless it is a public flow" {
    var app = pipelineApp()
    var crossed = listOf<String>()
    for (var r in app.platform.server.routes) {
        if (r.method() == "GET") {
            continue
        }
        var p = r.pattern().replace(":id", "x1").replace(":name", "x1")
        if (p.startsWith("/v1")) {
            p = p.substring(3)
        }
        if (WriteGate.isPublicWrite(p) || p.startsWith("/admin")) {
            continue
        }
        var res = app.client.send(r.method(), p, listOf("Content-Type: application/json"), "", "{}")
        if (res.status != 401) {
            crossed.add(r.method() + " " + p + " -> " + res.status)
        }
    }
    var report = ""
    for (var c in crossed) {
        report = report + c + "; "
    }
    Check.eqStr("routes that crossed", "", report)
    var adminWrite = app.client.postJson("/admin/moderators", "{}")
    Check.apiError(adminWrite, 401, "UNAUTHENTICATED")
}

// AdminRouteInterceptor
test "admin routes need an admin, moderator panels open to moderators, github stays admin-only" {
    var app = pipelineApp()
    SecurityFixtures.login(app.db(), "pipe_plain", "tok-pipe-plain-1234")
    SecurityFixtures.login(app.db(), "pipe_admin", "tok-pipe-admin-1234")
    app.db().execute("update users set is_admin = true where id = ?", DbParams().bindStr("pipe_admin"))
    var plain = listOf("X-Session-Token: tok-pipe-plain-1234")
    var admin = listOf("X-Session-Token: tok-pipe-admin-1234")
    var denied = app.client.getWith("/admin/reports", plain)
    Check.apiError(denied, 403, "FORBIDDEN")
    Check.jsonEq(denied, "message", "Acesso restrito a administradores.")
    Check.status(app.client.getWith("/admin/reports", admin), 200)
    var supportPlain = app.client.getWith("/admin/support", plain)
    Check.apiError(supportPlain, 403, "FORBIDDEN")
    Check.jsonEq(supportPlain, "message", "Acesso restrito a moderadores.")
    Check.status(app.client.getWith("/admin/support", admin), 200)
    Check.status(app.client.getWith("/admin/appeals/a1", admin), 200)
    Check.status(app.client.getWith("/admin/users/u1/sanction", admin), 200)
    Check.apiError(app.client.getWith("/admin/users/u1/ips", plain), 403, "FORBIDDEN")
    Check.apiError(app.client.getWith("/admin/users/u1", plain), 403, "FORBIDDEN")
    Check.jsonEq(app.client.getWith("/admin/users/u1", plain), "message", "Acesso restrito a administradores.")
    var github = app.client.getWith("/admin/support/github", plain)
    Check.jsonEq(github, "message", "Acesso restrito a administradores.")
    Check.jsonEq(app.client.getWith("/admin/support/github/repos", plain), "message", "Acesso restrito a administradores.")
    Check.status(app.client.getWith("/admin/support/github/repos", admin), 200)
    Check.apiError(app.client.getWith("/v1/admin/reports", plain), 403, "FORBIDDEN")
}

test "a moderator reaches the moderation panels but not the admin-only ones" {
    var app = pipelineApp()
    SecurityFixtures.login(app.db(), "pipe_mod", "tok-pipe-mod-123456")
    var viaEmail = listOf("X-Session-Token: tok-pipe-mod-123456")
    Check.apiError(app.client.getWith("/admin/support", viaEmail), 403, "FORBIDDEN")
}

test "the e-mail bootstrap allowlist grants admin only when enabled" {
    var app = pipelineApp()
    SecurityFixtures.login(app.db(), "pipe_mailadmin", "tok-pipe-mail-12345")
    app.db().execute("update users set email = ? where id = ?", DbParams().bindStr("Mail-Admin@test.invalid").bindStr("pipe_mailadmin"))
    Check.status(app.client.getWith("/admin/reports", listOf("X-Session-Token: tok-pipe-mail-12345")), 200)
}

test "an OPTIONS preflight never needs a session on admin routes" {
    var app = pipelineApp()
    var res = app.client.send("OPTIONS", "/admin/reports", listOf("Origin: https://enois.ia.br", "Access-Control-Request-Method: GET"), "", "")
    assert(res.status < 300)
}

test "reserved usernames cannot be taken" {
    assert(AdminGuard.isReservedUsername("Admin"))
    assert(AdminGuard.isReservedUsername("  mrfoxxo "))
    assert(AdminGuard.isReservedUsername("enois-team"))
    assert(!AdminGuard.isReservedUsername("maria"))
    Check.eqInt("reserved", 28, AdminGuard.reservedUsernames().size())
}

// FallbackSurfaceTests
test "a path outside the surface answers 200 with an empty body, for reads and writes" {
    var app = pipelineApp()
    var read = app.client.get("/caminho_sem_atribuicao_9f2c")
    Check.status(read, 200)
    Check.eqStr("body", "", read.body)
    var write = app.client.postJson("/caminho_sem_atribuicao_9f2c", "{}")
    Check.status(write, 200)
    Check.eqStr("write body", "", write.body)
}

test "a path of the surface answers normally, also under the /v1 alias" {
    var app = pipelineApp()
    Check.status(app.client.get("/health"), 200)
    assert(app.client.get("/health").body.length() > 0)
    Check.status(app.client.get("/v1/health"), 200)
    assert(app.client.get("/v1/health").body.length() > 0)
}

test "a route with a variable follows to the application" {
    var app = pipelineApp()
    var res = app.client.get("/feed/posts/id_que_nao_existe_9f2c")
    Check.apiError(res, 404, "POST_NOT_FOUND")
}

test "double slashes, encoded literals, case changes and matrix params never become a known route" {
    var app = pipelineApp()
    for (var p in listOf("/auth//config", "/auth/%63onfig", "/Auth/config", "/auth/config/", "/admin;v=1/support", "/%61dmin/support", "/admin/%73upport", "/%6doderation/me", "/admin/support/github;v=1", "/api/%61dmin/support")) {
        var res = app.client.get(p)
        Check.eqInt("status " + p, 200, res.status)
        Check.eqStr("body " + p, "", res.body)
    }
}

test "a query parameter never turns a public path into an administrative one" {
    var app = pipelineApp()
    var res = app.client.get("/auth/config?next=/%61dmin/support")
    Check.status(res, 200)
    Check.jsonEq(res, "captchaMode", "x")
}

test "similar prefixes and public data do not need an admin session" {
    var app = pipelineApp()
    Check.jsonEq(app.client.get("/users/%61dmin"), "profile", "true")
    Check.jsonEq(app.client.get("/users/admin"), "profile", "true")
    Check.jsonEq(app.client.get("/administer/support"), "profile", "true")
}

test "an invalid escape that reaches the filters is a 400 with an empty body" {
    var app = pipelineApp()
    for (var p in listOf("/admin/%zz", "/admin/%", "/%zz", "/feed/posts/%4")) {
        var res = app.client.get(p)
        Check.eqInt("status " + p, 400, res.status)
        Check.eqStr("body " + p, "", res.body)
    }
}

// RequestPathTests
test "request path decodes a literal once and collapses separators" {
    assert(RequestPath.application("/%61dmin/support") == "/admin/support")
    assert(RequestPath.application("/%2561dmin/support") == "/%61dmin/support")
    assert(RequestPath.application("//users/a+b") == "/users/a+b")
    assert(RequestPath.routing("/auth//%63onfig") == "/auth//config")
    assert(RequestPath.application("/auth//%63onfig") == "/auth/config")
    assert(RequestPath.routing("/users/a%C3%A7%C3%A3o") == "/users/ação")
    assert(RequestPath.routing("/Admin/support") == "/Admin/support")
    assert(RequestPath.routing("/users/a%3Bb") == "/users/a;b")
    assert(RequestPath.routing("/users/a%2Bb") == "/users/a+b")
    assert(RequestPath.application("/users/a%2Bb") == "/users/a+b")
}

test "a malformed escape is not a valid path" {
    var failed = listOf<String>()
    for (var p in listOf("/%zz", "/%", "/a%4", "/%g1")) {
        try {
            RequestPath.application(p)
        } catch (String e) {
            failed.add(e)
        }
    }
    Check.eqInt("rejected", 4, failed.size())
    Check.eqStr("reason", "REQUEST_PATH_MALFORMED", failed.get(0))
}

test "the /v1 alias is stripped for guards, the bare index and lookalikes are not" {
    assert(RequestPath.stripAlias("/v1/auth/login") == "/auth/login")
    assert(RequestPath.stripAlias("/v1") == "/v1")
    assert(RequestPath.stripAlias("/v1x/auth") == "/v1x/auth")
    assert(RequestPath.stripAlias("/auth/login") == "/auth/login")
}
