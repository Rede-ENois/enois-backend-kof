import kernel.error.*
import kernel.security.*

// Produced by the Java PasswordHasher algorithm (PBKDF2WithHmacSHA256, 256 bit) with
// salt bytes[i] = i * 11 + 1.
String javaHash120k() = "120000:AQwXIi04Q05ZZG96hZCbpg==:2KVRGQEqaaYN/f0Eq/L+1wCJSvYtEzqeM89SZAI1MuQ="

String javaHash10k() = "10000:AQwXIi04Q05ZZG96hZCbpg==:dk+ciXrd9/ajZERqGTq2nmJGK1MibQb6U0GeuPL3Z30="

String weakCode(password: String?) {
    try {
        Passwords.validateStrength(password)
    } catch (String e) {
        return Errors.parse(e).code() + "|" + Errors.parse(e).message()
    }
    return "OK"
}

test "verifies a hash written by the Java service" {
    assert(Passwords.matches("S3nha-Forte!çã", javaHash120k()))
    assert(!Passwords.matches("S3nha-Forte!ca", javaHash120k()))
    assert(!Passwords.matches("", javaHash120k()))
}

test "honours the stored iteration count of older hashes" {
    assert(Passwords.matches("legacy", javaHash10k()))
    assert(!Passwords.matches("legacy", javaHash120k()))
}

test "hash uses the Java format and round trips" {
    var stored = Passwords.hash("outra senha 123")
    var parts = stored.split(":")
    assert(parts.length == 3)
    assert(parts[0] == "120000")
    assert(Passwords.matches("outra senha 123", stored))
    assert(!Passwords.matches("outra senha 124", stored))
    assert(Passwords.hash("outra senha 123") != stored)
}

test "malformed stored hashes never match" {
    assert(!Passwords.matches("x", ""))
    assert(!Passwords.matches("x", "plain"))
    assert(!Passwords.matches("x", "120000:onlytwo"))
    assert(!Passwords.matches("x", "abc:AQwXIi04Q05ZZG96hZCbpg==:2KVRGQEqaaYN/f0Eq/L+1wCJSvYtEzqeM89SZAI1MuQ="))
    assert(!Passwords.matches("x", "120000:!!!:2KVRGQEqaaYN/f0Eq/L+1wCJSvYtEzqeM89SZAI1MuQ="))
    assert(!Passwords.matches("x", "0:AQwXIi04Q05ZZG96hZCbpg==:2KVRGQEqaaYN/f0Eq/L+1wCJSvYtEzqeM89SZAI1MuQ="))
    assert(!Passwords.matches("x", "1:2:3:4"))
}

test "the common password list is loaded from resources/security" {
    assert(Passwords.isCommon("12345678"))
    assert(Passwords.isCommon("11111111"))
    assert(!Passwords.isCommon("uma-frase-bem-longa-e-unica-9x"))
    assert(Passwords.common().size() > 10)
}

test "strength rules and messages" {
    assert(weakCode(null) == "WEAK_PASSWORD|Senha deve ter pelo menos 8 caracteres.")
    assert(weakCode("") == "WEAK_PASSWORD|Senha deve ter pelo menos 8 caracteres.")
    assert(weakCode("        ") == "WEAK_PASSWORD|Senha deve ter pelo menos 8 caracteres.")
    assert(weakCode("curta7!") == "WEAK_PASSWORD|Senha deve ter pelo menos 8 caracteres.")
    assert(weakCode("12345678") == "WEAK_PASSWORD|Escolha uma senha menos previsivel.")
    assert(weakCode("1234567890") == "WEAK_PASSWORD|Escolha uma senha menos previsivel.")
    assert(weakCode("Quase-Segura-8") == "OK")
    var max = "aB3$" + strings.repeat("x", 124)
    assert(max.length() == 128)
    assert(weakCode(max) == "OK")
    assert(weakCode(max + "y") == "WEAK_PASSWORD|Senha deve ter no maximo 128 caracteres.")
}

test "the common list is compared case-insensitively" {
    assert(Passwords.isCommon("PASSWORD"))
    assert(weakCode("PassWord") == "WEAK_PASSWORD|Escolha uma senha menos previsivel.")
}
