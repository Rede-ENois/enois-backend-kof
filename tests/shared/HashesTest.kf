import kernel.security.*

test "sha256Hex matches the known vectors" {
    assert(Hashes.sha256Hex("") == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    assert(Hashes.sha256Hex("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    assert(Hashes.sha256Hex("ação") != Hashes.sha256Hex("acao"))
}
