import kernel.config.*
import kernel.error.*
import kernel.security.*

// Produced by the Java algorithm (AES/GCM/NoPadding, 12 byte IV prefix, 128 bit tag) with
// key bytes[i] = i * 7 + 3 and IV bytes[i] = 255 - i * 5, plaintext "JBSWY3DPEHPK3PXP-ação".
String javaKey() = "AwoRGB8mLTQ7QklQV15lbHN6gYiPlp2kq7K5wMfO1dw="

String javaCiphertext() = "//r18Ovm4dzX0s3Iz0qQKTxbtRr46hFDnCrzZfrOzWh3tnnKHO33DZZu2PH9Gj7kvlxc"

String cipherCaught(f: () -> String) {
    try {
        return f()
    } catch (String e) {
        return e
    }
}

test "decrypts a ciphertext produced by the Java service" {
    var cipher = SecretCipher(javaKey(), true)
    assert(cipher.decrypt(javaCiphertext()) == "JBSWY3DPEHPK3PXP-ação")
}

test "encrypts to the layout the Java service reads" {
    var cipher = SecretCipher(javaKey(), true)
    var stored = cipher.encrypt("JBSWY3DPEHPK3PXP-ação")
    // 12 (iv) + 24 (utf-8 plaintext) + 16 (tag) bytes -> 52 bytes -> 72 base64 chars.
    assert(stored.length() == javaCiphertext().length())
    assert(cipher.decrypt(stored) == "JBSWY3DPEHPK3PXP-ação")
}

test "round trips and uses a fresh IV every time" {
    var cipher = SecretCipher(SecretCipher.generateKeyBase64(), true)
    var secret = Totp.generateSecret()
    var encrypted = cipher.encrypt(secret)
    assert(encrypted != secret)
    assert(!encrypted.contains(secret))
    assert(cipher.decrypt(encrypted) == secret)
    assert(cipher.encrypt(secret) != encrypted)
}

test "without a key the feature is unavailable with an explicit error" {
    var disabled = SecretCipher("", false)
    assert(!disabled.isEnabled())
    var err = cipherCaught(() -> disabled.encrypt("x"))
    assert(Errors.parse(err).status() == 503)
    assert(Errors.parse(err).code() == "SECURITY_KEY_NOT_CONFIGURED")
    assert(Errors.parse(err).message().contains("segundo fator"))
    var err2 = cipherCaught(() -> disabled.decrypt("x"))
    assert(Errors.parse(err2).code() == "SECURITY_KEY_NOT_CONFIGURED")
}

test "a key is required when configured as required" {
    var err = cipherCaught(() -> {
        SecretCipher("", true)
        return "no error"
    })
    assert(err.contains("REDE_SECURITY_ENCRYPTION_KEY"))
}

test "a key of the wrong size or encoding is refused" {
    var shortKey = cipherCaught(() -> {
        SecretCipher("Y2hhdmUtY3VydGE=", false)
        return "no error"
    })
    assert(shortKey.contains("32 bytes"))
    var notBase64 = cipherCaught(() -> {
        SecretCipher("not base64 !!", false)
        return "no error"
    })
    assert(notBase64.contains("base64"))
}

test "another key cannot read the value" {
    var first = SecretCipher(SecretCipher.generateKeyBase64(), true)
    var second = SecretCipher(SecretCipher.generateKeyBase64(), true)
    var encrypted = first.encrypt("segredo-do-totp")
    var err = cipherCaught(() -> second.decrypt(encrypted))
    assert(err.startsWith("SECRET_CIPHER_FAILURE"))
}

test "a tampered or truncated ciphertext is refused" {
    var cipher = SecretCipher(javaKey(), true)
    var tampered = "A" + javaCiphertext().substring(1)
    assert(cipherCaught(() -> cipher.decrypt(tampered)).startsWith("SECRET_CIPHER_FAILURE"))
    assert(cipherCaught(() -> cipher.decrypt("AAAA")).startsWith("SECRET_CIPHER_FAILURE"))
}

test "fromConfig requires the key outside the dev profile" {
    var dev = SecretCipher.fromConfig(Config.of(mapOf("SPRING_PROFILES_ACTIVE", "dev", "REDE_SECURITY_ENCRYPTION_KEY", "")))
    assert(!dev.isEnabled())
    var prd = cipherCaught(() -> {
        SecretCipher.fromConfig(Config.of(mapOf("SPRING_PROFILES_ACTIVE", "prd", "REDE_SECURITY_ENCRYPTION_KEY", "")))
        return "no error"
    })
    assert(prd.startsWith("CONFIG_MISSING"))
    var withKey = SecretCipher.fromConfig(Config.of(mapOf("SPRING_PROFILES_ACTIVE", "prd", "REDE_SECURITY_ENCRYPTION_KEY", javaKey())))
    assert(withKey.decrypt(javaCiphertext()) == "JBSWY3DPEHPK3PXP-ação")
}
