import kernel.security.*

test "random tokens are url safe and distinct" {
    var a = Tokens.random(32)
    var b = Tokens.random(32)
    assert(a != b, "two tokens collided")
    assert(a.length() == 43, "32 bytes are 43 base64url characters")
    assert(Tokens.random(48).length() == 64, "48 bytes are 64 characters")
    assert(a.indexOf("=") < 0 && a.indexOf("+") < 0 && a.indexOf("/") < 0, "not url safe")
}

test "hmac matches the RFC 4231 style vector for a known key" {
    // key = base64("key"), message = "The quick brown fox jumps over the lazy dog"
    var mac = Tokens.hmacSha256Url("a2V5", "The quick brown fox jumps over the lazy dog")
    assert(mac == "97yD9DBThCSxMpjmqm-xQ-9NWaFJRhdZl0edvC0aPNg", "wrong HMAC")
}

test "base64url round trip and safe compare" {
    var enc = Tokens.base64UrlEncode("1|2|nonce")
    var back = Tokens.base64UrlDecode(enc)
    assert(back == "1|2|nonce", "round trip failed")
    assert(Tokens.base64UrlDecode("***") == null, "garbage must not decode")
    assert(Tokens.safeEquals("abc", "abc"), "equal")
    assert(!Tokens.safeEquals("abc", "abd"), "different")
    assert(Tokens.validKey("AAAAAAAAAAAAAAAAAAAAAA=="), "16 bytes")
    assert(!Tokens.validKey("AAAA"), "too short")
}
