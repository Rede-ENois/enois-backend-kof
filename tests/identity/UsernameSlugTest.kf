import identity.*
import kernel.testkit.*

// UsernameSlugTests
test "accentsBecomeThePlainLetterInsteadOfAHyphen" {
    Check.eqStr("cecilia", "cecilia-maria", IdentityService.slug("Cecília Maria"))
    Check.eqStr("joao", "joao-conceicao", IdentityService.slug("João Conceição"))
    Check.eqStr("angela", "angela-unsal", IdentityService.slug("Ângela Ünsal"))
}

test "symbolsBecomeOneHyphenAndNothingLeftFallsBackToUser" {
    Check.eqStr("symbols", "ana-bia", IdentityService.slug("  Ana & Bia!! "))
    Check.eqStr("dot", "ana-souza", IdentityService.slug("ana.souza"))
    Check.eqStr("only symbols", "user", IdentityService.slug("!!!"))
    Check.eqStr("null", "user", IdentityService.slug(IdentityText.orEmpty(IdentityText.none())))
}

test "canonical e-mail drops the plus tag and the gmail dots" {
    Check.eqStr("plus", "ana@example.com", IdentityService.canonicalEmail("ana+tag@example.com"))
    Check.eqStr("not gmail", "ana.souza@example.com", IdentityService.canonicalEmail("ana.souza@example.com"))
    Check.eqStr("gmail dots", "anasouza@gmail.com", IdentityService.canonicalEmail("ana.souza+x@gmail.com"))
}
