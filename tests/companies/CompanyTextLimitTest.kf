import app.*
import kernel.testkit.*

// Port of the company cases of TextFieldLimitTests: a field over the column ceiling is refused with the field named
// (400 COMPANY_FIELD_TOO_LONG), not the generic 409 the database would answer.
test "empresaComNomeLongoRecusaDizendoOCampo" {
    var owner = OrgsTestKit.login("tfl_empresa")
    var res = owner.post("/empresas", "{\"name\":\"" + strings.repeat("E", 200) + "\",\"description\":\"Empresa de teste.\"}")
    Check.apiError(res, 400, "COMPANY_FIELD_TOO_LONG")
    Check.isTrue("names the field", OrgsTestKit.str(res, "message").contains("nome"))
    Check.isTrue("names the ceiling", OrgsTestKit.str(res, "message").contains("160"))
}

test "microprojetoComTituloLongoRecusaDizendoOCampo" {
    var owner = OrgsTestKit.login("tfl_micro")
    var company = owner.post("/empresas", "{\"name\":\"Estudio de Teste\",\"description\":\"Empresa criada para o teste de limite.\"}")
    Check.status(company, 200)
    var res = owner.post("/empresas/" + OrgsTestKit.str(company, "id") + "/microprojetos", "{\"title\":\"" + strings.repeat("M", 300) + "\",\"problem\":\"Problema real com pelo menos trinta caracteres para passar.\",\"deliverables\":\"Entregaveis com pelo menos vinte caracteres.\",\"acceptanceCriteria\":\"Criterios com pelo menos vinte caracteres.\"}")
    Check.apiError(res, 400, "COMPANY_FIELD_TOO_LONG")
    Check.isTrue("names the field", OrgsTestKit.str(res, "message").contains("titulo"))
    Check.isTrue("names the ceiling", OrgsTestKit.str(res, "message").contains("200"))
    OrgsTestKit.finish()
}
